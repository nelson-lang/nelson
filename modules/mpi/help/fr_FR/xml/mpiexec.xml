  <language>fr_FR</language>
  <keyword>mpiexec</keyword>
  <short_description>Exécute un script MPI.</short_description>
  <syntax>
    <syntax_item>mpiexec(script)</syntax_item>
    <syntax_item>mpiexec(script, nb_process)</syntax_item>
    <syntax_item>r = mpiexec(script, nb_process)</syntax_item>
    <syntax_item>[r, msg] = mpiexec(script, nb_process)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>script</param_name>
      <param_description>un nom de fichier avec l&apos;extension .m.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>nb_process</param_name>
      <param_description
      >un entier : nombre de processus.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>r</param_name>
      <param_description
      >un entier : maximum des codes de sortie de tous les processus créés par mpiexec.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Exécute un script MPI dans Nelson.</p>
    <p>Les processus MPI sont lancés en mode CLI (sans interface graphique, sans tracé).</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="false"
      ><![CDATA[
mpiexec([modulepath('mpi'), '/examples/help_examples/MPI_Allreduce.m'], 4)]]></example_item_data>
    </example_item>
  </examples>
