  <keyword>classUnderlying</keyword>
  <short_description>Classe des données d'un gpuArray.</short_description>
  <syntax>
    <syntax_item>c = classUnderlying(G)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>G</param_name>
      <param_description>un gpuArray.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>c</param_name>
      <param_description>un vecteur de caractères.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>c = classUnderlying(G)</b> renvoie la classe des valeurs stockées sur le périphérique, comme <b>underlyingType(G)</b>.</p>
  </description>
  <used_function />
