  <language>fr_FR</language>
  <keyword>isgpuarray</keyword>
  <short_description>Indique si une valeur est un gpuArray.</short_description>
  <syntax>
    <syntax_item>tf = isgpuarray(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>une valeur quelconque.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>logique : true lorsque <b>A</b> est un gpuArray.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = isgpuarray(A)</b> renvoie <b>true</b> lorsque <b>A</b> est un <b>gpuArray</b> stocké sur le périphérique, et <b>false</b> sinon.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[isgpuarray(gpuArray(single(1)))
isgpuarray(single(1))]]></example_item_data>
    </example_item>
  </examples>
