  <language>fr_FR</language>
  <keyword>isaUnderlying</keyword>
  <short_description>Teste la classe des données d'un gpuArray.</short_description>
  <syntax>
    <syntax_item>tf = isaUnderlying(G, typename)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>G</param_name>
      <param_description>un gpuArray.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>typename</param_name>
      <param_description>un nom de classe, ou <b>'numeric'</b>, <b>'float'</b> ou <b>'integer'</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>un scalaire logique.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = isaUnderlying(G, typename)</b> renvoie <b>true</b> si les valeurs stockées sur le périphérique sont de classe <b>typename</b> ou de la catégorie donnée, comme <b>isUnderlyingType(G, typename)</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[isaUnderlying(gpuArray(single(1)), 'float')]]></example_item_data>
    </example_item>
  </examples>
