  <language>en_US</language>
  <keyword>isaUnderlying</keyword>
  <short_description>Check the class of the data held by a gpuArray.</short_description>
  <syntax>
    <syntax_item>tf = isaUnderlying(G, typename)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>G</param_name>
      <param_description>a gpuArray.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>typename</param_name>
      <param_description>a class name, or <b>'numeric'</b>, <b>'float'</b> or <b>'integer'</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>a logical scalar.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = isaUnderlying(G, typename)</b> returns <b>true</b> when the values stored on the device are of class <b>typename</b> or of the given category, like <b>isUnderlyingType(G, typename)</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[isaUnderlying(gpuArray(single(1)), 'float')]]></example_item_data>
    </example_item>
  </examples>
