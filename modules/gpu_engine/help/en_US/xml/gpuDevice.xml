  <language>en_US</language>
  <keyword>gpuDevice</keyword>
  <short_description>Query the selected GPU device.</short_description>
  <syntax>
    <syntax_item>d = gpuDevice()</syntax_item>
  </syntax>
  <param_output>
    <param_output_item>
      <param_name>d</param_name>
      <param_description>a struct describing the selected GPU device.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>d = gpuDevice()</b> returns a struct describing the selected GPU device, with the following fields:</p>
    <p><b>Index</b>: the device index.</p>
    <p><b>Name</b>: the adapter name.</p>
    <p><b>Vendor</b>: the hardware vendor.</p>
    <p><b>Architecture</b>: the device architecture.</p>
    <p><b>Backend</b>: the graphics backend in use (Vulkan, Metal or D3D12).</p>
    <p><b>MaxBufferSize</b>: the maximum size in bytes of a single device buffer.</p>
    <p>An error is raised when no compatible GPU device is available.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[if canUseGPU()
  d = gpuDevice()
end]]></example_item_data>
    </example_item>
  </examples>
