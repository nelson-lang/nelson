  <language>en_US</language>
  <keyword>gather</keyword>
  <short_description>Transfer a gpuArray to the host workspace.</short_description>
  <syntax>
    <syntax_item>A = gather(G)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>G</param_name>
      <param_description>a gpuArray, or any host value.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>A</param_name>
      <param_description>a host array with the same values and underlying type.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>A = gather(G)</b> copies the <b>gpuArray</b> <b>G</b> from the device back to the host workspace. The result is a <b>single</b>, <b>logical</b> or complex <b>single</b> array, matching the underlying type of <b>G</b>.</p>
    <p>When <b>G</b> is already a host value, <b>gather</b> returns it unchanged.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[G = gpuArray(single([1 2 3]));
A = gather(G + 1)]]></example_item_data>
    </example_item>
  </examples>
