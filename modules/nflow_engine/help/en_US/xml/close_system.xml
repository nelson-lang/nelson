  <keyword>close_system</keyword>
  <short_description>Unload an nflow model; a dirty model requires an explicit save flag.</short_description>
  <syntax>
    <syntax_item>close_system(model)</syntax_item>
    <syntax_item>close_system(model, saveFlag)</syntax_item>
  </syntax>
  <param_input><param_input_item><param_name>args</param_name><param_description>see the syntaxes above.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>varargout</param_name><param_description>see the syntaxes above.</param_description></param_output_item></param_output>
  <description><p><b>close_system</b> unloads an nflow model; a dirty model requires an explicit save flag.</p></description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[new_system('demo');
add_block('nflow/source/sine', 'demo/Sine');
add_block('nflow/math/gain', 'demo/Gain', 'gain', 2);
add_line('demo', 'Sine/1', 'Gain/1');
bdclose('demo');]]></example_item_data>
    </example_item>
  </examples>
