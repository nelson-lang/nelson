  <language>en_US</language>
  <keyword>NFlow.rmlibrarypath</keyword>
  <short_description>Remove an nflow block library search path.</short_description>
  <syntax>
    <syntax_item>NFlow.rmlibrarypath(folder)</syntax_item>
    <syntax_item>paths = NFlow.rmlibrarypath(folder)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>folder</param_name><param_description>a directory previously added with <b>NFlow.addlibrarypath</b>.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>paths</param_name><param_description>the updated list of search paths, a cell array of character vectors.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>NFlow.rmlibrarypath</b> removes <b>folder</b> from the nflow block library search paths and rescans the remaining ones. Removing a folder that is not registered has no effect.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Register then remove a library folder.</example_item_description>
      <example_item_data><![CDATA[folder = [modulepath('nflow_gui'), '/examples/libraries'];
NFlow.addlibrarypath(folder);
NFlow.rmlibrarypath(folder)]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${nflow_engine}NFlow.addlibrarypath">NFlow.addlibrarypath</link></see_also_item>
    <see_also_item><link linkend="${nflow_engine}NFlow.librarypaths">NFlow.librarypaths</link></see_also_item>
  </see_also>
