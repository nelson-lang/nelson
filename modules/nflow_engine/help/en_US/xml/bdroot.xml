  <language>en_US</language>
  <keyword>bdroot</keyword>
  <short_description>Return the top-level model of a block path.</short_description>
  <syntax>
    <syntax_item>root = bdroot(obj)</syntax_item>
  </syntax>
  <param_input><param_input_item><param_name>obj</param_name><param_description>a model name or a block path ('model' or 'model/BlockName').</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>root</param_name><param_description>the top-level model name (the part before the first '/').</param_description></param_output_item></param_output>
  <description>
    <p><b>bdroot</b> returns the top-level model of a block path.</p>
    <p><b>bdroot('model')</b> is <b>'model'</b>; <b>bdroot('model/Sub/Blk')</b> is
    <b>'model'</b>. The root model must be loaded.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[new_system('demo');
add_block('nflow/math/gain', 'demo/Gain');
root = bdroot('demo/Gain')
bdclose('demo');]]></example_item_data>
    </example_item>
  </examples>
