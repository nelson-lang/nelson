  <keyword>bdroot</keyword>
  <short_description>Renvoie le modèle de plus haut niveau d'un chemin de bloc.</short_description>
  <syntax>
    <syntax_item>root = bdroot(obj)</syntax_item>
  </syntax>
  <param_input><param_input_item><param_name>obj</param_name><param_description>un nom de modèle ou un chemin de bloc ('modèle' ou 'modèle/NomDeBloc').</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>root</param_name><param_description>le nom du modèle de plus haut niveau (la partie avant le premier '/').</param_description></param_output_item></param_output>
  <description>
    <p><b>bdroot</b> renvoie le modèle de plus haut niveau d'un chemin de bloc.</p>
    <p><b>bdroot('modele')</b> vaut <b>'modele'</b> ; <b>bdroot('modele/Sub/Blk')</b> vaut
    <b>'modele'</b>. Le modèle racine doit être chargé.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[new_system('demo');
add_block('nflow/math/gain', 'demo/Gain');
root = bdroot('demo/Gain')
bdclose('demo');]]></example_item_data>
    </example_item>
  </examples>
