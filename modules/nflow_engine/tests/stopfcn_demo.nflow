{
  "version": "1.0.0",
  "format": "nflow-2",
  "metadata": { "author": "Allan CORNET", "tool": "Nelson nflow" },
  "license": "LGPL-3.0",
  "comments": "StopFcn fixture: a sine logged to workspace; the StopFcn records how many samples the run produced, to prove the callback fires with 'out' available.",
  "name": "StopFcn Demo",
  "blocks": [
    { "id": "s1", "type": "sine", "x": 40, "y": 160, "rotation": 0, "params": { "Amplitude": 1, "Frequency": 0.2, "Phase": 0 } },
    { "id": "tw", "type": "toWorkspace", "x": 280, "y": 160, "rotation": 0, "params": { "VariableName": "stopfcn_y", "MaxDataPoints": "inf", "Decimation": 1, "SaveFormat": "Array", "SampleTime": "-1" } }
  ],
  "connections": [ { "from": "s1", "to": "tw", "fromIndex": 0, "toIndex": 0 } ],
  "variables": "",
  "runtime": 5,
  "sampleTime": 0.05,
  "stopFcn": "assignin('base', 'stopfcn_samples', numel(out.tout));",
  "autoRoute": true
}
