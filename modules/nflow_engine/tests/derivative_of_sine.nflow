    { "id": "tw", "type": "toWorkspace", "x": 440, "y": 180, "rotation": 0, "params": { "VariableName": "derivative_of_sine_out", "MaxDataPoints": "inf", "Decimation": 1, "SaveFormat": "Array", "SampleTime": "-1" } }
