  <language>en_US</language>
  <keyword>opentoline</keyword>
  <short_description>opens a file in the editor at a line.</short_description>
  <syntax>
    <syntax_item>opentoline(filename, linenumber)</syntax_item>
    <syntax_item>opentoline(filename, linenumber, columnnumber)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>filename</param_name>
      <param_description>a string: path of the file to open.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>linenumber</param_name>
      <param_description>a number: line to place the cursor on (1 or more).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>columnnumber</param_name>
      <param_description>a number: column of that line (1 or more); the end of a short line is the limit.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>opentoline</b> opens <b>filename</b> in the text editor and places the cursor at <b>linenumber</b>, at the start of the line or at <b>columnnumber</b>.</p>
    <p>The line numbers printed by the debugger at a stop, and the locations of error messages, are links that call the same behaviour in the Qt and web desktops.</p>
  </description>
  <used_function />
