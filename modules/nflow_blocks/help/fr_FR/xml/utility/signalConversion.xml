  <short_description>Passe-plat qui recopie son entrée vers sa sortie inchangée (point de conversion).</short_description>
  <syntax>
    <syntax_item>Type de bloc : signalConversion</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ports d'entrée</param_name>
