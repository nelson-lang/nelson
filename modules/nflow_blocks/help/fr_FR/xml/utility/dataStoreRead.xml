  <keyword>dataStoreRead</keyword>
  <keyword_alias>block:dataStoreRead</keyword_alias>
  <short_description>Sort la valeur de la memoire de donnees nommee.</short_description>
  <syntax>
    <syntax_item>Type de bloc : dataStoreRead</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ports d entree</param_name>
      <param_description>Aucun port d entree (ce bloc n en a aucun).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ports de sortie</param_name>
      <param_description>1 port(s) de sortie declare(s).</param_description>
    </param_output_item>
