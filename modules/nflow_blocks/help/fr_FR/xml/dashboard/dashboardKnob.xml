  <keyword>dashboardKnob</keyword>
  <keyword_alias>block:dashboardKnob</keyword_alias>
  <short_description>Definit un parametre lie en tournant un bouton rotatif.</short_description>
  <syntax>
    <syntax_item>Block type: dashboardKnob</syntax_item>
  </syntax>
  <description>
    <p>Definit un parametre lie en tournant un bouton rotatif.</p>
    <table border="1">
      <tbody>
        <tr>
          <td>Module</td>
          <td>
            <code>nflow_blocks</code>
          </td>
        </tr>
        <tr>
