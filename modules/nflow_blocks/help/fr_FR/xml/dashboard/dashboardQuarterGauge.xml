  <short_description>Affiche un signal lie sur un cadran en quart de cercle de 90 degres.</short_description>
  <syntax>
    <syntax_item>Block type: dashboardQuarterGauge</syntax_item>
  </syntax>
  <description>
    <p>Affiche un signal lie sur un cadran en quart de cercle de 90 degres.</p>
