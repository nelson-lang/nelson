  <keyword>signalGenerator</keyword>
  <keyword_alias>block:signalGenerator</keyword_alias>
  <short_description>Source periodique configurable : sinus, carre ou dent de scie (Amplitude, Frequency).</short_description>
  <syntax>
    <syntax_item>Type de bloc : signalGenerator</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ports d entree</param_name>
      <param_description>Aucun port d entree (ce bloc n en a aucun).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ports de sortie</param_name>
