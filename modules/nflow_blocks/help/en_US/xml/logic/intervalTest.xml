  <keyword>intervalTest</keyword>
  <keyword_alias>block:intervalTest</keyword_alias>
  <short_description>Outputs 1 when the input lies within [LowerLimit, UpperLimit], else 0.</short_description>
  <syntax>
    <syntax_item>Block type: intervalTest</syntax_item>
  </syntax>
