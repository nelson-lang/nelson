  <keyword>dashboardDisplay</keyword>
  <keyword_alias>block:dashboardDisplay</keyword_alias>
  <short_description>Shows the current value of a bound signal as formatted text.</short_description>
  <syntax>
    <syntax_item>Block type: dashboardDisplay</syntax_item>
  </syntax>
  <description>
