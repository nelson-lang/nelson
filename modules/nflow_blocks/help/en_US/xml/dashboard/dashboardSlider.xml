    <p>
      <img src="../../../../libraries/dashboard/exports/dashboardSlider.svg" align="middle"/>
    </p>
    <p>
      <b>Description</b>
    </p>
    <p>The Slider block lets you set the bound parameter by dragging a handle along a linear track between the configured limits.</p>
    <p>
      <b>Ports</b>
    </p>
    <p>
      <b>Input(s)</b>
    </p>
    <p>This block declares no input ports.</p>
    <p>
      <b>Output(s)</b>
    </p>
    <p>This block declares no output ports.</p>
    <p>
      <b>Parameters</b>
    </p>
    <table border="1">
      <thead>
        <tr>
          <th>Parameter</th>
          <th>Default value</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>
            <code>LabelPosition</code>
          </td>
          <td>Top</td>
        </tr>
        <tr>
          <td>
            <code>Binding</code>
          </td>
          <td/>
        </tr>
        <tr>
          <td>
            <code>ShowInitialText</code>
          </td>
          <td>on</td>
        </tr>
        <tr>
          <td>
            <code>ScaleType</code>
          </td>
          <td>Linear</td>
        </tr>
        <tr>
          <td>
            <code>Limits</code>
          </td>
          <td>[0, -1, 100]</td>
        </tr>
      </tbody>
