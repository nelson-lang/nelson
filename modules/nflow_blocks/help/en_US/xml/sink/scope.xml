          <th>Side</th>
          <th>Position</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Port_1</td>
          <td>Numeric signal read by the block.</td>
          <td>left</td>
          <td>x=0, y=40</td>
        </tr>
        <tr>
          <td>Port_2</td>
          <td>Numeric signal read by the block.</td>
          <td>left</td>
          <td>x=0, y=80</td>
        </tr>
        <tr>
          <td>Port_3</td>
          <td>Numeric signal read by the block.</td>
          <td>left</td>
