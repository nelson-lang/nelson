        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Port_1</td>
          <td>Numeric signal read by the block.</td>
          <td>left</td>
          <td>x=0, y=40</td>
        </tr>
      </tbody>
    </table>
    <p>
      <b>Output(s)</b>
    </p>
    <p>This block declares no output ports.</p>
