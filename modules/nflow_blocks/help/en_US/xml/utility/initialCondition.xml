  <keyword>initialCondition</keyword>
  <keyword_alias>block:initialCondition</keyword_alias>
  <short_description>Forces the output to InitialValue at the first step, then passes the input.</short_description>
  <syntax>
    <syntax_item>Block type: initialCondition</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>input ports</param_name>
      <param_description>1 input port(s) declared.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>output ports</param_name>
