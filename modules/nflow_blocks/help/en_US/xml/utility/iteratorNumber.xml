          <th>Role</th>
          <th>Side</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Port_1</td>
          <td>Current 1-based iteration index (0 outside an iterator body).</td>
          <td>right</td>
        </tr>
      </tbody>
    </table>
