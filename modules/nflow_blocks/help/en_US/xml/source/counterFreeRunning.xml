  <keyword>counterFreeRunning</keyword>
  <keyword_alias>block:counterFreeRunning</keyword_alias>
  <short_description>Free-running up-counter, wraps modulo 2^NumBits.</short_description>
  <syntax>
    <syntax_item>Block type: counterFreeRunning</syntax_item>
  </syntax>
