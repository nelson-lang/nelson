          <th>Side</th>
          <th>Position</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Port_1</td>
          <td>Numeric signal produced by the block.</td>
          <td>right</td>
          <td>x=40, y=20</td>
