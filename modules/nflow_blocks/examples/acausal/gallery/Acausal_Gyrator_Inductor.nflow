{"version":"1.0.0","format":"nflow-2","metadata":{"author":"Allan CORNET","created":"2026-09-28","tool":"Nelson nflow"},"license":"LGPL-3.0","comments":"A gyrator terminated by a capacitor behaves like an inductor.","name":"Gyrator as Inductor","blocks":[{"id":"V1","type":"ConstantVoltage","params":{"V":1},"x":80,"y":200,"rotation":0},{"id":"R1","type":"Resistor","params":{"R":1},"x":220,"y":200,"rotation":0},{"id":"CS","type":"CurrentSensor","params":{},"x":360,"y":200,"rotation":0},{"id":"GY","type":"Gyrator","params":{"G1":1,"G2":1},"x":500,"y":200,"rotation":0},{"id":"C1","type":"Capacitor","params":{"C":2,"v0":0},"x":640,"y":200,"rotation":0},{"id":"G","type":"Ground","params":{},"x":780,"y":200,"rotation":0},{"id":"tw1","type":"toWorkspace","inputs":1,"outputs":0,"x":920,"y":90,"rotation":0,"params":{"VariableName":"i","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"sc","type":"scope","x":920,"y":320,"rotation":0,"params":{"width":340,"height":220,"ShowTickLabels":true}}],"connections":[{"from":"CS","to":"tw1","fromIndex":0,"toIndex":0},{"from":"CS","to":"sc","fromIndex":0,"toIndex":0}],"physicalWires":[{"pins":["V1.p","R1.p"]},{"pins":["R1.n","CS.p"]},{"pins":["CS.n","GY.p1"]},{"pins":["G.p","V1.n","GY.n1","GY.n2","C1.n"]},{"pins":["GY.p2","C1.p"]}],"solver":"dae","runtime":8,"sampleTime":0.01}