{"version":"1.0.0","format":"nflow-2","metadata":{"author":"Allan CORNET","created":"2026-09-28","tool":"Nelson nflow"},"license":"LGPL-3.0","comments":"A DC motor: armature coupled to an inertia through an EMF.","name":"DC Motor (EMF)","blocks":[{"id":"V1","type":"ConstantVoltage","params":{"V":1},"x":80,"y":200,"rotation":0},{"id":"R1","type":"Resistor","params":{"R":1},"x":220,"y":200,"rotation":0},{"id":"L1","type":"Inductor","params":{"L":1,"i0":0},"x":360,"y":200,"rotation":0},{"id":"CS","type":"CurrentSensor","params":{},"x":500,"y":200,"rotation":0},{"id":"EM","type":"EMF","params":{"k":1},"x":640,"y":200,"rotation":0},{"id":"JA","type":"Inertia","params":{"J":1,"phi0":0,"w0":0},"x":780,"y":200,"rotation":0},{"id":"D1","type":"RotDamper","params":{"d":1},"x":920,"y":200,"rotation":0},{"id":"W","type":"RotFixed","params":{"phi0":0},"x":1060,"y":200,"rotation":0},{"id":"WS","type":"RotSpeedSensor","params":{},"x":1200,"y":200,"rotation":0},{"id":"G","type":"Ground","params":{},"x":1340,"y":200,"rotation":0},{"id":"tw1","type":"toWorkspace","inputs":1,"outputs":0,"x":1480,"y":370,"rotation":0,"params":{"VariableName":"imot","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"tw2","type":"toWorkspace","inputs":1,"outputs":0,"x":1480,"y":300,"rotation":0,"params":{"VariableName":"wmot","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"sc","type":"scope","x":1480,"y":20,"rotation":0,"params":{"width":340,"height":220,"ShowTickLabels":true}}],"connections":[{"from":"CS","to":"tw1","fromIndex":0,"toIndex":0},{"from":"CS","to":"sc","fromIndex":0,"toIndex":0},{"from":"WS","to":"tw2","fromIndex":0,"toIndex":0},{"from":"WS","to":"sc","fromIndex":0,"toIndex":1}],"physicalWires":[{"pins":["V1.p","R1.p"]},{"pins":["R1.n","L1.p"]},{"pins":["L1.n","CS.p"]},{"pins":["CS.n","EM.p"]},{"pins":["G.p","V1.n","EM.n"]},{"pins":["EM.flange","JA.flange","D1.a","WS.flange"]},{"pins":["D1.b","W.flange"]}],"solver":"dae","runtime":6,"sampleTime":0.01}