{"version":"1.0.0","format":"nflow-2","metadata":{"author":"Allan CORNET","created":"2026-09-28","tool":"Nelson nflow"},"license":"LGPL-3.0","comments":"A cooling body; the sensor reads the heat loss.","name":"Heat-Flow Sensor Cooling","blocks":[{"id":"C1","type":"HeatCapacitor","params":{"C":2,"T0":100},"x":80,"y":200,"rotation":0},{"id":"HF","type":"HeatFlowSensor","params":{},"x":220,"y":200,"rotation":0},{"id":"K1","type":"ThermalConductor","params":{"G":1},"x":360,"y":200,"rotation":0},{"id":"TA","type":"FixedTemperature","params":{"T":20},"x":500,"y":200,"rotation":0},{"id":"TB","type":"TemperatureSensor","params":{},"x":640,"y":200,"rotation":0},{"id":"tw1","type":"toWorkspace","inputs":1,"outputs":0,"x":780,"y":370,"rotation":0,"params":{"VariableName":"Q","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"tw2","type":"toWorkspace","inputs":1,"outputs":0,"x":780,"y":300,"rotation":0,"params":{"VariableName":"Tb","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"sc","type":"scope","x":780,"y":20,"rotation":0,"params":{"width":340,"height":220,"ShowTickLabels":true}}],"connections":[{"from":"HF","to":"tw1","fromIndex":0,"toIndex":0},{"from":"HF","to":"sc","fromIndex":0,"toIndex":0},{"from":"TB","to":"tw2","fromIndex":0,"toIndex":0},{"from":"TB","to":"sc","fromIndex":0,"toIndex":1}],"physicalWires":[{"pins":["C1.port","HF.a","TB.port"]},{"pins":["HF.b","K1.a"]},{"pins":["K1.b","TA.port"]}],"solver":"dae","runtime":6,"sampleTime":0.02}