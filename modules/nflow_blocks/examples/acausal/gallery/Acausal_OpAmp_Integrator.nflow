{"version":"1.0.0","format":"nflow-2","metadata":{"author":"Allan CORNET","created":"2026-09-28","tool":"Nelson nflow"},"license":"LGPL-3.0","comments":"Ideal op-amp integrator, output ramps as -(1/RC) int Vin.","name":"Op-Amp Integrator","blocks":[{"id":"V1","type":"ConstantVoltage","params":{"V":1},"x":80,"y":200,"rotation":0},{"id":"Rin","type":"Resistor","params":{"R":1},"x":220,"y":200,"rotation":0},{"id":"Cf","type":"Capacitor","params":{"C":0.5,"v0":0},"x":360,"y":200,"rotation":0},{"id":"OA","type":"IdealOpAmp","params":{},"x":500,"y":200,"rotation":0},{"id":"VS","type":"VoltageSensor","params":{},"x":640,"y":200,"rotation":0},{"id":"G","type":"Ground","params":{},"x":780,"y":200,"rotation":0},{"id":"tw1","type":"toWorkspace","inputs":1,"outputs":0,"x":920,"y":90,"rotation":0,"params":{"VariableName":"vo","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"sc","type":"scope","x":920,"y":320,"rotation":0,"params":{"width":340,"height":220,"ShowTickLabels":true}}],"connections":[{"from":"VS","to":"tw1","fromIndex":0,"toIndex":0},{"from":"VS","to":"sc","fromIndex":0,"toIndex":0}],"physicalWires":[{"pins":["V1.p","Rin.p"]},{"pins":["Rin.n","Cf.p","OA.in_n"]},{"pins":["Cf.n","OA.out","VS.p"]},{"pins":["G.p","V1.n","OA.in_p","VS.n"]}],"solver":"dae","runtime":2,"sampleTime":0.01}