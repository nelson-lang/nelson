{"version":"1.0.0","format":"nflow-2","metadata":{"author":"Allan CORNET","created":"2026-09-28","tool":"Nelson nflow"},"license":"LGPL-3.0","comments":"First-order RL circuit: the inductor current rises to V/R.","name":"RL Step","blocks":[{"id":"V1","type":"ConstantVoltage","params":{"V":2},"x":80,"y":200,"rotation":0},{"id":"R1","type":"Resistor","params":{"R":4},"x":220,"y":200,"rotation":0},{"id":"L1","type":"Inductor","params":{"L":2,"i0":0},"x":360,"y":200,"rotation":0},{"id":"CS","type":"CurrentSensor","params":{},"x":500,"y":200,"rotation":0},{"id":"G","type":"Ground","params":{},"x":640,"y":200,"rotation":0},{"id":"tw1","type":"toWorkspace","inputs":1,"outputs":0,"x":780,"y":90,"rotation":0,"params":{"VariableName":"iL","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"sc","type":"scope","x":780,"y":320,"rotation":0,"params":{"width":340,"height":220,"ShowTickLabels":true}}],"connections":[{"from":"CS","to":"tw1","fromIndex":0,"toIndex":0},{"from":"CS","to":"sc","fromIndex":0,"toIndex":0}],"physicalWires":[{"pins":["V1.p","R1.p"]},{"pins":["R1.n","L1.p"]},{"pins":["L1.n","CS.p"]},{"pins":["G.p","V1.n","CS.n"]}],"solver":"dae","runtime":3,"sampleTime":0.01}