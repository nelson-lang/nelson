{"version":"1.0.0","format":"nflow-2","metadata":{"author":"Allan CORNET","created":"2026-09-28","tool":"Nelson nflow"},"license":"LGPL-3.0","comments":"A body radiating heat to a fixed ambient (Stefan-Boltzmann).","name":"Body Radiation","blocks":[{"id":"C1","type":"HeatCapacitor","params":{"C":1,"T0":5},"x":80,"y":200,"rotation":0},{"id":"BR","type":"BodyRadiation","params":{"Gr":0.1},"x":220,"y":200,"rotation":0},{"id":"TA","type":"FixedTemperature","params":{"T":2},"x":360,"y":200,"rotation":0},{"id":"TM","type":"TemperatureSensor","params":{},"x":500,"y":200,"rotation":0},{"id":"tw1","type":"toWorkspace","inputs":1,"outputs":0,"x":640,"y":90,"rotation":0,"params":{"VariableName":"Temp","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"sc","type":"scope","x":640,"y":320,"rotation":0,"params":{"width":340,"height":220,"ShowTickLabels":true}}],"connections":[{"from":"TM","to":"tw1","fromIndex":0,"toIndex":0},{"from":"TM","to":"sc","fromIndex":0,"toIndex":0}],"physicalWires":[{"pins":["C1.port","BR.a","TM.port"]},{"pins":["BR.b","TA.port"]}],"solver":"dae","runtime":2,"sampleTime":0.02}