{"version":"1.0.0","format":"nflow-2","metadata":{"author":"Allan CORNET","created":"2026-09-28","tool":"Nelson nflow"},"license":"LGPL-3.0","comments":"A resistor dissipating its power as heat into a thermal body.","name":"Heating Resistor","blocks":[{"id":"Vh","type":"ConstantVoltage","params":{"V":2},"x":80,"y":200,"rotation":0},{"id":"HR","type":"HeatingResistor","params":{"R":4},"x":220,"y":200,"rotation":0},{"id":"Cth","type":"HeatCapacitor","params":{"C":2,"T0":20},"x":360,"y":200,"rotation":0},{"id":"K1","type":"ThermalConductor","params":{"G":0.5},"x":500,"y":200,"rotation":0},{"id":"TA","type":"FixedTemperature","params":{"T":20},"x":640,"y":200,"rotation":0},{"id":"TM","type":"TemperatureSensor","params":{},"x":780,"y":200,"rotation":0},{"id":"G","type":"Ground","params":{},"x":920,"y":200,"rotation":0},{"id":"tw1","type":"toWorkspace","inputs":1,"outputs":0,"x":1060,"y":90,"rotation":0,"params":{"VariableName":"Temp","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"sc","type":"scope","x":1060,"y":320,"rotation":0,"params":{"width":340,"height":220,"ShowTickLabels":true}}],"connections":[{"from":"TM","to":"tw1","fromIndex":0,"toIndex":0},{"from":"TM","to":"sc","fromIndex":0,"toIndex":0}],"physicalWires":[{"pins":["Vh.p","HR.p"]},{"pins":["G.p","Vh.n","HR.n"]},{"pins":["HR.heatPort","Cth.port","K1.a","TM.port"]},{"pins":["K1.b","TA.port"]}],"solver":"dae","runtime":20,"sampleTime":0.05}