{"version":"1.0.0","format":"nflow-2","metadata":{"author":"Allan CORNET","created":"2026-09-28","tool":"Nelson nflow"},"license":"LGPL-3.0","comments":"A two-stage heat chain from a fixed boundary.","name":"Thermal Chain","blocks":[{"id":"TA","type":"FixedTemperature","params":{"T":100},"x":80,"y":200,"rotation":0},{"id":"K1","type":"ThermalConductor","params":{"G":2},"x":220,"y":200,"rotation":0},{"id":"C1","type":"HeatCapacitor","params":{"C":1,"T0":0},"x":360,"y":200,"rotation":0},{"id":"K2","type":"ThermalConductor","params":{"G":1},"x":500,"y":200,"rotation":0},{"id":"C2","type":"HeatCapacitor","params":{"C":2,"T0":0},"x":640,"y":200,"rotation":0},{"id":"M1","type":"TemperatureSensor","params":{},"x":780,"y":200,"rotation":0},{"id":"M2","type":"TemperatureSensor","params":{},"x":920,"y":200,"rotation":0},{"id":"tw1","type":"toWorkspace","inputs":1,"outputs":0,"x":1060,"y":370,"rotation":0,"params":{"VariableName":"T1","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"tw2","type":"toWorkspace","inputs":1,"outputs":0,"x":1060,"y":300,"rotation":0,"params":{"VariableName":"T2","SaveFormat":"Array","Decimation":1,"MaxDataPoints":"inf"}},{"id":"sc","type":"scope","x":1060,"y":20,"rotation":0,"params":{"width":340,"height":220,"ShowTickLabels":true}}],"connections":[{"from":"M1","to":"tw1","fromIndex":0,"toIndex":0},{"from":"M1","to":"sc","fromIndex":0,"toIndex":0},{"from":"M2","to":"tw2","fromIndex":0,"toIndex":0},{"from":"M2","to":"sc","fromIndex":0,"toIndex":1}],"physicalWires":[{"pins":["TA.port","K1.a"]},{"pins":["K1.b","C1.port","K2.a","M1.port"]},{"pins":["K2.b","C2.port","M2.port"]}],"solver":"dae","runtime":6,"sampleTime":0.01}