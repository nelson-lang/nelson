{
  "version": "1.0.0",
  "format": "nflow-2",
  "metadata": {
    "author": "Allan CORNET",
    "created": "2026-08-08",
    "tool": "Nelson nflow"
  },
  "license": "LGPL-3.0",
  "comments": "Planar 2-D demo: a rigid body hangs from a fixed anchor by a 2-D spring-damper under gravity. It swings and bounces as a spring pendulum and settles at the static spring stretch. Constraints are Baumgarte-stabilised. (Planar island: simulation only.) The Scope plots the body's vertical position; ToWorkspace exports it.",
  "name": "Planar Spring Pendulum",
  "blocks": [
    {
      "id": "wld",
      "type": "PlanarWorld",
      "params": { "gravity": 9.81 },
      "x": 0,
      "y": 90,
      "rotation": 0
    },
    {
      "id": "anc",
      "type": "PlanarFixed",
      "params": { "x": 0, "y": 1 },
      "x": 0,
      "y": 210,
      "rotation": 180
    },
    {
      "id": "b",
      "type": "PlanarBody",
      "params": {
        "m": 1,
        "I": 0.02,
        "x0": 0.2,
        "y0": 0,
        "phi0": 0,
        "frames": { "top": [0, 0.3] }
      },
      "x": 400,
      "y": 210,
      "rotation": 180
    },
    {
      "id": "sd",
      "type": "PlanarSpringDamper",
      "params": { "c": 60, "d": 6 },
      "x": 200,
      "y": 210,
      "rotation": 0
    },
    {
      "id": "sp",
      "type": "PlanarPositionSensor",
      "params": { "axis": "y" },
      "x": 400,
      "y": 490,
      "rotation": 90
    },
    {
      "id": "tw",
      "type": "toWorkspace",
      "params": { "VariableName": "y" },
      "inputs": 1,
      "outputs": 0,
      "x": 550,
      "y": 130,
      "rotation": 0
    },
    {
      "id": "sc",
      "type": "scope",
      "params": {
        "TMin": "",
        "TMax": "",
        "YMin": "",
        "YMax": "",
        "width": 320,
        "height": 220,
        "ShowTickLabels": true
      },
      "x": 550,
      "y": 300,
      "rotation": 0
    }
  ],
  "connections": [
    { "from": "sp", "to": "tw", "fromIndex": 0, "toIndex": 0 },
    { "from": "sp", "to": "sc", "fromIndex": 0, "toIndex": 0 }
  ],
  "solver": "dae",
  "runtime": 3,
  "sampleTime": 0.01,
  "physicalWires": [
    { "pins": ["sd.a", "anc.frame"] },
    { "pins": ["b.top", "sd.b"] },
    { "pins": ["sp.a", "b.com"] }
  ]
}
