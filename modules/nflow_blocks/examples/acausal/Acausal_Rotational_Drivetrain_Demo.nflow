{
  "version": "1.0.0",
  "format": "nflow-2",
  "metadata": {
    "author": "Allan CORNET",
    "created": "2026-08-05",
    "tool": "Nelson nflow"
  },
  "license": "LGPL-3.0",
  "comments": "Acausal rotational drivetrain: two inertias coupled by an ideal gear, driven by a constant torque and loaded by a rotational damper to a fixed reference. The gear scales speed and torque by its ratio; the output shaft accelerates to the steady speed where drive torque balances damping. The Scope plots the output-shaft speed; ToWorkspace exports it.",
  "name": "Acausal Rotational Drivetrain",
  "blocks": [
    {
      "id": "J1",
      "type": "Inertia",
      "params": { "J": 1, "w0": 0 },
      "x": 90,
      "y": 90,
      "rotation": 270
    },
    {
      "id": "G",
      "type": "IdealGear",
      "params": { "ratio": 2 },
      "x": 200,
      "y": 210,
      "rotation": 0
    },
    {
      "id": "J2",
      "type": "Inertia",
      "params": { "J": 3, "w0": 0 },
      "x": 290,
      "y": 90,
      "rotation": 270
    },
    {
      "id": "T",
      "type": "ConstantTorque",
      "params": { "tau": 2 },
      "x": 0,
      "y": 210,
      "rotation": 180
    },
    {
      "id": "D",
      "type": "RotDamper",
      "params": { "d": 1 },
      "x": 350,
      "y": 280,
      "rotation": 90
    },
    {
      "id": "W",
      "type": "RotFixed",
      "params": { "phi0": 0 },
      "x": 350,
      "y": 400,
      "rotation": 90
    },
    {
      "id": "WS",
      "type": "RotSpeedSensor",
      "params": {},
      "x": 290,
      "y": 490,
      "rotation": 90
    },
    {
      "id": "tw",
      "type": "toWorkspace",
      "params": { "VariableName": "w" },
      "inputs": 1,
      "outputs": 0,
      "x": 510,
      "y": 130,
      "rotation": 0
    },
    {
      "id": "sc",
      "type": "scope",
      "params": {
        "TMin": "",
        "TMax": "",
        "YMin": "",
        "YMax": "",
        "width": 320,
        "height": 220,
        "ShowTickLabels": true
      },
      "x": 510,
      "y": 300,
      "rotation": 0
    }
  ],
  "connections": [
    { "from": "WS", "to": "tw", "fromIndex": 0, "toIndex": 0 },
    { "from": "WS", "to": "sc", "fromIndex": 0, "toIndex": 0 }
  ],
  "solver": "dae",
  "runtime": 20,
  "sampleTime": 0.05,
  "physicalWires": [
    { "pins": ["T.flange", "G.a", "J1.flange"] },
    { "pins": ["G.b", "J2.flange", "WS.flange", "D.a"] },
    { "pins": ["D.b", "W.flange"] }
  ]
}
