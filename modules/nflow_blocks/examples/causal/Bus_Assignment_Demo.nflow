  "comments": "Groups a position vector and a scalar count into a bus (busCreator), replaces the 'count' member with a new value (busAssignment), then reads both members back out (busSelector). 'pos' passes through unchanged; 'count' is overwritten.",
  "name": "Bus Assignment Demo",
  "blocks": [
    {
      "id": "pos",
      "type": "constant",
      "x": 60,
      "y": 60,
      "rotation": 0,
      "params": {
        "Value": [1, 2]
      }
    },
    {
      "id": "cnt",
      "type": "constant",
      "x": 60,
      "y": 180,
      "rotation": 0,
      "params": {
        "Value": 7
      }
    },
    {
      "id": "bc",
      "type": "busCreator",
      "x": 220,
      "y": 135,
      "rotation": 0,
      "params": {
        "MemberNames": ["pos", "count"]
      },
      "inputs": 2
    },
    {
      "id": "newcnt",
      "type": "constant",
      "x": 60,
      "y": 300,
      "rotation": 0,
      "params": {
        "Value": 99
      }
    },
    {
      "id": "ba",
      "type": "busAssignment",
      "x": 380,
      "y": 210,
      "rotation": 0,
      "params": {
        "AssignedSignals": ["count"]
      },
      "inputs": 2
    },
    {
      "id": "sel",
      "type": "busSelector",
      "x": 560,
      "y": 205,
      "rotation": 0,
      "params": {
        "SelectedSignals": ["pos", "count"]
      },
      "outputs": 2
    },
    {
      "id": "scope_pos",
      "type": "scope",
      "x": 730,
      "y": 60,
      "rotation": 0,
      "params": {
        "Title": "pos (unchanged)"
      }
    },
    {
      "id": "scope_cnt",
      "type": "scope",
      "x": 730,
      "y": 260,
      "rotation": 0,
      "params": {
        "Title": "count (replaced)"
      }
    }
  ],
