{
  "version": "1.0.0",
  "format": "nflow-2",
  "metadata": {
    "author": "",
    "created": "2026-04-06",
    "tool": "Nelson nflow"
  },
  "license": "MIT",
  "comments": "Complementary filter estimating a 0.2 Hz sine angle from two imperfect sensors: an accelerometer-like reading (angle + noise) goes through a 0.5 Hz low-pass filter, while a gyroscope-like rate (derivative + 0.2 bias) is integrated, then high-passed at 0.5 Hz to remove the drift. Their sum tracks the true angle: the scope overlays the true angle, the noisy accelerometer reading and the fused estimate.",
  "name": "Complementary Filter",
  "blocks": [
    {
      "id": "b1",
      "type": "lpf",
      "x": 440,
      "y": 200,
      "rotation": 0,
      "params": {
        "Cutoff": 0.5
      }
    },
    {
      "id": "b2",
      "type": "hpf",
      "x": 800,
      "y": 360,
      "rotation": 0,
      "params": {
        "Cutoff": 0.5
      }
    },
    {
      "id": "b3",
      "type": "sum",
      "x": 940,
      "y": 240,
      "rotation": 0,
      "params": {
        "Inputs": "+++"
      }
    },
    {
      "id": "b4",
      "type": "derivative",
      "x": 240,
      "y": 360,
      "rotation": 0,
      "params": {}
    },
    {
      "id": "b5",
      "type": "sine",
      "x": 60,
      "y": 60,
      "rotation": 0,
      "params": {
        "Amplitude": 1,
        "Frequency": 0.2,
        "Phase": 0
      }
    },
    {
      "id": "b6",
      "type": "constant",
      "x": 60,
      "y": 440,
      "rotation": 0,
      "params": {
        "Value": 0.2,
        "OutDataType": "double"
      }
    },
    {
      "id": "b7",
      "type": "noise",
      "x": 60,
      "y": 200,
      "rotation": 0,
      "params": {
        "Amplitude": 1
      }
    },
    {
      "id": "b8",
      "type": "sum",
      "x": 240,
      "y": 200,
      "rotation": 0,
      "params": {
        "Inputs": "+++"
      }
    },
    {
      "id": "b9",
      "type": "sum",
      "x": 440,
      "y": 360,
      "rotation": 0,
      "params": {
        "Inputs": "+++"
      }
    },
    {
      "id": "b10",
      "type": "integrator",
      "x": 620,
      "y": 360,
      "rotation": 0,
      "params": {
        "InitialCondition": 0,
        "LowerSaturationLimit": "-inf",
        "UpperSaturationLimit": "inf"
      }
    },
    {
      "id": "b11",
      "type": "scope",
      "x": 1060,
      "y": 60,
      "rotation": 0,
      "params": {
        "TMin": "",
        "TMax": "",
        "YMin": "",
        "YMax": "",
        "width": 220,
        "height": 160,
        "ShowTickLabels": false
      }
    }
  ],
