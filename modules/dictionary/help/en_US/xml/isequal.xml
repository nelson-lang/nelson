  <language>en_US</language>
  <keyword>isequal</keyword>
  <short_description>Determine whether dictionaries are equal.</short_description>
  <syntax>
    <syntax_item>tf = isequal(d1, d2)</syntax_item>
    <syntax_item>tf = isequal(d1, d2, ..., dN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>d1, d2, ..., dN</param_name>
      <param_description>dictionary objects to compare.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>logical scalar: true when all dictionaries contain the same key-value associations.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>tf = isequal(d1, d2)</b> returns true when both dictionaries have the same configuration and the same key-value associations.</p>
    <p>
      Dictionary equality is independent of insertion order. If a key appears more than once during construction, only the last value kept by the dictionary is compared.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[d1 = dictionary([1 2], ["one", "two"]);
d2 = dictionary([2 1], ["two", "one"]);
tf = isequal(d1, d2)]]></example_item_data>
    </example_item>
  </examples>
