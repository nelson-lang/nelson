  <keyword>cdf2rdf</keyword>
  <short_description>Convert complex diagonal form to real block diagonal form.</short_description>
  <syntax>
    <syntax_item>[Vr, Dr] = cdf2rdf(V, D)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>V</param_name>
      <param_description>eigenvector matrix, as returned by <b>eig</b>.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>D</param_name>
      <param_description>diagonal eigenvalue matrix of a real matrix, as returned by <b>eig</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Vr</param_name>
      <param_description>real matrix of vectors.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>Dr</param_name>
      <param_description>real block diagonal matrix.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>[Vr, Dr] = cdf2rdf(V, D)</b> replaces each complex conjugate pair <b>a + bi</b>, <b>a - bi</b> on the diagonal of <b>D</b> by the real block <b>[a b; -b a]</b>. The two matching columns of <b>V</b> become <b>sqrt(2)</b> times the real and imaginary parts of the first one.</p>
    <p>Real eigenvalues and their vectors are kept, and <b>A * Vr = Vr * Dr</b> still holds.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[A = [1 2 0; -2 1 0; 0 0 3];
[V, D] = eig(A);
[Vr, Dr] = cdf2rdf(V, D)
norm(A * Vr - Vr * Dr)]]></example_item_data>
    </example_item>
  </examples>
