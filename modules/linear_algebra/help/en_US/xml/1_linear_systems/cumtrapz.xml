  <language>en_US</language>
  <keyword>cumtrapz</keyword>
  <short_description>Cumulative trapezoidal numerical integration.</short_description>
  <syntax>
    <syntax_item>Z = cumtrapz(Y)</syntax_item>
    <syntax_item>Z = cumtrapz(X, Y)</syntax_item>
    <syntax_item>Z = cumtrapz(Y, dim)</syntax_item>
    <syntax_item>Z = cumtrapz(X, Y, dim)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>vector or matrix (real or single)</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>point spacing: vector</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>dimension: positive integer scalar</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Z</param_name>
      <param_description>cumulative integral: same size as Y.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>cumtrapz(Y)</b> computes the cumulative integral of <b>Y</b> using the trapezoidal method with unit spacing, along the first non-singleton dimension.</p>
    <p><b>cumtrapz(X, Y)</b> integrates <b>Y</b> with respect to the coordinates given by <b>X</b>.</p>
    <p>The result has the same size as <b>Y</b>, and its first value along the working dimension is <b>0</b>.</p>
  </description>
  <used_function />
