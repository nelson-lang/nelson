  <language>en_US</language>
  <keyword>chol</keyword>
  <short_description>Cholesky factorization.</short_description>
  <syntax>
    <syntax_item>F = chol(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description
      >a matrix: square symmetric positive definite or Hermitian positive definite, dense or sparse.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>F</param_name>
      <param_description>Cholesky factor.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>F = chol(A)</b> factorizes symmetric positive definite matrix<b>A</b> into an upper triangular F that satisfies <b>A = F&apos; * F</b>.</p>
    <p>Sparse double, single, complex double, and complex single matrices are supported. Sparse factors keep sparse storage and keep the input numeric class where applicable.</p>
    <p>When the two-output form is used, the second output reports the failure index for non-positive-definite sparse matrices.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[A = [10 0 10; 0 20 0; 10 0 30];
F = chol(A)
]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Sparse complex single Cholesky factorization.</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[A = sparse(single([4 1i; -1i 3]));
R = chol(A)]]></example_item_data>
    </example_item>
  </examples>
