  <language>en_US</language>
  <keyword>pagepinv</keyword>
  <short_description>Page-wise pseudoinverse.</short_description>
  <syntax>
    <syntax_item>Y = pagepinv(X)</syntax_item>
    <syntax_item>Y = pagepinv(X, tol)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>a single or double N-D array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tol</param_name>
      <param_description>singular value tolerance used for every page.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>the array of pseudoinverses: <b>Y(:,:,i) = pinv(X(:,:,i))</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>Y = pagepinv(X)</b> returns the Moore-Penrose pseudoinverse of every page of <b>X</b>. An m-by-n page gives an n-by-m page.</p>
    <p><b>Y = pagepinv(X, tol)</b> treats singular values below <b>tol</b> as zero. By default each page uses the tolerance of <b>pinv</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[Y = pagepinv(cat(3, [1 2; 2 4], [1 0; 0 2]))]]></example_item_data>
    </example_item>
  </examples>
