  <language>en_US</language>
  <keyword>pageinv</keyword>
  <short_description>Page-wise matrix inverse.</short_description>
  <syntax>
    <syntax_item>Y = pageinv(X)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>N-D array whose pages are square matrices.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>array where each page is the inverse of the corresponding page of X.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>pageinv</b> computes the inverse of each page (the first two dimensions) of the N-D array X: Y(:,:,i) = inv(X(:,:,i)). Each page must be a square matrix.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[M = cat(3, [2 0; 0 4], [1 2; 3 4]);
Y = pageinv(M)]]></example_item_data>
    </example_item>
  </examples>
