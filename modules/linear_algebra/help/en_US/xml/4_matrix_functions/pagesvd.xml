  <language>en_US</language>
  <keyword>pagesvd</keyword>
  <short_description>Page-wise singular value decomposition.</short_description>
  <syntax>
    <syntax_item>S = pagesvd(X)</syntax_item>
    <syntax_item>[U, S, V] = pagesvd(X)</syntax_item>
    <syntax_item>[U, S, V] = pagesvd(X, 'econ')</syntax_item>
    <syntax_item>[...] = pagesvd(..., outputForm)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>a single or double N-D array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'econ'</param_name>
      <param_description>economy-size decomposition (<b>0</b> is also accepted).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>outputForm</param_name>
      <param_description><b>'vector'</b> or <b>'matrix'</b>: shape of the singular values.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>S</param_name>
      <param_description>singular values of each page, as a column (vector form) or a diagonal matrix.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>U</param_name>
      <param_description>left singular vectors of each page.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>V</param_name>
      <param_description>right singular vectors of each page.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>S = pagesvd(X)</b> returns the singular values of every page <b>X(:,:,i)</b> in decreasing order, as a column per page.</p>
    <p><b>[U, S, V] = pagesvd(X)</b> returns the full decomposition <b>X(:,:,i) = U(:,:,i) * S(:,:,i) * V(:,:,i)'</b>, with <b>S</b> in matrix form by default.</p>
    <p>With <b>'econ'</b>, only the first <b>min(m, n)</b> singular vectors are kept. <b>outputForm</b> chooses the vector or the matrix form of <b>S</b> whatever the number of outputs.</p>
  </description>
  <used_function />
