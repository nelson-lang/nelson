  <language>en_US</language>
  <keyword>pagetranspose</keyword>
  <short_description>Page-wise transpose.</short_description>
  <syntax>
    <syntax_item>Y = pagetranspose(X)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>N-D array.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>array where the first two dimensions of each page are transposed.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>pagetranspose</b> transposes the first two dimensions of each page of the N-D array X: Y(:,:,i) = X(:,:,i).'. Complex values are not conjugated.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[X = reshape(1:24, 2, 3, 4);
Y = pagetranspose(X)]]></example_item_data>
    </example_item>
  </examples>
