  <language>en_US</language>
  <keyword>pagemtimes</keyword>
  <short_description>Page-wise matrix multiplication.</short_description>
  <syntax>
    <syntax_item>C = pagemtimes(A, B)</syntax_item>
    <syntax_item>C = pagemtimes(A, transpA, B, transpB)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>array whose pages are matrices.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>B</param_name>
      <param_description>array whose pages are matrices.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>transpA</param_name>
      <param_description>transform applied to the pages of A: 'none', 'transpose' or 'ctranspose'.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>transpB</param_name>
      <param_description>transform applied to the pages of B: 'none', 'transpose' or 'ctranspose'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>C</param_name>
      <param_description>array whose pages are the matrix products of the pages of A and B.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>pagemtimes</b> multiplies the pages (the first two dimensions) of the N-D arrays A and B. C(:,:,i) = A(:,:,i) * B(:,:,i). The optional transform arguments transpose or conjugate-transpose each page before multiplying. If one input has a single page it is broadcast against the pages of the other.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = reshape(1:24, 2, 3, 4);
B = reshape(1:24, 3, 2, 4);
C = pagemtimes(A, B)]]></example_item_data>
    </example_item>
  </examples>
