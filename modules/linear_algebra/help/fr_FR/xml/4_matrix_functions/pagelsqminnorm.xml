  <language>fr_FR</language>
  <keyword>pagelsqminnorm</keyword>
  <short_description>Solution des moindres carrés de norme minimale page par page.</short_description>
  <syntax>
    <syntax_item>X = pagelsqminnorm(A, B)</syntax_item>
    <syntax_item>X = pagelsqminnorm(A, B, tol)</syntax_item>
    <syntax_item>X = pagelsqminnorm(..., rankWarn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>un tableau N-D single ou double.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>B</param_name>
      <param_description>un tableau N-D single ou double avec autant de lignes que <b>A</b>.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tol</param_name>
      <param_description>tolérance de rang, voir <b>lsqminnorm</b>.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>rankWarn</param_name>
      <param_description><b>'nowarn'</b> (par défaut) ou <b>'warn'</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>X</param_name>
      <param_description>le tableau des solutions : <b>X(:,:,i) = lsqminnorm(A(:,:,i), B(:,:,i))</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>X = pagelsqminnorm(A, B)</b> applique <b>lsqminnorm</b> à chaque page. Les dimensions au-delà de la deuxième doivent être égales ou valoir 1 : une dimension de taille 1 est répétée pour correspondre à l'autre entrée.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[X = pagelsqminnorm(cat(3, [1 2; 2 4], [1 0; 0 2]), cat(3, [1; 2], [1; 1]))]]></example_item_data>
    </example_item>
  </examples>
