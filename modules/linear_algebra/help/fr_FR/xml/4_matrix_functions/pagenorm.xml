  <language>fr_FR</language>
  <keyword>pagenorm</keyword>
  <short_description>Norme matricielle ou vectorielle page par page.</short_description>
  <syntax>
    <syntax_item>Y = pagenorm(X)</syntax_item>
    <syntax_item>Y = pagenorm(X, p)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>Tableau N-D. Chaque page est X(:,:,i,...).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>ordre de la norme : 2 (par defaut, plus grande valeur singuliere), 1, Inf ou 'fro'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>tableau des normes de chaque page, de taille [1 1 size(X,3) ...].</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>pagenorm(X)</b> calcule la norme 2 de chaque page X(:,:,i,...) du tableau N-D X et les retourne dans un tableau dont les deux premieres dimensions sont singleton.</p>
    <p><b>pagenorm(X, p)</b> utilise la norme d'ordre p : 1, 2, Inf ou 'fro'. Lorsqu'une page est un vecteur, la norme vectorielle correspondante est utilisee.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[X = cat(3, [1 2; 3 4], [5 6; 7 8]);
Y = pagenorm(X)]]></example_item_data>
    </example_item>
  </examples>
