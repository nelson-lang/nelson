  <language>fr_FR</language>
  <keyword>pageinv</keyword>
  <short_description>Inverse matriciel par page</short_description>
  <syntax>
    <syntax_item>Y = pageinv(X)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>tableau N-D dont les pages sont des matrices carrées.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>tableau où chaque page est l'inverse de la page correspondante de X.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>pageinv</b> calcule l'inverse de chaque page (les deux premières dimensions) du tableau N-D X : Y(:,:,i) = inv(X(:,:,i)). Chaque page doit être une matrice carrée.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[M = cat(3, [2 0; 0 4], [1 2; 3 4]);
Y = pageinv(M)]]></example_item_data>
    </example_item>
  </examples>
