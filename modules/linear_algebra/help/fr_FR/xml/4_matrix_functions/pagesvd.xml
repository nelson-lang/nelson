  <language>fr_FR</language>
  <keyword>pagesvd</keyword>
  <short_description>Décomposition en valeurs singulières page par page.</short_description>
  <syntax>
    <syntax_item>S = pagesvd(X)</syntax_item>
    <syntax_item>[U, S, V] = pagesvd(X)</syntax_item>
    <syntax_item>[U, S, V] = pagesvd(X, 'econ')</syntax_item>
    <syntax_item>[...] = pagesvd(..., outputForm)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>un tableau N-D single ou double.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'econ'</param_name>
      <param_description>décomposition économique (<b>0</b> est aussi accepté).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>outputForm</param_name>
      <param_description><b>'vector'</b> ou <b>'matrix'</b> : forme des valeurs singulières.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>S</param_name>
      <param_description>valeurs singulières de chaque page, en colonne (forme vecteur) ou en matrice diagonale.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>U</param_name>
      <param_description>vecteurs singuliers à gauche de chaque page.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>V</param_name>
      <param_description>vecteurs singuliers à droite de chaque page.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>S = pagesvd(X)</b> renvoie les valeurs singulières de chaque page <b>X(:,:,i)</b> par ordre décroissant, une colonne par page.</p>
    <p><b>[U, S, V] = pagesvd(X)</b> renvoie la décomposition complète <b>X(:,:,i) = U(:,:,i) * S(:,:,i) * V(:,:,i)'</b>, avec <b>S</b> sous forme de matrice par défaut.</p>
    <p>Avec <b>'econ'</b>, seuls les <b>min(m, n)</b> premiers vecteurs singuliers sont gardés. <b>outputForm</b> choisit la forme vecteur ou matrice de <b>S</b> quel que soit le nombre de sorties.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[X = cat(3, [4 1; 2 3], [2 0; 1 5]);
S = pagesvd(X)
[U, S, V] = pagesvd(X, 'econ');]]></example_item_data>
    </example_item>
  </examples>
