  <language>fr_FR</language>
  <keyword>pagectranspose</keyword>
  <short_description>Transposée conjuguée par page</short_description>
  <syntax>
    <syntax_item>Y = pagectranspose(X)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>tableau N-D.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>tableau où chaque page est remplacée par sa transposée conjuguée.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>pagectranspose</b> applique la transposée conjuguée aux deux premières dimensions de chaque page du tableau N-D X : Y(:,:,i) = X(:,:,i)'.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[X = reshape((1:8) + 1i, 2, 2, 2);
Y = pagectranspose(X)]]></example_item_data>
    </example_item>
  </examples>
