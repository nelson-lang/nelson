  <keyword>linsolve</keyword>
  <short_description>Résout un système d&apos;équations linéaires.</short_description>
  <syntax>
    <syntax_item>X = linsolve(A, B)</syntax_item>
    <syntax_item>X = linsolve(A, B, opts)</syntax_item>
    <syntax_item>[X, r] = linsolve(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>une matrice de coefficients.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>B</param_name>
      <param_description>le second membre.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>opts</param_name>
      <param_description>une structure d&apos;options ; le champ <b>TRANSA</b> résout <b>A&apos;*X = B</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>X</param_name>
      <param_description>la solution de <b>A*X = B</b>.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>r</param_name>
      <param_description>l&apos;estimation du conditionnement inverse de <b>A</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>X = linsolve(A, B)</b> résout le système linéaire <b>A*X = B</b>.</p>
    <p><b>X = linsolve(A, B, opts)</b> utilise les options de <b>opts</b> ; définissez <b>opts.TRANSA = true</b> pour résoudre <b>A&apos;*X = B</b>.</p>
  </description>
  <used_function />
