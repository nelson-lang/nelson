  <language>fr_FR</language>
  <keyword>cumtrapz</keyword>
  <short_description>Integration numerique cumulative par la methode des trapezes.</short_description>
  <syntax>
    <syntax_item>Z = cumtrapz(Y)</syntax_item>
    <syntax_item>Z = cumtrapz(X, Y)</syntax_item>
    <syntax_item>Z = cumtrapz(Y, dim)</syntax_item>
    <syntax_item>Z = cumtrapz(X, Y, dim)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>vecteur ou matrice (reel ou single)</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>espacement des points : vecteur</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>dimension : entier positif scalaire</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Z</param_name>
      <param_description>integrale cumulative : meme taille que Y.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>cumtrapz(Y)</b> calcule l'integrale cumulative de <b>Y</b> par la methode des trapezes avec un espacement unitaire, selon la premiere dimension non singuliere.</p>
    <p><b>cumtrapz(X, Y)</b> integre <b>Y</b> par rapport aux coordonnees donnees par <b>X</b>.</p>
    <p>Le resultat a la meme taille que <b>Y</b>, et sa premiere valeur selon la dimension de travail vaut <b>0</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[x = 0:0.1:pi;
Z = cumtrapz(x, sin(x))]]></example_item_data>
    </example_item>
  </examples>
