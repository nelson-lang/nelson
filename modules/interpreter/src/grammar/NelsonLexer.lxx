//=============================================================================
// This file is part of Nelson.
//=============================================================================
// LICENCE_BLOCK_BEGIN
// SPDX-License-Identifier: LGPL-3.0-or-later
// LICENCE_BLOCK_END
//=============================================================================
// This grammar only owns the flex scanner machinery. Its single rule delegates
// every character to the hand-written lexer, whose implementation lives in
// NelsonLexerHelpers.cpp (compiled directly, never duplicated into this
// generated file). See NelsonLexerHelpers.hpp for the shared entry points.
//=============================================================================
#ifdef _MSC_VER
#pragma warning(disable : 4996)
#endif
//=============================================================================
#define YYSTYPE Nelson::ParseRHS
//=============================================================================
#include "LexerContext.hpp"
#include "NelsonParserTokens.hpp"
#include "NelsonLexerHelpers.hpp"
//=============================================================================
%}
%%
(.|\n) { return nelsonManualLex(lexerContext); }
%%
//=============================================================================
int yylex(Nelson::LexerContext& lexerContext)
{
    Nelson::LexerContext* previousFlexLexerContext = activeFlexLexerContext;
    activeFlexLexerContext = &lexerContext;
    yyscan_t scanner;
    yylex_init(&scanner);
    int token = 0;
    try {
        token = flexGeneratedLex(lexerContext, scanner);
    } catch (...) {
        yylex_destroy(scanner);
        activeFlexLexerContext = previousFlexLexerContext;
        throw;
    }
    yylex_destroy(scanner);
    activeFlexLexerContext = previousFlexLexerContext;
    return token;
}
//=============================================================================
