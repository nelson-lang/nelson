%top{
#ifdef _MSC_VER
#include <stdint.h>
#endif
}
%option reentrant noyywrap noinput nounput never-interactive batch nodefault nounistd
%{
namespace Nelson { struct LexerContext; }
static thread_local Nelson::LexerContext* activeFlexLexerContext = nullptr;
#define YY_DECL static int flexGeneratedLex(Nelson::LexerContext& lexerContext, yyscan_t yyscanner)
#define YY_INPUT(buf,result,max_size) \
    do { \
        if (activeFlexLexerContext != nullptr && activeFlexLexerContext->datap != nullptr && *activeFlexLexerContext->datap != '\0') { \
            (buf)[0] = *activeFlexLexerContext->datap; \
            result = 1; \
        } else { \
            result = YY_NULL; \
        } \
    } while (0)
//=============================================================================
