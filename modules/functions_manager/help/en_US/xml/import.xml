  <language>en_US</language>
  <keyword>import</keyword>
  <short_description>Import names from namespaces.</short_description>
  <syntax>
    <syntax_item>import namespace.name</syntax_item>
    <syntax_item>import namespace.className.staticMethodName</syntax_item>
    <syntax_item>import namespace.*</syntax_item>
    <syntax_item>import(namespace_name)</syntax_item>
    <syntax_item>L = import()</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>namespace.name</param_name>
      <param_description>a dotted import name.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>namespace.*</param_name>
      <param_description>a namespace wildcard import.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>namespace_name</param_name>
      <param_description>a string scalar or character vector containing an import name.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>L</param_name>
      <param_description>a cell array of character vectors: current imports in insertion order.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>import</b> adds package functions, package class constructors, package static methods, or namespace wildcard imports to the current scope.</p>
    <p>Duplicate import names are ignored. Imports declared in a function or script apply to the whole function or script body. In the base scope, imports remain active until <b>clear import</b>.</p>
  </description>
  <used_function />
