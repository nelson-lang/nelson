  <language>en_US</language>
  <keyword>what</keyword>
  <short_description>Get Nelson builtin and macro list.</short_description>
  <syntax>
    <syntax_item>list_builtin = what()</syntax_item>
    <syntax_item>[list_builtin, list_macro] = what()</syntax_item>
    <syntax_item>list_builtin = what(module_name)</syntax_item>
    <syntax_item>[list_builtin, list_macro] = what(module_name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>module_name</param_name>
      <param_description>a string: an existing module name. Restricts the result to the builtin and macro functions of that module.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>list_builtin</param_name>
      <param_description>a cell of strings</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>list_macro</param_name>
      <param_description>a cell of strings</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>what</b> returns the list of all builtin and macro available in current Nelson&apos;s session.</p>
    <p>With a <b>module_name</b> argument, <b>what</b> returns only the builtin and macro functions that belong to that module. An unknown module name raises an error.</p>
  </description>
  <used_function />
