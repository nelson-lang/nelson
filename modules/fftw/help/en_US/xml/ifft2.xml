  <keyword>ifft2</keyword>
  <short_description>2-D inverse fast Fourier transform.</short_description>
  <syntax><syntax_item>Y = ifft2(X)</syntax_item><syntax_item>Y = ifft2(X, m, n)</syntax_item></syntax>
  <param_input><param_input_item><param_name>X</param_name><param_description>Input array.</param_description></param_input_item><param_input_item><param_name>m</param_name><param_description>Number of transform rows.</param_description></param_input_item><param_input_item><param_name>n</param_name><param_description>Number of transform columns.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>Y</param_name><param_description>Inverse transform result.</param_description></param_output_item></param_output>
  <description><p><b>ifft2</b> returns the two-dimensional inverse Fourier transform of <b>X</b>.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[X = magic(3); Y = ifft2(fft2(X))]]></example_item_data></example_item></examples>
