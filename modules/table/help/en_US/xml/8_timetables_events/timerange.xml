  <language>en_US</language>
  <keyword>timerange</keyword>
  <short_description>Time range for timetable row subscripting.</short_description>
  <syntax>
    <syntax_item>S = timerange(startTime, endTime)</syntax_item>
    <syntax_item>S = timerange(startTime, endTime, intervalType)</syntax_item>
    <syntax_item>S = timerange(timePeriod, datetimeUnit)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>startTime, endTime</param_name><param_description>Datetime, duration, or text scalar limits.</param_description></param_input_item>
    <param_input_item><param_name>intervalType</param_name><param_description>&apos;openright&apos;, &apos;closedleft&apos;, &apos;openleft&apos;, &apos;closedright&apos;, &apos;open&apos;, or &apos;closed&apos;.</param_description></param_input_item>
    <param_input_item><param_name>datetimeUnit</param_name><param_description>Calendar unit used to span a full period.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>S</param_name><param_description>Timetable row subscript.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>timerange</b> creates a row subscript for timetables. The default interval is half-open: it includes the start time and excludes the end time.</p>
    <p>Text limits <b>'-inf'</b> and <b>'inf'</b> create one-sided ranges.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data><![CDATA[TT = timetable(seconds((1:5)'), (10:10:50)', 'VariableNames', {'A'});
TT(timerange(seconds(2), seconds(4), 'closed'), :)]]></example_item_data></example_item>
  </examples>
