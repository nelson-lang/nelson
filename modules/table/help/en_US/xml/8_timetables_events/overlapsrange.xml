  <language>en_US</language>
  <keyword>overlapsrange</keyword>
  <short_description>Determine if timetable row times overlap a time range.</short_description>
  <syntax><syntax_item>[tf, tfRow] = overlapsrange(TT, timeSpec)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>TT</param_name><param_description>Input timetable.</param_description></param_input_item>
    <param_input_item><param_name>timeSpec</param_name><param_description>Time range specification.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>tf</param_name><param_description>Logical scalar.</param_description></param_output_item>
    <param_output_item><param_name>tfRow</param_name><param_description>Logical row selector.</param_description></param_output_item>
  </param_output>
  <description><p><b>overlapsrange</b> tests whether timetable row times overlap the specified time range.</p></description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[TT = timetable(seconds([1; 2; 3]), [10; 20; 30], 'VariableNames', {'A'});
overlapsrange(TT, seconds([2; 4]))
]]></example_item_data>
    </example_item>
  </examples>
