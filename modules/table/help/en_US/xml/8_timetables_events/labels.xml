  <language>en_US</language>
  <keyword>labels</keyword>
  <short_description>Timetable row subscript by row time values.</short_description>
  <syntax>
    <syntax_item>S = labels(lbls)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>lbls</param_name>
      <param_description>datetime, duration, double or single array: row time values to select.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>S</param_name>
      <param_description>timetable row subscript.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>labels</b> tells row time values from row positions when a timetable has numeric row times: <b>TT(labels(3), :)</b> selects the rows whose row time is 3, while <b>TT(3, :)</b> is the third row. Every row at a label value is selected, label by label. In an assignment, a label that is not a row time adds a row. Datetime and duration labels select like datetime and duration subscripts.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Rows by value or by position.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[TT = timetable([37.3; 39.1; 42.3], 'RowTimes', [1; 3; 236], 'VariableNames', {'Temp'})
TT(labels(3), :)
TT(3, :)
]]></example_item_data>
    </example_item>
  </examples>
