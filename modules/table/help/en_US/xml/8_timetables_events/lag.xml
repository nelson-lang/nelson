  <language>en_US</language>
  <keyword>lag</keyword>
  <short_description>Shift timetable data by rows.</short_description>
  <syntax>
    <syntax_item>TT2 = lag(TT, n)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>TT</param_name><param_description>Input timetable.</param_description></param_input_item>
    <param_input_item><param_name>n</param_name><param_description>Integer row shift.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>TT2</param_name><param_description>Shifted timetable.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>lag</b> shifts timetable variables by <b>n</b> rows while keeping row times unchanged.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[TT = timetable(seconds([1; 2; 3]), [10; 20; 30], 'VariableNames', {'A'});
lag(TT)
]]></example_item_data>
    </example_item>
  </examples>
