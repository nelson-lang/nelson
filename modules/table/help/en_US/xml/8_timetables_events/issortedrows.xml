  <keyword>issortedrows</keyword>
  <short_description>Determine if timetable rows are sorted.</short_description>
  <syntax><syntax_item>tf = issortedrows(A)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>Input timetable.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>tf</param_name><param_description>Logical scalar.</param_description></param_output_item>
  </param_output>
  <description><p><b>issortedrows</b> returns true when timetable rows are sorted by row times.</p></description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[TT = timetable(seconds([1; 2; 3]), [10; 20; 30], 'VariableNames', {'A'});
issortedrows(TT)
]]></example_item_data>
    </example_item>
  </examples>
