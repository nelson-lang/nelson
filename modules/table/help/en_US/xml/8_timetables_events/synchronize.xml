  <language>en_US</language>
  <keyword>synchronize</keyword>
  <short_description>Synchronize timetables to common row times.</short_description>
  <syntax>
    <syntax_item>TT = synchronize(TT1, TT2)</syntax_item>
    <syntax_item>TT = synchronize(TT1, TT2, newTimeBasis, method)</syntax_item>
    <syntax_item>TT = synchronize(TT1, TT2, newTimes, method)</syntax_item>
    <syntax_item>TT = synchronize(TT1, TT2, 'regular', method, 'TimeStep', dt)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>TT1, TT2</param_name><param_description>Input timetables.</param_description></param_input_item>
    <param_input_item><param_name>newTimeBasis</param_name><param_description>&apos;union&apos;, &apos;intersection&apos;, &apos;first&apos;, or &apos;last&apos;.</param_description></param_input_item>
    <param_input_item><param_name>method</param_name><param_description>Method used to retime each input timetable.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>TT</param_name><param_description>Synchronized timetable.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>synchronize</b> combines timetables and aligns their variables to common row times.</p>
    <p>Supported time bases include union, intersection, first, last, regular time grids, named time steps, and explicit time vectors.</p>
    <p>The retiming method is passed to <b>retime</b>, including fill, nearest-neighbor, interpolation, and aggregation methods.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[t = datetime(2024, 1, 1) + days(0:1)';
TT1 = timetable(t, [1; 2], 'VariableNames', {'A'});
TT2 = timetable(t, [10; 20], 'VariableNames', {'B'});
TT = synchronize(TT1, TT2)]]></example_item_data></example_item>
  </examples>
