  <language>en_US</language>
  <keyword>topkrows</keyword>
  <short_description>Return top rows of a table or timetable.</short_description>
  <syntax>
    <syntax_item>B = topkrows(A, k)</syntax_item>
    <syntax_item>[B, I] = topkrows(A, k, vars)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>Input table or timetable.</param_description></param_input_item>
    <param_input_item><param_name>k</param_name><param_description>Number of rows.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>B</param_name><param_description>Output table or timetable.</param_description></param_output_item>
    <param_output_item><param_name>I</param_name><param_description>Selected row indices.</param_description></param_output_item>
  </param_output>
  <description><p><b>topkrows</b> returns the first <b>k</b> rows after sorting by row times or selected variables.</p></description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[TT = timetable(seconds([1; 2; 3]), [10; 30; 20], 'VariableNames', {'A'});
topkrows(TT, 2, 'A')
]]></example_item_data>
    </example_item>
  </examples>
