  <language>en_US</language>
  <keyword>timetable</keyword>
  <short_description>Create timetable from variables and row times.</short_description>
  <syntax>
    <syntax_item>TT = timetable(rowTimes, var1, ..., varN)</syntax_item>
    <syntax_item>TT = timetable(var1, ..., varN, &apos;RowTimes&apos;, rowTimes)</syntax_item>
    <syntax_item>TT = timetable(&apos;Size&apos;, sz, &apos;VariableTypes&apos;, types)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>rowTimes</param_name>
      <param_description>datetime or duration vector used as row times.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>var1, ..., varN</param_name>
      <param_description>Variables with one row per row time.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>TT</param_name>
      <param_description>Timetable object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>timetable</b> creates a timetable, a tabular object whose rows are identified by times.</p>
    <p>Row times can be provided as the first input or with the <b>&apos;RowTimes&apos;</b> name-value argument.</p>
    <p>Variable names, dimension names, description, user data, and custom properties are stored in <b>TT.Properties</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[t = datetime(2024, 1, 1) + days(0:2)';
TT = timetable(t, [10; 20; 30], 'VariableNames', {'A'});
TT.Properties.RowTimes]]></example_item_data>
    </example_item>
  </examples>
