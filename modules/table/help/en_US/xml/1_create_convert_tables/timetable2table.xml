  <language>en_US</language>
  <keyword>timetable2table</keyword>
  <short_description>Convert timetable to table.</short_description>
  <syntax>
    <syntax_item>T = timetable2table(TT)</syntax_item>
    <syntax_item>T = timetable2table(TT, &apos;ConvertRowTimes&apos;, tf)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>TT</param_name><param_description>Timetable object.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>T</param_name><param_description>Table object.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>timetable2table</b> converts a timetable to a table.</p>
    <p>When <b>&apos;ConvertRowTimes&apos;</b> is true, row times are inserted as the first table variable.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[t = datetime(2024, 1, 1) + days(0:1)';
TT = timetable(t, [1; 2], 'VariableNames', {'A'});
T = timetable2table(TT, 'ConvertRowTimes', true)]]></example_item_data></example_item>
  </examples>
