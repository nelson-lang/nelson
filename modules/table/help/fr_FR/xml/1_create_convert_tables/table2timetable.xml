  <language>fr_FR</language>
  <keyword>table2timetable</keyword>
  <short_description>Convertir une table en timetable.</short_description>
  <syntax>
    <syntax_item>TT = table2timetable(T, &apos;RowTimes&apos;, rowTimes)</syntax_item>
    <syntax_item>TT = table2timetable(T, &apos;TimeStep&apos;, dt)</syntax_item>
    <syntax_item>TT = table2timetable(T, &apos;SampleRate&apos;, fs)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>T</param_name><param_description>Objet table.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>TT</param_name><param_description>Objet timetable.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>table2timetable</b> convertit une table en timetable et attribue des temps aux lignes de sortie.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[T = table([1; 2; 3], 'VariableNames', {'A'});
t = datetime(2024, 1, 1) + days(0:2)';
TT = table2timetable(T, 'RowTimes', t)]]></example_item_data></example_item>
  </examples>
