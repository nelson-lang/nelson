  <language>fr_FR</language>
  <keyword>array2timetable</keyword>
  <short_description>Convertir un tableau homogene en timetable.</short_description>
  <syntax>
    <syntax_item>TT = array2timetable(A, &apos;RowTimes&apos;, rowTimes)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>Tableau d&apos;entree.</param_description></param_input_item>
    <param_input_item><param_name>rowTimes</param_name><param_description>Vecteur datetime ou duration.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>TT</param_name><param_description>Objet timetable.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>array2timetable</b> convertit les colonnes de <b>A</b> en variables d&apos;une timetable.</p>
    <p>Utilisez <b>&apos;VariableNames&apos;</b> pour fournir les noms de variables de la timetable de sortie.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[t = datetime(2024, 1, 1) + days(0:2)';
A = [1 10; 2 20; 3 30];
TT = array2timetable(A, 'RowTimes', t)]]></example_item_data></example_item>
  </examples>
