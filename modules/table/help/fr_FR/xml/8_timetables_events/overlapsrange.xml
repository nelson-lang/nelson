  <keyword>overlapsrange</keyword>
  <short_description>Determiner si les temps de lignes chevauchent une plage.</short_description>
  <syntax><syntax_item>[tf, tfRow] = overlapsrange(TT, timeSpec)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>TT</param_name><param_description>Timetable d&apos;entree.</param_description></param_input_item>
    <param_input_item><param_name>timeSpec</param_name><param_description>Specification de plage de temps.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>tf</param_name><param_description>Scalaire logique.</param_description></param_output_item>
    <param_output_item><param_name>tfRow</param_name><param_description>Selecteur logique de lignes.</param_description></param_output_item>
  </param_output>
  <description><p><b>overlapsrange</b> teste si les temps de lignes chevauchent la plage de temps specifiee.</p></description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[TT = timetable(seconds([1; 2; 3]), [10; 20; 30], 'VariableNames', {'A'});
overlapsrange(TT, seconds([2; 4]))
]]></example_item_data>
    </example_item>
  </examples>
