  <keyword>SEEK_END</keyword>
  <short_description>Origin value for <b>fseek</b>: the end of the file.</short_description>
  <syntax>
    <syntax_item>id = SEEK_END()</syntax_item>
  </syntax>
  <param_input />
  <param_output>
    <param_output_item>
      <param_name>id</param_name>
      <param_description>the value <b>1</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>id = SEEK_END()</b> returns the numeric origin value to pass to <b>fseek</b> to position the file relative to the end of the file.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[id = SEEK_END()]]></example_item_data>
    </example_item>
  </examples>
