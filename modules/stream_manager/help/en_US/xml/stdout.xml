  <language>en_US</language>
  <keyword>stdout</keyword>
  <short_description>File identifier of the standard output stream.</short_description>
  <syntax>
    <syntax_item>fd = stdout()</syntax_item>
  </syntax>
  <param_input />
  <param_output>
    <param_output_item>
      <param_name>fd</param_name>
      <param_description>the value <b>1</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>fd = stdout()</b> returns <b>1</b>, the file identifier of the standard output stream.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[fprintf(stdout(), 'Hello\n');]]></example_item_data>
    </example_item>
  </examples>
