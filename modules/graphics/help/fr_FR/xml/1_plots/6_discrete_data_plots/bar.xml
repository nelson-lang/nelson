  <language>fr_FR</language>
  <keyword>bar</keyword>
  <short_description>Diagramme en barres.</short_description>
  <syntax>
    <syntax_item>bar(Y)</syntax_item>
    <syntax_item>bar(X, Y)</syntax_item>
    <syntax_item>bar(..., width)</syntax_item>
    <syntax_item>bar(..., color)</syntax_item>
    <syntax_item>bar(..., 'grouped')</syntax_item>
    <syntax_item>bar(..., 'stacked')</syntax_item>
    <syntax_item>bar(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>bar(ax, ...)</syntax_item>
    <syntax_item>b = bar(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>abscisses : scalaire, vecteur, tableau categorical, tableau de chaines ou cellule d'etiquettes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>ordonnees : vecteur ou matrice.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>width</param_name>
      <param_description>scalaire, 0.8 par defaut.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>color</param_name>
      <param_description>chaine scalaire ou vecteur ligne de caracteres : nom de couleur ou nom court de couleur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName</param_name>
      <param_description>chaine scalaire ou vecteur ligne de caracteres.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyValue</param_name>
      <param_description>une valeur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>objet axes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>b</param_name>
      <param_description>objet graphique bar ou vecteur d'objets graphiques bar.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>bar(X, Y)</b> cree un diagramme en barres avec les positions X et les valeurs Y.</p>
    <p>Lorsqu'un seul argument est fourni, <b>bar(Y)</b> genere les positions X de 1 au nombre de lignes de Y.</p>
    <p>Vous pouvez specifier la largeur des barres. Une valeur de 1.0 fait toucher les barres voisines, tandis que la largeur par defaut vaut 0.8.</p>
    <p>Lorsque Y est une matrice, <b>bar</b> cree des barres groupees par defaut. Utiliser <b>'stacked'</b> pour empiler les colonnes dans chaque groupe.</p>
    <p>Lorsque X est un tableau categoriel, les barres sont placees dans l'ordre des categories (celui renvoye par <b>categories</b>), Y est reordonne en consequence, et les noms des categories servent d'etiquettes de graduation.</p>
    <p>Voir <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.bar.properties">proprietes de bar</link> pour la liste complete des proprietes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Diagramme en barres depuis un vecteur.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
y = [91 75 123.5 105 150 131 203 179 249 226 281.5];
bar(y);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Diagramme avec des barres plus etroites.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
y = [91 75 123.5 105 150 131 203 179 249 226 281.5];
bar(y, 0.5);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_2.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Diagramme avec positions explicites et couleur.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
x = 1900:10:2000;
y = [75 91 105 123.5 131 150 179 203 226 249 281.5];
bar(x, y, 'r');
]]></example_item_data>
      <example_item_img src="../../../../images/bar_3.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Diagramme avec etiquettes de chaines.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
x = ["Summer", "Spring", "Winter", "Autumn"];
y = [2 1 4 3];
bar(x, y);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_4.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Diagramme avec proprietes de face et de contour.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
y = [91 75 123.5 105 150 131 203 179 249 226 281.5];
bar(y, 'FaceColor', [0 .5 .5], 'EdgeColor', [0 .9 .9], 'LineWidth', 1.5);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_5.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Barres groupees.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
y = [1 2; 3 4; 5 6];
bar(y, 'grouped');
]]></example_item_data>
      <example_item_img src="../../../../images/bar_6.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Barres empilees avec valeurs positives et negatives.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
y = [1 -2 3; -4 5 -6];
bar(y, 'stacked');
]]></example_item_data>
      <example_item_img src="../../../../images/bar_7.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Barres empilees a une position scalaire.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
x = 2020;
y = [30 50 23];
bar(x, y, "stacked");
]]></example_item_data>
      <example_item_img src="../../../../images/bar_8.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Diagramme avec etiquettes categoriales.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
X = categorical({'Small', 'Medium', 'Large', 'Extra Large'});
X = reordercats(X, {'Small', 'Medium', 'Large', 'Extra Large'});
Y = [10 21 33 52];
bar(X, Y);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_9.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Diagramme depuis une variable de table.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
Month = ["April"; "May"; "June"; "July"; "August"];
Sales = [2000; 3000; 4000; 5000; 6000];
Revenue = [1500; 1800; 2000; 3000; 4000];
tbl = table(Month, Sales, Revenue);
bar(tbl.Month, tbl.Sales);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_10.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Barres groupees depuis plusieurs variables de table.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
Month = ["April"; "May"; "June"; "July"; "August"];
Sales = [2000; 3000; 4000; 5000; 6000];
Revenue = [1500; 1800; 2000; 3000; 4000];
tbl = table(Month, Sales, Revenue);
bar(tbl.Month, [tbl.Sales, tbl.Revenue]);
legend({'Sales', 'Revenue'}, 'Location', 'northwest');
]]></example_item_data>
      <example_item_img src="../../../../images/bar_11.svg" align="middle" generate="true" />
    </example_item>
  </examples>
