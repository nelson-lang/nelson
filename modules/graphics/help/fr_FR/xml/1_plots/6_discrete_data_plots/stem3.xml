  <language>fr_FR</language>
  <keyword>stem3</keyword>
  <short_description>Afficher un trace en tiges 3-D.</short_description>
  <syntax>
    <syntax_item>stem3(Z)</syntax_item>
    <syntax_item>stem3(X, Y, Z)</syntax_item>
    <syntax_item>stem3(..., LineSpec)</syntax_item>
    <syntax_item>stem3(..., &apos;filled&apos;)</syntax_item>
    <syntax_item>stem3(parent, ...)</syntax_item>
    <syntax_item>h = stem3(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>Z</param_name>
      <param_description>Hauteurs des tiges : vecteur ou matrice numerique.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>Coordonnees X : vecteur ou matrice numerique.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>Coordonnees Y : vecteur ou matrice numerique.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>LineSpec</param_name>
      <param_description>Specification de style de ligne, marqueur et couleur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>Axes ou hggroup parent.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>Objet graphique stem.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>stem3</b> affiche des tiges verticales de z = 0 aux valeurs de <b>Z</b>, avec des marqueurs aux sommets.</p>
    <p>L'objet retourne est un objet graphique <b>stem</b>. Voir <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.stem.properties">nelson.graphics.stem.properties</link> pour les proprietes prises en charge.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Afficher un trace en tiges 3-D depuis une matrice.</example_item_description>
      <example_item_data><![CDATA[Z = peaks(8);
stem3(Z);]]></example_item_data>
      <example_item_img src="../../../../images/stem3_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Specifier les coordonnees et remplir les marqueurs.</example_item_description>
      <example_item_data><![CDATA[t = 0:0.2:2*pi;
stem3(cos(t), sin(t), t, 'r--', 'filled');]]></example_item_data>
      <example_item_img src="../../../../images/stem3_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${graphics}1_plots/6_discrete_data_plots/stem">stem</link></see_also_item>
    <see_also_item><link linkend="${graphics}1_plots/1_line_plots/plot3">plot3</link></see_also_item>
