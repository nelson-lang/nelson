  <language>fr_FR</language>
  <keyword>fcontour</keyword>
  <short_description>Tracer des contours depuis une fonction de deux variables.</short_description>
  <syntax>
    <syntax_item>fcontour(fun)</syntax_item>
    <syntax_item>fcontour(fun, xyinterval)</syntax_item>
    <syntax_item>fcontour(fun, [xmin xmax ymin ymax])</syntax_item>
    <syntax_item>fcontour(..., LineSpec)</syntax_item>
    <syntax_item>fcontour(..., nomPropriete, valeurPropriete)</syntax_item>
    <syntax_item>fcontour(parent, ...)</syntax_item>
    <syntax_item>h = fcontour(...)</syntax_item>
  </syntax>
  <description>
    <p><b>fcontour</b> echantillonne <b>fun(x,y)</b> sur une grille reguliere et affiche des lignes de contour comme objet graphique <b>functioncontour</b>.</p>
    <p>Voir <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.functioncontour.properties">proprietes de functioncontour</link> pour la liste complete des proprietes.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Afficher des contours de fonction.</example_item_description>
      <example_item_data><![CDATA[fcontour(@(x, y) x.^2 - y.^2, [-2 2 -2 2]);]]></example_item_data>
      <example_item_img src="../../../../images/fcontour_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Utiliser une couleur de ligne et des niveaux explicites.</example_item_description>
      <example_item_data><![CDATA[h = fcontour(@(x, y) x + y, '-r', 'LevelList', [-2 0 2]);
h.LineWidth = 1.5;]]></example_item_data>
      <example_item_img src="../../../../images/fcontour_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
