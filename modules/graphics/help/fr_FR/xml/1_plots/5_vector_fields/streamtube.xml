  <language>fr_FR</language>
  <keyword>streamtube</keyword>
  <short_description>Afficher des chemins de courant avec un style tube.</short_description>
  <syntax>
    <syntax_item>streamtube(U, V, W, sx, sy, sz)</syntax_item>
    <syntax_item>streamtube(X, Y, Z, U, V, W, sx, sy, sz)</syntax_item>
    <syntax_item>streamtube(vertices)</syntax_item>
    <syntax_item>streamtube(vertices, width)</syntax_item>
    <syntax_item>h = streamtube(...)</syntax_item>
  </syntax>
  <description>
    <p><b>streamtube</b> affiche des chemins de courant 3-D sous forme de surfaces tube.</p>
    <p><b>streamtube(vertices)</b> utilise des sommets de lignes de courant pre-calcules. Les handles retournes sont des objets surface.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Afficher un chemin avec un style tube.</example_item_description>
      <example_item_data><![CDATA[t = 0:.15:2;
vertices = {[cos(t)' sin(t)' t']};
streamtube(vertices);]]></example_item_data>
      <example_item_img src="../../../../images/streamtube_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
