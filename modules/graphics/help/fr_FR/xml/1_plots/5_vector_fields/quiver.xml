  <keyword>quiver</keyword>
  <short_description>Trace de champ vectoriel 2-D.</short_description>
  <syntax>
    <syntax_item>quiver(U, V)</syntax_item>
    <syntax_item>quiver(X, Y, U, V)</syntax_item>
    <syntax_item>quiver(..., scale)</syntax_item>
    <syntax_item>quiver(..., LineSpec)</syntax_item>
    <syntax_item>quiver(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>quiver(parent, ...)</syntax_item>
    <syntax_item>h = quiver(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X, Y</param_name>
      <param_description>Coordonnees des bases des fleches, sous forme de scalaires, vecteurs ou matrices.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>U, V</param_name>
      <param_description>Composantes vectorielles, sous forme de tableaux numeriques de meme taille.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>scale</param_name>
      <param_description>Facteur d'echelle automatique. Utiliser 0 pour desactiver l'echelle automatique.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>LineSpec</param_name>
      <param_description>Specification de style de ligne, marqueur et couleur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>Parent axes ou hggroup.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName</param_name>
      <param_description>Nom de propriete sous forme de chaine scalaire ou de vecteur de caracteres.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyValue</param_name>
      <param_description>Valeur de propriete.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>Objet graphique quiver.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>quiver(U,V)</b> trace des fleches avec les composantes vectorielles <b>U</b> et <b>V</b> sur une grille reguliere.</p>
    <p><b>quiver(X,Y,U,V)</b> trace les fleches aux coordonnees donnees par <b>X</b> et <b>Y</b>.</p>
    <p>L'objet retourne a le type <b>quiver</b>. Ses proprietes publiques incluent <b>XData</b>, <b>YData</b>, <b>UData</b>, <b>VData</b>, <b>WData</b>, <b>AutoScale</b>, <b>AutoScaleFactor</b>, <b>ScaleFactor</b>, <b>Color</b>, <b>LineStyle</b>, <b>LineWidth</b>, <b>Marker</b>, <b>MarkerSize</b>, <b>MaxHeadSize</b>, <b>ShowArrowHead</b>, <b>Alignment</b>, <b>DisplayName</b> et les proprietes graphiques communes.</p>
    <p>Voir <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.quiver.properties">proprietes de quiver</link> pour la liste complete des proprietes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Tracer un champ vectoriel sur une grille reguliere.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[[X, Y] = meshgrid(-2:0.5:2, -2:0.5:2);
U = -Y;
V = X;
h = quiver(X, Y, U, V);
axis equal]]></example_item_data>
      <example_item_img src="../../../../images/quiver_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Styliser les fleches et desactiver l'echelle automatique.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[x = 1:5;
y = [1 2 1 2 1];
u = [1 0 -1 0 1];
v = [0 1 0 -1 0];
h = quiver(x, y, u, v, 0, 'r--o', 'LineWidth', 1.5);
h.ShowArrowHead = 'on';]]></example_item_data>
      <example_item_img src="../../../../images/quiver_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
