  <language>fr_FR</language>
  <keyword>streamparticles</keyword>
  <short_description>Afficher des marqueurs de particules le long de chemins de courant.</short_description>
  <syntax>
    <syntax_item>streamparticles(vertices)</syntax_item>
    <syntax_item>streamparticles(vertices, n)</syntax_item>
    <syntax_item>streamparticles(parent, vertices, n)</syntax_item>
    <syntax_item>streamparticles(lineHandle, vertices, n)</syntax_item>
    <syntax_item>streamparticles(..., name, value)</syntax_item>
    <syntax_item>h = streamparticles(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>vertices</param_name>
      <param_description>Tableau de cellules d'ensembles de coordonnees de lignes de courant, avec deux ou trois colonnes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>lineHandle</param_name>
      <param_description>Objet line existant a reutiliser pour les marqueurs de particules.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>Nombre de marqueurs de particules a echantillonner sur chaque ligne de courant.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>name, value</param_name>
      <param_description>Les proprietes prises en charge incluent Marker, MarkerEdgeColor, MarkerFaceColor, Animate, FrameRate et ParticleAlignment.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>streamparticles</b> affiche des marqueurs aux positions echantillonnees depuis des sommets de lignes de courant pre-calcules.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Afficher des particules de courant.</example_item_description>
      <example_item_data><![CDATA[vertices = {[0 0; 0.5 0.2; 1 0.5; 1.5 0.8]};
streamparticles(vertices);]]></example_item_data>
      <example_item_img src="../../../../images/streamparticles_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Afficher des particules depuis des sommets de lignes de courant pre-calcules.</example_item_description>
      <example_item_data><![CDATA[vertices = {[0 0; 0.5 0.2; 1 0.5; 1.5 0.8]};
streamparticles(vertices, 4, 'MarkerFaceColor', 'red');]]></example_item_data>
      <example_item_img src="../../../../images/streamparticles_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
