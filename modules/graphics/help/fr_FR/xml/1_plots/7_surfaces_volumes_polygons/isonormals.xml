  <keyword>isonormals</keyword>
  <short_description>Calculer les normales des sommets d'une isosurface.</short_description>
  <syntax>
    <syntax_item>n = isonormals(X, Y, Z, V, vertices)</syntax_item>
    <syntax_item>n = isonormals(V, vertices)</syntax_item>
    <syntax_item>n = isonormals(V, p)</syntax_item>
    <syntax_item>n = isonormals(X, Y, Z, V, p)</syntax_item>
    <syntax_item>n = isonormals(..., 'negate')</syntax_item>
    <syntax_item>isonormals(V, p)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X, Y, Z</param_name>
      <param_description>Vecteurs de grille ou tableaux 3-D de meme taille que V.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>V</param_name>
      <param_description>Donnees volumiques 3-D reelles numeriques.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>vertices, p</param_name>
      <param_description>Matrice de sommets N-by-3 ou handle de patch.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>n</param_name>
      <param_description>Vecteurs normaux N-by-3 interpoles depuis le gradient du volume.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>isonormals</b> calcule les normales aux sommets d'une isosurface. Avec un handle de patch et sans sortie, la propriete VertexNormals est definie.</p>
  </description>
