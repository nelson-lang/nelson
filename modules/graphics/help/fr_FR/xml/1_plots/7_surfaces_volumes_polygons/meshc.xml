  <language>fr_FR</language>
  <keyword>meshc</keyword>
  <short_description>Afficher un maillage avec des contours en dessous.</short_description>
  <syntax>
    <syntax_item>meshc(Z)</syntax_item>
    <syntax_item>meshc(Z, C)</syntax_item>
    <syntax_item>meshc(X, Y, Z)</syntax_item>
    <syntax_item>meshc(X, Y, Z, C)</syntax_item>
    <syntax_item>meshc(parent, ...)</syntax_item>
    <syntax_item>meshc('Parent', parent, ...)</syntax_item>
    <syntax_item>h = meshc(...)</syntax_item>
  </syntax>
  <description>
    <p><b>meshc</b> affiche un maillage et des lignes de contour projetees a la base du maillage.</p>
    <p>La valeur retournee est un vecteur graphique a deux elements contenant l'objet surface puis l'objet contour.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Maillage avec contours.</example_item_description>
      <example_item_data><![CDATA[meshc(peaks(30));]]></example_item_data>
      <example_item_img src="../../../../images/meshc_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Utiliser des donnees de couleur separees et des axes parents.</example_item_description>
      <example_item_data><![CDATA[f = figure();
ax = axes('Parent', f);
Z = peaks(20);
C = abs(Z);
meshc('Parent', ax, Z, C, 'LineWidth', 1.5);]]></example_item_data>
      <example_item_img src="../../../../images/meshc_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
