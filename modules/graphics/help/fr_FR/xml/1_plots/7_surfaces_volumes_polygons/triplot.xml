  <language>fr_FR</language>
  <keyword>triplot</keyword>
  <short_description>Trace de triangles 2-D</short_description>
  <syntax>
    <syntax_item>triplot(T, x, y)</syntax_item>
    <syntax_item>triplot(T, x, y, LineSpec)</syntax_item>
    <syntax_item>triplot(TO)</syntax_item>
    <syntax_item>triplot(..., Name, Value)</syntax_item>
    <syntax_item>h = triplot(...)</syntax_item>
  </syntax>
  <description>
    <p><b>triplot</b> trace un maillage triangulaire 2-D depuis une matrice de connectivite ou un objet de triangulation.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Tracer une triangulation et les centres inscrits de ses triangles.</example_item_description>
      <example_item_data runnable="gui"><![CDATA[rng default;
P = rand([30 2]);
DT = delaunayTriangulation(P);
IC = incenter(DT);
triplot(DT)
hold on
plot(IC(:, 1), IC(:, 2), '*r')]]></example_item_data>
      <example_item_img src="../../../../images/triplot_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
