  <language>fr_FR</language>
  <keyword>ellipsoid</keyword>
  <short_description>Crée un ellipsoïde.</short_description>
  <syntax>
    <syntax_item>[X, Y, Z] = ellipsoid(xc, yc, zc, xr, yr, zr)</syntax_item>
    <syntax_item>[X, Y, Z] = ellipsoid(xc, yc, zc, xr, yr, zr, n)</syntax_item>
    <syntax_item>ellipsoid(...)</syntax_item>
    <syntax_item>ellipsoid(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>xc, yc, zc</param_name>
      <param_description>le centre de l&apos;ellipsoïde.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>xr, yr, zr</param_name>
      <param_description>les longueurs des demi-axes selon x, y et z.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>un entier positif : la résolution de la grille (par défaut 20). Le résultat est (n+1)-par-(n+1).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>X, Y, Z</param_name>
      <param_description>les coordonnées de la surface de l&apos;ellipsoïde.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ellipsoid</b> génère les coordonnées d&apos;un ellipsoïde centré en
      <b>(xc, yc, zc)</b> avec les demi-axes <b>(xr, yr, zr)</b>. Appelée sans
      argument de sortie, elle trace la surface.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
ellipsoid(0, 0, 0, 3, 2, 1);
axis equal]]></example_item_data>
    </example_item>
  </examples>
