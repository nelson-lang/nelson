  <language>fr_FR</language>
  <keyword>addpoints</keyword>
  <short_description>Ajouter des points a une ligne animée.</short_description>
  <syntax>
    <syntax_item>addpoints(an, x, y)</syntax_item>
    <syntax_item>addpoints(an, x, y, z)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>an</param_name>
      <param_description>objet graphique animatedline.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>x, y, z</param_name>
      <param_description>coordonnées numériques avec le même nombre d'éléments.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>addpoints</b> ajoute des coordonnées a une ligne animée et rafraîchit la figure parente.</p>
    <p>Si <b>z</b> est omis, des coordonnées z nulles sont stockées.</p>
    <p>La propriété <b>MaximumNumPoints</b> limite les coordonnées stockées et conserve les points les plus récents.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[an = animatedline('MaximumNumPoints', 50);
x = linspace(0, 4*pi, 200);
addpoints(an, x, sin(x));
drawnow]]></example_item_data>
    </example_item>
  </examples>
