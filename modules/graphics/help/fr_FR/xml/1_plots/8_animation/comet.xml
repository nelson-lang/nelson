  <language>fr_FR</language>
  <keyword>comet</keyword>
  <short_description>Creer un trace comete 2-D.</short_description>
  <syntax>
    <syntax_item>comet(y)</syntax_item>
    <syntax_item>comet(x, y)</syntax_item>
    <syntax_item>comet(x, y, p)</syntax_item>
    <syntax_item>comet(ax, x, y, p)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x, y</param_name>
      <param_description>vecteurs numeriques avec le meme nombre d'elements.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>facteur de longueur du corps dans l'intervalle [0, 1).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>axes cible.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>comet</b> anime une tete avec marqueur, un corps mobile et une trace complete pour un trace comete deux dimensions.</p>
    <p>L'etat final des axes contient deux objets animatedline et un objet line avec marqueur seulement.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[t = 0:pi/80:2*pi;
comet(cos(t), sin(t), 0.2)]]></example_item_data>
    </example_item>
  </examples>
