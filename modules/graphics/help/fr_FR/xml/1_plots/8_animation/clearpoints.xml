  <language>fr_FR</language>
  <keyword>clearpoints</keyword>
  <short_description>Effacer les points d'une ligne animee.</short_description>
  <syntax>
    <syntax_item>clearpoints(an)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>an</param_name>
      <param_description>objet graphique animatedline.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>clearpoints</b> supprime toutes les coordonnees stockees dans une ligne animee et rafraichit la figure parente.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[an = animatedline(1:5, [2 4 1 3 5]);
clearpoints(an);
[x, y] = getpoints(an)]]></example_item_data>
    </example_item>
  </examples>
