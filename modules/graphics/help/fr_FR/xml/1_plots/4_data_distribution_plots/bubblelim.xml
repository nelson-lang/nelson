  <keyword>bubblelim</keyword>
  <short_description>Definit ou retourne les limites des donnees de taille des bulles.</short_description>
  <syntax>
    <syntax_item>bubblelim(limits)</syntax_item>
    <syntax_item>bubblelim(&apos;auto&apos;)</syntax_item>
    <syntax_item>bubblelim(&apos;manual&apos;)</syntax_item>
    <syntax_item>bubblelim(ax, ...)</syntax_item>
    <syntax_item>limits = bubblelim()</syntax_item>
    <syntax_item>mode = bubblelim(&apos;mode&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>limits</param_name>
      <param_description>Vecteur numerique a deux elements [min max].</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes cible. Si omis, les axes courants sont utilises.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>limits</param_name>
      <param_description>Limites courantes des donnees de taille des bulles.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>bubblelim</b> controle les limites de donnees utilisees pour convertir <b>SizeData</b> en diametres de bulles.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Definir les limites de bulles.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[figure();
bubblechart(1:3, [2 4 6], [10 100 1000]);
bubblelim([10 1000]);]]></example_item_data>
      <example_item_img src="../../../../images/bubblelim_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
