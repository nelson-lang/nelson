  <keyword>bubblesize</keyword>
  <short_description>Definit ou retourne la plage des diametres affiches des bulles.</short_description>
  <syntax>
    <syntax_item>bubblesize(range)</syntax_item>
    <syntax_item>bubblesize(ax, range)</syntax_item>
    <syntax_item>range = bubblesize()</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>range</param_name>
      <param_description>Vecteur positif a deux elements [min max], en points.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes cible. Si omis, les axes courants sont utilises.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>range</param_name>
      <param_description>Plage courante des diametres affiches des bulles.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>bubblesize</b> controle les diametres minimum et maximum affiches des bulles dans les axes.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Reduire les tailles de bulles.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[figure();
bubblechart(1:3, [2 4 6], [10 100 1000]);
bubblesize([5 30]);]]></example_item_data>
      <example_item_img src="../../../../images/bubblesize_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
