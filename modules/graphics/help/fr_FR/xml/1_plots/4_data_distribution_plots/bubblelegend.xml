  <language>fr_FR</language>
  <keyword>bubblelegend</keyword>
  <short_description>Ajoute une legende de taille de bulles.</short_description>
  <syntax>
    <syntax_item>bubblelegend(title)</syntax_item>
    <syntax_item>bubblelegend(ax, title)</syntax_item>
    <syntax_item>bubblelegend(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>bl = bubblelegend(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>title</param_name>
      <param_description>Texte du titre de la legende.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName, propertyValue</param_name>
      <param_description>Paires nom-valeur pour l&apos;objet bubblelegend.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>bl</param_name>
      <param_description>Objet graphique de legende de bulles.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>bubblelegend</b> cree un objet graphique <b>bubblelegend</b>.</p>
    <p>Voir <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.bubblelegend.properties">proprietes de bubblelegend</link> pour la liste complete des proprietes.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Ajouter une legende pour les tailles de bulles.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[figure();
bubblechart(1:3, [2 4 6], [10 100 1000]);
bubblesize([5 30]);
bubblelegend('Population', 'Location', 'eastoutside');]]></example_item_data>
      <example_item_img src="../../../../images/bubblelegend_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
