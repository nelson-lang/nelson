  <language>fr_FR</language>
  <keyword>line</keyword>
  <short_description>Crée une ligne primitive.</short_description>
  <syntax>
    <syntax_item>go = line()</syntax_item>
    <syntax_item>po = line(x, y)</syntax_item>
    <syntax_item>go = line(x, y, z)</syntax_item>
    <syntax_item>go = line(ax, x, y, z)</syntax_item>
    <syntax_item
    >go = line(ax, x, y, z, propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x, y , z</param_name>
      <param_description
      >Un ou plusieurs vecteurs ou matrices de coordonnées.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes cibles : objet axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName</param_name>
      <param_description
      >Une chaîne scalaire ou un vecteur ligne de caractères.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyValue</param_name>
      <param_description>Une valeur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>go</param_name>
      <param_description>Un objet graphique : type ligne.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>line(x, y)</b> crée une ligne dans les axes courants avec les vecteurs<b>x</b> et <b>y</b>.</p>
    <p>
      <b>line(x, y, z)</b> crée une ligne en coordonnées tridimensionnelles.</p>
    <p>Voir <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.line.properties">proprietes de line</link> pour la liste complete des proprietes.</p>
    <p>
      <b>BeingDeleted</b> Indicateur signalant que l&apos;objet est en cours de suppression.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
x = linspace(0,10)';
y1 = sin(x);
y2 = cos(x);
line(x, y1, 'Color', [0 1 0])
line(x, y2, 'Color', [1 0 0])
]]></example_item_data>
      <example_item_img
        src="../../../../images/line_xy.svg"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
x = [1 9];
y = [2 12];
line(x,y,'Color','red','LineStyle','--')]]></example_item_data>
      <example_item_img
        src="../../../../images/line_linestyle.svg"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
t = linspace(0,10*pi,400);
x = sin(t);
y = cos(t);
z = t;
line(x,y,z)
view(3)]]></example_item_data>
      <example_item_img
        src="../../../../images/line_xyz.svg"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
