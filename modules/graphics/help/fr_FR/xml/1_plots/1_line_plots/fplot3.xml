  <language>fr_FR</language>
  <keyword>fplot3</keyword>
  <short_description>Tracer une courbe parametrique 3-D depuis des handles de fonctions.</short_description>
  <syntax>
    <syntax_item>fplot3(xfun, yfun, zfun)</syntax_item>
    <syntax_item>fplot3(xfun, yfun, zfun, tinterval)</syntax_item>
    <syntax_item>fplot3(..., LineSpec)</syntax_item>
    <syntax_item>fplot3(parent, ...)</syntax_item>
    <syntax_item>h = fplot3(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>xfun, yfun, zfun</param_name>
      <param_description>Handles de fonctions evalues sur l'intervalle du parametre.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tinterval</param_name>
      <param_description>Vecteur fini croissant a deux elements. La valeur par defaut est [-5 5].</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>LineSpec</param_name>
      <param_description>Specification de style de ligne, marqueur et couleur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Paires nom-valeur</param_name>
      <param_description>Proprietes de ligne et de parameterizedfunctionline, dont MeshDensity.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>Objet graphique de ligne de fonction parametrique.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>fplot3</b> echantillonne trois handles de fonctions sur un intervalle de parametre et affiche la courbe 3-D obtenue.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Tracer une helice.</example_item_description>
      <example_item_data><![CDATA[fplot3(@(t) cos(t), @(t) sin(t), @(t) t, [0 6*pi]);]]></example_item_data>
      <example_item_img src="../../../../images/fplot3_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Personnaliser le style de ligne.</example_item_description>
      <example_item_data><![CDATA[fplot3(@(t) t, @(t) t.^2, @(t) t.^3, [-2 2], 'r--', 'LineWidth', 2);]]></example_item_data>
      <example_item_img src="../../../../images/fplot3_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
