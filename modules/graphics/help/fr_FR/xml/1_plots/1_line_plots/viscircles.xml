  <language>fr_FR</language>
  <keyword>viscircles</keyword>
  <short_description>Trace des cercles.</short_description>
  <syntax>
    <syntax_item>viscircles(centers, radii)</syntax_item>
    <syntax_item>viscircles(ax, centers, radii)</syntax_item>
    <syntax_item>viscircles(..., 'Color', c)</syntax_item>
    <syntax_item>viscircles(..., 'LineWidth', w)</syntax_item>
    <syntax_item>h = viscircles(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>centers</param_name>
      <param_description>une matrice N par 2 des centres des cercles [x y].</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>radii</param_name>
      <param_description>un scalaire ou un vecteur de N rayons.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>les axes cibles.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>l&apos;objet groupe contenant les cercles tracés.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>viscircles</b> trace des cercles aux <b>centers</b> et <b>radii</b>
      donnés sur les axes. La couleur (rouge par défaut) et l&apos;épaisseur de
      trait se règlent avec les arguments nom-valeur <b>'Color'</b> et
      <b>'LineWidth'</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
axis equal
viscircles([0 0; 2 1], [1; 0.5], 'Color', 'b');]]></example_item_data>
    </example_item>
  </examples>
