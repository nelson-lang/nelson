  <language>fr_FR</language>
  <keyword>yline</keyword>
  <short_description>Ligne constante horizontale.</short_description>
  <syntax>
    <syntax_item>yline(yvalue)</syntax_item>
    <syntax_item>yline(yvalue, LineSpec)</syntax_item>
    <syntax_item>yline(yvalue, LineSpec, label)</syntax_item>
    <syntax_item>yline(yvalue, nomPropriete, valeurPropriete)</syntax_item>
    <syntax_item>yline(ax, yvalue)</syntax_item>
    <syntax_item>cl = yline(yvalue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>yvalue</param_name>
      <param_description
      >un scalaire ou un vecteur numérique réel : position de la ou des lignes horizontales sur l'axe des y.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>LineSpec</param_name>
      <param_description
      >un vecteur ligne de caractères ou une chaîne scalaire : style et couleur de la ligne, par exemple <b>'--r'</b>.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>label</param_name>
      <param_description
      >un vecteur ligne de caractères, une chaîne scalaire ou un tableau de cellules de caractères : texte affiché près de la ligne.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes cible : objet axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>nomPropriete</param_name>
      <param_description
      >une chaîne scalaire ou un vecteur ligne de caractères.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>valeurPropriete</param_name>
      <param_description>une valeur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>cl</param_name>
      <param_description
      >un objet graphique : type ConstantLine.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>yline(yvalue)</b> trace une ligne horizontale à la valeur <b>yvalue</b>
    sur les axes courants. La ligne occupe toute la largeur des axes.</p>
    <p>Utilisez un <b>LineSpec</b> pour définir le style et la couleur de la
    ligne, et un <b>label</b> pour l'annoter.</p>
    <p>Lorsque <b>yvalue</b> est un vecteur, une ligne horizontale est créée pour
    chaque valeur.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
plot(1:10, (1:10).^2);
yline(50, '-.b', 'mean');
]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
plot(1:10, sin(1:10));
yline([-1 0 1], 'Color', [0 0 1]);
]]></example_item_data>
    </example_item>
  </examples>
