  <keyword>isappdata</keyword>
  <short_description>Vrai si des données applicatives existent.</short_description>
  <syntax><syntax_item>tf = isappdata(h, name)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>h</param_name><param_description>un objet graphique.</param_description></param_input_item>
    <param_input_item><param_name>name</param_name><param_description>une chaîne : le nom de la donnée.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>tf</param_name><param_description>vrai si la donnée nommée est stockée sur h.</param_description></param_output_item></param_output>
  <description><p><b>isappdata</b> renvoie vrai lorsqu&apos;une donnée applicative nommée <b>name</b> existe sur <b>h</b>.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="adv-cli"><![CDATA[f = figure();
setappdata(gca, 'state', 42);
isappdata(gca, 'state')]]></example_item_data></example_item></examples>
