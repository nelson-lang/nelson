  <language>fr_FR</language>
  <keyword>makehgtform</keyword>
  <short_description>Crée une matrice de transformation 4 par 4.</short_description>
  <syntax>
    <syntax_item>M = makehgtform()</syntax_item>
    <syntax_item>M = makehgtform('translate', [tx ty tz])</syntax_item>
    <syntax_item>M = makehgtform('scale', s)</syntax_item>
    <syntax_item>M = makehgtform('xrotate', r)</syntax_item>
    <syntax_item>M = makehgtform('yrotate', r)</syntax_item>
    <syntax_item>M = makehgtform('zrotate', r)</syntax_item>
    <syntax_item>M = makehgtform(transform1, value1, transform2, value2, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>'translate'</param_name>
      <param_description>un vecteur à trois éléments [tx ty tz] : une translation.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'scale'</param_name>
      <param_description
      >un scalaire ou un vecteur à trois éléments : une mise à l&apos;échelle uniforme ou par axe.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'xrotate', 'yrotate', 'zrotate'</param_name>
      <param_description>un angle scalaire en radians : une rotation autour de cet axe.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>M</param_name>
      <param_description>une matrice de transformation 4 par 4.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>makehgtform</b> construit une matrice de transformation 4 par 4 à partir
      d&apos;une suite de translations, mises à l&apos;échelle et rotations. Les
      transformations sont multipliées de gauche à droite : la première listée est
      donc appliquée en dernier à un point. Le résultat convient à la propriété
      <b>Matrix</b> d&apos;un objet de transformation.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[M = makehgtform('translate', [1 0 0], 'zrotate', pi / 2)]]></example_item_data>
    </example_item>
  </examples>
