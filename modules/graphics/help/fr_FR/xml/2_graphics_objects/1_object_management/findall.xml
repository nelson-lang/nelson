  <language>fr_FR</language>
  <keyword>findall</keyword>
  <short_description>Trouve des objets graphiques, y compris les handles caches.</short_description>
  <syntax>
    <syntax_item>h = findall()</syntax_item>
    <syntax_item>h = findall(prop, value)</syntax_item>
    <syntax_item>h = findall(objhandles, prop, value)</syntax_item>
    <syntax_item>h = findall(objhandles, &apos;flat&apos;, ...)</syntax_item>
    <syntax_item>h = findall(objhandles, &apos;-depth&apos;, d, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>objhandles</param_name>
      <param_description>objet graphique ou tableau d&apos;objets graphiques depuis lesquels chercher.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>prop</param_name>
      <param_description>nom de propriete sous forme de vecteur de caracteres ou chaine scalaire.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>value</param_name>
      <param_description>valeur de propriete a rechercher.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>d</param_name>
      <param_description>profondeur de recherche, entiere positive ou nulle, ou Inf.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>tableau colonne des objets graphiques trouves.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>findall</b> parcourt la hierarchie graphique comme <b>findobj</b>, mais inclut les objets dont <b>HandleVisibility</b> vaut <b>&apos;off&apos;</b> ou <b>&apos;callback&apos;</b>.</p>
    <p>Quand la recherche demarre depuis <b>groot</b>, les figures cachees sont parcourues meme si <b>ShowHiddenHandles</b> vaut <b>&apos;off&apos;</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[close all
f = figure('Visible', 'off', 'HandleVisibility', 'off', 'Tag', 'hiddenFigure');
h = findall(groot(), 'Tag', 'hiddenFigure')]]></example_item_data>
    </example_item>
  </examples>
