  <keyword>rmappdata</keyword>
  <short_description>Supprime des données applicatives d'un objet.</short_description>
  <syntax><syntax_item>rmappdata(h, name)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>h</param_name><param_description>un objet graphique.</param_description></param_input_item>
    <param_input_item><param_name>name</param_name><param_description>une chaîne : le nom de la donnée à supprimer.</param_description></param_input_item>
  </param_input>
  <description><p><b>rmappdata</b> supprime la donnée applicative nommée <b>name</b> de <b>h</b>. C&apos;est une erreur si la donnée n&apos;existe pas.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="adv-cli"><![CDATA[f = figure();
setappdata(gca, 'state', 42);
rmappdata(gca, 'state');
isappdata(gca, 'state')]]></example_item_data></example_item></examples>
