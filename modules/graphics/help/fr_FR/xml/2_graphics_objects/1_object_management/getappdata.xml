  <keyword>getappdata</keyword>
  <short_description>Récupère des données applicatives d'un objet.</short_description>
  <syntax>
    <syntax_item>value = getappdata(h, name)</syntax_item>
    <syntax_item>s = getappdata(h)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>h</param_name><param_description>un objet graphique.</param_description></param_input_item>
    <param_input_item><param_name>name</param_name><param_description>une chaîne : le nom de la donnée.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>value</param_name><param_description>la valeur stockée, ou [] si le nom n&apos;est pas défini.</param_description></param_output_item>
    <param_output_item><param_name>s</param_name><param_description>une structure de toutes les données applicatives si aucun nom n&apos;est donné.</param_description></param_output_item>
  </param_output>
  <description><p><b>getappdata</b> renvoie la donnée applicative nommée <b>name</b> stockée sur <b>h</b>, ou l&apos;ensemble sous forme de structure si <b>name</b> est omis.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="adv-cli"><![CDATA[f = figure();
setappdata(gca, 'state', 42);
getappdata(gca, 'state')]]></example_item_data></example_item></examples>
