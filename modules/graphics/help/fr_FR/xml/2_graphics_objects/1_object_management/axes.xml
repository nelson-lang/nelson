  <language>fr_FR</language>
  <keyword>axes</keyword>
  <short_description>Créer des axes cartésiens.</short_description>
  <syntax>
    <syntax_item>ax = axes()</syntax_item>
    <syntax_item>ax = axes(parent)</syntax_item>
    <syntax_item>ax = axes(propertyName, propertyValue)</syntax_item>
    <syntax_item>ax = axes(parent, propertyName, propertyValue)</syntax_item>
    <syntax_item>axes(cax)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description
      >une valeur scalaire d&apos;objet graphique : conteneur parent, spécifié comme une figure.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>cax</param_name>
      <param_description>axes à rendre courant.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName</param_name>
      <param_description
      >une chaîne scalaire ou un vecteur ligne de caractères.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyValue</param_name>
      <param_description>une valeur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ax</param_name>
      <param_description>un objet graphique : type axes.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>axes</b> crée des axes dans la figure courante et les définit comme axes courants.</p>
    <p>
      <b>axes(cax)</b> rend les axes courants.</p>
    <p>Un clic sur un axe le rend automatiquement courant.</p>
    <p>Voir <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.axes.properties">proprietes de axes</link> pour la liste complete des proprietes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
ax1 = axes('Position', [0.1 0.1 0.7 0.7]);
ax2 = axes('Position', [0.65 0.65 0.28 0.28]);
x = linspace(0,10);
y1 = sin(x);
y2 = cos(x);
plot(ax1, x, y1);
plot(ax2, x, y2);]]></example_item_data>
      <example_item_img
        src="../../../../images/axes.svg"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
