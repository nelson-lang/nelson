  <keyword>setappdata</keyword>
  <short_description>Stocke des données applicatives sur un objet.</short_description>
  <syntax><syntax_item>setappdata(h, name, value)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>h</param_name><param_description>un objet graphique.</param_description></param_input_item>
    <param_input_item><param_name>name</param_name><param_description>une chaîne : le nom de la donnée.</param_description></param_input_item>
    <param_input_item><param_name>value</param_name><param_description>une valeur quelconque à stocker.</param_description></param_input_item>
  </param_input>
  <description><p><b>setappdata</b> stocke la <b>value</b> nommée comme donnée applicative sur l&apos;objet <b>h</b>, récupérable avec <b>getappdata</b>.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="adv-cli"><![CDATA[f = figure();
setappdata(gca, 'state', 42);
getappdata(gca, 'state')]]></example_item_data></example_item></examples>
