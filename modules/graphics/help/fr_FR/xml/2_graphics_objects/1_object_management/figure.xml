  <language>fr_FR</language>
  <keyword>figure</keyword>
  <short_description>Crée une fenêtre figure.</short_description>
  <syntax>
    <syntax_item>f = figure()</syntax_item>
    <syntax_item>f = figure(ID)</syntax_item>
    <syntax_item>f = figure(H)</syntax_item>
    <syntax_item>f = figure(propertyName, propertyValue)</syntax_item>
    <syntax_item>f = figure(ID, propertyName, propertyValue)</syntax_item>
    <syntax_item>f = figure(H, propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ID</param_name>
      <param_description
      >Un entier scalaire : recherche ou crée avec cet ID.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>H</param_name>
      <param_description
      >Un objet graphique scalaire sur une figure existante.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName</param_name>
      <param_description
      >Une chaîne scalaire ou un vecteur ligne de caractères.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyValue</param_name>
      <param_description>Une valeur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>f</param_name>
      <param_description
      >Un objet graphique : handle de figure.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>figure</b> crée une figure.</p>
    <p
    >Un clic sur une figure la définit automatiquement comme figure courante.</p>
    <p />
    <p>Voir <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.figure.properties">proprietes de figure</link> pour la liste complete des proprietes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure(1)
g = figure(2)
h = figure(3)
figure(g)
gcf()
figure('Name', 'Hello')
]]></example_item_data>
    </example_item>
  </examples>
