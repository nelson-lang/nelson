  <language>fr_FR</language>
  <keyword>uidropdown</keyword>
  <short_description>Crée une liste déroulante.</short_description>
  <syntax>
    <syntax_item>h = uidropdown()</syntax_item>
    <syntax_item>h = uidropdown(parent)</syntax_item>
    <syntax_item>h = uidropdown(..., propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>conteneur parent.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName, propertyValue</param_name>
      <param_description>paires nom-valeur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>objet composant UI.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>dd = uidropdown</b> crée une liste déroulante. <b>Items</b> contient les entrées affichées ; <b>ItemsData</b> associe optionnellement une valeur de données retournée par <b>Value</b>. <b>ValueIndex</b> est l'indice (base 1) de la sélection. <b>Editable</b> 'on' permet la saisie libre. Callback <b>ValueChangedFcn</b> (event : <b>Value</b>, <b>PreviousValue</b>, <b>Edited</b>, <b>ValueIndex</b>, <b>PreviousValueIndex</b>).</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture du composant UI pour l'image d'aide.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = uifigure('Visible', 'off', 'Name', 'Drop down', 'Position', [100 100 420 260]);
dd = uidropdown(f, 'Items', {'Small', 'Medium', 'Large'}, 'Position', [125 115 170 24]);
dd.Value = 'Medium';
drawnow();]]></example_item_data>
      <example_item_img
        src="../../../../images/uidropdown_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>

    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>uidropdown</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[
f = uifigure();
dd = uidropdown(f, 'Items', {'Rouge', 'Vert', 'Bleu'}, 'ItemsData', [1 2 3]);
dd.Value = 2;
]]></example_item_data>
    </example_item>
  </examples>
