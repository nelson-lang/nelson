  <language>fr_FR</language>
  <keyword>uislider</keyword>
  <short_description>Crée un curseur (slider) ou un curseur de plage.</short_description>
  <syntax>
    <syntax_item>h = uislider()</syntax_item>
    <syntax_item>h = uislider(parent)</syntax_item>
    <syntax_item>h = uislider(..., propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>parent container.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName, propertyValue</param_name>
      <param_description>name-value pairs.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>UI component object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>sld = uislider</b> crée un curseur ; <b>uislider(parent, 'range')</b> crée un curseur de plage dont la <b>Value</b> est un vecteur à deux éléments. Propriétés : <b>Value</b>, <b>Limits</b>, <b>Orientation</b>, <b>MajorTicks</b>/<b>MinorTicks</b>/<b>MajorTickLabels</b> avec modes auto/manuel, <b>Step</b>/<b>StepMode</b>, <b>ValueChangedFcn</b>, <b>ValueChangingFcn</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture du composant UI pour l'image d'aide.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = uifigure('Visible', 'off', 'Name', 'Slider', 'Position', [100 100 520 300]);
sld = uislider(f, 'Position', [90 165 300 30]);
sld.Value = 42;
rs = uislider(f, 'range');
rs.Position = [90 95 300 30];
rs.Value = [20 70];
drawnow();]]></example_item_data>
      <example_item_img
        src="../../../../images/uislider_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>

    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>uislider</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[
f = uifigure();
sld = uislider(f, 'Limits', [0 10], 'Value', 4);
rs = uislider(f, 'range', 'Value', [20 60]);
]]></example_item_data>
    </example_item>
  </examples>
