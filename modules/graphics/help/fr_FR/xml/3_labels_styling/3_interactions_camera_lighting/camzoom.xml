  <language>fr_FR</language>
  <keyword>camzoom</keyword>
  <short_description>Zoome la caméra en avant ou en arrière.</short_description>
  <syntax>
    <syntax_item>camzoom(zf)</syntax_item>
    <syntax_item>camzoom(ax, zf)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Un objet graphique scalaire : des axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>zf</param_name>
      <param_description>Le facteur de zoom, un scalaire réel positif. Une valeur supérieure à 1 zoome en avant, une valeur inférieure à 1 zoome en arrière.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>camzoom</b> zoome la caméra en divisant la tangente de la moitié de
    <b>CameraViewAngle</b> par le facteur de zoom, la scène apparaît donc <b>zf</b>
    fois plus grande, et bascule <b>CameraViewAngleMode</b> en <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camproj('perspective');
camzoom(2);]]></example_item_data>
    </example_item>
  </examples>
