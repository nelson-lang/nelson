  <language>fr_FR</language>
  <keyword>camroll</keyword>
  <short_description>Fait rouler la caméra autour de l'axe de visée.</short_description>
  <syntax>
    <syntax_item>camroll(dtheta)</syntax_item>
    <syntax_item>camroll(ax, dtheta)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Un objet graphique scalaire : des axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dtheta</param_name>
      <param_description>L'angle de roulis en degrés.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>camroll</b> fait tourner le <b>CameraUpVector</b> autour de la droite
    joignant la position et la cible de la caméra, faisant rouler la vue de
    l'angle indiqué.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camroll(30);]]></example_item_data>
    </example_item>
  </examples>
