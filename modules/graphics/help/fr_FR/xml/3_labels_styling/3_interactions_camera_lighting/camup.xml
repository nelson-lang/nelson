  <language>fr_FR</language>
  <keyword>camup</keyword>
  <short_description>Définit ou interroge le vecteur vertical de la caméra.</short_description>
  <syntax>
    <syntax_item>camup</syntax_item>
    <syntax_item>u = camup</syntax_item>
    <syntax_item>camup([x y z])</syntax_item>
    <syntax_item>camup('auto')</syntax_item>
    <syntax_item>camup('manual')</syntax_item>
    <syntax_item>mode = camup('mode')</syntax_item>
    <syntax_item>camup(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Un objet graphique scalaire : des axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>[x y z]</param_name>
      <param_description>Le vecteur vertical de la caméra, spécifié comme un vecteur à trois éléments.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>u</param_name>
      <param_description>Le vecteur vertical actuel de la caméra, un vecteur à trois éléments.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>camup</b> définit ou interroge la propriété <b>CameraUpVector</b> d'un axes.</p>
    <p>Spécifier un vecteur vertical bascule <b>CameraUpVectorMode</b> en <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camup([0 0 1]);
u = camup()]]></example_item_data>
    </example_item>
  </examples>
