  <language>fr_FR</language>
  <keyword>lighting</keyword>
  <short_description>Definit le mode d'eclairage des surfaces et patchs.</short_description>
  <syntax>
    <syntax_item>lighting(type)</syntax_item>
    <syntax_item>lighting(ax, type)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes cible.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>type</param_name>
      <param_description><b>none</b>, <b>flat</b> ou <b>gouraud</b>.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>lighting</b> definit <b>FaceLighting</b> et <b>EdgeLighting</b> pour les surfaces et patchs des axes.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[
surf(peaks(30), 'EdgeColor', 'none');
light();
lighting gouraud;
]]></example_item_data>
      <example_item_img src="../../../../images/lighting_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
