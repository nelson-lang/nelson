  <language>fr_FR</language>
  <keyword>campan</keyword>
  <short_description>Fait pivoter la cible de la caméra autour de la position.</short_description>
  <syntax>
    <syntax_item>campan(dtheta, dphi)</syntax_item>
    <syntax_item>campan(dtheta, dphi, coordsys)</syntax_item>
    <syntax_item>campan(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Un objet graphique scalaire : des axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dtheta</param_name>
      <param_description>Rotation horizontale en degrés.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dphi</param_name>
      <param_description>Rotation verticale en degrés.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>coordsys</param_name>
      <param_description>'data' (par défaut, rotation horizontale autour de l'axe z) ou 'camera' (rotation horizontale autour du vecteur vertical de la caméra).</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>campan</b> fait tourner la cible de la caméra autour de la position de
    la caméra, en conservant la distance caméra-cible constante. Cela change la
    direction visée par la caméra sans déplacer la caméra elle-même.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camproj('perspective');
campan(10, 0);]]></example_item_data>
    </example_item>
  </examples>
