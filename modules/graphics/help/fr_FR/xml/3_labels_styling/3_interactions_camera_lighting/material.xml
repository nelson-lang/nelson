  <language>fr_FR</language>
  <keyword>material</keyword>
  <short_description>Definit les proprietes de materiau.</short_description>
  <syntax>
    <syntax_item>material(name)</syntax_item>
    <syntax_item>material(ax, name)</syntax_item>
    <syntax_item>material(values)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>name</param_name>
      <param_description><b>default</b>, <b>shiny</b>, <b>dull</b> ou <b>metal</b>.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>Quatre ou cinq coefficients de materiau.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>material</b> modifie les coefficients ambiant, diffus, speculaire, exposant et reflectance.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[
surf(peaks(30), 'EdgeColor', 'none', 'FaceLighting', 'gouraud');
light('Position', [1 -1 1]);
lighting gouraud;
material('metal');
view(35, 28);
]]></example_item_data>
      <example_item_img src="../../../../images/material_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
