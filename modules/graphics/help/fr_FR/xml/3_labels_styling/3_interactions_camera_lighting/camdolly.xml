  <language>fr_FR</language>
  <keyword>camdolly</keyword>
  <short_description>Déplace la position et la cible de la caméra.</short_description>
  <syntax>
    <syntax_item>camdolly(dx, dy, dz)</syntax_item>
    <syntax_item>camdolly(dx, dy, dz, coordsys)</syntax_item>
    <syntax_item>camdolly(dx, dy, dz, coordsys, units)</syntax_item>
    <syntax_item>camdolly(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Un objet graphique scalaire : des axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dx, dy, dz</param_name>
      <param_description>Le déplacement le long de chaque axe du système de coordonnées choisi.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>coordsys</param_name>
      <param_description>'camera' (par défaut : dx vers la droite, dy vers le haut, dz le long de la direction de visée) ou 'data' (axes du monde).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>units</param_name>
      <param_description>'normalized' (par défaut : relatif à la distance caméra-cible) ou 'data'.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>camdolly</b> déplace la position et la cible de la caméra de la même
    quantité, faisant glisser la vue à travers la scène.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camproj('perspective');
camdolly(0.2, 0, 0);]]></example_item_data>
    </example_item>
  </examples>
