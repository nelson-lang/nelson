  <keyword>camva</keyword>
  <short_description>Définit ou interroge l'angle de vue de la caméra.</short_description>
  <syntax>
    <syntax_item>camva</syntax_item>
    <syntax_item>a = camva</syntax_item>
    <syntax_item>camva(angle)</syntax_item>
    <syntax_item>camva('auto')</syntax_item>
    <syntax_item>camva('manual')</syntax_item>
    <syntax_item>mode = camva('mode')</syntax_item>
    <syntax_item>camva(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Un objet graphique scalaire : des axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>angle</param_name>
      <param_description>L'angle de vue de la caméra en degrés, un scalaire réel dans l'intervalle (0, 180).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>a</param_name>
      <param_description>L'angle de vue actuel de la caméra en degrés.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>camva</b> définit ou interroge la propriété <b>CameraViewAngle</b> d'un axes.</p>
    <p>L'angle de vue est le champ de vision de la caméra : un angle plus grand
    fait paraître la scène plus petite. Avec une projection en perspective, il
    contrôle l'intensité de l'effet de perspective. Spécifier un angle bascule
    <b>CameraViewAngleMode</b> en <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camproj('perspective');
camva(30);]]></example_item_data>
    </example_item>
  </examples>
