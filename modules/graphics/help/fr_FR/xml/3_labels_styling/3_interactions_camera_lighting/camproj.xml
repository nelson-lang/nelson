  <keyword>camproj</keyword>
  <short_description>Définit ou interroge le type de projection de la caméra.</short_description>
  <syntax>
    <syntax_item>camproj</syntax_item>
    <syntax_item>p = camproj</syntax_item>
    <syntax_item>camproj('orthographic')</syntax_item>
    <syntax_item>camproj('perspective')</syntax_item>
    <syntax_item>camproj(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Un objet graphique scalaire : des axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>type</param_name>
      <param_description>Le type de projection : 'orthographic' ou 'perspective'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>Le type de projection actuel.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>camproj</b> définit ou interroge la propriété <b>Projection</b> d'un axes.</p>
    <p>Une projection <b>orthographic</b> conserve les lignes parallèles
    parallèles et une taille apparente indépendante de la distance. Une projection
    <b>perspective</b> ajoute l'effet de perspective : les objets plus éloignés de
    la caméra paraissent plus petits.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camproj('perspective');
p = camproj()]]></example_item_data>
    </example_item>
  </examples>
