  <language>fr_FR</language>
  <keyword>camlight</keyword>
  <short_description>Cree ou positionne une lumiere par rapport a la camera.</short_description>
  <syntax>
    <syntax_item>camlight()</syntax_item>
    <syntax_item>camlight('headlight')</syntax_item>
    <syntax_item>camlight('left')</syntax_item>
    <syntax_item>camlight('right')</syntax_item>
    <syntax_item>camlight(az, el)</syntax_item>
    <syntax_item>go = camlight(...)</syntax_item>
  </syntax>
  <description>
    <p><b>camlight</b> place une lumiere infinie depuis la camera courante ou une position angulaire.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[
surf(peaks(30), 'EdgeColor', 'none', 'FaceLighting', 'gouraud');
camlight('headlight');
material('shiny');
view(35, 28);
]]></example_item_data>
      <example_item_img src="../../../../images/camlight_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
