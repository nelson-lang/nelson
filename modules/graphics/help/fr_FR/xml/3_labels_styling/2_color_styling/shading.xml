  <language>fr_FR</language>
  <keyword>shading</keyword>
  <short_description>Definit le mode d'ombrage des surfaces et patchs.</short_description>
  <syntax>
    <syntax_item>shading(type)</syntax_item>
    <syntax_item>shading(ax, type)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes cible.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>type</param_name>
      <param_description><b>faceted</b>, <b>flat</b> ou <b>interp</b>.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>shading</b> modifie <b>FaceColor</b> et <b>EdgeColor</b> pour les surfaces et patchs des axes.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[
surf(peaks(20));
shading interp;
]]></example_item_data>
      <example_item_img src="../../../../images/shading_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
