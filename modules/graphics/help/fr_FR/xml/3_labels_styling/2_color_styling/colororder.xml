  <language>fr_FR</language>
  <keyword>colororder</keyword>
  <short_description>Definir ou interroger l'ordre des couleurs des axes.</short_description>
  <syntax>
    <syntax_item>colororder(colors)</syntax_item>
    <syntax_item>colororder(name)</syntax_item>
    <syntax_item>colororder(ax, ...)</syntax_item>
    <syntax_item>colors = colororder</syntax_item>
    <syntax_item>colors = colororder(ax)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>colors</param_name>
      <param_description>matrice numerique reelle n-par-3 contenant des valeurs de couleurs RGB.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>ordre de couleurs nomme : 'default', 'gem', 'glow', 'sail', 'reef', 'meadow', 'dye' ou 'earth'.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>objet axes cible. S'il est omis, les axes courants sont utilises.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>colors</param_name>
      <param_description>ordre des couleurs courant des axes, sous forme de matrice RGB n-par-3.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>colororder</b> definit ou interroge la propriete <b>ColorOrder</b> des axes.</p>
    <p>Definir un ordre de couleurs remet <b>ColorOrderIndex</b> a 1. Les objets bar dont la couleur de face est automatique sont mis a jour avec le nouvel ordre.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Utiliser un ordre de couleurs nomme pour des barres groupees.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
colororder('reef');
bar([1 3 5; 2 4 6; 3 5 7]);
]]></example_item_data>
      <example_item_img src="../../../../images/colororder_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Definir un ordre de couleurs RGB personnalise.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
ax = axes('Parent', f);
colororder(ax, [0.8 0.1 0.1; 0.1 0.5 0.9; 0.2 0.7 0.2]);
y = [1:5; 2:6; 3:7]';
plot(ax, 1:5, y);
]]></example_item_data>
      <example_item_img src="../../../../images/colororder_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
