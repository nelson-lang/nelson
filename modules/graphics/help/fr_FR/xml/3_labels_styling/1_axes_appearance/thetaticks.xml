  <keyword>thetaticks</keyword>
  <short_description>Définit ou retourne les graduations angulaires des axes polaires.</short_description>
  <syntax>
    <syntax_item>ticks = thetaticks()</syntax_item>
    <syntax_item>thetaticks(values)</syntax_item>
    <syntax_item>thetaticks(&apos;auto&apos;)</syntax_item>
    <syntax_item>thetaticks(&apos;manual&apos;)</syntax_item>
    <syntax_item>m = thetaticks(&apos;mode&apos;)</syntax_item>
    <syntax_item>thetaticks(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>Vecteur numérique de valeurs de graduation angulaire en degrés.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;auto&apos;</param_name>
      <param_description>Active la sélection automatique des graduations et étiquettes angulaires.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;manual&apos;</param_name>
      <param_description>Conserve les valeurs courantes de graduations angulaires.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;mode&apos;</param_name>
      <param_description>Retourne le mode des graduations angulaires.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes polaire cible.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ticks</param_name>
      <param_description>Vecteur ligne numérique de valeurs de graduation angulaire en degrés.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>&apos;auto&apos; ou &apos;manual&apos;.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>thetaticks</b> retourne ou définit les valeurs des graduations angulaires de l&apos;axes polaire courant. Les valeurs sont exprimées en degrés.</p>
    <p>La définition de valeurs numériques passe le mode a <b>manual</b>. Si les étiquettes angulaires sont en mode automatique, elles sont régénérées depuis les nouvelles valeurs.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Définir les graduations angulaires.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
polarplot(linspace(0, 2*pi, 80), ones(1, 80));
thetaticks(0:45:360);
ticks = thetaticks()
]]></example_item_data>
    </example_item>
  </examples>
