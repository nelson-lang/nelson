  <keyword>rlim</keyword>
  <short_description>Definit ou retourne les limites radiales des axes polaires.</short_description>
  <syntax>
    <syntax_item>lims = rlim()</syntax_item>
    <syntax_item>rlim([rmin, rmax])</syntax_item>
    <syntax_item>rlim(&apos;auto&apos;)</syntax_item>
    <syntax_item>rlim(&apos;manual&apos;)</syntax_item>
    <syntax_item>m = rlim(&apos;mode&apos;)</syntax_item>
    <syntax_item>rlim(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>[rmin, rmax]</param_name>
      <param_description>Vecteur a deux elements. La seconde valeur doit etre superieure a la premiere.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;auto&apos;</param_name>
      <param_description>Active la selection automatique des limites radiales a partir des donnees tracees.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;manual&apos;</param_name>
      <param_description>Conserve les limites radiales courantes jusqu&apos;a modification explicite.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;mode&apos;</param_name>
      <param_description>Retourne le mode courant des limites radiales.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes polaire cible.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>lims</param_name>
      <param_description>Vecteur a deux elements : [rmin, rmax].</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>&apos;auto&apos; ou &apos;manual&apos;.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>rlim</b> retourne ou definit les limites radiales de l&apos;axes polaire courant.</p>
    <p>La definition de limites numeriques passe le mode radial a <b>manual</b>. Le mode <b>auto</b> recalcule les limites lors du rafraichissement de l&apos;axes polaire.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Definir les limites radiales.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
theta = linspace(0, 2*pi, 100);
polarplot(theta, 2 + sin(theta));
rlim([0 3]);
currentLimits = rlim()
currentMode = rlim('mode')
]]></example_item_data>
    </example_item>
  </examples>
