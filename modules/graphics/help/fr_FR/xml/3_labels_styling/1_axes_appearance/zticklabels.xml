  <language>fr_FR</language>
  <keyword>zticklabels</keyword>
  <short_description>Definir ou obtenir les etiquettes de l'axe des z.</short_description>
  <syntax>
    <syntax_item>labels = zticklabels()</syntax_item>
    <syntax_item>zticklabels(labels)</syntax_item>
    <syntax_item>zticklabels(&apos;auto&apos;)</syntax_item>
    <syntax_item>zticklabels(&apos;manual&apos;)</syntax_item>
    <syntax_item>m = zticklabels(&apos;mode&apos;)</syntax_item>
    <syntax_item>zticklabels(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>labels</param_name>
      <param_description>Tableau de cellules de chaines ou tableau de chaines des etiquettes de l'axe des z.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;auto&apos;</param_name>
      <param_description>Active les etiquettes automatiques de l'axe des z.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;manual&apos;</param_name>
      <param_description>Fige les etiquettes courantes de l'axe des z.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;mode&apos;</param_name>
      <param_description>Retourne le mode des etiquettes de l'axe des z.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes cibles. Par defaut, les axes courants.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>labels</param_name>
      <param_description>Tableau de cellules de chaines des etiquettes de l'axe des z.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>&apos;auto&apos; ou &apos;manual&apos;.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>zticklabels</b> obtient ou definit les etiquettes de l'axe des z des axes courants.</p>
    <p>Specifier des etiquettes bascule le mode des etiquettes de l'axe des z sur <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Definir les etiquettes de l'axe des z.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
t = linspace(0, 10, 50);
plot3(sin(t), cos(t), t);
zticks([0 5 10]);
zticklabels({'low','mid','high'});
labels = zticklabels()
]]></example_item_data>
    </example_item>
  </examples>
