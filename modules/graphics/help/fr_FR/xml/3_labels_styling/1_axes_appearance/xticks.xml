  <keyword>xticks</keyword>
  <short_description>Definir ou obtenir les graduations de l'axe des x.</short_description>
  <syntax>
    <syntax_item>ticks = xticks()</syntax_item>
    <syntax_item>xticks(values)</syntax_item>
    <syntax_item>xticks(&apos;auto&apos;)</syntax_item>
    <syntax_item>xticks(&apos;manual&apos;)</syntax_item>
    <syntax_item>m = xticks(&apos;mode&apos;)</syntax_item>
    <syntax_item>xticks(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>Vecteur numerique des graduations de l'axe des x.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;auto&apos;</param_name>
      <param_description>Active la selection automatique des graduations de l'axe des x.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;manual&apos;</param_name>
      <param_description>Fige les graduations courantes de l'axe des x.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;mode&apos;</param_name>
      <param_description>Retourne le mode des graduations de l'axe des x.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes cibles. Par defaut, les axes courants.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ticks</param_name>
      <param_description>Vecteur ligne numerique des graduations de l'axe des x.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>&apos;auto&apos; ou &apos;manual&apos;.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>xticks</b> obtient ou definit les graduations de l'axe des x des axes courants.</p>
    <p>Specifier des graduations bascule le mode des graduations de l'axe des x sur <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Definir les graduations de l'axe des x.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
x = linspace(0, 10, 50);
plot(x, sin(x));
xticks(0:2:10);
ticks = xticks()
]]></example_item_data>
    </example_item>
  </examples>
