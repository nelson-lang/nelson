  <language>en_US</language>
  <keyword>rotate</keyword>
  <short_description>Rotate graphics objects about an axis.</short_description>
  <syntax>
    <syntax_item>rotate(h, direction, alpha)</syntax_item>
    <syntax_item>rotate(h, direction, alpha, origin)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>h</param_name>
      <param_description>a graphics object or an array of objects with XData/YData(/ZData).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>direction</param_name>
      <param_description
      >the rotation axis: a three-element vector [x y z], or a two-element [azimuth elevation] in degrees.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>the rotation angle in degrees.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>origin</param_name>
      <param_description
      >the center of rotation (default: the center of the axes plot box).</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>rotate</b> rotates the graphics objects <b>h</b> by <b>alpha</b> degrees
      about the axis given by <b>direction</b>, passing through <b>origin</b>. The
      object data is transformed in place.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
s = surf(peaks(20));
rotate(s, [0 0 1], 45);]]></example_item_data>
    </example_item>
  </examples>
