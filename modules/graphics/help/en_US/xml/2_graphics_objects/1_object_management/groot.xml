  <language>en_US</language>
  <keyword>groot</keyword>
  <short_description>graphic root object.</short_description>
  <syntax>
    <syntax_item>g = groot()</syntax_item>
  </syntax>
  <param_output>
    <param_output_item>
      <param_name>g</param_name>
      <param_description>a graphics object: root object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>groot</b> returns the graphics root object.</p>
    <p>See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.groot.properties">groot properties</link> for the complete property list.</p><p>
      Root defaults can be set with names of the form <b>Default</b><i>Object</i><i>Property</i>. For example, <b>set(groot(), &apos;DefaultFigureColormap&apos;, cmap)</b> changes the colormap used by new figures. Use the value <b>&apos;remove&apos;</b> to restore the factory default.</p>
  </description>
  <used_function />
  <bibliography />
