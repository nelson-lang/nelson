    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[g = groot()
g.ScreenDepth]]></example_item_data>
    </example_item>
  </examples>
