  <language>en_US</language>
  <keyword>getappdata</keyword>
  <short_description>Retrieve application-defined data from an object.</short_description>
  <syntax>
    <syntax_item>value = getappdata(h, name)</syntax_item>
    <syntax_item>s = getappdata(h)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>h</param_name><param_description>a graphics object.</param_description></param_input_item>
    <param_input_item><param_name>name</param_name><param_description>a string: the data name.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>value</param_name><param_description>the stored value, or [] if the name is not set.</param_description></param_output_item>
    <param_output_item><param_name>s</param_name><param_description>a structure of all application data when no name is given.</param_description></param_output_item>
  </param_output>
  <description><p><b>getappdata</b> returns the application-defined data named <b>name</b> stored on <b>h</b>, or all of it as a structure when <b>name</b> is omitted.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="adv-cli"><![CDATA[f = figure();
setappdata(gca, 'state', 42);
getappdata(gca, 'state')]]></example_item_data></example_item></examples>
