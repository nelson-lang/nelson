  <language>en_US</language>
  <keyword>shg</keyword>
  <short_description>Show the current graph window.</short_description>
  <syntax>
    <syntax_item>shg</syntax_item>
    <syntax_item>shg()</syntax_item>
  </syntax>
  <description>
    <p><b>shg</b> brings the current figure forward, creating one if none
      exists. It is equivalent to <b>figure(gcf)</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
plot(1:10);
shg]]></example_item_data>
    </example_item>
  </examples>
