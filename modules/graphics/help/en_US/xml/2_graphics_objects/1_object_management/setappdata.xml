  <keyword>setappdata</keyword>
  <short_description>Store application-defined data on an object.</short_description>
  <syntax><syntax_item>setappdata(h, name, value)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>h</param_name><param_description>a graphics object.</param_description></param_input_item>
    <param_input_item><param_name>name</param_name><param_description>a string: the data name.</param_description></param_input_item>
    <param_input_item><param_name>value</param_name><param_description>any value to store.</param_description></param_input_item>
  </param_input>
  <description><p><b>setappdata</b> stores the named <b>value</b> as application-defined data on the object <b>h</b>, retrievable with <b>getappdata</b>.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="adv-cli"><![CDATA[f = figure();
setappdata(gca, 'state', 42);
getappdata(gca, 'state')]]></example_item_data></example_item></examples>
