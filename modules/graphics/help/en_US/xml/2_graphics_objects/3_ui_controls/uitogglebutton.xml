  <language>en_US</language>
  <keyword>uitogglebutton</keyword>
  <short_description>Create toggle button in a button group.</short_description>
  <syntax>
    <syntax_item>h = uitogglebutton()</syntax_item>
    <syntax_item>h = uitogglebutton(parent)</syntax_item>
    <syntax_item>h = uitogglebutton(..., propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>parent container.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName, propertyValue</param_name>
      <param_description>name-value pairs.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>UI component object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tb = uitogglebutton(bg)</b> creates a toggle button inside a uibuttongroup with exclusive selection. Properties: <b>Value</b>, <b>Text</b>, <b>Icon</b>, <b>IconAlignment</b>, alignments, <b>BackgroundColor</b>, fonts.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Captured UI component for the help image.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = uifigure('Visible', 'off', 'Name', 'Toggle buttons', 'Position', [100 100 420 260]);
bg = uibuttongroup(f, 'Position', [95 60 230 140]);
tb1 = uitogglebutton(bg, 'Text', 'A', 'Position', [30 70 70 30]);
tb2 = uitogglebutton(bg, 'Text', 'B', 'Position', [125 70 70 30]);
tb2.Value = true;
drawnow();]]></example_item_data>
      <example_item_img
        src="../../../../images/uitogglebutton_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>

    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>uitogglebutton</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[
f = uifigure();
bg = uibuttongroup(f);
tb1 = uitogglebutton(bg, 'Text', 'A');
tb2 = uitogglebutton(bg, 'Text', 'B');
]]></example_item_data>
    </example_item>
  </examples>
