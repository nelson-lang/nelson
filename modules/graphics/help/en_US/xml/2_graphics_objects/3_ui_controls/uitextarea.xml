  <language>en_US</language>
  <keyword>uitextarea</keyword>
  <short_description>Create text area component.</short_description>
  <syntax>
    <syntax_item>h = uitextarea()</syntax_item>
    <syntax_item>h = uitextarea(parent)</syntax_item>
    <syntax_item>h = uitextarea(..., propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>parent container.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName, propertyValue</param_name>
      <param_description>name-value pairs.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>UI component object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ta = uitextarea</b> creates a multi-line text area. <b>Value</b> is a cell array of character vectors (one per line). Properties: <b>Editable</b>, <b>WordWrap</b>, <b>HorizontalAlignment</b>, <b>Placeholder</b>, <b>ValueChangedFcn</b>, <b>ValueChangingFcn</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Captured UI component for the help image.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = uifigure('Visible', 'off', 'Name', 'Text area', 'Position', [100 100 420 260]);
ta = uitextarea(f, 'Position', [95 75 230 115]);
ta.Value = {'Line one'; 'Line two'; 'Line three'};
drawnow();]]></example_item_data>
      <example_item_img
        src="../../../../images/uitextarea_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>

    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>uitextarea</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[
f = uifigure();
ta = uitextarea(f, 'Value', {'first line', 'second line'});
]]></example_item_data>
    </example_item>
  </examples>
