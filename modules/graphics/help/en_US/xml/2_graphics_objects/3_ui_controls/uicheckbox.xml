  <language>en_US</language>
  <keyword>uicheckbox</keyword>
  <short_description>Create check box component.</short_description>
  <syntax>
    <syntax_item>h = uicheckbox()</syntax_item>
    <syntax_item>h = uicheckbox(parent)</syntax_item>
    <syntax_item>h = uicheckbox(..., propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>parent container.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName, propertyValue</param_name>
      <param_description>name-value pairs.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>UI component object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>cbx = uicheckbox</b> creates a check box with a logical <b>Value</b>, a <b>Text</b> label, <b>WordWrap</b>, fonts and a <b>ValueChangedFcn</b> callback (event data: <b>Value</b>, <b>PreviousValue</b>).</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Captured UI component for the help image.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = uifigure('Visible', 'off', 'Name', 'Check box', 'Position', [100 100 420 260]);
cb = uicheckbox(f, 'Text', 'Enable alerts', 'Value', true, 'Position', [130 120 170 24]);
drawnow();]]></example_item_data>
      <example_item_img
        src="../../../../images/uicheckbox_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>

    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>uicheckbox</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[
f = uifigure();
cbx = uicheckbox(f, 'Text', 'Accept', 'Value', true, 'ValueChangedFcn', @(s, e) disp(e.Value));
]]></example_item_data>
    </example_item>
  </examples>
