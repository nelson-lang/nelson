  <language>en_US</language>
  <keyword>uitreenode</keyword>
  <short_description>Create tree node.</short_description>
  <syntax>
    <syntax_item>h = uitreenode()</syntax_item>
    <syntax_item>h = uitreenode(parent)</syntax_item>
    <syntax_item>h = uitreenode(..., propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>parent object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName, propertyValue</param_name>
      <param_description>name-value pairs.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>UI object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>n = uitreenode(parent)</b> creates a tree node in a uitree or under another TreeNode. Properties: <b>Text</b>, <b>NodeData</b>, <b>Icon</b>, <b>ContextMenu</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Captured UI component for the help image.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = uifigure('Visible', 'off', 'Name', 'Tree nodes', 'Position', [100 100 420 260]);
tr = uitree(f, 'Position', [70 40 210 180]);
n1 = uitreenode(tr, 'Text', 'Project');
uitreenode(n1, 'Text', 'Input');
uitreenode(n1, 'Text', 'Results');
expand(tr);
drawnow();]]></example_item_data>
      <example_item_img
        src="../../../../images/uitreenode_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>

    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>uitreenode</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[
f = uifigure();
t = uitree(f);
n = uitreenode(t, 'Text', 'Node 1', 'NodeData', [1 2 3]);
]]></example_item_data>
    </example_item>
  </examples>
