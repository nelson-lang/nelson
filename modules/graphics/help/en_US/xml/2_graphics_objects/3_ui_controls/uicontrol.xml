  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Pushbutton</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[
f = figure;
b = uicontrol(f,Style='pushbutton', String='Click Me', Position=[100 100 60 30], Callback='disp(''Hello World!'')')
]]></example_item_data>
