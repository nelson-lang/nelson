  <language>en_US</language>
  <keyword>uiknob</keyword>
  <short_description>Create knob or discrete knob component.</short_description>
  <syntax>
    <syntax_item>h = uiknob()</syntax_item>
    <syntax_item>h = uiknob(parent)</syntax_item>
    <syntax_item>h = uiknob(..., propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>parent container.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName, propertyValue</param_name>
      <param_description>name-value pairs.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>UI component object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>kb = uiknob</b> creates a continuous knob (<b>Value</b>/<b>Limits</b>/ticks/<b>ValueChangingFcn</b>); <b>uiknob(parent, 'discrete')</b> creates a discrete knob using <b>Items</b>/<b>ItemsData</b>/<b>ValueIndex</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Captured UI component for the help image.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = uifigure('Visible', 'off', 'Name', 'Knobs', 'Position', [100 100 620 360]);
kb = uiknob(f);
kb.Position = [70 90 170 170];
kb.Value = 55;
dk = uiknob(f, 'discrete');
dk.Position = [310 70 260 220];
dk.Value = 'Medium';
drawnow();]]></example_item_data>
      <example_item_img
        src="../../../../images/uiknob_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>

    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>uiknob</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[
f = uifigure();
kb = uiknob(f, 'Value', 30);
dk = uiknob(f, 'discrete', 'Items', {'Low', 'High'});
]]></example_item_data>
    </example_item>
  </examples>
