  <language>en_US</language>
  <keyword>thetalim</keyword>
  <short_description>Set or get angular limits for polar axes.</short_description>
  <syntax>
    <syntax_item>lims = thetalim()</syntax_item>
    <syntax_item>thetalim([thetamin, thetamax])</syntax_item>
    <syntax_item>thetalim(&apos;auto&apos;)</syntax_item>
    <syntax_item>thetalim(&apos;manual&apos;)</syntax_item>
    <syntax_item>m = thetalim(&apos;mode&apos;)</syntax_item>
    <syntax_item>thetalim(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>[thetamin, thetamax]</param_name>
      <param_description>Two-element vector of angular limits in degrees. The second value must be greater than the first value.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;auto&apos;</param_name>
      <param_description>Use automatic angular limits, currently [0 360].</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;manual&apos;</param_name>
      <param_description>Keep the current angular limits.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;mode&apos;</param_name>
      <param_description>Return the angular limits mode.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Target polar axes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>lims</param_name>
      <param_description>Two-element vector of angular limits in degrees.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>&apos;auto&apos; or &apos;manual&apos;.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>thetalim</b> gets or sets angular limits for the current polar axes. Unlike <b>polarplot</b> data angles, angular limits are expressed in degrees.</p>
    <p>Setting numeric angular limits switches angular limit mode to <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Display only the upper half of a polar plot.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
theta = linspace(0, pi, 100);
polarplot(theta, sin(theta));
thetalim([0 180]);
lims = thetalim()
]]></example_item_data>
    </example_item>
  </examples>
