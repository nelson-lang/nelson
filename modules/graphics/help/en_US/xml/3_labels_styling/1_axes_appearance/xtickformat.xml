  <language>en_US</language>
  <keyword>xtickformat</keyword>
  <short_description>Set or get the x-axis tick label format.</short_description>
  <syntax>
    <syntax_item>xtickformat(fmt)</syntax_item>
    <syntax_item>fmt = xtickformat()</syntax_item>
    <syntax_item>xtickformat(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>fmt</param_name>
      <param_description>Format specifier: a sprintf-style conversion or a preset keyword.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Target axes. Default is the current axes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>fmt</param_name>
      <param_description>Current tick label format.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>xtickformat</b> sets or gets the format used for the x-axis tick labels of the current axes.</p>
    <p>The format applies to automatically generated tick labels.</p>
    <p>The format is a sprintf-style conversion (for example <b>%.2f</b> or <b>%g</b>) applied to each numeric tick value. The preset keywords <b>usd</b>, <b>eur</b>, <b>gbp</b>, <b>jpy</b>, <b>degrees</b> and <b>percentage</b> are also accepted. Custom tick labels set with xticklabels take precedence over the format.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Format x-axis tick labels.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
plot(1:10, (1:10) / 4);
xtickformat('%.2f');
]]></example_item_data>
    </example_item>
  </examples>
