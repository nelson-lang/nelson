  <language>en_US</language>
  <keyword>rticks</keyword>
  <short_description>Set or get radial tick values for polar axes.</short_description>
  <syntax>
    <syntax_item>ticks = rticks()</syntax_item>
    <syntax_item>rticks(values)</syntax_item>
    <syntax_item>rticks(&apos;auto&apos;)</syntax_item>
    <syntax_item>rticks(&apos;manual&apos;)</syntax_item>
    <syntax_item>m = rticks(&apos;mode&apos;)</syntax_item>
    <syntax_item>rticks(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>Numeric vector of radial tick values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;auto&apos;</param_name>
      <param_description>Enable automatic radial tick selection and automatic radial tick labels.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;manual&apos;</param_name>
      <param_description>Keep current radial tick values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;mode&apos;</param_name>
      <param_description>Return the radial tick mode.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Target polar axes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ticks</param_name>
      <param_description>Numeric row vector of radial tick values.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>&apos;auto&apos; or &apos;manual&apos;.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>rticks</b> gets or sets radial tick values on the current polar axes.</p>
    <p>Setting numeric tick values switches radial tick mode to <b>manual</b>. If radial tick labels are in automatic mode, labels are regenerated from the new values.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Set radial ticks.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
polarplot(linspace(0, 2*pi, 80), linspace(0, 4, 80));
rticks([0 1 2 3 4]);
ticks = rticks()
]]></example_item_data>
    </example_item>
  </examples>
