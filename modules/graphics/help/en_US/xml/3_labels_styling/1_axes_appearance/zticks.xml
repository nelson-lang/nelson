  <language>en_US</language>
  <keyword>zticks</keyword>
  <short_description>Set or get z-axis tick values.</short_description>
  <syntax>
    <syntax_item>ticks = zticks()</syntax_item>
    <syntax_item>zticks(values)</syntax_item>
    <syntax_item>zticks(&apos;auto&apos;)</syntax_item>
    <syntax_item>zticks(&apos;manual&apos;)</syntax_item>
    <syntax_item>m = zticks(&apos;mode&apos;)</syntax_item>
    <syntax_item>zticks(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>Numeric vector of z-axis tick values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;auto&apos;</param_name>
      <param_description>Enable automatic z-tick selection.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;manual&apos;</param_name>
      <param_description>Freeze the current z-tick values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;mode&apos;</param_name>
      <param_description>Return the z-tick mode.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Target axes. Default is the current axes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ticks</param_name>
      <param_description>Numeric row vector of z-axis tick values.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>&apos;auto&apos; or &apos;manual&apos;.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>zticks</b> gets or sets the tick values along the z-axis of the current axes.</p>
    <p>Specifying tick values switches the z-tick mode to <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Set z-axis ticks.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
t = linspace(0, 10, 50);
plot3(sin(t), cos(t), t);
zticks(0:2:10);
ticks = zticks()
]]></example_item_data>
    </example_item>
  </examples>
