  <language>en_US</language>
  <keyword>thetaticklabels</keyword>
  <short_description>Set or get angular tick labels for polar axes.</short_description>
  <syntax>
    <syntax_item>labels = thetaticklabels()</syntax_item>
    <syntax_item>thetaticklabels(labels)</syntax_item>
    <syntax_item>thetaticklabels(&apos;auto&apos;)</syntax_item>
    <syntax_item>thetaticklabels(&apos;manual&apos;)</syntax_item>
    <syntax_item>m = thetaticklabels(&apos;mode&apos;)</syntax_item>
    <syntax_item>thetaticklabels(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>labels</param_name>
      <param_description>Cell array, string array, character vector, or numeric values converted to labels.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;auto&apos;</param_name>
      <param_description>Generate angular tick labels from angular tick values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;manual&apos;</param_name>
      <param_description>Keep current angular tick labels.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;mode&apos;</param_name>
      <param_description>Return the angular tick label mode.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Target polar axes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>labels</param_name>
      <param_description>Cell array of angular tick labels.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>&apos;auto&apos; or &apos;manual&apos;.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>thetaticklabels</b> gets or sets labels displayed next to angular ticks.</p>
    <p>Setting labels switches angular tick label mode to <b>manual</b>. The number of displayed labels is matched with the number of visible angular ticks.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Set custom angular labels.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
polarplot(linspace(0, 2*pi, 80), ones(1, 80));
thetaticks(0:90:360);
thetaticklabels({'E'; 'N'; 'W'; 'S'; 'E'});
labels = thetaticklabels()
]]></example_item_data>
    </example_item>
  </examples>
