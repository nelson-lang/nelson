  <language>en_US</language>
  <keyword>xticklabels</keyword>
  <short_description>Set or get x-axis tick labels.</short_description>
  <syntax>
    <syntax_item>labels = xticklabels()</syntax_item>
    <syntax_item>xticklabels(labels)</syntax_item>
    <syntax_item>xticklabels(&apos;auto&apos;)</syntax_item>
    <syntax_item>xticklabels(&apos;manual&apos;)</syntax_item>
    <syntax_item>m = xticklabels(&apos;mode&apos;)</syntax_item>
    <syntax_item>xticklabels(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>labels</param_name>
      <param_description>Cell array of character vectors or string array of x-axis tick labels.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;auto&apos;</param_name>
      <param_description>Enable automatic x-tick labels.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;manual&apos;</param_name>
      <param_description>Freeze the current x-tick labels.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;mode&apos;</param_name>
      <param_description>Return the x-tick label mode.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Target axes. Default is the current axes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>labels</param_name>
      <param_description>Cell array of character vectors of x-axis tick labels.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>&apos;auto&apos; or &apos;manual&apos;.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>xticklabels</b> gets or sets the tick labels along the x-axis of the current axes.</p>
    <p>Specifying labels switches the x-tick label mode to <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Set x-axis tick labels.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
bar([10 20 30 41]);
xticks(1:4);
xticklabels({'A','B','C','D'});
labels = xticklabels()
]]></example_item_data>
    </example_item>
  </examples>
