  <language>en_US</language>
  <keyword>xticks</keyword>
  <short_description>Set or get x-axis tick values.</short_description>
  <syntax>
    <syntax_item>ticks = xticks()</syntax_item>
    <syntax_item>xticks(values)</syntax_item>
    <syntax_item>xticks(&apos;auto&apos;)</syntax_item>
    <syntax_item>xticks(&apos;manual&apos;)</syntax_item>
    <syntax_item>m = xticks(&apos;mode&apos;)</syntax_item>
    <syntax_item>xticks(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>values</param_name>
      <param_description>Numeric vector of x-axis tick values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;auto&apos;</param_name>
      <param_description>Enable automatic x-tick selection.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;manual&apos;</param_name>
      <param_description>Freeze the current x-tick values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;mode&apos;</param_name>
      <param_description>Return the x-tick mode.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Target axes. Default is the current axes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ticks</param_name>
      <param_description>Numeric row vector of x-axis tick values.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>&apos;auto&apos; or &apos;manual&apos;.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>xticks</b> gets or sets the tick values along the x-axis of the current axes.</p>
    <p>Specifying tick values switches the x-tick mode to <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Set x-axis ticks.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
x = linspace(0, 10, 50);
plot(x, sin(x));
xticks(0:2:10);
ticks = xticks()
]]></example_item_data>
    </example_item>
  </examples>
