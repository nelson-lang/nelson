  <language>en_US</language>
  <keyword>ztickformat</keyword>
  <short_description>Set or get the z-axis tick label format.</short_description>
  <syntax>
    <syntax_item>ztickformat(fmt)</syntax_item>
    <syntax_item>fmt = ztickformat()</syntax_item>
    <syntax_item>ztickformat(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>fmt</param_name>
      <param_description>Format specifier: a sprintf-style conversion or a preset keyword.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Target axes. Default is the current axes.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>fmt</param_name>
      <param_description>Current tick label format.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ztickformat</b> sets or gets the format used for the z-axis tick labels of the current axes.</p>
    <p>The format applies to automatically generated tick labels.</p>
    <p>The format is a sprintf-style conversion (for example <b>%.2f</b> or <b>%g</b>) applied to each numeric tick value. The preset keywords <b>usd</b>, <b>eur</b>, <b>gbp</b>, <b>jpy</b>, <b>degrees</b> and <b>percentage</b> are also accepted. Custom tick labels set with zticklabels take precedence over the format.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Format z-axis tick labels.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[
t = linspace(0, 10, 50);
plot3(sin(t), cos(t), t / 4);
ztickformat('%.1f');
]]></example_item_data>
    </example_item>
  </examples>
