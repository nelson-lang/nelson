  <language>en_US</language>
  <keyword>enableDefaultInteractivity</keyword>
  <short_description>Enable the built-in axes interactions.</short_description>
  <syntax>
    <syntax_item>enableDefaultInteractivity(ax)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description
      >a scalar graphics object value: an axes.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p
    ><b>enableDefaultInteractivity(ax)</b> turns the built-in interactions of the axes <b>ax</b> back on after they were turned off with <b
      >disableDefaultInteractivity</b>.</p>
    <p
    >With the built-in interactions on, dragging the cursor over the axes pans the content (or rotates it for a 3-D view) and the scroll wheel zooms.</p>
    <p>This is the default state of a new axes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[plot(1:1000, sin(1:1000))
ax = gca();
disableDefaultInteractivity(ax);
enableDefaultInteractivity(ax);
]]></example_item_data>
    </example_item>
  </examples>
