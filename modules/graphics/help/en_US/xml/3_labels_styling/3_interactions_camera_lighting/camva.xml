  <language>en_US</language>
  <keyword>camva</keyword>
  <short_description>Set or query the camera view angle.</short_description>
  <syntax>
    <syntax_item>camva</syntax_item>
    <syntax_item>a = camva</syntax_item>
    <syntax_item>camva(angle)</syntax_item>
    <syntax_item>camva('auto')</syntax_item>
    <syntax_item>camva('manual')</syntax_item>
    <syntax_item>mode = camva('mode')</syntax_item>
    <syntax_item>camva(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>a scalar graphics object value: an axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>angle</param_name>
      <param_description>the camera view angle in degrees, a real scalar in the range (0, 180).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>a</param_name>
      <param_description>the current camera view angle in degrees.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>camva</b> sets or queries the <b>CameraViewAngle</b> property of an axes.</p>
    <p>The view angle is the field of view of the camera: a larger angle makes
    the scene appear smaller. With a perspective projection it controls the
    strength of the foreshortening. Specifying an angle switches
    <b>CameraViewAngleMode</b> to <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camproj('perspective');
camva(30);]]></example_item_data>
    </example_item>
  </examples>
