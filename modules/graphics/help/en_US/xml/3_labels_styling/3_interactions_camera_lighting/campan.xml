  <language>en_US</language>
  <keyword>campan</keyword>
  <short_description>Rotate the camera target around the position.</short_description>
  <syntax>
    <syntax_item>campan(dtheta, dphi)</syntax_item>
    <syntax_item>campan(dtheta, dphi, coordsys)</syntax_item>
    <syntax_item>campan(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>a scalar graphics object value: an axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dtheta</param_name>
      <param_description>horizontal rotation in degrees.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dphi</param_name>
      <param_description>vertical rotation in degrees.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>coordsys</param_name>
      <param_description>'data' (default, horizontal rotation about the z axis) or 'camera' (horizontal rotation about the camera up vector).</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>campan</b> rotates the camera target around the camera position,
    keeping the camera-to-target distance constant. This changes the direction
    the camera points without moving the camera itself.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camproj('perspective');
campan(10, 0);]]></example_item_data>
    </example_item>
  </examples>
