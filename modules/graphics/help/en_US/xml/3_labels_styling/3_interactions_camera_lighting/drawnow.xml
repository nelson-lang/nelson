  <language>en_US</language>
  <keyword>drawnow</keyword>
  <short_description>Update figures and process callbacks</short_description>
  <syntax>
    <syntax_item>drawnow()</syntax_item>
    <syntax_item>drawnow('limitrate')</syntax_item>
    <syntax_item>drawnow limitrate</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>limitrate</param_name>
      <param_description>Limits figure updates to reduce rendering work during animation loops.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p>
      <b>drawnow</b> flushes the event queue and updates the figure window.</p>
    <p>
      <b>drawnow('limitrate')</b> and <b>drawnow limitrate</b> process pending callbacks but skip figure updates when the previous update was recent. This mode is useful in animation loops.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[x = -pi:pi/20:pi;
plot(x, cos(x))
drawnow
title('Title Here ...')
grid on]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[x = linspace(0, 2*pi, 200);
h = plot(x, sin(x));
for k = 1:20
  set(h, 'YData', sin(x + k / 10));
  drawnow limitrate
end]]></example_item_data>
    </example_item>
  </examples>
