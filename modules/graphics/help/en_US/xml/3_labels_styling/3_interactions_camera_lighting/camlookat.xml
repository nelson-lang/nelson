  <language>en_US</language>
  <keyword>camlookat</keyword>
  <short_description>Aim the camera at an object.</short_description>
  <syntax>
    <syntax_item>camlookat</syntax_item>
    <syntax_item>camlookat(obj)</syntax_item>
    <syntax_item>camlookat(ax)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>obj</param_name>
      <param_description>a graphics object to look at (for example a surface or line).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>an axes whose contents are framed.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>camlookat</b> sets the camera target to the center of the object and
    moves the camera along the current viewing direction so the object fills
    the view. With no argument it frames the current axes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
[x, y, z] = sphere(20);
s = surf(x + 5, y - 3, z);
axis equal;
camlookat(s);]]></example_item_data>
    </example_item>
  </examples>
