  <language>en_US</language>
  <keyword>camroll</keyword>
  <short_description>Roll the camera about the viewing axis.</short_description>
  <syntax>
    <syntax_item>camroll(dtheta)</syntax_item>
    <syntax_item>camroll(ax, dtheta)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>a scalar graphics object value: an axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dtheta</param_name>
      <param_description>the roll angle in degrees.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>camroll</b> rotates the <b>CameraUpVector</b> about the line joining
    the camera position and the camera target, rolling the view by the given
    angle.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camroll(30);]]></example_item_data>
    </example_item>
  </examples>
