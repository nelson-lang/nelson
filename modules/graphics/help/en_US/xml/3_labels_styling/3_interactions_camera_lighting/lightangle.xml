  <language>en_US</language>
  <keyword>lightangle</keyword>
  <short_description>Create or position a light from angles.</short_description>
  <syntax>
    <syntax_item>lightangle(az, el)</syntax_item>
    <syntax_item>lightangle(ax, az, el)</syntax_item>
    <syntax_item>lightangle(go, az, el)</syntax_item>
    <syntax_item>go = lightangle(...)</syntax_item>
  </syntax>
  <description>
    <p><b>lightangle</b> converts azimuth and elevation angles to a light position. If no light handle is supplied, it creates one.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[
surf(peaks(30), 'EdgeColor', 'none', 'FaceLighting', 'gouraud');
lightangle(45, 30);
material('shiny');
view(35, 28);
]]></example_item_data>
      <example_item_img src="../../../../images/lightangle_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
