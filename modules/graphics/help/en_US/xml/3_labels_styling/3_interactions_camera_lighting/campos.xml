  <language>en_US</language>
  <keyword>campos</keyword>
  <short_description>Set or query the camera position.</short_description>
  <syntax>
    <syntax_item>campos</syntax_item>
    <syntax_item>pos = campos</syntax_item>
    <syntax_item>campos([x y z])</syntax_item>
    <syntax_item>campos('auto')</syntax_item>
    <syntax_item>campos('manual')</syntax_item>
    <syntax_item>mode = campos('mode')</syntax_item>
    <syntax_item>campos(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>a scalar graphics object value: an axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>[x y z]</param_name>
      <param_description>the camera position, specified as a three-element vector.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>pos</param_name>
      <param_description>the current camera position, a three-element vector.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>campos</b> sets or queries the <b>CameraPosition</b> property of an axes.</p>
    <p>Specifying a position switches <b>CameraPositionMode</b> to <b>manual</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camproj('perspective');
camtarget([0 0 0]);
campos([80 -120 90]);
camva(35);]]></example_item_data>
    </example_item>
  </examples>
