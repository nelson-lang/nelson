  <language>en_US</language>
  <keyword>camproj</keyword>
  <short_description>Set or query the camera projection type.</short_description>
  <syntax>
    <syntax_item>camproj</syntax_item>
    <syntax_item>p = camproj</syntax_item>
    <syntax_item>camproj('orthographic')</syntax_item>
    <syntax_item>camproj('perspective')</syntax_item>
    <syntax_item>camproj(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>a scalar graphics object value: an axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>type</param_name>
      <param_description>the projection type: 'orthographic' or 'perspective'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>the current projection type.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>camproj</b> sets or queries the <b>Projection</b> property of an axes.</p>
    <p>An <b>orthographic</b> projection keeps parallel lines parallel and the
    apparent size independent of distance. A <b>perspective</b> projection adds
    foreshortening, so objects farther from the camera appear smaller.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
surf(peaks(40), 'EdgeColor', 'none');
camproj('perspective');
p = camproj()]]></example_item_data>
    </example_item>
  </examples>
