  <keyword>caxis</keyword>
  <short_description>Query or set axes color limits.</short_description>
  <syntax><syntax_item>limits = caxis()</syntax_item><syntax_item>caxis([cmin cmax])</syntax_item><syntax_item>mode = caxis('mode')</syntax_item><syntax_item>caxis('auto')</syntax_item><syntax_item>caxis('manual')</syntax_item></syntax>
  <param_input><param_input_item><param_name>limits</param_name><param_description>Two-element increasing numeric vector.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>limits</param_name><param_description>Current color limits.</param_description></param_output_item></param_output>
  <description><p><b>caxis</b> is a compatibility interface for axes color limits.</p></description>
