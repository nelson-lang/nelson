  <language>en_US</language>
  <keyword>shading</keyword>
  <short_description>Set surface and patch shading mode.</short_description>
  <syntax>
    <syntax_item>shading(type)</syntax_item>
    <syntax_item>shading(ax, type)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>target axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>type</param_name>
      <param_description><b>faceted</b>, <b>flat</b>, or <b>interp</b>.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>shading</b> changes the <b>FaceColor</b> and <b>EdgeColor</b> of surface and patch children in axes.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[
surf(peaks(20));
shading interp;
]]></example_item_data>
      <example_item_img src="../../../../images/shading_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
