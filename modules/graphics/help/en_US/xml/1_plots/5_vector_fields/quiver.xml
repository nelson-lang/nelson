  <language>en_US</language>
  <keyword>quiver</keyword>
  <short_description>2-D vector field plot.</short_description>
  <syntax>
    <syntax_item>quiver(U, V)</syntax_item>
    <syntax_item>quiver(X, Y, U, V)</syntax_item>
    <syntax_item>quiver(..., scale)</syntax_item>
    <syntax_item>quiver(..., LineSpec)</syntax_item>
    <syntax_item>quiver(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>quiver(parent, ...)</syntax_item>
    <syntax_item>h = quiver(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X, Y</param_name>
      <param_description>Arrow base coordinates, specified as scalars, vectors, or matrices.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>U, V</param_name>
      <param_description>Vector components, specified as numeric arrays of the same size.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>scale</param_name>
      <param_description>Automatic scale factor. Use 0 to disable automatic scaling.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>LineSpec</param_name>
      <param_description>Line style, marker, and color specification.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>Axes or hggroup parent.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName</param_name>
      <param_description>Scalar string or character vector property name.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyValue</param_name>
      <param_description>Property value.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>Quiver graphics object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>quiver(U,V)</b> plots arrows with vector components <b>U</b> and <b>V</b> on a regular grid.</p>
    <p><b>quiver(X,Y,U,V)</b> plots arrows at the coordinates specified by <b>X</b> and <b>Y</b>.</p>
    <p>See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.quiver.properties">quiver properties</link> for the complete property list.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Plot a vector field on a regular grid.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[[X, Y] = meshgrid(-2:0.5:2, -2:0.5:2);
U = -Y;
V = X;
h = quiver(X, Y, U, V);
axis equal]]></example_item_data>
      <example_item_img src="../../../../images/quiver_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Style the arrows and disable automatic scaling.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[x = 1:5;
y = [1 2 1 2 1];
u = [1 0 -1 0 1];
v = [0 1 0 -1 0];
h = quiver(x, y, u, v, 0, 'r--o', 'LineWidth', 1.5);
h.ShowArrowHead = 'on';]]></example_item_data>
      <example_item_img src="../../../../images/quiver_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
