  <language>en_US</language>
  <keyword>fimplicit3</keyword>
  <short_description>Plot an implicit 3-D function surface approximation.</short_description>
  <syntax>
    <syntax_item>fimplicit3(fun)</syntax_item>
    <syntax_item>fimplicit3(fun, interval)</syntax_item>
    <syntax_item>fimplicit3(fun, [xmin xmax ymin ymax zmin zmax])</syntax_item>
    <syntax_item>fimplicit3(..., LineSpec)</syntax_item>
    <syntax_item>fimplicit3(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>fimplicit3(parent, ...)</syntax_item>
    <syntax_item>h = fimplicit3(...)</syntax_item>
  </syntax>
  <description>
    <p><b>fimplicit3</b> samples <b>fun(x,y,z)</b> on a regular grid and displays an approximated zero-level surface as an <b>implicitfunctionsurface</b> graphics object.</p>
    <p>See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.implicitfunctionsurface.properties">implicitfunctionsurface properties</link> for the complete property list.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Plot a sphere approximation.</example_item_description>
      <example_item_data><![CDATA[fimplicit3(@(x, y, z) x.^2 + y.^2 + z.^2 - 1, [-1.5 1.5]);]]></example_item_data>
      <example_item_img src="../../../../images/fimplicit3_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Use a line specification and surface properties.</example_item_description>
      <example_item_data><![CDATA[h = fimplicit3(@(x, y, z) x.^2 + y.^2 + z.^2 - 1, [-1.5 1.5], 'r', 'FaceAlpha', 0.5);]]></example_item_data>
      <example_item_img src="../../../../images/fimplicit3_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
