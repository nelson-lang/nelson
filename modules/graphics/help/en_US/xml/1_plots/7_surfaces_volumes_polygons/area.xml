  <language>en_US</language>
  <keyword>area</keyword>
  <short_description>Create area plots.</short_description>
  <syntax>
    <syntax_item>area(Y)</syntax_item>
    <syntax_item>area(X, Y)</syntax_item>
    <syntax_item>area(..., basevalue)</syntax_item>
    <syntax_item>area(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>area(ax, ...)</syntax_item>
    <syntax_item>go = area(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>x-coordinates.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>area data. Matrix columns create stacked area objects.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>basevalue</param_name>
      <param_description>baseline value. Default is 0.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>go</param_name>
      <param_description>graphics object handles of area type.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>area</b> creates one native area graphics object per data column. Area objects use filled polygon rendering and support face, edge, line, alpha, base value, and interaction properties.</p>
    <p>See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.area.properties">area properties</link> for the complete property list.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[y = [1 2; 3 1; 2 4];
area(y);]]></example_item_data>
      <example_item_img src="../../../../images/area_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
