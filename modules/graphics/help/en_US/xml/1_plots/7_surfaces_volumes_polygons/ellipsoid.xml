  <language>en_US</language>
  <keyword>ellipsoid</keyword>
  <short_description>Create an ellipsoid.</short_description>
  <syntax>
    <syntax_item>[X, Y, Z] = ellipsoid(xc, yc, zc, xr, yr, zr)</syntax_item>
    <syntax_item>[X, Y, Z] = ellipsoid(xc, yc, zc, xr, yr, zr, n)</syntax_item>
    <syntax_item>ellipsoid(...)</syntax_item>
    <syntax_item>ellipsoid(ax, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>xc, yc, zc</param_name>
      <param_description>the center of the ellipsoid.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>xr, yr, zr</param_name>
      <param_description>the semi-axis lengths along x, y and z.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>a positive integer: the grid resolution (default 20). The result is (n+1)-by-(n+1).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>X, Y, Z</param_name>
      <param_description>the coordinates of the ellipsoid surface.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ellipsoid</b> generates the coordinates of an ellipsoid centered at
      <b>(xc, yc, zc)</b> with semi-axes <b>(xr, yr, zr)</b>. Called without an
      output argument, it draws the surface.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
ellipsoid(0, 0, 0, 3, 2, 1);
axis equal]]></example_item_data>
    </example_item>
  </examples>
