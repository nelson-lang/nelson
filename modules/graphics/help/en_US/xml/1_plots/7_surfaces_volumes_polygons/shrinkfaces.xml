  <language>en_US</language>
  <keyword>shrinkfaces</keyword>
  <short_description>Reduce patch face size.</short_description>
  <syntax>
    <syntax_item>shrinkfaces(p, sf)</syntax_item>
    <syntax_item>nfv = shrinkfaces(p, sf)</syntax_item>
    <syntax_item>nfv = shrinkfaces(fv, sf)</syntax_item>
    <syntax_item>nfv = shrinkfaces(faces, vertices, sf)</syntax_item>
    <syntax_item>[newFaces, newVertices] = shrinkfaces(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>Patch handle.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>fv</param_name>
      <param_description>Structure with faces and vertices fields.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>sf</param_name>
      <param_description>Nonnegative shrink factor. The default is 0.3.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>nfv, newFaces, newVertices</param_name>
      <param_description>Shrunk face and vertex data with nonshared vertices.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>shrinkfaces</b> moves each face vertex toward the center of its face and creates nonshared vertices.</p>
  </description>
  <see_also>
    <see_also_item><link linkend="${graphics}1_plots/7_surfaces_volumes_polygons/isosurface">isosurface</link></see_also_item>
