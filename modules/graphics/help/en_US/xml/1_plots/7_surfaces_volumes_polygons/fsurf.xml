  <language>en_US</language>
  <keyword>fsurf</keyword>
  <short_description>Plot a function surface.</short_description>
  <syntax>
    <syntax_item>fsurf(fun)</syntax_item>
    <syntax_item>fsurf(fun, range)</syntax_item>
    <syntax_item>fsurf(ax, ...)</syntax_item>
    <syntax_item>fsurf(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>go = fsurf(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>fun</param_name>
      <param_description>function handle evaluated as fun(X, Y).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>range</param_name>
      <param_description>two element range for both axes or four element [xmin xmax ymin ymax].</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>MeshDensity</param_name>
      <param_description>number of sample points in each direction.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>XRange, YRange</param_name>
      <param_description>sampling intervals. Changing either range after creation resamples the function surface.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>XRangeMode, YRangeMode</param_name>
      <param_description><b>auto</b> for the default range, <b>manual</b> after an explicit range assignment.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ShowContours</param_name>
      <param_description>set to <b>on</b> to add contour lines under the function surface.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>go</param_name>
      <param_description>a graphics object: functionsurface type.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>fsurf</b> samples a function on a rectangular grid and displays the result as a function surface object. The grid is resampled when <b>Function</b>, <b>XRange</b>, <b>YRange</b>, or <b>MeshDensity</b> changes.</p>
    <p>See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.functionsurface.properties">functionsurface properties</link> for the complete property list.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[
fsurf(@(x, y) sin(x) + cos(y), [-3 3 -3 3], 'FaceColor', 'interp', 'EdgeColor', 'none', 'ShowContours', 'on');
light();
lighting gouraud;
]]></example_item_data>
      <example_item_img src="../../../../images/fsurf_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
