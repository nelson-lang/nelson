  <language>en_US</language>
  <keyword>surfnorm</keyword>
  <short_description>Compute or display surface normal vectors.</short_description>
  <syntax>
    <syntax_item>surfnorm(Z)</syntax_item>
    <syntax_item>surfnorm(X, Y, Z)</syntax_item>
    <syntax_item>Nx = surfnorm(...)</syntax_item>
    <syntax_item>[Nx, Ny] = surfnorm(...)</syntax_item>
    <syntax_item>[Nx, Ny, Nz] = surfnorm(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>Z</param_name>
      <param_description>Surface height data, specified as a real numeric matrix with at least three rows and three columns.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>X, Y</param_name>
      <param_description>Surface coordinate matrices with the same size as Z.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Nx, Ny, Nz</param_name>
      <param_description>Normalized surface normal vector components.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>surfnorm</b> computes unit normal vectors for a surface. With no output arguments, it displays the surface and draws one normal segment at each surface point.</p>
    <p>When only Z is specified, the x- and y-coordinates are the column and row indices of Z.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Display normals on a surface.</example_item_description>
      <example_item_data><![CDATA[[X, Y, Z] = peaks(20);
surfnorm(X, Y, Z);]]></example_item_data>
      <example_item_img src="../../../../images/surfnorm_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Compute normal vector components.</example_item_description>
      <example_item_data><![CDATA[[Nx, Ny, Nz] = surfnorm(peaks(10));]]></example_item_data>
    </example_item>
  </examples>
