  <language>en_US</language>
  <keyword>polarhistogram</keyword>
  <short_description>Display angle data as a polar histogram.</short_description>
  <syntax>
    <syntax_item>polarhistogram(theta)</syntax_item>
    <syntax_item>polarhistogram(theta, nbins)</syntax_item>
    <syntax_item>polarhistogram(..., &apos;BinEdges&apos;, edges)</syntax_item>
    <syntax_item>h = polarhistogram(...)</syntax_item>
  </syntax>
  <description>
    <p><b>polarhistogram</b> bins angle data and displays the bin counts as polar sectors.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Create a polar histogram.</example_item_description>
      <example_item_data><![CDATA[rng(0);
theta = 2*pi*rand(200, 1);
polarhistogram(theta, 16);]]></example_item_data>
      <example_item_img src="../../../../images/polarhistogram_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${graphics}1_plots/4_data_distribution_plots/histogram">histogram</link></see_also_item>
    <see_also_item><link linkend="${graphics}1_plots/2_polar_plots/polarplot">polarplot</link></see_also_item>
  </see_also>
