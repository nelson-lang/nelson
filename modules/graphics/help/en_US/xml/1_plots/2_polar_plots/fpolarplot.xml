  <language>en_US</language>
  <keyword>fpolarplot</keyword>
  <short_description>Plot a function in polar coordinates.</short_description>
  <syntax>
    <syntax_item>fpolarplot(fun)</syntax_item>
    <syntax_item>fpolarplot(fun, [tmin tmax])</syntax_item>
    <syntax_item>fpolarplot(..., LineSpec)</syntax_item>
    <syntax_item>fpolarplot(..., Name, Value)</syntax_item>
    <syntax_item>fpolarplot(parent, ...)</syntax_item>
    <syntax_item>h = fpolarplot(...)</syntax_item>
  </syntax>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>Function line graphics object drawn in polar axes.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>fpolarplot</b> samples a function over an angle interval and plots the resulting radius values in polar coordinates. The returned object is a <b>functionline</b>.</p>
    <p>Name-value pairs can set line properties and functionline properties such as <b>MeshDensity</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Plot a polar function.</example_item_description>
      <example_item_data><![CDATA[fpolarplot(@(t) 1 + sin(4*t), [0 2*pi], 'r-');]]></example_item_data>
      <example_item_img src="../../../../images/fpolarplot_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
