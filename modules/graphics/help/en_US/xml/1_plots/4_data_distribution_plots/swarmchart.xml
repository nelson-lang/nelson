  <language>en_US</language>
  <keyword>swarmchart</keyword>
  <short_description>Display a 2-D swarm chart.</short_description>
  <syntax>
    <syntax_item>swarmchart(x, y)</syntax_item>
    <syntax_item>swarmchart(x, y, sz, c)</syntax_item>
    <syntax_item>swarmchart(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>h = swarmchart(...)</syntax_item>
  </syntax>
  <description>
    <p><b>swarmchart</b> displays points using a scatter object. The returned object keeps the original <b>XData</b> and <b>YData</b> and uses scatter jitter properties for the displayed x positions.</p>
    <p>Supported chart properties are <b>XJitter</b>, <b>XJitterWidth</b>, and <b>ColorVariable</b>. Other arguments are forwarded to <b>scatter</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Display grouped observations.</example_item_description>
      <example_item_data><![CDATA[swarmchart([1 1 1 2 2 2], [4 5 3 7 6 8], 'filled');]]></example_item_data>
      <example_item_img src="../../../../images/swarmchart_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
