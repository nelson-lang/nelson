  <language>en_US</language>
  <keyword>bubblelegend</keyword>
  <short_description>Add a bubble size legend.</short_description>
  <syntax>
    <syntax_item>bubblelegend(title)</syntax_item>
    <syntax_item>bubblelegend(ax, title)</syntax_item>
    <syntax_item>bubblelegend(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>bl = bubblelegend(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>title</param_name>
      <param_description>Legend title text.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName, propertyValue</param_name>
      <param_description>Name-value pairs for the bubble legend object.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>bl</param_name>
      <param_description>Bubble legend graphics object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>bubblelegend</b> creates a <b>bubblelegend</b> graphics object.</p>
    <p>See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.bubblelegend.properties">bubblelegend properties</link> for the complete property list.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Add a legend for bubble sizes.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[figure();
bubblechart(1:3, [2 4 6], [10 100 1000]);
bubblesize([5 30]);
bubblelegend('Population', 'Location', 'eastoutside');]]></example_item_data>
      <example_item_img src="../../../../images/bubblelegend_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
  <see_also>
