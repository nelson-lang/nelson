  <language>en_US</language>
  <keyword>bubblesize</keyword>
  <short_description>Set or query rendered bubble diameter range.</short_description>
  <syntax>
    <syntax_item>bubblesize(range)</syntax_item>
    <syntax_item>bubblesize(ax, range)</syntax_item>
    <syntax_item>range = bubblesize()</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>range</param_name>
      <param_description>Two-element positive numeric vector [min max], in points.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Target axes. If omitted, the current axes is used.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>range</param_name>
      <param_description>Current rendered bubble diameter range.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>bubblesize</b> controls the minimum and maximum rendered bubble diameters for bubble charts in an axes.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Reduce bubble sizes.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[figure();
bubblechart(1:3, [2 4 6], [10 100 1000]);
bubblesize([5 30]);]]></example_item_data>
      <example_item_img src="../../../../images/bubblesize_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
