  <language>en_US</language>
  <keyword>plotmatrix</keyword>
  <short_description>Display a matrix of pairwise plots.</short_description>
  <syntax>
    <syntax_item>plotmatrix(X)</syntax_item>
    <syntax_item>plotmatrix(X, Y)</syntax_item>
    <syntax_item>plotmatrix(..., marker)</syntax_item>
    <syntax_item>[h, ax, bigax, p, pax] = plotmatrix(...)</syntax_item>
  </syntax>
  <description>
    <p><b>plotmatrix</b> creates a grid of pairwise plots for the columns of numeric matrices. With one input matrix, the diagonal cells include histograms returned in <b>p</b>, while <b>h</b> contains the scatter line objects.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Create a plot matrix for three variables.</example_item_description>
      <example_item_data><![CDATA[X = [1 2 3; 2 3 5; 3 5 8; 4 7 13; 5 11 21];
plotmatrix(X);]]></example_item_data>
      <example_item_img src="../../../../images/plotmatrix_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Compare columns from two matrices.</example_item_description>
      <example_item_data><![CDATA[rng(0);
X = rand(30, 2);
Y = [X(:, 1).^2, sin(X(:, 2)), X(:, 1) + X(:, 2)];
plotmatrix(X, Y, 'o');]]></example_item_data>
      <example_item_img src="../../../../images/plotmatrix_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
