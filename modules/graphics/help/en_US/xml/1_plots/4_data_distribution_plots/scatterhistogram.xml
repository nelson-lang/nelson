  <language>en_US</language>
  <keyword>scatterhistogram</keyword>
  <short_description>Display a scatter plot with marginal histograms.</short_description>
  <syntax>
    <syntax_item>scatterhistogram(x, y)</syntax_item>
    <syntax_item>scatterhistogram(..., &apos;NumBins&apos;, n)</syntax_item>
    <syntax_item>scatterhistogram(..., &apos;MarkerStyle&apos;, marker)</syntax_item>
    <syntax_item>h = scatterhistogram(...)</syntax_item>
  </syntax>
  <description>
    <p><b>scatterhistogram</b> creates a scatter plot and displays histograms for the x and y data distributions.</p>
    <p>The returned object has type <b>scatterhistogram</b>. See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.scatterhistogram.properties">scatterhistogram properties</link> for the complete property list.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>Nelson</example_item_type>
      <example_item_description>Create a scatter histogram.</example_item_description>
      <example_item_data><![CDATA[rng(0);
x = randn(200, 1);
y = 0.5 * x + randn(200, 1);
scatterhistogram(x, y, 'NumBins', 20);]]></example_item_data>
      <example_item_img src="../../../../images/scatterhistogram_1.svg" align="middle" generate="true" />
    </example_item>
  </examples>
