  <language>en_US</language>
  <keyword>line</keyword>
  <short_description>Create primitive line.</short_description>
  <syntax>
    <syntax_item>go = line()</syntax_item>
    <syntax_item>po = line(x, y)</syntax_item>
    <syntax_item>go = line(x, y, z)</syntax_item>
    <syntax_item>go = line(ax, x, y, z)</syntax_item>
    <syntax_item
    >go = line(ax, x, y, z, propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x, y , z</param_name>
      <param_description
      >a scalar graphics object value: parent container, specified as a figure.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Target axes: axes object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName</param_name>
      <param_description
      >a scalar string or row vector character.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyValue</param_name>
      <param_description>a value.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>go</param_name>
      <param_description>a graphics object: line type.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>line(x, y)</b> creates a line in the current axes with vectors<b>x</b> and <b>y</b>.</p>
    <p>
      <b>line(x, y, z)</b> creates a line in three-dimensional coordinates.</p>
    <p>See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.line.properties">line properties</link> for the complete property list.</p><p />
    <p>
      <b>BeingDeleted</b> Flag indicating that the object is being deleted.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
x = linspace(0,10)';
y1 = sin(x);
y2 = cos(x);
line(x, y1, 'Color', [0 1 0])
line(x, y2, 'Color', [1 0 0])
]]></example_item_data>
      <example_item_img
        src="../../../../images/line_xy.svg"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
x = [1 9];
y = [2 12];
line(x,y,'Color','red','LineStyle','--')]]></example_item_data>
      <example_item_img
        src="../../../../images/line_linestyle.svg"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
t = linspace(0,10*pi,400);
x = sin(t);
y = cos(t);
z = t;
line(x,y,z)
view(3)]]></example_item_data>
      <example_item_img
        src="../../../../images/line_xyz.svg"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
