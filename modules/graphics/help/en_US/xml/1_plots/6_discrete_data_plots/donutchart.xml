  <language>en_US</language>
  <keyword>donutchart</keyword>
  <short_description>Donut chart object.</short_description>
  <syntax>
    <syntax_item>donutchart(data)</syntax_item>
    <syntax_item>donutchart(data, names)</syntax_item>
    <syntax_item>donutchart(fig, ...)</syntax_item>
    <syntax_item>donutchart(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>d = donutchart(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>data</param_name>
      <param_description>Numeric vector of wedge values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>names</param_name>
      <param_description>String array, character vector, or cell array of character vectors used as wedge names.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>fig</param_name>
      <param_description>Figure parent.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName</param_name>
      <param_description>Donut chart property name.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyValue</param_name>
      <param_description>Value assigned to the named property.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>d</param_name>
      <param_description>Donut chart graphics object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>donutchart(data)</b> creates one donut chart object in the current figure.</p>
    <p><b>InnerRadius</b> controls the hole radius as a fraction of the outer radius. <b>CenterLabel</b> draws text in the center of the hole.</p>
    <p>See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.donutchart.properties">donutchart properties</link> for the complete property list.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Donut chart with a center label.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[figure('Color', [1 1 1]);
d = donutchart([4 3 2], ["A", "B", "C"], 'CenterLabel', '9');]]></example_item_data>
      <example_item_img src="../../../../images/donutchart_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Custom inner radius and colors.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[figure('Color', [1 1 1]);
d = donutchart([5 4 3 2], 'InnerRadius', 0.35, 'FaceAlpha', 0.75, ...
  'ColorOrder', [0.8 0.2 0.2; 0.2 0.7 0.3; 0.2 0.4 0.8]);]]></example_item_data>
      <example_item_img src="../../../../images/donutchart_2.svg" align="middle" generate="true" />
    </example_item>
  </examples>
