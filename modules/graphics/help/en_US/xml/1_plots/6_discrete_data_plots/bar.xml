  <language>en_US</language>
  <keyword>bar</keyword>
  <short_description>Bar graph.</short_description>
  <syntax>
    <syntax_item>bar(Y)</syntax_item>
    <syntax_item>bar(X, Y)</syntax_item>
    <syntax_item>bar(..., width)</syntax_item>
    <syntax_item>bar(..., color)</syntax_item>
    <syntax_item>bar(..., 'grouped')</syntax_item>
    <syntax_item>bar(..., 'stacked')</syntax_item>
    <syntax_item>bar(..., propertyName, propertyValue)</syntax_item>
    <syntax_item>bar(ax, ...)</syntax_item>
    <syntax_item>b = bar(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>x-coordinates: scalar, vector, categorical array, string array, or cell array of labels.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>y-coordinates: vector or matrix.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>width</param_name>
      <param_description>scalar, 0.8 (default).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>color</param_name>
      <param_description>a scalar string or row vector character: color name or short color name.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName</param_name>
      <param_description>a scalar string or row vector character.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyValue</param_name>
      <param_description>a value.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes object.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>b</param_name>
      <param_description>bar graphics object or vector of bar graphics objects.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>bar(X, Y)</b> creates a bar graph using X positions and Y values.</p>
    <p>When only one argument is provided, <b>bar(Y)</b> generates X positions from 1 to the number of rows in Y.</p>
    <p>You can optionally specify the width of the bars. A value of 1.0 makes each bar touch its neighboring bars, while the default width is 0.8.</p>
    <p>When Y is a matrix, <b>bar</b> creates grouped bars by default. Use <b>'stacked'</b> to stack columns in each group.</p>
    <p>When X is a categorical array, the bars are placed in category order (as returned by <b>categories</b>), Y is reordered to match, and the category names are used as tick labels.</p>
    <p>See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.bar.properties">bar properties</link> for the complete property list.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Bar graph from a vector.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
y = [91 75 123.5 105 150 131 203 179 249 226 281.5];
bar(y);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_1.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Bar graph with narrower bars.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
y = [91 75 123.5 105 150 131 203 179 249 226 281.5];
bar(y, 0.5);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_2.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Bar graph with explicit positions and a color.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
x = 1900:10:2000;
y = [75 91 105 123.5 131 150 179 203 226 249 281.5];
bar(x, y, 'r');
]]></example_item_data>
      <example_item_img src="../../../../images/bar_3.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Bar graph with string labels.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
x = ["Summer", "Spring", "Winter", "Autumn"];
y = [2 1 4 3];
bar(x, y);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_4.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Bar graph with face and edge properties.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
y = [91 75 123.5 105 150 131 203 179 249 226 281.5];
bar(y, 'FaceColor', [0 .5 .5], 'EdgeColor', [0 .9 .9], 'LineWidth', 1.5);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_5.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Grouped bars.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
y = [1 2; 3 4; 5 6];
bar(y, 'grouped');
]]></example_item_data>
      <example_item_img src="../../../../images/bar_6.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Stacked bars with positive and negative values.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
y = [1 -2 3; -4 5 -6];
bar(y, 'stacked');
]]></example_item_data>
      <example_item_img src="../../../../images/bar_7.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Stacked bars at a scalar position.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
x = 2020;
y = [30 50 23];
bar(x, y, "stacked");
]]></example_item_data>
      <example_item_img src="../../../../images/bar_8.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Bar graph with categorical labels.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
X = categorical({'Small', 'Medium', 'Large', 'Extra Large'});
X = reordercats(X, {'Small', 'Medium', 'Large', 'Extra Large'});
Y = [10 21 33 52];
bar(X, Y);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_9.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Bar graph from a table variable.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
Month = ["April"; "May"; "June"; "July"; "August"];
Sales = [2000; 3000; 4000; 5000; 6000];
Revenue = [1500; 1800; 2000; 3000; 4000];
tbl = table(Month, Sales, Revenue);
bar(tbl.Month, tbl.Sales);
]]></example_item_data>
      <example_item_img src="../../../../images/bar_10.svg" align="middle" generate="true" />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Grouped bars from several table variables.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
Month = ["April"; "May"; "June"; "July"; "August"];
Sales = [2000; 3000; 4000; 5000; 6000];
Revenue = [1500; 1800; 2000; 3000; 4000];
tbl = table(Month, Sales, Revenue);
bar(tbl.Month, [tbl.Sales, tbl.Revenue]);
legend({'Sales', 'Revenue'}, 'Location', 'northwest');
]]></example_item_data>
      <example_item_img src="../../../../images/bar_11.svg" align="middle" generate="true" />
    </example_item>
  </examples>
