  <language>en_US</language>
  <keyword>getpoints</keyword>
  <short_description>Return points from animated line.</short_description>
  <syntax>
    <syntax_item>[x, y] = getpoints(an)</syntax_item>
    <syntax_item>[x, y, z] = getpoints(an)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>an</param_name>
      <param_description>animatedline graphics object.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>x, y, z</param_name>
      <param_description>stored coordinates.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>getpoints</b> returns only the coordinates stored on the animated line.</p>
    <p>Two-dimensional lines store and return zero z-coordinates when a third output is requested.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[an = animatedline(1:4, [1 4 2 3]);
[x, y, z] = getpoints(an)]]></example_item_data>
    </example_item>
  </examples>
