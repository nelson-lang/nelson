  <language>en_US</language>
  <keyword>comet</keyword>
  <short_description>Create 2-D comet plot.</short_description>
  <syntax>
    <syntax_item>comet(y)</syntax_item>
    <syntax_item>comet(x, y)</syntax_item>
    <syntax_item>comet(x, y, p)</syntax_item>
    <syntax_item>comet(ax, x, y, p)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x, y</param_name>
      <param_description>numeric vectors with the same number of elements.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>body length scale factor in the interval [0, 1).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>target axes.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>comet</b> animates a marker head, a trailing body, and a complete trace for a two-dimensional comet plot.</p>
    <p>The final axes state contains two animated line objects and one marker-only line object.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[t = 0:pi/80:2*pi;
comet(cos(t), sin(t), 0.2)]]></example_item_data>
    </example_item>
  </examples>
