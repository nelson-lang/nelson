  <language>en_US</language>
  <keyword>animatedline</keyword>
  <short_description>Create animated line.</short_description>
  <syntax>
    <syntax_item>an = animatedline()</syntax_item>
    <syntax_item>an = animatedline(x, y)</syntax_item>
    <syntax_item>an = animatedline(x, y, z)</syntax_item>
    <syntax_item>an = animatedline(ax, ...)</syntax_item>
    <syntax_item>an = animatedline(..., propertyName, propertyValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x, y, z</param_name>
      <param_description>numeric coordinates: scalars or arrays with the same number of elements.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>target axes or group object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyName</param_name>
      <param_description>a scalar string or character vector.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>propertyValue</param_name>
      <param_description>a property value.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>an</param_name>
      <param_description>a graphics object: animatedline type.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>animatedline</b> creates an animated line with no stored points.</p>
    <p><b>animatedline(x, y)</b> creates an animated line initialized with two-dimensional coordinates.</p>
    <p><b>animatedline(x, y, z)</b> creates an animated line initialized with three-dimensional coordinates.</p>
    <p>Use <b>addpoints</b>, <b>clearpoints</b>, and <b>getpoints</b> to mutate or query the stored coordinates.</p>
    <p><b>MaximumNumPoints</b> limits the number of stored points. When the limit is reached, older points are discarded.</p>
    <p>See <link linkend="${graphics}2_graphics_objects/4_properties/nelson.graphics.animatedline.properties">animatedline properties</link> for the complete property list.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
ax = axes('Parent', f);
an = animatedline(ax, 'Color', [0 0.4 0.8], 'LineWidth', 2);
x = linspace(0, 2*pi, 120);
addpoints(an, x, sin(x));
drawnow]]></example_item_data>
    </example_item>
  </examples>
