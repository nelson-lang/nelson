  <keyword>unsetenv</keyword>
  <short_description
  >Supprime une variable d&apos;environnement.</short_description>
  <syntax>
    <syntax_item>unsetenv(env_name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>env_name</param_name>
      <param_description
      >chaine scalaire ou vecteur de caracteres : nom de la variable d&apos;environnement.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p>
      <b>unsetenv</b> supprime la variable d&apos;environnement <b
      >env_name</b> de l&apos;environnement du processus courant.</p>
    <p>Si la variable n&apos;existe pas, <b>unsetenv</b> n&apos;a aucun effet.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[setenv('MY_ENV_VAR', 'funvalue')
isenv('MY_ENV_VAR')
unsetenv('MY_ENV_VAR')
isenv('MY_ENV_VAR')]]></example_item_data>
    </example_item>
  </examples>
