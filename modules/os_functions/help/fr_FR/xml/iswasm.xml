  <keyword>iswasm</keyword>
  <short_description
  >Vérifie si la version est pour la plateforme WebAssembly.</short_description>
  <syntax>
    <syntax_item>s = iswasm()</syntax_item>
  </syntax>
  <param_output>
    <param_output_item>
      <param_name>s</param_name>
      <param_description
      >un booléen : vrai si la plateforme est WebAssembly.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>iswasm</b> vérifie si la plateforme est WebAssembly.</p>
    <p>Renvoie <b
      >true</b> lorsque Nelson est exécuté depuis une compilation WebAssembly (dans un navigateur ou un environnement WebAssembly), et <b
      >false</b> sinon.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[if iswasm
  disp('Your platform is WebAssembly')
else
  disp('Your platform is not WebAssembly')
end]]></example_item_data>
    </example_item>
  </examples>
