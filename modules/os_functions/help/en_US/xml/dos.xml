  <language>en_US</language>
  <keyword>dos</keyword>
  <short_description>Execute a command with the operating system shell.</short_description>
  <syntax>
    <syntax_item>status = dos(command)</syntax_item>
    <syntax_item>[status, output, duration] = dos(command)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>command</param_name>
      <param_description>string scalar or character vector: command to execute in the operating system shell.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;-echo&apos;</param_name>
      <param_description>optional flag that also displays command output in the command window.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>status</param_name>
      <param_description>integer exit status returned by the shell command.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>output</param_name>
      <param_description>text captured from standard output and standard error.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>duration</param_name>
      <param_description>execution duration in milliseconds.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>dos executes a command through the operating system shell and returns the exit status.</p>
    <p>With output arguments, Nelson can also return the command text output and execution duration. dos follows the same command execution model as system.</p>
  </description>
  <used_function>
    <used_function_item>system</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Run a shell command and capture its output.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[status, output] = dos('echo Nelson')]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${os_functions}system">system</link></see_also_item>
  </see_also>
