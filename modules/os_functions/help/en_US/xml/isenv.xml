  <language>en_US</language>
  <keyword>isenv</keyword>
  <short_description
  >Determine if an environment variable exists.</short_description>
  <syntax>
    <syntax_item>tf = isenv(env_name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>env_name</param_name>
      <param_description
      >string scalar, character vector, string array, cell array of character vectors: environment variable name.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description
      >logical: true if the environment variable is defined, false otherwise.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>isenv</b> returns <b>true</b> if the environment variable <b
      >env_name</b> is defined in the current process environment, even when its value is empty.</p>
    <p>If <b>env_name</b> is a nonscalar string array or cell array of character vectors, then <b
      >tf</b> has the same dimensions as <b>env_name</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[setenv('MY_ENV_VAR', 'funvalue')
isenv('MY_ENV_VAR')
isenv('A_VARIABLE_THAT_DOES_NOT_EXIST')
isenv(["MY_ENV_VAR", "A_VARIABLE_THAT_DOES_NOT_EXIST"])
]]></example_item_data>
    </example_item>
  </examples>
