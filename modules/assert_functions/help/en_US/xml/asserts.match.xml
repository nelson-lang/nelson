  <language>en_US</language>
  <keyword>asserts.match</keyword>
  <short_description>Check that text matches a regular expression.</short_description>
  <syntax>
    <syntax_item>asserts.match(text, pattern)</syntax_item>
    <syntax_item>[res, msg] = asserts.match(text, pattern)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>text</param_name><param_description>Character vector or string scalar to test.</param_description></param_input_item>
    <param_input_item><param_name>pattern</param_name><param_description>Regular expression pattern.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when pattern matches text.</p>
    <p>Invalid regular expressions raise an argument error immediately.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Regular expression match</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.match('abc123', '^abc[0-9]+$');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a missing match</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.match('abc', '[0-9]+');]]></example_item_data>
    </example_item>
  </examples>
