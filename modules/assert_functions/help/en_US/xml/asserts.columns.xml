  <language>en_US</language>
  <keyword>asserts.columns</keyword>
  <short_description>Check the column count.</short_description>
  <syntax>
    <syntax_item>asserts.columns(value, n)</syntax_item>
    <syntax_item>[res, msg] = asserts.columns(value, n)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Value to test.</param_description></param_input_item>
    <param_input_item><param_name>n</param_name><param_description>Expected nonnegative finite integer scalar column count.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when size(value, 2) equals n.</p>
    <p>Invalid n raises an argument error immediately.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Three columns</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.columns(ones(2, 3), 3);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a column-count failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.columns(ones(2, 3), 2);]]></example_item_data>
    </example_item>
  </examples>
