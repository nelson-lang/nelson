  <language>en_US</language>
  <keyword>asserts.containsAll</keyword>
  <short_description>Check that text contains all expected patterns.</short_description>
  <syntax>
    <syntax_item>asserts.containsAll(text, patterns)</syntax_item>
    <syntax_item>[res, msg] = asserts.containsAll(text, patterns)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>text</param_name><param_description>Character vector or string scalar to test.</param_description></param_input_item>
    <param_input_item><param_name>patterns</param_name><param_description>Character vector, string scalar, string array or cell of character vectors. Every pattern must be present.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when every pattern is found in text.</p>
    <p>Use asserts.containsAny when one matching pattern is enough.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>All patterns present</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.containsAll('Nelson language', {'Nelson', 'language'});]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a missing pattern</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.containsAll('Nelson language', {'Nelson', 'toolbox'});]]></example_item_data>
    </example_item>
  </examples>
