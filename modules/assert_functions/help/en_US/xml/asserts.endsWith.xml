  <language>en_US</language>
  <keyword>asserts.endsWith</keyword>
  <short_description>Check that text ends with a suffix.</short_description>
  <syntax>
    <syntax_item>asserts.endsWith(text, suffix)</syntax_item>
    <syntax_item>[res, msg] = asserts.endsWith(text, suffix)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>text</param_name><param_description>Character vector or string scalar to test.</param_description></param_input_item>
    <param_input_item><param_name>suffix</param_name><param_description>Expected suffix.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when text ends with suffix.</p>
    <p>With outputs, a missing suffix is returned as an assertion failure.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Expected suffix</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.endsWith('Nelson language', 'language');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a suffix failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.endsWith('Nelson language', 'Nelson');]]></example_item_data>
    </example_item>
  </examples>
