  <language>en_US</language>
  <keyword>asserts.warning</keyword>
  <short_description>Check that a command emits the expected warning.</short_description>
  <syntax>
    <syntax_item>asserts.warning(command, expectedWarning)</syntax_item>
    <syntax_item>asserts.warning(command, expectedMessage, expectedIdentifier)</syntax_item>
    <syntax_item>[res, msg] = asserts.warning(command, expectedWarning)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>command</param_name><param_description>Command string evaluated in the current context.</param_description></param_input_item>
    <param_input_item><param_name>expectedWarning</param_name><param_description>Expected warning message substring or warning identifier.</param_description></param_input_item>
    <param_input_item><param_name>expectedMessage</param_name><param_description>Expected warning message.</param_description></param_input_item>
    <param_input_item><param_name>expectedIdentifier</param_name><param_description>Expected warning identifier.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when the command emits a matching warning.</p>
    <p>The two-argument form accepts either the warning message text or the warning identifier.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Expected warning text</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.warning('warning(''Nelson:asserts:example'', ''expected warning'');', 'expected warning');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a missing warning</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.warning('1 + 1', 'expected warning');]]></example_item_data>
    </example_item>
  </examples>
