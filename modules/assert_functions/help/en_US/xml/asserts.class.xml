  <language>en_US</language>
  <keyword>asserts.class</keyword>
  <short_description>Check that a value has the expected class.</short_description>
  <syntax>
    <syntax_item>asserts.class(value, expectedClass)</syntax_item>
    <syntax_item>[res, msg] = asserts.class(value, expectedClass)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Value to test.</param_description></param_input_item>
    <param_input_item><param_name>expectedClass</param_name><param_description>Expected class name as a character vector or string scalar.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when class(value) matches expectedClass.</p>
    <p>Use asserts.type to accept one class among several allowed classes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Expected class</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.class(single(1), 'single');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a class failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.class(int32(1), 'double');]]></example_item_data>
    </example_item>
  </examples>
