  <language>en_US</language>
  <keyword>asserts.allfalse</keyword>
  <short_description>Check that every logical entry is false.</short_description>
  <syntax>
    <syntax_item>asserts.allfalse(value)</syntax_item>
    <syntax_item>[res, msg] = asserts.allfalse(value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Logical scalar or array.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when every logical entry is false.</p>
    <p>Non-logical inputs raise an argument error immediately.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>All false</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.allfalse([false false]);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a true entry</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.allfalse([false true]);]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${assert_functions}asserts.alltrue">asserts.alltrue</link></see_also_item>
    <see_also_item><link linkend="${assert_functions}asserts.isfalse">asserts.isfalse</link></see_also_item>
  </see_also>
