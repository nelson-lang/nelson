  <language>en_US</language>
  <keyword>asserts.notEqual</keyword>
  <short_description>Check that two values are not equal.</short_description>
  <syntax>
    <syntax_item>asserts.notEqual(computed, expected)</syntax_item>
    <syntax_item>[res, msg] = asserts.notEqual(computed, expected)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>computed</param_name><param_description>Computed value.</param_description></param_input_item>
    <param_input_item><param_name>expected</param_name><param_description>Value that must not be equal to computed.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when asserts.isequal would fail.</p>
    <p>It is useful for negative equality checks in tests.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Different values</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.notEqual(1, 2);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture an equality failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.notEqual(1, 1);]]></example_item_data>
    </example_item>
  </examples>
