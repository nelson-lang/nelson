  <keyword>asserts.greaterThan</keyword>
  <short_description>Check that every value is strictly greater than a limit.</short_description>
  <syntax>
    <syntax_item>asserts.greaterThan(value, limit)</syntax_item>
    <syntax_item>[res, msg] = asserts.greaterThan(value, limit)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Real numeric or logical scalar or array.</param_description></param_input_item>
    <param_input_item><param_name>limit</param_name><param_description>Real numeric or logical scalar or array. Scalar expansion is supported.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when value &gt; limit for every compared element.</p>
    <p>Arrays must have the same dimensions unless one input is scalar.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Scalar expansion</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.greaterThan([2 3], 1);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a relation failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.greaterThan([0 3], 1);]]></example_item_data>
    </example_item>
  </examples>
