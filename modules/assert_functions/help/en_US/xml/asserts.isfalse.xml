  <language>en_US</language>
  <keyword>asserts.isfalse</keyword>
  <short_description>Check that a logical condition is false.</short_description>
  <syntax>
    <syntax_item>asserts.isfalse(condition)</syntax_item>
    <syntax_item>asserts.isfalse(condition, message)</syntax_item>
    <syntax_item>[res, msg] = asserts.isfalse(condition)</syntax_item>
    <syntax_item>[res, msg] = asserts.isfalse(condition, message)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>condition</param_name><param_description>Logical scalar or array to test. Every entry must be false.</param_description></param_input_item>
    <param_input_item><param_name>message</param_name><param_description>Optional custom failure message.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>This is the method-style form of assert_isfalse.</p>
    <p>With no output, a failed assertion raises an error. With outputs, the function returns false and the failure message.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Passing condition</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.isfalse(3 < 2);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.isfalse(true, 'condition failed');]]></example_item_data>
    </example_item>
  </examples>
