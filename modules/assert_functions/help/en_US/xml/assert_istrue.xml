  <language>en_US</language>
  <keyword>assert_istrue</keyword>
  <short_description>Historical name for asserts.istrue.</short_description>
  <syntax>
    <syntax_item>assert_istrue(condition)</syntax_item>
    <syntax_item>assert_istrue(condition, message)</syntax_item>
    <syntax_item>[res, msg] = assert_istrue(condition)</syntax_item>
    <syntax_item>[res, msg] = assert_istrue(condition, message)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>condition</param_name><param_description>Logical scalar or array to test. Every entry must be true.</param_description></param_input_item>
    <param_input_item><param_name>message</param_name><param_description>Optional custom failure message.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>Assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>assert_istrue</b> is kept for compatibility.</p>
    <p>For complete documentation, use <link linkend="${assert_functions}asserts.istrue">asserts.istrue</link>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Historical call</example_item_description><example_item_data runnable="cli"><![CDATA[assert_istrue(3 == 3);]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Canonical call</example_item_description><example_item_data runnable="cli"><![CDATA[asserts.istrue(true);]]></example_item_data></example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${assert_functions}asserts.istrue">asserts.istrue</link></see_also_item>
