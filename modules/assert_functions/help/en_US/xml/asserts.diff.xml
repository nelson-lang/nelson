  <language>en_US</language>
  <keyword>asserts.diff</keyword>
  <short_description>Return equality diagnostics without throwing.</short_description>
  <syntax>
    <syntax_item>msg = asserts.diff(computed, expected)</syntax_item>
    <syntax_item>[res, msg] = asserts.diff(computed, expected)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>computed</param_name><param_description>Computed value.</param_description></param_input_item>
    <param_input_item><param_name>expected</param_name><param_description>Expected value.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>This is a diagnostic helper, not a failing assertion.</p>
    <p>It returns the same style of message as asserts.isequal for comparison failures.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Inspect a difference</example_item_description>
      <example_item_data runnable="cli"><![CDATA[msg = asserts.diff([1 2], [1 3]);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Check equality status</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.diff([1 2], [1 2]);]]></example_item_data>
    </example_item>
  </examples>
