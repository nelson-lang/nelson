  <language>en_US</language>
  <keyword>asserts.type</keyword>
  <short_description>Check that a value has one of the expected classes.</short_description>
  <syntax>
    <syntax_item>asserts.type(value, expectedTypes)</syntax_item>
    <syntax_item>[res, msg] = asserts.type(value, expectedTypes)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Value to test.</param_description></param_input_item>
    <param_input_item><param_name>expectedTypes</param_name><param_description>Class name or class name list as string array or cell of character vectors.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when class(value) is present in expectedTypes.</p>
    <p>The expected type list must not be empty.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>One of several classes</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.type(single(1), {'double', 'single'});]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a type failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.type(int32(1), {'double', 'single'});]]></example_item_data>
    </example_item>
  </examples>
