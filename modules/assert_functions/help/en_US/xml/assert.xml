  <language>en_US</language>
  <keyword>assert</keyword>
  <short_description>Check that a condition is true.</short_description>
  <syntax>
    <syntax_item>assert(condition)</syntax_item>
    <syntax_item>assert(condition, message)</syntax_item>
    <syntax_item>assert(condition, message, value)</syntax_item>
    <syntax_item>assert(condition, identifier, message)</syntax_item>
    <syntax_item>assert(condition, identifier, message, value)</syntax_item>
    <syntax_item>[res, msg] = assert(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>condition</param_name><param_description>Logical or real numeric scalar or array to test. Every entry must be nonzero.</param_description></param_input_item>
    <param_input_item><param_name>message</param_name><param_description>Optional custom failure message. Format replacements are supported with following values.</param_description></param_input_item>
    <param_input_item><param_name>identifier</param_name><param_description>Optional error identifier used when the assertion raises an error.</param_description></param_input_item>
    <param_input_item><param_name>value</param_name><param_description>Optional value inserted in the message format.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>Assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>assert</b> raises an error when condition is false and no output is requested.</p>
    <p>With outputs, assertion failures are returned as <b>res</b> and <b>msg</b> instead of being raised.</p>
    <p>Use the <b>asserts</b> package for qualified assertion helpers, for example <b>asserts.isequal(...)</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Passing condition</example_item_description><example_item_data runnable="cli"><![CDATA[assert(5 > 3);]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Custom message</example_item_description><example_item_data runnable="cli"><![CDATA[[res, msg] = assert(false, 'condition failed');]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Formatted message</example_item_description><example_item_data runnable="cli"><![CDATA[[res, msg] = assert(false, 'value %.2f', 1.234);]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Error identifier</example_item_description><example_item_data runnable="cli"><![CDATA[[res, msg] = assert(false, 'Nelson:asserts:example', 'condition failed');]]></example_item_data></example_item>
  </examples>
