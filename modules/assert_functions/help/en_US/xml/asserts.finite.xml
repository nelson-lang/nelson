  <language>en_US</language>
  <keyword>asserts.finite</keyword>
  <short_description>Check that every numeric entry is finite.</short_description>
  <syntax>
    <syntax_item>asserts.finite(value)</syntax_item>
    <syntax_item>[res, msg] = asserts.finite(value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Numeric or logical scalar or array.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when every entry is finite.</p>
    <p>NaN, Inf and -Inf fail this assertion.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Finite values</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.finite([1 2 3]);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture an infinite value</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.finite([1 Inf]);]]></example_item_data>
    </example_item>
  </examples>
