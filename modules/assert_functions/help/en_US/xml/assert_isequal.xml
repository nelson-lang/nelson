  <language>en_US</language>
  <keyword>assert_isequal</keyword>
  <short_description>Historical name for asserts.isequal.</short_description>
  <syntax>
    <syntax_item>assert_isequal(computed, expected)</syntax_item>
    <syntax_item>assert_isequal(computed, expected, message)</syntax_item>
    <syntax_item>res = assert_isequal(computed, expected)</syntax_item>
    <syntax_item>[res, msg] = assert_isequal(computed, expected)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>computed</param_name><param_description>Computed value.</param_description></param_input_item>
    <param_input_item><param_name>expected</param_name><param_description>Expected value.</param_description></param_input_item>
    <param_input_item><param_name>message</param_name><param_description>Optional custom failure message.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if values are equal, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>Assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>assert_isequal</b> is kept for compatibility.</p>
    <p>For complete documentation, use <link linkend="${assert_functions}asserts.isequal">asserts.isequal</link>.</p>
  </description>
  <used_function>isequaln</used_function>
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Historical call</example_item_description><example_item_data runnable="cli"><![CDATA[assert_isequal([1 2], [1 2]);]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Canonical call</example_item_description><example_item_data runnable="cli"><![CDATA[asserts.isequal([1 2], [1 2]);]]></example_item_data></example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${assert_functions}asserts.isequal">asserts.isequal</link></see_also_item>
    <see_also_item><link linkend="${elementary_functions}isequaln">isequaln</link></see_also_item>
  </see_also>
