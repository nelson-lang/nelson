  <language>en_US</language>
  <keyword>asserts.hasField</keyword>
  <short_description>Check that a structure has a field.</short_description>
  <syntax>
    <syntax_item>asserts.hasField(s, fieldName)</syntax_item>
    <syntax_item>[res, msg] = asserts.hasField(s, fieldName)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>s</param_name><param_description>Structure value.</param_description></param_input_item>
    <param_input_item><param_name>fieldName</param_name><param_description>Expected field name as a character vector or string scalar.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when s contains fieldName.</p>
    <p>Invalid non-structure inputs raise an argument error immediately.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Existing field</example_item_description>
      <example_item_data runnable="cli"><![CDATA[S = struct('a', 1); asserts.hasField(S, 'a');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a missing field</example_item_description>
      <example_item_data runnable="cli"><![CDATA[S = struct('a', 1); [res, msg] = asserts.hasField(S, 'b');]]></example_item_data>
    </example_item>
  </examples>
