  <language>en_US</language>
  <keyword>asserts.throws</keyword>
  <short_description>Check that a command throws an error containing expected text.</short_description>
  <syntax>
    <syntax_item>asserts.throws(command, expectedSubstring)</syntax_item>
    <syntax_item>asserts.throws(command, expectedSubstring, expectedIdentifier)</syntax_item>
    <syntax_item>[res, msg] = asserts.throws(command, expectedSubstring)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>command</param_name><param_description>Command string evaluated in the current context.</param_description></param_input_item>
    <param_input_item><param_name>expectedSubstring</param_name><param_description>Expected substring in the error message.</param_description></param_input_item>
    <param_input_item><param_name>expectedIdentifier</param_name><param_description>Optional expected error identifier.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true if the assertion passes, false otherwise.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>assertion failure message, empty on success.</param_description></param_output_item>
  </param_output>
  <description>
    <p>The assertion passes when the command raises an error whose message contains expectedSubstring.</p>
    <p>Use asserts.checkerror when the full error message must match.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Expected error substring</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.throws('cos', 'Not enough input arguments.');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture missing error</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.throws('1 + 1', 'unused');]]></example_item_data>
    </example_item>
  </examples>
