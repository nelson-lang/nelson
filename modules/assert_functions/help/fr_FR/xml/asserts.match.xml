  <language>fr_FR</language>
  <keyword>asserts.match</keyword>
  <short_description>Vérifie qu&apos;un texte correspond à une expression régulière.</short_description>
  <syntax>
    <syntax_item>asserts.match(text, pattern)</syntax_item>
    <syntax_item>[res, msg] = asserts.match(text, pattern)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>text</param_name><param_description>Vecteur de caractères ou scalaire string à tester.</param_description></param_input_item>
    <param_input_item><param_name>pattern</param_name><param_description>Motif d&apos;expression régulière.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion réussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;échec de l&apos;assertion, vide en cas de succès.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion réussit lorsque pattern correspond à text.</p>
    <p>Les expressions régulières invalides levent immédiatement une erreur d&apos;argument.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Regular expression match</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.match('abc123', '^abc[0-9]+$');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a missing match</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.match('abc', '[0-9]+');]]></example_item_data>
    </example_item>
  </examples>
