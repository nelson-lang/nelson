  <language>fr_FR</language>
  <keyword>assert_checkerror</keyword>
  <short_description>Nom historique de asserts.checkerror.</short_description>
  <syntax>
    <syntax_item>assert_checkerror(command, expectedMessage)</syntax_item>
    <syntax_item>assert_checkerror(command, expectedMessage, expectedIdentifier)</syntax_item>
    <syntax_item>[res, msg] = assert_checkerror(command, expectedMessage)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>command</param_name><param_description>Commande texte evaluee dans le contexte courant.</param_description></param_input_item>
    <param_input_item><param_name>expectedMessage</param_name><param_description>Message d'erreur complet attendu.</param_description></param_input_item>
    <param_input_item><param_name>expectedIdentifier</param_name><param_description>Identifiant d'erreur attendu optionnel.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l'erreur attendue est produite, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>Message d'echec de l'assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>assert_checkerror</b> est conservee pour compatibilite.</p>
    <p>Pour la documentation complete, utiliser <link linkend="${assert_functions}asserts.checkerror">asserts.checkerror</link>.</p>
    <p>Utiliser <link linkend="${assert_functions}asserts.throws">asserts.throws</link> lorsque seule une sous-chaine du message doit correspondre.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Appel historique</example_item_description><example_item_data runnable="cli"><![CDATA[assert_checkerror('cos', 'Not enough input arguments.');]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Appel canonique</example_item_description><example_item_data runnable="cli"><![CDATA[asserts.checkerror('cos', 'Not enough input arguments.');]]></example_item_data></example_item>
  </examples>
