  <language>fr_FR</language>
  <keyword>asserts.satisfies</keyword>
  <short_description>Verifie une valeur avec un predicat personnalise.</short_description>
  <syntax>
    <syntax_item>asserts.satisfies(value, predicate)</syntax_item>
    <syntax_item>[res, msg] = asserts.satisfies(value, predicate)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Valeur passee comme unique entree au predicat.</param_description></param_input_item>
    <param_input_item><param_name>predicate</param_name><param_description>Handle de fonction ou nom de fonction. Il doit retourner un scalaire logique.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque predicate(value) retourne le scalaire logique true.</p>
    <p>Les predicats invalides ou les resultats non logiques levent immediatement une erreur d&apos;argument.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Named predicate</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.satisfies(1, 'isnumeric');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Function handle predicate</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.satisfies(1, @(x) isscalar(x));]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture predicate failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.satisfies([1 2], @(x) isscalar(x));]]></example_item_data>
    </example_item>
  </examples>
