  <language>fr_FR</language>
  <keyword>asserts.nonNan</keyword>
  <short_description>Verifie qu&apos;aucune entree numerique ne vaut NaN.</short_description>
  <syntax>
    <syntax_item>asserts.nonNan(value)</syntax_item>
    <syntax_item>[res, msg] = asserts.nonNan(value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Scalaire ou tableau numerique ou logique.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsqu&apos;aucune entree ne vaut NaN.</p>
    <p>Les valeurs infinies sont autorisees par cette assertion.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>No NaN values</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.nonNan([1 Inf]);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a NaN value</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.nonNan([1 NaN]);]]></example_item_data>
    </example_item>
  </examples>
