  <language>fr_FR</language>
  <keyword>asserts.throws</keyword>
  <short_description>Verifie qu&apos;une commande genere une erreur contenant le texte attendu.</short_description>
  <syntax>
    <syntax_item>asserts.throws(command, expectedSubstring)</syntax_item>
    <syntax_item>asserts.throws(command, expectedSubstring, expectedIdentifier)</syntax_item>
    <syntax_item>[res, msg] = asserts.throws(command, expectedSubstring)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>command</param_name><param_description>Commande texte evaluee dans le contexte courant.</param_description></param_input_item>
    <param_input_item><param_name>expectedSubstring</param_name><param_description>Sous-chaine attendue dans le message d&apos;erreur.</param_description></param_input_item>
    <param_input_item><param_name>expectedIdentifier</param_name><param_description>Identifiant d&apos;erreur attendu optionnel.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque la commande leve une erreur dont le message contient expectedSubstring.</p>
    <p>Utiliser asserts.checkerror lorsque le message complet doit correspondre.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Expected error substring</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.throws('cos', 'Not enough input arguments.');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture missing error</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.throws('1 + 1', 'unused');]]></example_item_data>
    </example_item>
  </examples>
