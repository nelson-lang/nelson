  <language>fr_FR</language>
  <keyword>asserts.empty</keyword>
  <short_description>Vérifie qu&apos;une valeur est vide.</short_description>
  <syntax>
    <syntax_item>asserts.empty(value)</syntax_item>
    <syntax_item>[res, msg] = asserts.empty(value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Valeur à tester.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion réussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;échec de l&apos;assertion, vide en cas de succès.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion réussit lorsque value n&apos;a aucun élément.</p>
    <p>Les diagnostics incluent les dimensions calculées.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Empty value</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.empty([]);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a non-empty value</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.empty(1);]]></example_item_data>
    </example_item>
  </examples>
