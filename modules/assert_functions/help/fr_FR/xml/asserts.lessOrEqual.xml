  <language>fr_FR</language>
  <keyword>asserts.lessOrEqual</keyword>
  <short_description>Vérifie que chaque valeur est inférieure ou égale à une limite.</short_description>
  <syntax>
    <syntax_item>asserts.lessOrEqual(value, limit)</syntax_item>
    <syntax_item>[res, msg] = asserts.lessOrEqual(value, limit)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Scalaire ou tableau réel numérique ou logique.</param_description></param_input_item>
    <param_input_item><param_name>limit</param_name><param_description>Scalaire ou tableau réel numérique ou logique. L&apos;expansion scalaire est supportée.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion réussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;échec de l&apos;assertion, vide en cas de succès.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion réussit lorsque value &lt;= limit pour chaque élément comparé.</p>
    <p>Les tableaux doivent avoir les mêmes dimensions sauf si une entrée est scalaire.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Élément-wise comparison</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.lessOrEqual([1 2], [1 2]);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a relation failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.lessOrEqual([1 4], 3);]]></example_item_data>
    </example_item>
  </examples>
