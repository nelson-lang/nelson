  <keyword>asserts.rowVector</keyword>
  <short_description>Verifie qu&apos;une valeur est un vecteur ligne.</short_description>
  <syntax>
    <syntax_item>asserts.rowVector(value)</syntax_item>
    <syntax_item>[res, msg] = asserts.rowVector(value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Valeur a tester.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque value a la forme d&apos;un vecteur ligne.</p>
    <p>Les diagnostics indiquent la classe et les dimensions calculees.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Row vector</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.rowVector([1 2]);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a shape failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.rowVector([1; 2]);]]></example_item_data>
    </example_item>
  </examples>
