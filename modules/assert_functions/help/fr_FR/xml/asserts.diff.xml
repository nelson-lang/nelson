  <language>fr_FR</language>
  <keyword>asserts.diff</keyword>
  <short_description>Retourne les diagnostics d&apos;egalite sans lever d&apos;erreur.</short_description>
  <syntax>
    <syntax_item>msg = asserts.diff(computed, expected)</syntax_item>
    <syntax_item>[res, msg] = asserts.diff(computed, expected)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>computed</param_name><param_description>Valeur calculee.</param_description></param_input_item>
    <param_input_item><param_name>expected</param_name><param_description>Valeur attendue.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>C&apos;est un helper de diagnostic, pas une assertion qui leve une erreur.</p>
    <p>Il retourne le meme style de message que asserts.isequal pour les echecs de comparaison.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Inspect a difference</example_item_description>
      <example_item_data runnable="cli"><![CDATA[msg = asserts.diff([1 2], [1 3]);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Check equality status</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.diff([1 2], [1 2]);]]></example_item_data>
    </example_item>
  </examples>
