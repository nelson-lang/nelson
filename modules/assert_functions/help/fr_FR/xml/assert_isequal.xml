  <language>fr_FR</language>
  <keyword>assert_isequal</keyword>
  <short_description>Nom historique de asserts.isequal.</short_description>
  <syntax>
    <syntax_item>assert_isequal(computed, expected)</syntax_item>
    <syntax_item>assert_isequal(computed, expected, message)</syntax_item>
    <syntax_item>res = assert_isequal(computed, expected)</syntax_item>
    <syntax_item>[res, msg] = assert_isequal(computed, expected)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>computed</param_name><param_description>Valeur calculée.</param_description></param_input_item>
    <param_input_item><param_name>expected</param_name><param_description>Valeur attendue.</param_description></param_input_item>
    <param_input_item><param_name>message</param_name><param_description>Message d'échec personnalisé optionnel.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si les valeurs sont égales, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>Message d'échec de l'assertion, vide en cas de succès.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>assert_isequal</b> est conservée pour compatibilité.</p>
    <p>Pour la documentation complète, utiliser <link linkend="${assert_functions}asserts.isequal">asserts.isequal</link>.</p>
  </description>
  <used_function>isequaln</used_function>
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Appel historique</example_item_description><example_item_data runnable="cli"><![CDATA[assert_isequal([1 2], [1 2]);]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Appel canonique</example_item_description><example_item_data runnable="cli"><![CDATA[asserts.isequal([1 2], [1 2]);]]></example_item_data></example_item>
  </examples>
