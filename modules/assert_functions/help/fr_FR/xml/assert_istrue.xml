  <keyword>assert_istrue</keyword>
  <short_description>Nom historique de asserts.istrue.</short_description>
  <syntax>
    <syntax_item>assert_istrue(condition)</syntax_item>
    <syntax_item>assert_istrue(condition, message)</syntax_item>
    <syntax_item>[res, msg] = assert_istrue(condition)</syntax_item>
    <syntax_item>[res, msg] = assert_istrue(condition, message)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>condition</param_name><param_description>Scalaire ou tableau logique a tester. Chaque entree doit etre true.</param_description></param_input_item>
    <param_input_item><param_name>message</param_name><param_description>Message d'echec personnalise optionnel.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l'assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>Message d'echec de l'assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>assert_istrue</b> est conservee pour compatibilite.</p>
    <p>Pour la documentation complete, utiliser <link linkend="${assert_functions}asserts.istrue">asserts.istrue</link>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Appel historique</example_item_description><example_item_data runnable="cli"><![CDATA[assert_istrue(3 == 3);]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Appel canonique</example_item_description><example_item_data runnable="cli"><![CDATA[asserts.istrue(true);]]></example_item_data></example_item>
  </examples>
