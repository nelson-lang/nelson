  <language>fr_FR</language>
  <keyword>asserts.contains</keyword>
  <short_description>Verifie qu&apos;un texte contient un motif.</short_description>
  <syntax>
    <syntax_item>asserts.contains(text, pattern)</syntax_item>
    <syntax_item>[res, msg] = asserts.contains(text, pattern)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>text</param_name><param_description>Vecteur de caracteres ou scalaire string a tester.</param_description></param_input_item>
    <param_input_item><param_name>pattern</param_name><param_description>Motif texte attendu.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque pattern est trouve dans text.</p>
    <p>Utiliser asserts.containsAll ou asserts.containsAny pour une liste de motifs.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Pattern present</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.contains('Nelson language', 'language');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a missing pattern</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.contains('Nelson language', 'toolbox');]]></example_item_data>
    </example_item>
  </examples>
