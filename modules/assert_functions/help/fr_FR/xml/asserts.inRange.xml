  <language>fr_FR</language>
  <keyword>asserts.inRange</keyword>
  <short_description>Verifie que chaque valeur est dans un intervalle inclusif.</short_description>
  <syntax>
    <syntax_item>asserts.inRange(value, minValue, maxValue)</syntax_item>
    <syntax_item>[res, msg] = asserts.inRange(value, minValue, maxValue)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Scalaire ou tableau reel numerique ou logique.</param_description></param_input_item>
    <param_input_item><param_name>minValue</param_name><param_description>Borne inferieure inclusive. L&apos;expansion scalaire est supportee.</param_description></param_input_item>
    <param_input_item><param_name>maxValue</param_name><param_description>Borne superieure inclusive. L&apos;expansion scalaire est supportee.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque minValue &lt;= value &lt;= maxValue pour chaque element compare.</p>
    <p>Les bornes peuvent etre scalaires ou des tableaux de dimensions compatibles avec value.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Inclusive range</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.inRange([1 2], 0, 3);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture an out-of-range value</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.inRange([1 4], 0, 3);]]></example_item_data>
    </example_item>
  </examples>
