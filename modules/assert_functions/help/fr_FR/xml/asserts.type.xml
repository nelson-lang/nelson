  <language>fr_FR</language>
  <keyword>asserts.type</keyword>
  <short_description>Verifie qu&apos;une valeur a l&apos;une des classes attendues.</short_description>
  <syntax>
    <syntax_item>asserts.type(value, expectedTypes)</syntax_item>
    <syntax_item>[res, msg] = asserts.type(value, expectedTypes)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Valeur a tester.</param_description></param_input_item>
    <param_input_item><param_name>expectedTypes</param_name><param_description>Nom de classe ou liste de noms de classes sous forme de tableau de strings ou cellule de vecteurs de caracteres.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque class(value) est present dans expectedTypes.</p>
    <p>La liste des types attendus ne doit pas etre vide.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>One of several classes</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.type(single(1), {'double', 'single'});]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a type failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.type(int32(1), {'double', 'single'});]]></example_item_data>
    </example_item>
  </examples>
