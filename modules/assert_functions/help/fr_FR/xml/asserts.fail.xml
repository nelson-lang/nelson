  <language>fr_FR</language>
  <keyword>asserts.fail</keyword>
  <short_description>Force un echec d&apos;assertion.</short_description>
  <syntax>
    <syntax_item>asserts.fail()</syntax_item>
    <syntax_item>asserts.fail(message)</syntax_item>
    <syntax_item>[res, msg] = asserts.fail(message)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>message</param_name><param_description>Message d&apos;echec personnalise optionnel.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>Utiliser cette assertion pour marquer un chemin d&apos;execution qui ne doit pas etre atteint.</p>
    <p>Avec sorties, aucune erreur n&apos;est levee et res vaut false.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a forced failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.fail('unreachable branch');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Raise a forced failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[try; asserts.fail('unreachable branch'); catch ME; disp(ME.message); end]]></example_item_data>
    </example_item>
  </examples>
