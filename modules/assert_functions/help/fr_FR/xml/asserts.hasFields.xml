  <language>fr_FR</language>
  <keyword>asserts.hasFields</keyword>
  <short_description>Verifie qu&apos;une structure possede tous les champs attendus.</short_description>
  <syntax>
    <syntax_item>asserts.hasFields(s, expectedFields)</syntax_item>
    <syntax_item>[res, msg] = asserts.hasFields(s, expectedFields)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>s</param_name><param_description>Valeur structure.</param_description></param_input_item>
    <param_input_item><param_name>expectedFields</param_name><param_description>Liste de noms de champs sous forme de vecteur de caracteres, scalaire string, tableau de strings ou cellule de vecteurs de caracteres.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque chaque champ attendu existe dans s.</p>
    <p>Les champs supplementaires dans s sont autorises.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Fields present</example_item_description>
      <example_item_data runnable="cli"><![CDATA[S = struct('a', 1, 'b', 2); asserts.hasFields(S, {'a', 'b'});]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a missing field</example_item_description>
      <example_item_data runnable="cli"><![CDATA[S = struct('a', 1); [res, msg] = asserts.hasFields(S, {'a', 'b'});]]></example_item_data>
    </example_item>
  </examples>
