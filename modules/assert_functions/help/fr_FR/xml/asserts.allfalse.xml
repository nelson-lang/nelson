  <language>fr_FR</language>
  <keyword>asserts.allfalse</keyword>
  <short_description>Verifie que chaque entree logique vaut false.</short_description>
  <syntax>
    <syntax_item>asserts.allfalse(value)</syntax_item>
    <syntax_item>[res, msg] = asserts.allfalse(value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Scalaire ou tableau logique.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque chaque entree logique vaut false.</p>
    <p>Les entrees non logiques levent immediatement une erreur d&apos;argument.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>All false</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.allfalse([false false]);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a true entry</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.allfalse([false true]);]]></example_item_data>
    </example_item>
  </examples>
