  <language>fr_FR</language>
  <keyword>asserts.notApprox</keyword>
  <short_description>Verifie que deux valeurs numeriques ne sont pas approximativement egales.</short_description>
  <syntax>
    <syntax_item>asserts.notApprox(computed, expected, relTol)</syntax_item>
    <syntax_item>asserts.notApprox(computed, expected, relTol, absTol)</syntax_item>
    <syntax_item>[res, msg] = asserts.notApprox(computed, expected, relTol)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>computed</param_name><param_description>Valeur numerique calculee.</param_description></param_input_item>
    <param_input_item><param_name>expected</param_name><param_description>Valeur qui ne doit pas etre approximativement egale a computed.</param_description></param_input_item>
    <param_input_item><param_name>relTol</param_name><param_description>Tolerance relative finie non negative.</param_description></param_input_item>
    <param_input_item><param_name>absTol</param_name><param_description>Tolerance absolue finie non negative optionnelle.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque asserts.isapprox echouerait.</p>
    <p>Les deux tolerances doivent etre des scalaires numeriques finis non negatifs.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Different numeric values</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.notApprox(1, 2, eps);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture approximate equality</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.notApprox(1, 1, eps);]]></example_item_data>
    </example_item>
  </examples>
