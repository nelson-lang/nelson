  <language>fr_FR</language>
  <keyword>asserts.istrue</keyword>
  <short_description>Verifie qu&apos;une condition logique est vraie.</short_description>
  <syntax>
    <syntax_item>asserts.istrue(condition)</syntax_item>
    <syntax_item>asserts.istrue(condition, message)</syntax_item>
    <syntax_item>[res, msg] = asserts.istrue(condition)</syntax_item>
    <syntax_item>[res, msg] = asserts.istrue(condition, message)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>condition</param_name><param_description>Scalaire ou tableau logique a tester. Chaque entree doit etre true.</param_description></param_input_item>
    <param_input_item><param_name>message</param_name><param_description>Message d&apos;echec personnalise optionnel.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>Forme methode de assert_istrue.</p>
    <p>Sans sortie, un echec leve une erreur. Avec sorties, la fonction retourne false et le message d&apos;echec.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Passing condition</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.istrue(3 > 2);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.istrue(false, 'condition failed');]]></example_item_data>
    </example_item>
  </examples>
