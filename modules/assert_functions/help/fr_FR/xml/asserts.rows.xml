  <language>fr_FR</language>
  <keyword>asserts.rows</keyword>
  <short_description>Verifie le nombre de lignes.</short_description>
  <syntax>
    <syntax_item>asserts.rows(value, n)</syntax_item>
    <syntax_item>[res, msg] = asserts.rows(value, n)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Valeur a tester.</param_description></param_input_item>
    <param_input_item><param_name>n</param_name><param_description>Nombre de lignes attendu, scalaire entier fini non negatif.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque size(value, 1) est egal a n.</p>
    <p>Un n invalide leve immediatement une erreur d&apos;argument.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Two rows</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.rows(ones(2, 3), 2);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a row-count failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.rows(ones(2, 3), 3);]]></example_item_data>
    </example_item>
  </examples>
