  <keyword>asserts.notEqual</keyword>
  <short_description>Verifie que deux valeurs ne sont pas egales.</short_description>
  <syntax>
    <syntax_item>asserts.notEqual(computed, expected)</syntax_item>
    <syntax_item>[res, msg] = asserts.notEqual(computed, expected)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>computed</param_name><param_description>Valeur calculee.</param_description></param_input_item>
    <param_input_item><param_name>expected</param_name><param_description>Valeur qui ne doit pas etre egale a computed.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque asserts.isequal echouerait.</p>
    <p>Elle sert aux controles negatifs d&apos;egalite dans les tests.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Different values</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.notEqual(1, 2);]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture an equality failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.notEqual(1, 1);]]></example_item_data>
    </example_item>
  </examples>
