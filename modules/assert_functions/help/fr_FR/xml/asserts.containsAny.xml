  <language>fr_FR</language>
  <keyword>asserts.containsAny</keyword>
  <short_description>Verifie qu&apos;un texte contient au moins un motif attendu.</short_description>
  <syntax>
    <syntax_item>asserts.containsAny(text, patterns)</syntax_item>
    <syntax_item>[res, msg] = asserts.containsAny(text, patterns)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>text</param_name><param_description>Vecteur de caracteres ou scalaire string a tester.</param_description></param_input_item>
    <param_input_item><param_name>patterns</param_name><param_description>Vecteur de caracteres, scalaire string, tableau de strings ou cellule de vecteurs de caracteres. Au moins un motif doit etre present.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsqu&apos;au moins un motif est trouve dans text.</p>
    <p>Utiliser asserts.containsAll lorsque chaque motif doit correspondre.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>One pattern present</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.containsAny('Nelson language', {'toolbox', 'Nelson'});]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture missing patterns</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.containsAny('Nelson language', {'toolbox', 'module'});]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${assert_functions}asserts.containsAll">asserts.containsAll</link></see_also_item>
    <see_also_item><link linkend="${assert_functions}asserts.contains">asserts.contains</link></see_also_item>
  </see_also>
