  <language>fr_FR</language>
  <keyword>asserts.noError</keyword>
  <short_description>Verifie qu&apos;une commande se termine sans erreur.</short_description>
  <syntax>
    <syntax_item>asserts.noError(command)</syntax_item>
    <syntax_item>[res, msg] = asserts.noError(command)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>command</param_name><param_description>Commande texte evaluee dans le contexte courant.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque l&apos;evaluation de la commande ne leve pas d&apos;erreur.</p>
    <p>Avec sorties, les erreurs inattendues sont retournees comme echecs d&apos;assertion au lieu d&apos;etre levees directement.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Command without error</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.noError('1 + 1');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture an unexpected error</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.noError('cos');]]></example_item_data>
    </example_item>
  </examples>
