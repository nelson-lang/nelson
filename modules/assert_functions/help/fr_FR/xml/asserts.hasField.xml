  <language>fr_FR</language>
  <keyword>asserts.hasField</keyword>
  <short_description>Verifie qu&apos;une structure possede un champ.</short_description>
  <syntax>
    <syntax_item>asserts.hasField(s, fieldName)</syntax_item>
    <syntax_item>[res, msg] = asserts.hasField(s, fieldName)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>s</param_name><param_description>Valeur structure.</param_description></param_input_item>
    <param_input_item><param_name>fieldName</param_name><param_description>Nom de champ attendu sous forme de vecteur de caracteres ou scalaire string.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque s contient fieldName.</p>
    <p>Les entrees non structure invalides levent immediatement une erreur d&apos;argument.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Existing field</example_item_description>
      <example_item_data runnable="cli"><![CDATA[S = struct('a', 1); asserts.hasField(S, 'a');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a missing field</example_item_description>
      <example_item_data runnable="cli"><![CDATA[S = struct('a', 1); [res, msg] = asserts.hasField(S, 'b');]]></example_item_data>
    </example_item>
  </examples>
