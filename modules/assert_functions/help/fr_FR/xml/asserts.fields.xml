  <language>fr_FR</language>
  <keyword>asserts.fields</keyword>
  <short_description>Verifie l&apos;ensemble exact des champs d&apos;une structure.</short_description>
  <syntax>
    <syntax_item>asserts.fields(s, expectedFields)</syntax_item>
    <syntax_item>[res, msg] = asserts.fields(s, expectedFields)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>s</param_name><param_description>Valeur structure.</param_description></param_input_item>
    <param_input_item><param_name>expectedFields</param_name><param_description>Liste exacte des noms de champs. L&apos;ordre des champs est ignore.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque s n&apos;a aucun champ manquant et aucun champ supplementaire.</p>
    <p>Utiliser asserts.hasFields lorsque les champs supplementaires sont autorises.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Exact field set</example_item_description>
      <example_item_data runnable="cli"><![CDATA[S = struct('a', 1, 'b', 2); asserts.fields(S, {'b', 'a'});]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture an extra field</example_item_description>
      <example_item_data runnable="cli"><![CDATA[S = struct('a', 1, 'b', 2); [res, msg] = asserts.fields(S, {'a'});]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${assert_functions}asserts.hasFields">asserts.hasFields</link></see_also_item>
  </see_also>
