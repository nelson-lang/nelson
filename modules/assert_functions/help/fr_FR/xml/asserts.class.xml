  <language>fr_FR</language>
  <keyword>asserts.class</keyword>
  <short_description>Verifie qu&apos;une valeur a la classe attendue.</short_description>
  <syntax>
    <syntax_item>asserts.class(value, expectedClass)</syntax_item>
    <syntax_item>[res, msg] = asserts.class(value, expectedClass)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>value</param_name><param_description>Valeur a tester.</param_description></param_input_item>
    <param_input_item><param_name>expectedClass</param_name><param_description>Nom de classe attendu sous forme de vecteur de caracteres ou scalaire string.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>res</param_name><param_description>true si l&apos;assertion reussit, false sinon.</param_description></param_output_item>
    <param_output_item><param_name>msg</param_name><param_description>message d&apos;echec de l&apos;assertion, vide en cas de succes.</param_description></param_output_item>
  </param_output>
  <description>
    <p>L&apos;assertion reussit lorsque class(value) correspond a expectedClass.</p>
    <p>Utiliser asserts.type pour accepter une classe parmi plusieurs classes autorisees.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Expected class</example_item_description>
      <example_item_data runnable="cli"><![CDATA[asserts.class(single(1), 'single');]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Capture a class failure</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[res, msg] = asserts.class(int32(1), 'double');]]></example_item_data>
    </example_item>
  </examples>
