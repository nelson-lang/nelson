  <language>en_US</language>
  <keyword>are</keyword>
  <short_description>Algebraic Riccati equation solution.</short_description>
  <syntax>
    <syntax_item>X = are(A, B, C)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>square state matrix.</param_description></param_input_item>
    <param_input_item><param_name>B</param_name><param_description>symmetric nonnegative matrix in the quadratic term.</param_description></param_input_item>
    <param_input_item><param_name>C</param_name><param_description>symmetric state-weighting matrix.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>X</param_name><param_description>stabilizing solution.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>are</b> solves <b>A' * X + X * A - X * B * X + C = 0</b>.</p>
  </description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
A = [-1 0; 0 -2];
B = [1 0; 0 0];
C = eye(2);
X = are(A, B, C)
]]></example_item_data></example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${control_system}care">care</link></see_also_item>
  </see_also>
