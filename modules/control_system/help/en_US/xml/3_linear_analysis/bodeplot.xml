  <language>en_US</language>
  <keyword>bodeplot</keyword>
  <short_description>Bode plot of a SISO LTI system with plotting options.</short_description>
  <syntax>
    <syntax_item>bodeplot(sys)</syntax_item>
    <syntax_item>bodeplot(sys, opt)</syntax_item>
    <syntax_item>bodeplot(sys, lineSpec)</syntax_item>
    <syntax_item>bodeplot(sys, opt, lineSpec)</syntax_item>
    <syntax_item>bodeplot(sys, w, ...)</syntax_item>
    <syntax_item>[magnitude, phase, w] = bodeplot(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>sys</param_name>
      <param_description>a SISO LTI model.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>opt</param_name>
      <param_description
      >an options structure returned by bodeoptions.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>lineSpec</param_name>
      <param_description>Line style, marker, and color.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>w</param_name>
      <param_description
      >a cell {wmin, wmax} or a frequency vector.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>magnitude</param_name>
      <param_description>Magnitude: size 1 x 1 x k (SISO).</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>phase</param_name>
      <param_description>Phase: size 1 x 1 x k (SISO).</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>w</param_name>
      <param_description>Frequencies: a vector: 1 x k.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>bodeplot(sys)</b> generates a Bode plot of the SISO LTI system <b>sys</b>, like <b>bode</b>.</p>
    <p><b>bodeplot(sys, opt)</b> applies the plotting options described by <b>opt</b> (see <b>bodeoptions</b>).</p>
    <p>When <b>opt.PhaseUnits</b> is <b>'rad'</b>, the phase is plotted in radians. When <b>opt.Grid</b> is <b>'on'</b>, a grid is displayed.</p>
    <p>A <b>lineSpec</b> character vector and a frequency specification <b>w</b> can also be provided, as with <b>bode</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[G = tf([3], [1 1/2 4]);
opt = bodeoptions();
opt.PhaseUnits = 'rad';
opt.Grid = 'on';
f = figure();
bodeplot(G, opt, '--');
]]></example_item_data>
      <example_item_img
        src="../../images/bodeplot_1.svg"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
