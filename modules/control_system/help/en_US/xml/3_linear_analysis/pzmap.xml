  <language>en_US</language>
  <keyword>pzmap</keyword>
  <short_description>Pole-zero map of a dynamic system.</short_description>
  <syntax>
    <syntax_item>pzmap(sys)</syntax_item>
    <syntax_item>[p, z] = pzmap(sys)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>sys</param_name>
      <param_description>Dynamic system: a SISO LTI model.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>Poles of the system.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>z</param_name>
      <param_description>Zeros of the system.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>pzmap(sys)</b> plots the poles and zeros of the dynamic system model <b>sys</b> in the complex plane.</p>
    <p>Each pole is marked with an <b>x</b> and each zero with an <b>o</b>.</p>
    <p
    >When output arguments are requested, <b>[p, z] = pzmap(sys)</b> returns the poles <b>p</b> and the zeros <b>z</b> without producing a plot.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[f = figure();
sys = tf([1 2], [1 3 2]);
pzmap(sys);
]]></example_item_data>
      <example_item_img
        src="../../images/pzmap_1.svg"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
