  <short_description>Singular value response of an LTI model.</short_description>
  <syntax><syntax_item>sigma(sys)</syntax_item><syntax_item>sv = sigma(sys, w)</syntax_item><syntax_item>[sv, wout] = sigma(sys, w)</syntax_item></syntax>
  <param_input><param_input_item><param_name>sys</param_name><param_description>LTI model.</param_description></param_input_item><param_input_item><param_name>w</param_name><param_description>Frequency vector in rad/s.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>sv</param_name><param_description>Singular values for each frequency.</param_description></param_output_item><param_output_item><param_name>wout</param_name><param_description>Frequency vector.</param_description></param_output_item></param_output>
  <description><p><b>sigma</b> computes singular values of the frequency response.</p></description>
