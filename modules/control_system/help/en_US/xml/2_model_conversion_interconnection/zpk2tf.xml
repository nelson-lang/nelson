  <language>en_US</language>
  <keyword>zpk2tf</keyword>
  <short_description
  >Convert zero-pole-gain model to transfer function.</short_description>
  <syntax>
    <syntax_item>sys = zpk2tf(zpkObj)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>zpkObj</param_name>
      <param_description>a zpk model.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>sys</param_name>
      <param_description>the equivalent tf model.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>sys = zpk2tf(zpkObj)</b> converts a zero-pole-gain model into an equivalent transfer function model.</p>
    <p>The sample time, variable and model metadata of the input model are preserved in the result.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[z = zpk([], [-1 -2], 3);
sys = zpk2tf(z)
]]></example_item_data>
    </example_item>
  </examples>
