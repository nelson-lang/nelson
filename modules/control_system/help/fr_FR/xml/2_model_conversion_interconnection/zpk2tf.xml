  <language>fr_FR</language>
  <keyword>zpk2tf</keyword>
  <short_description
  >Convertit un modèle zéros-pôles-gain en fonction de transfert.</short_description>
  <syntax>
    <syntax_item>sys = zpk2tf(zpkObj)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>zpkObj</param_name>
      <param_description>un modèle zpk.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>sys</param_name>
      <param_description>le modèle tf équivalent.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>sys = zpk2tf(zpkObj)</b> convertit un modèle zéros-pôles-gain en un modèle de fonction de transfert équivalent.</p>
    <p>Le temps d&apos;échantillonnage, la variable et les métadonnées du modèle d&apos;entrée sont conservés dans le résultat.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[z = zpk([], [-1 -2], 3);
sys = zpk2tf(z)
]]></example_item_data>
    </example_item>
  </examples>
