  <short_description>Réponse en valeurs singulières d'un modèle LTI.</short_description>
  <syntax><syntax_item>sigma(sys)</syntax_item><syntax_item>sv = sigma(sys, w)</syntax_item><syntax_item>[sv, wout] = sigma(sys, w)</syntax_item></syntax>
  <param_input><param_input_item><param_name>sys</param_name><param_description>Modèle LTI.</param_description></param_input_item><param_input_item><param_name>w</param_name><param_description>Vecteur de fréquences en rad/s.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>sv</param_name><param_description>Valeurs singulières pour chaque fréquence.</param_description></param_output_item><param_output_item><param_name>wout</param_name><param_description>Vecteur de fréquences.</param_description></param_output_item></param_output>
  <description><p><b>sigma</b> calcule les valeurs singulières de la réponse fréquentielle.</p></description>
