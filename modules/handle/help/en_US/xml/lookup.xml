  <language>en_US</language>
  <keyword>lookup</keyword>
  <short_description>Look up values in an object.</short_description>
  <syntax>
    <syntax_item>value = lookup(obj, ...)</syntax_item>
    <syntax_item>[value, found] = lookup(obj, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>obj</param_name>
      <param_description>object that implements keyed value lookup.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>key</param_name>
      <param_description>key to look up.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>value</param_name>
      <param_description>value associated with the key.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>found</param_name>
      <param_description>logical value indicating whether the lookup succeeded, when returned by the object implementation.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>lookup dispatches value lookup to the object type passed as first argument.</p>
    <p>If the first argument does not implement lookup, Nelson reports that the function is not implemented for that type.</p>
  </description>
  <used_function>
    <used_function_item>dictionary</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Look up a value in a dictionary through the generic function.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[d = dictionary(["one" "two"], [1 2]);
value = lookup(d, "two")]]></example_item_data>
    </example_item>
  </examples>
