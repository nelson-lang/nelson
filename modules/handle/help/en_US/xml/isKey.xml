  <language>en_US</language>
  <keyword>isKey</keyword>
  <short_description>Determine whether an object contains a key.</short_description>
  <syntax>
    <syntax_item>tf = isKey(obj, key)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>obj</param_name>
      <param_description>object that implements keyed lookup.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>key</param_name>
      <param_description>key to search for.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>logical value: true when the key exists.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>isKey dispatches key lookup to the object type passed as first argument.</p>
    <p>If the first argument does not implement keyed lookup, Nelson reports that the function is not implemented for that type.</p>
  </description>
  <used_function>
    <used_function_item>dictionary</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Test whether a dictionary contains a key.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[d = dictionary(["one" "two"], [1 2]);
tf = isKey(d, "two")]]></example_item_data>
    </example_item>
  </examples>
