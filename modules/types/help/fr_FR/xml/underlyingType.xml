  <language>fr_FR</language>
  <keyword>underlyingType</keyword>
  <short_description>Type sous-jacent d'un tableau</short_description>
  <syntax>
    <syntax_item>t = underlyingType(X)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>tableau d'entrée.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>t</param_name>
      <param_description>nom de la classe sous-jacente de X, sous forme de vecteur de caractères.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>underlyingType</b> retourne le nom de la classe sous-jacente de X. Pour les tableaux ordinaires, c'est identique à class(X) ; pour une énumération construite sur un type fondamental, il retourne ce type fondamental.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[underlyingType(int32(5))]]></example_item_data>
    </example_item>
  </examples>
