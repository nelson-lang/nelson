  <language>fr_FR</language>
  <keyword>isenum</keyword>
  <short_description>Détermine si l'entrée est une énumération</short_description>
  <syntax>
    <syntax_item>tf = isenum(X)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>valeur d'entrée.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>scalaire logique, vrai si X est une énumération.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>isenum</b> retourne vrai si X est une instance d'une classe d'énumération, et faux sinon.</p>
  </description>
