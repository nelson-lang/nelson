  <language>en_US</language>
  <keyword>memoize</keyword>
  <short_description>Add memoization to a function.</short_description>
  <syntax>
    <syntax_item>mf = memoize(fh)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>fh</param_name>
      <param_description>function handle to memoize.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>mf</param_name>
      <param_description>MemoizedFunction object that caches the results of fh.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>memoize</b> returns a MemoizedFunction that caches the outputs of the function handle fh. Calling the returned object with a set of inputs evaluates fh once for those inputs and returns the cached result on later calls with the same inputs. Set the Enabled property to false to bypass the cache, and use clearCache to empty it.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[mf = memoize(@(x) x .^ 2);
y = mf(4)]]></example_item_data>
    </example_item>
  </examples>
