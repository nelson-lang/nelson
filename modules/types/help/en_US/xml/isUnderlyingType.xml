  <language>en_US</language>
  <keyword>isUnderlyingType</keyword>
  <short_description>Check the underlying data type.</short_description>
  <syntax>
    <syntax_item>tf = isUnderlyingType(X, typename)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>any value.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>typename</param_name>
      <param_description>a class name, or a category: <b>'numeric'</b>, <b>'float'</b> or <b>'integer'</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>a logical scalar.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = isUnderlyingType(X, typename)</b> returns <b>true</b> when <b>underlyingType(X)</b> is <b>typename</b>, or belongs to the given category. For a gpuArray the type of the data on the device is used.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[isUnderlyingType(single(1), 'float')
isUnderlyingType(int8(1), 'single')]]></example_item_data>
    </example_item>
  </examples>
