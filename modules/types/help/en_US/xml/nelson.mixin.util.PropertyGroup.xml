  <keyword>nelson.mixin.util.PropertyGroup</keyword>
  <short_description>A titled group of properties for custom object display.</short_description>
  <syntax>
    <syntax_item>g = nelson.mixin.util.PropertyGroup(propertyList)</syntax_item>
    <syntax_item>g = nelson.mixin.util.PropertyGroup(propertyList, title)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>propertyList</param_name><param_description>cell array of property names.</param_description></param_input_item>
    <param_input_item><param_name>title</param_name><param_description>optional group title (char or string).</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>g</param_name><param_description>a scalar nelson.mixin.util.PropertyGroup.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>nelson.mixin.util.PropertyGroup</b> groups object properties for display. A
    <b>getPropertyGroups</b> method of a <b>nelson.mixin.CustomDisplay</b> subclass returns
    an array of property groups, each rendered with its title followed by its properties.</p>
    <p>Properties: <b>Title</b>, <b>PropertyList</b> and the read-only <b>NumProperties</b>.</p>
  </description>
  <used_function /><bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Create a property group.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[g = nelson.mixin.util.PropertyGroup({'X', 'Y'}, 'Coordinates');
g.Title
g.NumProperties]]></example_item_data>
    </example_item>
  </examples>
