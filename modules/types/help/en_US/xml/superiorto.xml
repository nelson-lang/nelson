  <keyword>superiorto</keyword>
  <short_description>Declare superior class precedence.</short_description>
  <syntax>
    <syntax_item>superiorto(class1, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>class1, ...</param_name>
      <param_description>class names, as character vectors.</param_description>
    </param_input_item>
  </param_input>
  <param_output />
  <description>
    <p><b>superiorto(class1, ...)</b> declares that the class being defined has higher precedence than the named classes when dispatching overloaded operators.</p>
    <p>It is called from a class constructor.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[superiorto('double')]]></example_item_data>
    </example_item>
  </examples>
