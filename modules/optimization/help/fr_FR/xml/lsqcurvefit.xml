<xmldoc>
  <copyright>SAME AS NELSON SOFTWARE</copyright><language>fr_FR</language><keyword>lsqcurvefit</keyword>
  <short_description>Ajustement de courbe par moindres carres.</short_description>
  <syntax><syntax_item>x = lsqcurvefit(fun, x0, xdata, ydata)</syntax_item><syntax_item>x = lsqcurvefit(fun, x0, xdata, ydata, lb, ub, options)</syntax_item></syntax>
  <param_input><param_input_item><param_name>fun</param_name><param_description>Fonction modele.</param_description></param_input_item><param_input_item><param_name>x0</param_name><param_description>Point initial.</param_description></param_input_item><param_input_item><param_name>xdata</param_name><param_description>Donnees d'entree du modele.</param_description></param_input_item><param_input_item><param_name>ydata</param_name><param_description>Donnees observees.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>Parametres ajustes.</param_description></param_output_item></param_output>
  <description><p><b>lsqcurvefit</b> minimise <b>fun(x, xdata) - ydata</b> avec <b>lsqnonlin</b>.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = lsqcurvefit(@(p,t) p(1) * exp(p(2) * t), [1; 0], (0:3).', exp((0:3).'))]]></example_item_data></example_item></examples>
