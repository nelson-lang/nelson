  <language>fr_FR</language>
  <keyword>solve</keyword>
  <short_description>Résoudre un objet problème d'optimization.</short_description>
  <syntax>
    <syntax_item>sol = solve(prob)</syntax_item>
    <syntax_item>[sol, fval, exitflag, output] = solve(prob, name, value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>prob</param_name>
      <param_description>objet problème d'optimization.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>name, value</param_name>
      <param_description>réglages facultatifs du solveur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>sol</param_name>
      <param_description>structure de solution.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>fval</param_name>
      <param_description>valeur de l'objectif.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>exitflag</param_name>
      <param_description>indicateur de terminaison.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>solve</b> compile un modèle problem-based pris en charge et appelle un solveur direct.</p>
  </description>
  <used_function>
    <used_function_item>prob2struct</used_function_item>
    <used_function_item>fminsearch</used_function_item>
  </used_function>
  <bibliography>J. Nocedal and S. J. Wright, Numerical Optimization, Springer, 2006.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = optimvar('x');
prob = optimproblem('Objective', (x - 2)^2);
[sol, fval] = solve(prob)
]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item>
      <link linkend="${optimization}optimproblem">optimproblem</link>
    </see_also_item>
    <see_also_item>
      <link linkend="${optimization}prob2struct">prob2struct</link>
    </see_also_item>
  </see_also>
