  <language>fr_FR</language>
  <keyword>optimoptions</keyword>
  <short_description>Créer des options de solveur.</short_description>
  <syntax>
    <syntax_item>options = optimoptions(solver)</syntax_item>
    <syntax_item>options = optimoptions(solver, name, value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>solver</param_name>
      <param_description>nom de solveur, function handle ou problème d'optimization.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>name, value</param_name>
      <param_description>paires nom-valeur d'options.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>options</param_name>
      <param_description>objet d'options du solveur.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>optimoptions</b> valide les noms d'options pour le solveur choisi et retourne un objet convertible en structure pour les solveurs directs.</p>
  </description>
  <used_function>
    <used_function_item>optimset</used_function_item>
  </used_function>
  <bibliography>P. E. Gill, W. Murray and M. H. Wright, Practical Optimization, Academic Press, 1981.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[opts = optimoptions('fsolve', 'TolFun', 1e-8);
[x, fval] = fsolve(@(x) x - 3, 0, opts)
]]></example_item_data>
    </example_item>
  </examples>
