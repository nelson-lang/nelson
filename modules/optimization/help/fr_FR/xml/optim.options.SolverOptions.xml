  <keyword>optim.options.SolverOptions</keyword>
  <short_description>Objet d&apos;options de solveur.</short_description>
  <syntax>
    <syntax_item>options = optimoptions(solver)</syntax_item>
    <syntax_item>options = optimoptions(problem)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>solver</param_name>
      <param_description>nom de solveur ou objet probleme utilise par optimoptions.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Name, Value</param_name>
      <param_description>noms et valeurs d&apos;options du solveur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>options</param_name>
      <param_description>objet d&apos;options de solveur.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>optim.options.SolverOptions stocke les valeurs d&apos;options de solveur creees par optimoptions.</p>
    <p>L&apos;objet est passe aux solveurs d&apos;optimisation ou a solve via le flux problem-based.</p>
  </description>
  <used_function>
    <used_function_item>optimoptions</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Creer des options pour fminsearch.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[opts = optimoptions('fminsearch', 'Display', 'off')]]></example_item_data>
    </example_item>
  </examples>
