  <language>fr_FR</language>
  <keyword>fminbnd</keyword>
  <short_description>Minimisation scalaire bornée.</short_description>
  <syntax>
    <syntax_item>x = fminbnd(fun, x1, x2)</syntax_item>
    <syntax_item>[x, fval, exitflag, output] = fminbnd(fun, x1, x2, options)</syntax_item>
    <syntax_item>x = fminbnd(problem)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>fun</param_name>
      <param_description>fonction objectif scalaire.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>x1, x2</param_name>
      <param_description>bornes finies de l'intervalle.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>options</param_name>
      <param_description>options du solveur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>x</param_name>
      <param_description>minimiseur estimé dans l'intervalle.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>fval</param_name>
      <param_description>valeur de l'objectif.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>exitflag</param_name>
      <param_description>indicateur de terminaison.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>output</param_name>
      <param_description>diagnostics.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>fminbnd</b> applique la méthode bornée de Brent, combinant recherche par section dorée et interpolation parabolique. Une structure problem peut contenir les champs objective, x1, x2 et options.</p>
  </description>
  <used_function>
    <used_function_item>optimset</used_function_item>
  </used_function>
  <bibliography>R. P. Brent, Algorithms for Minimization Without Derivatives, Prentice-Hall, 1973.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[[x, fval] = fminbnd(@(x) (x - 1.5)^2, -2, 4)
]]></example_item_data>
    </example_item>
  </examples>
