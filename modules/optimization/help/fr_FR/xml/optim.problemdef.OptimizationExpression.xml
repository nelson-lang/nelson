  <keyword>optim.problemdef.OptimizationExpression</keyword>
  <short_description>Expression d&apos;optimisation.</short_description>
  <syntax>
    <syntax_item>expr = optimexpr(...)</syntax_item>
    <syntax_item>expr = fcn2optimexpr(f, ...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>value</param_name>
      <param_description>valeur numerique, variable d&apos;optimisation ou expression utilisee pour creer une expression.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dimensions</param_name>
      <param_description>dimensions utilisees pour creer un tableau d&apos;expressions nulles.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>expr</param_name>
      <param_description>objet expression d&apos;optimisation.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>optim.problemdef.OptimizationExpression represente des expressions arithmetiques construites a partir de variables d&apos;optimisation.</p>
    <p>Les expressions peuvent servir d&apos;objectifs ou de parties de contraintes dans un modele problem-based.</p>
  </description>
  <used_function>
    <used_function_item>optimexpr</used_function_item>
    <used_function_item>optimvar</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Creer une expression scalaire a partir de variables d&apos;optimisation.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[x = optimvar('x', 2, 1);
expr = (x(1) - 1)^2 + (x(2) - 2)^2]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
