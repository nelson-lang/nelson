  <keyword>optim.problemdef.OptimizationConstraint</keyword>
  <short_description>Contraintes d&apos;optimisation.</short_description>
  <syntax>
    <syntax_item>constr = optimconstr(...)</syntax_item>
    <syntax_item>prob.Constraints.name = constr</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>left, relation, right</param_name>
      <param_description>expression gauche, operateur de relation et expression droite utilises pour construire une contrainte.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>prob.Constraints.name</param_name>
      <param_description>emplacement de contrainte nommee dans un probleme d&apos;optimisation.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>constr</param_name>
      <param_description>objet contrainte d&apos;optimisation.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>optim.problemdef.OptimizationConstraint represente des contraintes construites a partir de variables et d&apos;expressions d&apos;optimisation.</p>
    <p>Les contraintes sont attachees a un OptimizationProblem via sa propriete Constraints.</p>
  </description>
  <used_function>
    <used_function_item>optimvar</used_function_item>
    <used_function_item>optimproblem</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Construire une contrainte a partir de variables d&apos;optimisation.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[x = optimvar('x', 2, 1, 'LowerBound', 0);
constr = x(1) + x(2) <= 4]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
