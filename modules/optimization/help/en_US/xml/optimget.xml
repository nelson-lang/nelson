  <language>en_US</language>
  <keyword>optimget</keyword>
  <short_description>Read an optimization option value.</short_description>
  <syntax>
    <syntax_item>value = optimget(options, name)</syntax_item>
    <syntax_item>value = optimget(options, name, default)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>options</param_name>
      <param_description>structure or solver options object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>option name.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>default</param_name>
      <param_description>fallback value.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>value</param_name>
      <param_description>option value or default.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>optimget</b> retrieves a named option, using a default when the option is absent or empty.</p>
  </description>
  <used_function>
    <used_function_item>optimset</used_function_item>
  </used_function>
  <bibliography>J. Nocedal and S. J. Wright, Numerical Optimization, Springer, 2006.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[opts = optimset('MaxIter', 200);
maxiter = optimget(opts, 'MaxIter', 100)
]]></example_item_data>
    </example_item>
  </examples>
