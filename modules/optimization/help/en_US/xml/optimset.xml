  <language>en_US</language>
  <keyword>optimset</keyword>
  <short_description>Create or edit optimization option structures.</short_description>
  <syntax>
    <syntax_item>options = optimset()</syntax_item>
    <syntax_item>options = optimset(name, value)</syntax_item>
    <syntax_item>options = optimset(oldopts, name, value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>name, value</param_name>
      <param_description>option name and value pairs.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>oldopts</param_name>
      <param_description>existing option structure.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>options</param_name>
      <param_description>option structure.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>optimset</b> creates a structure accepted by the direct solvers in this module. Option names support unambiguous abbreviations.</p>
  </description>
  <used_function />
  <bibliography>J. Nocedal and S. J. Wright, Numerical Optimization, Springer, 2006.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[opts = optimset('TolX', 1e-8, 'Display', 'off')
tol = optimget(opts, 'TolX')
]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
