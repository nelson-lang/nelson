  <language>en_US</language>
  <keyword>optim.problemdef.OptimizationVariable</keyword>
  <short_description>Variable for optimization expressions.</short_description>
  <syntax>
    <syntax_item>x = optimvar(name)</syntax_item>
    <syntax_item>x = optimvar(name, n, m, Name, Value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>variable name used in generated expressions and solution structures.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n, m</param_name>
      <param_description>optional dimensions for vector or matrix variables.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Name, Value</param_name>
      <param_description>variable properties such as LowerBound, UpperBound, and Type.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>x</param_name>
      <param_description>optimization variable object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>optim.problemdef.OptimizationVariable represents scalar or array variables used to build optimization expressions.</p>
    <p>Create variables with optimvar, then combine them into objectives and constraints.</p>
  </description>
  <used_function>
    <used_function_item>optimvar</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Create a two-element variable and use it in an expression.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[x = optimvar('x', 2, 1, 'LowerBound', 0);
expr = (x(1) - 1)^2 + (x(2) - 2)^2]]></example_item_data>
    </example_item>
  </examples>
