  <language>en_US</language>
  <keyword>lsqnonneg</keyword>
  <short_description>Nonnegative linear least-squares solution.</short_description>
  <syntax>
    <syntax_item>x = lsqnonneg(C, d)</syntax_item>
    <syntax_item>[x, resnorm, residual, exitflag, output, lambda] = lsqnonneg(C, d, options)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>C</param_name>
      <param_description>coefficient matrix.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>d</param_name>
      <param_description>right-hand side vector.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>options</param_name>
      <param_description>solver options.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>x</param_name>
      <param_description>nonnegative least-squares solution.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>resnorm</param_name>
      <param_description>squared residual norm.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>residual</param_name>
      <param_description>d - C*x.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>lambda</param_name>
      <param_description>KKT multipliers for nonnegativity constraints.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>lsqnonneg</b> solves min norm(C*x-d)^2 subject to x &gt;= 0 using an active-set method.</p>
  </description>
  <used_function>
    <used_function_item>optimset</used_function_item>
  </used_function>
  <bibliography>C. L. Lawson and R. J. Hanson, Solving Least Squares Problems, SIAM, 1995.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[C = [1 0; 0 1; 1 1];
d = [1; 2; 3];
[x, resnorm] = lsqnonneg(C, d)
]]></example_item_data>
    </example_item>
  </examples>
