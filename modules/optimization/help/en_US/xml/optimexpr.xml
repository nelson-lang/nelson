  <language>en_US</language>
  <keyword>optimexpr</keyword>
  <short_description>Create an optimization expression.</short_description>
  <syntax>
    <syntax_item>expr = optimexpr()</syntax_item>
    <syntax_item>expr = optimexpr(value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>value</param_name>
      <param_description>numeric value or expression seed.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>expr</param_name>
      <param_description>optimization expression object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>optimexpr</b> creates an expression object that can be combined with optimization variables by arithmetic operators.</p>
  </description>
  <used_function>
    <used_function_item>optimvar</used_function_item>
    <used_function_item>evaluate</used_function_item>
  </used_function>
  <bibliography>J. Nocedal and S. J. Wright, Numerical Optimization, Springer, 2006.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = optimvar('x');
expr = optimexpr(3) + x^2;
value = evaluate(expr, struct('x', 2))
]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
