  <language>en_US</language>
  <keyword>optimvar</keyword>
  <short_description>Create optimization variables.</short_description>
  <syntax>
    <syntax_item>x = optimvar(name)</syntax_item>
    <syntax_item>x = optimvar(name, n, m, name, value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>variable name.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n, m</param_name>
      <param_description>variable dimensions.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>name, value</param_name>
      <param_description>variable properties such as LowerBound, UpperBound and Type.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>x</param_name>
      <param_description>optimization variable object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>optimvar</b> creates scalar or array variables used in problem-based expressions. Vector variables can be indexed with parentheses in expressions.</p>
  </description>
  <used_function>
    <used_function_item>optimproblem</used_function_item>
    <used_function_item>optimexpr</used_function_item>
  </used_function>
  <bibliography>J. Nocedal and S. J. Wright, Numerical Optimization, Springer, 2006.</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = optimvar('x', 2, 1, 'LowerBound', 0);
expr = (x(1) - 1)^2 + (x(2) - 2)^2
]]></example_item_data>
    </example_item>
  </examples>
