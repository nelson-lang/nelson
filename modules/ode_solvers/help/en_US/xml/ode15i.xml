  <language>en_US</language>
  <keyword>ode15i</keyword>
  <short_description>Implicit ODE solver entry point.</short_description>
  <syntax>
    <syntax_item>[t, y] = ode15i(odefun, tspan, y0, yp0)</syntax_item>
  </syntax>
  <description>
    <p>
      <b>ode15i</b> solves residual problems of the form <b>F(t,y,yp)=0</b>.</p>
    <table style="width:100%">
      <tr>
        <th>Item</th>
        <th>Details</th>
      </tr>
      <tr>
        <td>Problem form</td>
        <td>Implicit residual <b>F(t,y,yp)=0</b>.</td>
      </tr>
      <tr>
        <td>Inputs</td>
        <td><b>odefun</b>, <b>tspan</b>, <b>y0</b>, <b>yp0</b>, and options created with <b>odeset</b>.</td>
      </tr>
      <tr>
        <td>Outputs</td>
        <td><b>[t,y]</b> arrays or a <b>sol</b> structure with slopes available through <b>deval</b>.</td>
      </tr>
      <tr>
        <td>Initialization</td>
        <td>Use <b>decic</b> to adjust consistent initial conditions.</td>
      </tr>
    </table>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[[t, y] = ode15i(@(t,y,yp) yp + y, [0 1], 1, -1)]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
