  <language>en_US</language>
  <keyword>ddeset</keyword>
  <short_description>Create or update DDE options.</short_description>
  <syntax>
    <syntax_item>options = ddeset()</syntax_item>
    <syntax_item>options = ddeset(name, value)</syntax_item>
  </syntax>
  <description>
    <p>
      <b>ddeset</b> creates an options structure for delay equation solvers. It accepts common ODE options plus <b>InitialY</b> and <b>Jumps</b>.</p>
    <table style="width:100%">
      <tr>
        <th>Option</th>
        <th>Purpose</th>
      </tr>
      <tr>
        <td><b>InitialY</b></td>
        <td>Initial history value used when no history structure is supplied.</td>
      </tr>
      <tr>
        <td><b>Jumps</b></td>
        <td>Known discontinuity times.</td>
      </tr>
      <tr>
        <td>Common ODE options</td>
        <td>Tolerances, steps, events, and output settings shared with <b>odeset</b>.</td>
      </tr>
    </table>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Complete DDE and BVP added features example.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[rootPath = modulepath('ode_solvers', 'root');
run([rootPath, '/examples/dde_bvp_added_features_example.m'])]]></example_item_data>
    </example_item>
  </examples>
