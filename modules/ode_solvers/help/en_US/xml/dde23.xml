  <language>en_US</language>
  <keyword>dde23</keyword>
  <short_description>Solve delay equations with constant delays.</short_description>
  <syntax>
    <syntax_item>sol = dde23(ddefun, delays, history, tspan)</syntax_item>
    <syntax_item>sol = dde23(ddefun, delays, history, tspan, options)</syntax_item>
  </syntax>
  <description>
    <p>
      <b>dde23</b> solves delay equations where each delay is a positive constant lag. The derivative function is called as <b>f(t,y,z)</b>, where each column of <b>z</b> is a delayed state.</p>
    <table style="width:100%">
      <tr>
        <th>Item</th>
        <th>Details</th>
      </tr>
      <tr>
        <td>Delay type</td>
        <td>Positive constant lags.</td>
      </tr>
      <tr>
        <td>Callback</td>
        <td><b>f(t,y,z)</b></td>
      </tr>
      <tr>
        <td>History</td>
        <td>Scalar, vector, solution structure, or function depending on the call form.</td>
      </tr>
      <tr>
        <td>Solution</td>
        <td><b>sol</b> structure with <b>x</b>, <b>y</b>, <b>yp</b>, <b>solver</b>, and <b>deval</b> interpolation.</td>
      </tr>
    </table>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Constant history.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[sol = dde23(@(t,y,z) -y + z, 0.1, 1, [0 1]);
y = deval(sol, 0.5)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Complete DDE and BVP added features example.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[rootPath = modulepath('ode_solvers', 'root');
run([rootPath, '/examples/dde_bvp_added_features_example.m'])]]></example_item_data>
    </example_item>
  </examples>
