  <language>en_US</language>
  <keyword>bvpxtend</keyword>
  <short_description>Extend a BVP solution guess.</short_description>
  <syntax>
    <syntax_item>solinit = bvpxtend(sol, xnew)</syntax_item>
    <syntax_item>solinit = bvpxtend(sol, xnew, ynew)</syntax_item>
  </syntax>
  <description>
    <p>
      <b>bvpxtend</b> builds a new BVP initial guess from an existing solution and a refined mesh.</p>
    <table style="width:100%">
  <tr><th>Input</th><th>Details</th></tr>
  <tr><td><b>sol</b></td><td>Existing solution or initial guess structure.</td></tr>
  <tr><td><b>xnew</b></td><td>New mesh points added to or replacing the previous mesh.</td></tr>
  <tr><td><b>ynew</b></td><td>Optional values used at the new mesh points.</td></tr>
  <tr><td><b>solinit</b></td><td>Extended guess structure for another <b>bvp4c</b> or <b>bvp5c</b> call.</td></tr>
</table>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Complete DDE and BVP added features example.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[rootPath = modulepath('ode_solvers', 'root');
run([rootPath, '/examples/dde_bvp_added_features_example.m'])]]></example_item_data>
    </example_item>
  </examples>
