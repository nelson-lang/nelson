  <language>fr_FR</language>
  <keyword>ddeget</keyword>
  <short_description>Recupere une option DDE.</short_description>
  <syntax>
    <syntax_item>value = ddeget(options, name)</syntax_item>
    <syntax_item>value = ddeget(options, name, defaultValue)</syntax_item>
  </syntax>
  <description>
    <p>
      <b>ddeget</b> recupere une valeur d'une structure d'options DDE et retourne la valeur par defaut quand l'option est vide.</p>
    <table style="width:100%">
      <tr>
        <th>Appel</th>
        <th>Role</th>
      </tr>
      <tr>
        <td><b>value = *get(options,name)</b></td>
        <td>Retourne la valeur stockee pour <b>name</b>.</td>
      </tr>
      <tr>
        <td><b>value = *get(options,name,default)</b></td>
        <td>Retourne <b>default</b> si l option est absente ou vide.</td>
      </tr>
    </table>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Exemple complet des fonctionnalites DDE et BVP ajoutees.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[rootPath = modulepath('ode_solvers', 'root');
run([rootPath, '/examples/dde_bvp_added_features_example.m'])]]></example_item_data>
    </example_item>
  </examples>
