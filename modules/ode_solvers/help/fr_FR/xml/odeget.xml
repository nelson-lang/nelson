  <language>fr_FR</language>
  <keyword>odeget</keyword>
  <short_description>Lire une option EDO.</short_description>
  <syntax>
    <syntax_item>valeur = odeget(options, nom)</syntax_item>
    <syntax_item>valeur = odeget(options, nom, defaut)</syntax_item>
  </syntax>
  <description>
    <p>
      <b>odeget</b> renvoie une option nommee ou une valeur par defaut.</p>
    <table style="width:100%">
      <tr>
        <th>Appel</th>
        <th>Role</th>
      </tr>
      <tr>
        <td><b>value = *get(options,name)</b></td>
        <td>Retourne la valeur stockee pour <b>name</b>.</td>
      </tr>
      <tr>
        <td><b>value = *get(options,name,default)</b></td>
        <td>Retourne <b>default</b> si l option est absente ou vide.</td>
      </tr>
    </table>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[options = odeset('RelTol', 1e-4); value = odeget(options, 'RelTol')]]></example_item_data>
    </example_item>
  </examples>
