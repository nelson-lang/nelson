  <language>fr_FR</language>
  <keyword>ode15i</keyword>
  <short_description>Entree de solveur EDO implicite.</short_description>
  <syntax>
    <syntax_item>[t, y] = ode15i(odefun, tspan, y0, yp0)</syntax_item>
  </syntax>
  <description>
    <p>
      <b>ode15i</b> resout les problemes residuels de la forme <b>F(t,y,yp)=0</b>.</p>
    <table style="width:100%">
      <tr>
        <th>Element</th>
        <th>Details</th>
      </tr>
      <tr>
        <td>Forme du probleme</td>
        <td>Residu implicite <b>F(t,y,yp)=0</b>.</td>
      </tr>
      <tr>
        <td>Entrees</td>
        <td><b>odefun</b>, <b>tspan</b>, <b>y0</b>, <b>yp0</b>, et options creees avec <b>odeset</b>.</td>
      </tr>
      <tr>
        <td>Sorties</td>
        <td>Tableaux <b>[t,y]</b> ou structure <b>sol</b> avec pentes disponibles pour <b>deval</b>.</td>
      </tr>
      <tr>
        <td>Initialisation</td>
        <td>Utilisez <b>decic</b> pour ajuster des conditions initiales coherentes.</td>
      </tr>
    </table>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[[t, y] = ode15i(@(t,y,yp) yp + y, [0 1], 1, -1)]]></example_item_data>
    </example_item>
  </examples>
