  <language>fr_FR</language>
  <keyword>ode78</keyword>
  <short_description>Solveur EDO non raide haut ordre.</short_description>
  <syntax>
    <syntax_item>[t, y] = ode78(odefun, tspan, y0)</syntax_item>
  </syntax>
  <description>
    <p>
      <b>ode78</b> expose une entree de solveur non raide avec le moteur adaptatif partage.</p>
    <table style="width:100%">
      <tr>
        <th>Element</th>
        <th>Details</th>
      </tr>
      <tr>
        <td>Forme du probleme</td>
        <td><b>y' = f(t,y)</b>, avec valeur initiale <b>y0</b>.</td>
      </tr>
      <tr>
        <td>Entrees</td>
        <td><b>odefun</b>, <b>tspan</b>, <b>y0</b>, et options creees avec <b>odeset</b>.</td>
      </tr>
      <tr>
        <td>Sorties</td>
        <td><b>[t,y]</b> pour les tableaux ou <b>sol</b> pour une structure compatible avec <b>deval</b> et <b>odextend</b>.</td>
      </tr>
      <tr>
        <td>Evenements</td>
        <td>Les options <b>Events</b> renseignent <b>te</b>, <b>ye</b> et <b>ie</b> ou les champs <b>xe</b>, <b>ye</b> et <b>ie</b> de la structure.</td>
      </tr>
    </table>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[[t, y] = ode78(@(t,y) -y, [0 1], 1)]]></example_item_data>
    </example_item>
  </examples>
