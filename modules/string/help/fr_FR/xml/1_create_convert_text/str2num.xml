  <language>fr_FR</language>
  <keyword>str2num</keyword>
  <short_description>Convertit un tableau de caractères en tableau numérique.</short_description>
  <syntax>
    <syntax_item>x = str2num(s)</syntax_item>
    <syntax_item>[x, ok] = str2num(s)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>s</param_name>
      <param_description>un vecteur de caractères ou une chaîne scalaire contenant une expression numérique.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>x</param_name>
      <param_description>le résultat numérique, ou <b>[]</b> si le texte ne peut être évalué en nombre.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ok</param_name>
      <param_description>un logique : <b>true</b> si la conversion a réussi.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>x = str2num(s)</b> convertit le tableau de caractères <b>s</b> en tableau numérique en l&apos;évaluant.</p>
    <p>Comme <b>str2num</b> évalue son entrée, préférez <b>str2double</b> pour les conversions scalaires simples.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[x = str2num('[1 2 3]')
[y, ok] = str2num('4 5; 6 7')]]></example_item_data>
    </example_item>
  </examples>
