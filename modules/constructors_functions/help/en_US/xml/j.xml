  <language>en_US</language>
  <keyword>j</keyword>
  <short_description>Imaginary unit.</short_description>
  <syntax>
    <syntax_item>j</syntax_item>
    <syntax_item>3*j</syntax_item>
  </syntax>
  <param_output>
    <param_output_item>
      <param_name>j</param_name>
      <param_description>scalar complex value equal to sqrt(-1).</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>j returns the imaginary unit sqrt(-1), like i.</p>
    <p>j can be redefined as an ordinary variable. Use clear to restore the default behavior.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Build a complex number with the imaginary unit.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[z = 2 + 3*j]]></example_item_data>
    </example_item>
  </examples>
