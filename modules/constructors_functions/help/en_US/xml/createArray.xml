  <language>en_US</language>
  <keyword>createArray</keyword>
  <short_description>Create an array filled with a value.</short_description>
  <syntax>
    <syntax_item>A = createArray(n)</syntax_item>
    <syntax_item>A = createArray(sz1, ..., szN)</syntax_item>
    <syntax_item>A = createArray(sz)</syntax_item>
    <syntax_item>A = createArray(..., classname)</syntax_item>
    <syntax_item>A = createArray(..., 'like', p)</syntax_item>
    <syntax_item>A = createArray(..., 'FillValue', v)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>n, sz1, ..., szN, sz</param_name>
      <param_description>size: n gives n-by-n, a list of sizes or a size vector. Negative sizes become 0.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>classname</param_name>
      <param_description>class of the result: a numeric class, <b>'logical'</b>, <b>'char'</b>, <b>'string'</b> or <b>'cell'</b>.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>prototype given with <b>'like'</b>: the result has its class, complexity and gpuArray location.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>FillValue</param_name>
      <param_description>value of every element. Default: 0, <b>false</b>, <b>char(0)</b>, a missing string or an empty cell.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>A</param_name>
      <param_description>the new array.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>A = createArray(sz)</b> returns an array of zeros of size <b>sz</b>.</p>
    <p>The class comes from <b>classname</b>, from the prototype given with <b>'like'</b>, or else from <b>FillValue</b>. When a class is given, <b>FillValue</b> is converted to it, with saturation for integer classes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[createArray(2, 3)
createArray(1, 3, 'int8', 'FillValue', 300)
createArray(1, 2, 'FillValue', "x")]]></example_item_data>
    </example_item>
  </examples>
