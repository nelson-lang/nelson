  <language>en_US</language>
  <keyword>eps</keyword>
  <short_description>Creates an epsilon (machine precision)</short_description>
  <syntax>
    <syntax_item>d = eps</syntax_item>
    <syntax_item>d = eps(X)</syntax_item>
    <syntax_item>d = eps(&apos;double&apos;)</syntax_item>
    <syntax_item>d = eps(&apos;single&apos;)</syntax_item>
    <syntax_item>d = eps(&apos;like&apos;, p)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>a double or single array (real or complex, full or sparse).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>an array whose class, complexity and sparsity are given to the result.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>d</param_name>
      <param_description>a double or single: the spacing of floating-point numbers.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>eps</b> returns the machine precision 2^(-52) for double and 2^(-23) for single.</p>
    <p>eps(Inf), eps(-Inf) and eps(NaN) return NaN.</p>
    <p><b>eps(X)</b> returns, element by element, the distance from <b>abs(X)</b> to the next larger number of the same class; the result is real and full, with the size of <b>X</b>.</p>
    <p><b>eps('like', p)</b> returns the value for the class of <b>p</b>; a complex or sparse <b>p</b> gives a complex or sparse result.</p>
  </description>
