  <language>fr_FR</language>
  <keyword>factoran</keyword>
  <short_description>Analyse factorielle.</short_description>
  <syntax>
    <syntax_item>lambda = factoran(X, m)</syntax_item>
    <syntax_item>lambda = factoran(X, m, Name, Value)</syntax_item>
    <syntax_item>[lambda, psi, T, stats, F] = factoran(...)</syntax_item>
  </syntax>
  <description>
    <p><b>factoran</b> estime les charges factorielles pour une matrice de donnees reelles ou une matrice de covariance.</p>
    <p>Les arguments nom-valeur incluent Xtype, Rotate, Scores, Start, Options et Coeff. Les rotations prises en charge incluent varimax, quartimax, equamax, parsimax, orthomax et none.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [1 2 3; 2 3 5; 4 5 8; 5 7 11; 7 8 13; 8 10 16];
[lambda, psi, T, stats, F] = factoran(X, 2)]]></example_item_data>
    </example_item>
  </examples>
