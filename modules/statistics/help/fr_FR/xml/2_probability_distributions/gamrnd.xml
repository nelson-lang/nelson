  <language>fr_FR</language>
  <keyword>gamrnd</keyword>
  <short_description>Nombres aleatoires gamma</short_description>
  <syntax>
    <syntax_item>r = gamrnd(a, b)</syntax_item>
    <syntax_item>r = gamrnd(a, b, sz)</syntax_item>
    <syntax_item>r = gamrnd(a, b, sz1, ..., szN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>a</param_name><param_description>scalaire positif ou tableau : parametre de forme.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>scalaire positif ou tableau : parametre d'echelle.</param_description></param_input_item>
    <param_input_item><param_name>sz</param_name><param_description>scalaire, vecteur ou dimensions separees par des virgules : taille de la sortie.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>tableau : valeurs aleatoires.</param_description></param_output_item></param_output>
  <description><p><b>gamrnd</b> genere des valeurs aleatoires de loi gamma.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[rng(0);
r = gamrnd(2, 3, 2, 3);]]></example_item_data></example_item></examples>
