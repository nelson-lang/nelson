  <language>fr_FR</language>
  <keyword>chi2pdf</keyword>
  <short_description>Densite de probabilite chi-square</short_description>
  <syntax>
    <syntax_item>y = chi2pdf(x, v)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>tableau numerique reel : valeurs ou la densite est evaluee.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v</param_name>
      <param_description>tableau numerique reel positif ou scalaire : degres de liberte.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>y</param_name>
      <param_description>valeurs de densite.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>chi2pdf</b> calcule la densite de probabilite chi-square. Les entrees scalaires sont etendues aux tableaux.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [0.5 1 2 5];
y = chi2pdf(x, 4);]]></example_item_data>
    </example_item>
  </examples>
