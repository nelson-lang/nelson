  <keyword>raylinv</keyword>
  <short_description>Inverse de repartition Rayleigh</short_description>
  <syntax><syntax_item>x = raylinv(p, b)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>p</param_name><param_description>probabilites dans [0, 1].</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>scalaire positif ou tableau : parametre d'echelle.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>tableau : valeurs inverses cumulees.</param_description></param_output_item></param_output>
  <description><p><b>raylinv</b> evalue les inverses Rayleigh element par element.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[p = [0 0.3934693402873666 0.8646647167633873];
x = raylinv(p, 2);]]></example_item_data></example_item></examples>
