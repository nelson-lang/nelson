  <language>fr_FR</language>
  <keyword>normlike</keyword>
  <short_description>Oppose de la log-vraisemblance normale</short_description>
  <syntax>
    <syntax_item>nlogL = normlike(params, x)</syntax_item>
    <syntax_item>[nlogL, avar] = normlike(params, x)</syntax_item>
    <syntax_item>[nlogL, avar] = normlike(params, x, censoring, freq)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>params</param_name><param_description>vecteur reel a deux elements [mu sigma] : parametres de la loi normale.</param_description></param_input_item>
    <param_input_item><param_name>x</param_name><param_description>tableau reel non vide de valeurs finies : donnees observees.</param_description></param_input_item>
    <param_input_item><param_name>censoring</param_name><param_description>tableau contenant des valeurs 0 ou 1 : indicateurs de censure a droite.</param_description></param_input_item>
    <param_input_item><param_name>freq</param_name><param_description>tableau de valeurs finies positives ou nulles : frequences d'observation.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>nlogL</param_name><param_description>scalaire : oppose de la log-vraisemblance.</param_description></param_output_item>
    <param_output_item><param_name>avar</param_name><param_description>tableau 2 par 2 : estimation de covariance asymptotique.</param_description></param_output_item>
  </param_output>
  <description><p><b>normlike</b> retourne l'oppose de la log-vraisemblance pour des donnees de loi normale et l'estimation de covariance asymptotique.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [-2 -1 0 1 3 5];
[nlogL, avar] = normlike([1 2], x);]]></example_item_data></example_item></examples>
