  <language>fr_FR</language>
  <keyword>chi2inv</keyword>
  <short_description>Inverse de la fonction de repartition chi-square</short_description>
  <syntax>
    <syntax_item>x = chi2inv(p, v)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>tableau numerique reel de probabilites dans [0,1].</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v</param_name>
      <param_description>tableau numerique reel positif ou scalaire : degres de liberte.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>x</param_name>
      <param_description>valeurs cumulees inverses.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>chi2inv</b> calcule l'inverse des probabilites chi-square de queue inferieure.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[p = [0.025 0.5 0.975];
x = chi2inv(p, 4);]]></example_item_data>
    </example_item>
  </examples>
