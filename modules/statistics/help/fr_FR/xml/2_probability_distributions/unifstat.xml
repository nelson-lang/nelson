  <language>fr_FR</language>
  <keyword>unifstat</keyword>
  <short_description>Moyenne et variance uniformes continues</short_description>
  <syntax>
    <syntax_item>[m, v] = unifstat(a, b)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>a</param_name>
      <param_description>scalaire reel ou tableau : borne inferieure.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>b</param_name>
      <param_description>scalaire reel ou tableau : borne superieure.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>m</param_name>
      <param_description>tableau : moyennes.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>v</param_name>
      <param_description>tableau : variances.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>unifstat</b> renvoie la moyenne et la variance element par element de lois uniformes continues.</p>
    <p>Les bornes scalaires sont etendues pour correspondre aux bornes tableau. Les intervalles invalides produisent des valeurs NaN.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[[m, v] = unifstat(0, 1);
a = 1:6;
b = 2 * a;
[m2, v2] = unifstat(a, b);]]></example_item_data>
    </example_item>
  </examples>
