  <language>fr_FR</language>
  <keyword>poissfit</keyword>
  <short_description>Estimation du taux de Poisson</short_description>
  <syntax><syntax_item>lambdaHat = poissfit(x)</syntax_item><syntax_item>[lambdaHat, lambdaCI] = poissfit(x, alpha)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>vecteur ou matrice reel non vide d'entiers finis positifs ou nuls : comptes observes.</param_description></param_input_item>
    <param_input_item><param_name>alpha</param_name><param_description>scalaire dans l'intervalle [0, 1] : niveau de signification. La valeur par defaut est 0.05.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>lambdaHat</param_name><param_description>tableau : estimations du taux de Poisson.</param_description></param_output_item>
    <param_output_item><param_name>lambdaCI</param_name><param_description>tableau : intervalles de confiance des estimations.</param_description></param_output_item>
  </param_output>
  <description><p><b>poissfit</b> estime le parametre de taux de la loi de Poisson.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 1 2 3 5 8];
[lambdaHat, lambdaCI] = poissfit(x);]]></example_item_data></example_item></examples>
