  <keyword>unidcdf</keyword>
  <short_description>Fonction de repartition uniforme discrete</short_description>
  <syntax><syntax_item>p = unidcdf(x, n)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>tableau numerique reel.</param_description></param_input_item>
    <param_input_item><param_name>n</param_name><param_description>scalaire entier positif ou tableau : valeur maximale.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>p</param_name><param_description>probabilites cumulees.</param_description></param_output_item></param_output>
  <description><p><b>unidcdf</b> calcule les probabilites cumulees de la loi uniforme discrete sur les entiers de 1 a <b>n</b>.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = 0:6;
p = unidcdf(x, 5);]]></example_item_data></example_item></examples>
