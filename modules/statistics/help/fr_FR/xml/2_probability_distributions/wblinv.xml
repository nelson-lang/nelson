  <language>fr_FR</language>
  <keyword>wblinv</keyword>
  <short_description>Inverse de la fonction de repartition Weibull</short_description>
  <syntax>
    <syntax_item>x = wblinv(p)</syntax_item>
    <syntax_item>x = wblinv(p, a)</syntax_item>
    <syntax_item>x = wblinv(p, a, b)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>p</param_name><param_description>scalaire reel ou tableau : valeurs de probabilite.</param_description></param_input_item>
    <param_input_item><param_name>a</param_name><param_description>scalaire positif ou tableau : parametre d'echelle. La valeur par defaut est 1.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>scalaire positif ou tableau : parametre de forme. La valeur par defaut est 1.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>tableau : valeurs de probabilite inverse.</param_description></param_output_item></param_output>
  <description><p><b>wblinv</b> evalue les probabilites cumulees inverses Weibull element par element.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[p = [0 0.5 0.9];
x = wblinv(p, 2, 3);]]></example_item_data></example_item></examples>
