  <language>fr_FR</language>
  <keyword>gevlike</keyword>
  <short_description>Oppose de la log-vraisemblance de la loi extreme generalisee</short_description>
  <syntax>
    <syntax_item>nlogL = gevlike(params, x)</syntax_item>
    <syntax_item>[nlogL, avar] = gevlike(params, x, censoring, freq)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>params</param_name><param_description>vecteur a trois elements : parametres de forme, d'echelle et de position.</param_description></param_input_item>
    <param_input_item><param_name>x</param_name><param_description>tableau reel fini non vide : donnees d'echantillon.</param_description></param_input_item>
    <param_input_item><param_name>censoring</param_name><param_description>tableau contenant des valeurs 0 ou 1 : indicateurs de censure a droite.</param_description></param_input_item>
    <param_input_item><param_name>freq</param_name><param_description>tableau de valeurs finies non negatives : frequences d'observation.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>nlogL</param_name><param_description>scalaire : oppose de la log-vraisemblance.</param_description></param_output_item>
    <param_output_item><param_name>avar</param_name><param_description>tableau 3-par-3 : matrice de covariance approchee.</param_description></param_output_item>
  </param_output>
  <description><p><b>gevlike</b> evalue l'oppose de la log-vraisemblance de la loi extreme generalisee.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [-1.2 -0.4 0.1 0.8 1.5 2.8 4.0];
phat = gevfit(x);
nlogL = gevlike(phat, x);]]></example_item_data></example_item></examples>
