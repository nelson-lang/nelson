  <keyword>unifpdf</keyword>
  <short_description>Densite de probabilite uniforme continue</short_description>
  <syntax><syntax_item>y = unifpdf(x)</syntax_item><syntax_item>y = unifpdf(x, a, b)</syntax_item></syntax>
  <param_input><param_input_item><param_name>x</param_name><param_description>tableau numerique reel.</param_description></param_input_item><param_input_item><param_name>a</param_name><param_description>borne inferieure, 0 par defaut.</param_description></param_input_item><param_input_item><param_name>b</param_name><param_description>borne superieure, 1 par defaut.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>y</param_name><param_description>valeurs de densite de probabilite.</param_description></param_output_item></param_output>
  <description><p><b>unifpdf</b> calcule les valeurs de densite de la distribution uniforme continue.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = 0:0.25:1;
y = unifpdf(x);]]></example_item_data></example_item></examples>
