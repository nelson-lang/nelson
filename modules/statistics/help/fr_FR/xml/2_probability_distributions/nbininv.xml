  <keyword>nbininv</keyword>
  <short_description>Inverse de repartition binomiale negative</short_description>
  <syntax><syntax_item>x = nbininv(y, r, p)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>y</param_name><param_description>probabilites dans l'intervalle [0, 1].</param_description></param_input_item>
    <param_input_item><param_name>r</param_name><param_description>scalaire positif ou tableau : nombre de succes.</param_description></param_input_item>
    <param_input_item><param_name>p</param_name><param_description>scalaire ou tableau dans l'intervalle [0, 1] : probabilite de succes.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>valeurs inverses.</param_description></param_output_item></param_output>
  <description><p><b>nbininv</b> calcule l'inverse de repartition de la loi binomiale negative.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[y = [0.1 0.5 0.9];
x = nbininv(y, 3, 0.4);]]></example_item_data></example_item></examples>
