  <language>fr_FR</language>
  <keyword>binornd</keyword>
  <short_description>Nombres aleatoires binomiaux</short_description>
  <syntax>
    <syntax_item>r = binornd(n, p)</syntax_item>
    <syntax_item>r = binornd(n, p, sz)</syntax_item>
    <syntax_item>r = binornd(n, p, sz1, ..., szN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>n</param_name><param_description>scalaire entier positif ou nul ou tableau : nombre d'essais.</param_description></param_input_item>
    <param_input_item><param_name>p</param_name><param_description>scalaire ou tableau dans l'intervalle [0, 1] : probabilite.</param_description></param_input_item>
    <param_input_item><param_name>sz</param_name><param_description>scalaire, vecteur ou dimensions separees par des virgules : taille de la sortie.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>tableau : valeurs aleatoires.</param_description></param_output_item></param_output>
  <description><p><b>binornd</b> genere des valeurs aleatoires de loi binomiale.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[rng(0);
r = binornd(10, 0.3, 2, 3);]]></example_item_data></example_item></examples>
