  <keyword>betainv</keyword>
  <short_description>Fonction de repartition inverse beta</short_description>
  <syntax><syntax_item>x = betainv(p, a, b)</syntax_item></syntax>
  <param_input><param_input_item><param_name>p</param_name><param_description>tableau numerique reel de probabilites.</param_description></param_input_item><param_input_item><param_name>a</param_name><param_description>premier parametre de forme positif.</param_description></param_input_item><param_input_item><param_name>b</param_name><param_description>second parametre de forme positif.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>valeurs inverses de queue inferieure beta.</param_description></param_output_item></param_output>
  <description><p><b>betainv</b> calcule les probabilites inverses de queue inferieure beta.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[p = [0.025 0.5 0.975];
x = betainv(p, 2, 5);]]></example_item_data></example_item></examples>
