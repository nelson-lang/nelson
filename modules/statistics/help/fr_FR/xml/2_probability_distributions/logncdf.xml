  <language>fr_FR</language>
  <keyword>logncdf</keyword>
  <short_description>Fonction de répartition lognormale</short_description>
  <syntax>
    <syntax_item>p = logncdf(x)</syntax_item>
    <syntax_item>p = logncdf(x, mu, sigma)</syntax_item>
    <syntax_item>[p, pLo, pUp] = logncdf(x, mu, sigma, pCov)</syntax_item>
    <syntax_item>p = logncdf(..., 'upper')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>scalaire réel ou tableau : valeurs.</param_description></param_input_item>
    <param_input_item><param_name>mu</param_name><param_description>scalaire réel ou tableau : moyenne des valeurs logarithmiques.</param_description></param_input_item>
    <param_input_item><param_name>sigma</param_name><param_description>scalaire positif ou tableau : écart-type des valeurs logarithmiques.</param_description></param_input_item>
    <param_input_item><param_name>pCov</param_name><param_description>matrice de covariance 2 par 2 pour les bornes de confiance.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>p</param_name><param_description>tableau : probabilités cumulées.</param_description></param_output_item>
    <param_output_item><param_name>pLo</param_name><param_description>tableau : bornes de confiance inférieures.</param_description></param_output_item>
    <param_output_item><param_name>pUp</param_name><param_description>tableau : bornes de confiance supérieures.</param_description></param_output_item>
  </param_output>
  <description><p><b>logncdf</b> évalue les probabilités cumulées lognormales élément par élément.</p></description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description />
      <example_item_data runnable="cli"><![CDATA[p = logncdf([0 1 exp(1)]);
q = logncdf(exp(10), 'upper');]]></example_item_data></example_item>
  </examples>
