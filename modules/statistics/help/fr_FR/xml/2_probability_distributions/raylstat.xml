  <keyword>raylstat</keyword>
  <short_description>Moyenne et variance Rayleigh</short_description>
  <syntax><syntax_item>[m, v] = raylstat(b)</syntax_item></syntax>
  <param_input><param_input_item><param_name>b</param_name><param_description>scalaire positif ou tableau : parametre d'echelle.</param_description></param_input_item></param_input>
  <param_output>
    <param_output_item><param_name>m</param_name><param_description>tableau : moyennes.</param_description></param_output_item>
    <param_output_item><param_name>v</param_name><param_description>tableau : variances.</param_description></param_output_item>
  </param_output>
  <description><p><b>raylstat</b> renvoie la moyenne et la variance element par element de lois Rayleigh.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[m, v] = raylstat(2);]]></example_item_data></example_item></examples>
