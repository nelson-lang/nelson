  <language>fr_FR</language>
  <keyword>fcdf</keyword>
  <short_description>Fonction de répartition F</short_description>
  <syntax>
    <syntax_item>p = fcdf(x, v1, v2)</syntax_item>
    <syntax_item>p = fcdf(x, v1, v2, &apos;upper&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>tableau numérique réel : valeurs ou la distribution est évaluée.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v1</param_name>
      <param_description>tableau numérique réel positif ou scalaire : degrés de liberté du numérateur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v2</param_name>
      <param_description>tableau numérique réel positif ou scalaire : degrés de liberté du dénominateur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>probabilités cumulées ou probabilités de queue supérieure.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>fcdf</b> calculé par défaut les probabilités de queue inférieure de la distribution F et les probabilités de queue supérieure avec <b>&apos;upper&apos;</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [0.5 1 2 5];
p = fcdf(x, 5, 20);
q = fcdf(x, 5, 20, 'upper');]]></example_item_data>
    </example_item>
  </examples>
