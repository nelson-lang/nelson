<xmldoc>
  <copyright>SAME AS NELSON SOFTWARE</copyright><language>fr_FR</language><keyword>binostat</keyword>
  <short_description>Moyenne et variance binomiales</short_description>
  <syntax><syntax_item>[m, v] = binostat(n, p)</syntax_item></syntax>
  <param_input><param_input_item><param_name>n</param_name><param_description>entier non negatif scalaire ou tableau : nombre d'essais.</param_description></param_input_item><param_input_item><param_name>p</param_name><param_description>scalaire ou tableau dans l'intervalle [0, 1] : probabilite de succes.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>m</param_name><param_description>tableau : moyennes.</param_description></param_output_item><param_output_item><param_name>v</param_name><param_description>tableau : variances.</param_description></param_output_item></param_output>
  <description><p><b>binostat</b> retourne la moyenne et la variance de la loi binomiale.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[m, v] = binostat([10 20], [0.25 0.5]);]]></example_item_data></example_item></examples>
