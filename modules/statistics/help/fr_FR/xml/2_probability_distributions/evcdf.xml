  <language>fr_FR</language>
  <keyword>evcdf</keyword>
  <short_description>Fonction de repartition de la loi extreme value</short_description>
  <syntax>
    <syntax_item>p = evcdf(x)</syntax_item>
    <syntax_item>p = evcdf(x, mu)</syntax_item>
    <syntax_item>p = evcdf(x, mu, sigma)</syntax_item>
    <syntax_item>p = evcdf(x, mu, sigma, 'upper')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>scalaire ou tableau reel : valeurs.</param_description></param_input_item>
    <param_input_item><param_name>mu</param_name><param_description>scalaire ou tableau reel : parametre de position. La valeur par defaut est 0.</param_description></param_input_item>
    <param_input_item><param_name>sigma</param_name><param_description>scalaire ou tableau positif : parametre d'echelle. La valeur par defaut est 1.</param_description></param_input_item>
    <param_input_item><param_name>'upper'</param_name><param_description>option pour retourner la probabilite de queue superieure.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>p</param_name><param_description>tableau : valeurs de probabilite.</param_description></param_output_item></param_output>
  <description><p><b>evcdf</b> evalue element par element les probabilites cumulees de la loi extreme value.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [-2 -1 0 1 2];
p = evcdf(x, 0, 1);]]></example_item_data></example_item></examples>
