  <language>fr_FR</language>
  <keyword>unidrnd</keyword>
  <short_description>Nombres aleatoires uniformes discrets</short_description>
  <syntax>
    <syntax_item>r = unidrnd(n)</syntax_item>
    <syntax_item>r = unidrnd(n, sz)</syntax_item>
    <syntax_item>r = unidrnd(n, sz1, ..., szN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>n</param_name><param_description>scalaire entier positif ou tableau : valeur maximale.</param_description></param_input_item>
    <param_input_item><param_name>sz</param_name><param_description>scalaire, vecteur ou dimensions separees par des virgules : taille de la sortie.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>tableau : entiers aleatoires.</param_description></param_output_item></param_output>
  <description><p><b>unidrnd</b> genere des entiers aleatoires uniformes entre 1 et <b>n</b>.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[rng(0);
r = unidrnd(5, 2, 3);]]></example_item_data></example_item></examples>
