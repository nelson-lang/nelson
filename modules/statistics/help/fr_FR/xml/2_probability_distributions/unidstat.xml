  <language>fr_FR</language>
  <keyword>unidstat</keyword>
  <short_description>Moyenne et variance uniformes discretes</short_description>
  <syntax>
    <syntax_item>m = unidstat(n)</syntax_item>
    <syntax_item>[m, v] = unidstat(n)</syntax_item>
  </syntax>
  <param_input><param_input_item><param_name>n</param_name><param_description>scalaire entier positif ou tableau : valeur maximale.</param_description></param_input_item></param_input>
  <param_output>
    <param_output_item><param_name>m</param_name><param_description>moyennes.</param_description></param_output_item>
    <param_output_item><param_name>v</param_name><param_description>variances.</param_description></param_output_item>
  </param_output>
  <description><p><b>unidstat</b> calcule la moyenne et la variance de la loi uniforme discrete sur les entiers de 1 a <b>n</b>.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[m, v] = unidstat([1 5 10]);]]></example_item_data></example_item></examples>
