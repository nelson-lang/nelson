  <keyword>raylpdf</keyword>
  <short_description>Densité de probabilité Rayleigh</short_description>
  <syntax><syntax_item>y = raylpdf(x, b)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>scalaire réel ou tableau : valeurs.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>scalaire positif ou tableau : paramètre d'échelle.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>y</param_name><param_description>tableau : valeurs de densité.</param_description></param_output_item></param_output>
  <description><p><b>raylpdf</b> évalue les densités Rayleigh élément par élément.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 2 4];
y = raylpdf(x, 2);]]></example_item_data></example_item></examples>
