  <language>fr_FR</language>
  <keyword>unidinv</keyword>
  <short_description>Inverse de repartition uniforme discrete</short_description>
  <syntax><syntax_item>x = unidinv(p, n)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>p</param_name><param_description>probabilites dans l'intervalle [0, 1].</param_description></param_input_item>
    <param_input_item><param_name>n</param_name><param_description>scalaire entier positif ou tableau : valeur maximale.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>valeurs inverses.</param_description></param_output_item></param_output>
  <description><p><b>unidinv</b> calcule l'inverse de repartition de la loi uniforme discrete sur les entiers de 1 a <b>n</b>.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[p = [0 0.1 0.5 1];
x = unidinv(p, 5);]]></example_item_data></example_item></examples>
