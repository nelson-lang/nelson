  <language>fr_FR</language>
  <keyword>raylfit</keyword>
  <short_description>Estimation de l'echelle Rayleigh</short_description>
  <syntax>
    <syntax_item>phat = raylfit(x)</syntax_item>
    <syntax_item>[phat, pci] = raylfit(x, alpha)</syntax_item>
    <syntax_item>[phat, pci] = raylfit(x, alpha, censoring, freq)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>vecteur ou matrice reel non negatif fini non vide : donnees d'echantillon.</param_description></param_input_item>
    <param_input_item><param_name>alpha</param_name><param_description>scalaire dans l'intervalle [0, 1] : niveau de signification. La valeur par defaut est 0.05.</param_description></param_input_item>
    <param_input_item><param_name>censoring</param_name><param_description>tableau contenant les valeurs 0 ou 1 : indicateurs de censure a droite.</param_description></param_input_item>
    <param_input_item><param_name>freq</param_name><param_description>tableau de valeurs finies non negatives : frequences des observations.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>phat</param_name><param_description>tableau : estimations du parametre d'echelle.</param_description></param_output_item>
    <param_output_item><param_name>pci</param_name><param_description>tableau : intervalles de confiance des estimations.</param_description></param_output_item>
  </param_output>
  <description><p><b>raylfit</b> estime le parametre d'echelle de la distribution Rayleigh.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0.5 1 2 3 5 8];
[phat, pci] = raylfit(x);]]></example_item_data></example_item></examples>
