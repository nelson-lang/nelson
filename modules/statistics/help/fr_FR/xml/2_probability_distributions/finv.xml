  <language>fr_FR</language>
  <keyword>finv</keyword>
  <short_description>Fonction de repartition inverse F</short_description>
  <syntax>
    <syntax_item>x = finv(p, v1, v2)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>tableau numerique reel : probabilites.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v1</param_name>
      <param_description>tableau numerique reel positif ou scalaire : degres de liberte du numerateur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v2</param_name>
      <param_description>tableau numerique reel positif ou scalaire : degres de liberte du denominateur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>x</param_name>
      <param_description>valeurs inverses de queue inferieure de la distribution F.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>finv</b> calcule les probabilites inverses de queue inferieure de la distribution F.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[p = [0.025 0.5 0.975];
x = finv(p, 5, 20);]]></example_item_data>
    </example_item>
  </examples>
