  <language>fr_FR</language>
  <keyword>geocdf</keyword>
  <short_description>Fonction de répartition géométrique</short_description>
  <syntax>
    <syntax_item>y = geocdf(x, p)</syntax_item>
    <syntax_item>y = geocdf(x, p, 'upper')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>scalaire réel ou tableau : nombre d'échecs avant le premier succès.</param_description></param_input_item>
    <param_input_item><param_name>p</param_name><param_description>scalaire ou tableau dans l'intervalle [0, 1] : probabilité de succès.</param_description></param_input_item>
    <param_input_item><param_name>'upper'</param_name><param_description>option pour retourner la probabilité de queue supérieure.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>y</param_name><param_description>tableau : valeurs de probabilité.</param_description></param_output_item></param_output>
  <description><p><b>geocdf</b> évalue les probabilités cumulées géométriques élément par élément.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 1 2 5];
y = geocdf(x, 0.25);]]></example_item_data></example_item></examples>
