  <language>fr_FR</language>
  <keyword>tcdf</keyword>
  <short_description>Fonction de repartition de Student t</short_description>
  <syntax>
    <syntax_item>p = tcdf(x, v)</syntax_item>
    <syntax_item>p = tcdf(x, v, &apos;upper&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>tableau numerique reel : valeurs ou la distribution est evaluee.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v</param_name>
      <param_description>tableau numerique reel positif ou scalaire : degres de liberte.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>probabilites cumulees ou probabilites de queue superieure.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tcdf</b> calcule par defaut les probabilites de queue inferieure de Student t et les probabilites de queue superieure avec <b>&apos;upper&apos;</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [-3 -1 0 1 3];
p = tcdf(x, 5);
q = tcdf(x, 5, 'upper');]]></example_item_data>
    </example_item>
  </examples>
