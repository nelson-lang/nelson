  <keyword>gaminv</keyword>
  <short_description>Fonction de répartition inverse gamma</short_description>
  <syntax><syntax_item>x = gaminv(p, a)</syntax_item><syntax_item>x = gaminv(p, a, b)</syntax_item></syntax>
  <param_input><param_input_item><param_name>p</param_name><param_description>tableau numérique réel de probabilités.</param_description></param_input_item><param_input_item><param_name>a</param_name><param_description>paramètre de forme positif.</param_description></param_input_item><param_input_item><param_name>b</param_name><param_description>paramètre d'échelle positif, 1 par défaut.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>valeurs inversés de queue inférieure gamma.</param_description></param_output_item></param_output>
  <description><p><b>gaminv</b> calcule les probabilités inversés de queue inférieure gamma.</p></description>
