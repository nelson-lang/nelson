  <language>fr_FR</language>
  <keyword>nbinstat</keyword>
  <short_description>Moyenne et variance binomiales negatives</short_description>
  <syntax>
    <syntax_item>m = nbinstat(r, p)</syntax_item>
    <syntax_item>[m, v] = nbinstat(r, p)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>r</param_name><param_description>scalaire positif ou tableau : nombre de succes.</param_description></param_input_item>
    <param_input_item><param_name>p</param_name><param_description>scalaire ou tableau dans l'intervalle [0, 1] : probabilite de succes.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>m</param_name><param_description>moyennes.</param_description></param_output_item>
    <param_output_item><param_name>v</param_name><param_description>variances.</param_description></param_output_item>
  </param_output>
  <description><p><b>nbinstat</b> calcule la moyenne et la variance de la loi binomiale negative.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[m, v] = nbinstat([1 3], [0.5 0.4]);]]></example_item_data></example_item></examples>
