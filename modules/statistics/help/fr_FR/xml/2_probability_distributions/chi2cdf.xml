  <language>fr_FR</language>
  <keyword>chi2cdf</keyword>
  <short_description>Fonction de repartition chi-square</short_description>
  <syntax>
    <syntax_item>p = chi2cdf(x, v)</syntax_item>
    <syntax_item>p = chi2cdf(x, v, &apos;upper&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>tableau numerique reel : valeurs ou la distribution est evaluee.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v</param_name>
      <param_description>tableau numerique reel positif ou scalaire : degres de liberte.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>probabilites cumulees ou probabilites de queue superieure.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>chi2cdf</b> calcule les probabilites chi-square de queue inferieure par defaut et de queue superieure avec <b>&apos;upper&apos;</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [0.5 1 2 5];
p = chi2cdf(x, 4);
q = chi2cdf(x, 4, 'upper');]]></example_item_data>
    </example_item>
  </examples>
