  <language>fr_FR</language>
  <keyword>gamcdf</keyword>
  <short_description>Fonction de répartition gamma</short_description>
  <syntax><syntax_item>p = gamcdf(x, a)</syntax_item><syntax_item>p = gamcdf(x, a, b)</syntax_item><syntax_item>p = gamcdf(x, a, b, &apos;upper&apos;)</syntax_item></syntax>
  <param_input><param_input_item><param_name>x</param_name><param_description>tableau numérique réel.</param_description></param_input_item><param_input_item><param_name>a</param_name><param_description>paramètre de forme positif.</param_description></param_input_item><param_input_item><param_name>b</param_name><param_description>paramètre d'échelle positif, 1 par défaut.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>p</param_name><param_description>probabilités cumulées ou de queue supérieure.</param_description></param_output_item></param_output>
  <description><p><b>gamcdf</b> calculé par défaut les probabilités de queue inférieure gamma et les probabilités de queue supérieure avec <b>&apos;upper&apos;</b>.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 0.5 1 2 5];
p = gamcdf(x, 2, 3);
q = gamcdf(x, 2, 3, 'upper');]]></example_item_data></example_item></examples>
