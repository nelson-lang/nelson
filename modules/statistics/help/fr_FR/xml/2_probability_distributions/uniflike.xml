  <language>fr_FR</language>
  <keyword>uniflike</keyword>
  <short_description>Oppose de la log-vraisemblance uniforme continue</short_description>
  <syntax><syntax_item>nlogL = uniflike(params, x)</syntax_item><syntax_item>[nlogL, avar] = uniflike(params, x, censoring, freq)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>params</param_name><param_description>vecteur a deux elements contenant les bornes inferieure et superieure.</param_description></param_input_item>
    <param_input_item><param_name>x</param_name><param_description>tableau reel non vide : donnees echantillon.</param_description></param_input_item>
    <param_input_item><param_name>censoring</param_name><param_description>tableau contenant les valeurs 0 ou 1. La valeur par defaut est un tableau de zeros.</param_description></param_input_item>
    <param_input_item><param_name>freq</param_name><param_description>tableau fini positif ou nul de frequences d'observation. La valeur par defaut est un tableau de uns.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>nlogL</param_name><param_description>scalaire : oppose de la log-vraisemblance.</param_description></param_output_item>
    <param_output_item><param_name>avar</param_name><param_description>matrice : estimation de covariance asymptotique.</param_description></param_output_item>
  </param_output>
  <description><p><b>uniflike</b> retourne l'oppose de la log-vraisemblance pour des donnees de loi uniforme continue.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [2 5 3 4];
[nlogL, avar] = uniflike([1 6], x);]]></example_item_data></example_item></examples>
