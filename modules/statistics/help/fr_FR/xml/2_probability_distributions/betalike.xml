  <language>fr_FR</language>
  <keyword>betalike</keyword>
  <short_description>Oppose de la log-vraisemblance beta</short_description>
  <syntax>
    <syntax_item>nlogL = betalike(params, x)</syntax_item>
    <syntax_item>[nlogL, avar] = betalike(params, x)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>params</param_name><param_description>vecteur reel positif a deux elements : parametres de forme de la loi beta.</param_description></param_input_item>
    <param_input_item><param_name>x</param_name><param_description>tableau reel non vide de valeurs finies dans l'intervalle ouvert (0, 1) : donnees observees.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>nlogL</param_name><param_description>scalaire : oppose de la log-vraisemblance.</param_description></param_output_item>
    <param_output_item><param_name>avar</param_name><param_description>tableau 2 par 2 : estimation de covariance asymptotique.</param_description></param_output_item>
  </param_output>
  <description><p><b>betalike</b> retourne l'oppose de la log-vraisemblance pour des donnees de loi beta et l'estimation de covariance asymptotique.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0.12 0.2 0.35 0.5 0.7 0.85];
[nlogL, avar] = betalike([1.5 1.8], x);]]></example_item_data></example_item></examples>
