  <language>fr_FR</language>
  <keyword>unifinv</keyword>
  <short_description>Fonction de répartition inverse uniforme continue</short_description>
  <syntax><syntax_item>x = unifinv(p)</syntax_item><syntax_item>x = unifinv(p, a, b)</syntax_item></syntax>
  <param_input><param_input_item><param_name>p</param_name><param_description>tableau numérique réel de probabilités.</param_description></param_input_item><param_input_item><param_name>a</param_name><param_description>borne inférieure, 0 par défaut.</param_description></param_input_item><param_input_item><param_name>b</param_name><param_description>borne supérieure, 1 par défaut.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>valeurs inversés de queue inférieure uniforme continue.</param_description></param_output_item></param_output>
  <description><p><b>unifinv</b> calcule les probabilités inversés de queue inférieure de la distribution uniforme continue.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[p = [0.25 0.5 0.75];
x = unifinv(p, -1, 1);]]></example_item_data></example_item></examples>
