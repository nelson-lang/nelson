  <language>fr_FR</language>
  <keyword>binofit</keyword>
  <short_description>Estimation de probabilité binomiale</short_description>
  <syntax><syntax_item>pHat = binofit(x, n)</syntax_item><syntax_item>[pHat, pCI] = binofit(x, n, alpha)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>tableau réel non vide d'entiers finis positifs ou nuls : succès observes.</param_description></param_input_item>
    <param_input_item><param_name>n</param_name><param_description>tableau ou scalaire réel non vide d'entiers finis positifs ou nuls : nombres d'essais. Chaque valeur doit être supérieure ou égale à la valeur correspondante dans x.</param_description></param_input_item>
    <param_input_item><param_name>alpha</param_name><param_description>scalaire dans l'intervalle [0, 1] : niveau de signification. La valeur par défaut est 0.05.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>pHat</param_name><param_description>tableau : probabilités binomiales estimées.</param_description></param_output_item>
    <param_output_item><param_name>pCI</param_name><param_description>tableau : intervalles de confiance des estimations. La première colonne contient les bornes inférieures et la seconde les bornes supérieures.</param_description></param_output_item>
  </param_output>
  <description><p><b>binofit</b> estime les probabilités binomiales à partir des succès observes et des nombres d'essais.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 2 5 8 10];
n = 10;
[pHat, pCI] = binofit(x, n);]]></example_item_data></example_item></examples>
