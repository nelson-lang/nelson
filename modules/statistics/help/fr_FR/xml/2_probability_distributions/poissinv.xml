  <keyword>poissinv</keyword>
  <short_description>Fonction de repartition inverse de Poisson</short_description>
  <syntax><syntax_item>x = poissinv(y, lambda)</syntax_item></syntax>
  <param_input><param_input_item><param_name>y</param_name><param_description>tableau numerique reel de probabilites.</param_description></param_input_item><param_input_item><param_name>lambda</param_name><param_description>parametre de taux non negatif.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>plus petites valeurs entieres dont les probabilites cumulees sont au moins y.</param_description></param_output_item></param_output>
  <description><p><b>poissinv</b> calcule les probabilites inverses de queue inferieure de Poisson.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[y = [0.025 0.5 0.975];
x = poissinv(y, 4);]]></example_item_data></example_item></examples>
