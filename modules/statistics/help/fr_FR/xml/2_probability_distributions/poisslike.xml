  <language>fr_FR</language>
  <keyword>poisslike</keyword>
  <short_description>Oppose de la log-vraisemblance de Poisson</short_description>
  <syntax><syntax_item>nlogL = poisslike(lambda, x)</syntax_item><syntax_item>[nlogL, avar] = poisslike(lambda, x)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>lambda</param_name><param_description>scalaire positif ou nul : parametre de taux de Poisson.</param_description></param_input_item>
    <param_input_item><param_name>x</param_name><param_description>tableau reel non vide d'entiers finis positifs ou nuls : comptes observes.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>nlogL</param_name><param_description>scalaire : oppose de la log-vraisemblance.</param_description></param_output_item>
    <param_output_item><param_name>avar</param_name><param_description>scalaire : estimation de variance asymptotique.</param_description></param_output_item>
  </param_output>
  <description><p><b>poisslike</b> retourne l'oppose de la log-vraisemblance pour des donnees de loi de Poisson et l'estimation de variance asymptotique.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 1 2 3 5 8];
[nlogL, avar] = poisslike(3, x);]]></example_item_data></example_item></examples>
