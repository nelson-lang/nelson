  <language>fr_FR</language>
  <keyword>betafit</keyword>
  <short_description>Estimation des paramètres beta</short_description>
  <syntax>
    <syntax_item>phat = betafit(x)</syntax_item>
    <syntax_item>[phat, pci] = betafit(x, alpha)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>vecteur ou matrice réel non vide de valeurs finies dans l'intervalle ouvert (0, 1) : données observées.</param_description></param_input_item>
    <param_input_item><param_name>alpha</param_name><param_description>scalaire dans l'intervalle [0, 1] : niveau de signification. La valeur par défaut est 0.05.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>phat</param_name><param_description>tableau : estimations des paramètres de forme de la loi beta.</param_description></param_output_item>
    <param_output_item><param_name>pci</param_name><param_description>tableau : intervalles de confiance des estimations.</param_description></param_output_item>
  </param_output>
  <description><p><b>betafit</b> estime les deux paramètres de forme de la loi beta.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0.12 0.2 0.35 0.5 0.7 0.85];
[phat, pci] = betafit(x);]]></example_item_data></example_item></examples>
