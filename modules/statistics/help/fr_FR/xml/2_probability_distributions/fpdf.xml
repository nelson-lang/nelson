  <language>fr_FR</language>
  <keyword>fpdf</keyword>
  <short_description>Densité de probabilité F</short_description>
  <syntax>
    <syntax_item>y = fpdf(x, v1, v2)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>tableau numérique réel : valeurs ou la distribution est évaluée.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v1</param_name>
      <param_description>tableau numérique réel positif ou scalaire : degrés de liberté du numérateur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v2</param_name>
      <param_description>tableau numérique réel positif ou scalaire : degrés de liberté du dénominateur.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>y</param_name>
      <param_description>valeurs de densité de probabilité.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>fpdf</b> calcule les valeurs de densité de probabilité de la distribution F. Les entrées scalaires sont étendues a la taille des tableaux.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [0.5 1 2 5];
y = fpdf(x, 5, 20);]]></example_item_data>
    </example_item>
  </examples>
