  <language>fr_FR</language>
  <keyword>logninv</keyword>
  <short_description>Inverse de repartition lognormale</short_description>
  <syntax>
    <syntax_item>x = logninv(p)</syntax_item>
    <syntax_item>x = logninv(p, mu, sigma)</syntax_item>
    <syntax_item>[x, xLo, xUp] = logninv(p, mu, sigma, pCov)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>p</param_name><param_description>probabilites dans [0, 1].</param_description></param_input_item>
    <param_input_item><param_name>mu</param_name><param_description>scalaire reel ou tableau : moyenne des valeurs logarithmiques.</param_description></param_input_item>
    <param_input_item><param_name>sigma</param_name><param_description>scalaire positif ou tableau : ecart-type des valeurs logarithmiques.</param_description></param_input_item>
    <param_input_item><param_name>pCov</param_name><param_description>matrice de covariance 2 par 2 pour les bornes de confiance.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>x</param_name><param_description>tableau : valeurs inverses cumulees.</param_description></param_output_item>
    <param_output_item><param_name>xLo</param_name><param_description>tableau : bornes de confiance inferieures.</param_description></param_output_item>
    <param_output_item><param_name>xUp</param_name><param_description>tableau : bornes de confiance superieures.</param_description></param_output_item>
  </param_output>
  <description><p><b>logninv</b> evalue les inverses lognormales element par element.</p></description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description />
      <example_item_data runnable="cli"><![CDATA[p = [0.15865525393145707 0.5 0.8413447460685429];
x = logninv(p);]]></example_item_data></example_item>
  </examples>
