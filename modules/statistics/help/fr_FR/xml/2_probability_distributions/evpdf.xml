  <language>fr_FR</language>
  <keyword>evpdf</keyword>
  <short_description>Fonction de densité de la loi extrême value</short_description>
  <syntax>
    <syntax_item>y = evpdf(x)</syntax_item>
    <syntax_item>y = evpdf(x, mu)</syntax_item>
    <syntax_item>y = evpdf(x, mu, sigma)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>scalaire ou tableau réel : valeurs.</param_description></param_input_item>
    <param_input_item><param_name>mu</param_name><param_description>scalaire ou tableau réel : paramètre de position. La valeur par défaut est 0.</param_description></param_input_item>
    <param_input_item><param_name>sigma</param_name><param_description>scalaire ou tableau positif : paramètre d'échelle. La valeur par défaut est 1.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>y</param_name><param_description>tableau : valeurs de densité.</param_description></param_output_item></param_output>
  <description><p><b>evpdf</b> évalue élément par élément la densité de la loi extrême value.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [-2 -1 0 1 2];
y = evpdf(x, 0, 1);]]></example_item_data></example_item></examples>
