  <language>fr_FR</language>
  <keyword>poissrnd</keyword>
  <short_description>Nombres aleatoires de Poisson</short_description>
  <syntax>
    <syntax_item>r = poissrnd(lambda)</syntax_item>
    <syntax_item>r = poissrnd(lambda, sz)</syntax_item>
    <syntax_item>r = poissrnd(lambda, sz1, ..., szN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>lambda</param_name><param_description>scalaire positif ou nul ou tableau : parametre de taux.</param_description></param_input_item>
    <param_input_item><param_name>sz</param_name><param_description>scalaire, vecteur ou dimensions separees par des virgules : taille de la sortie.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>tableau : valeurs aleatoires.</param_description></param_output_item></param_output>
  <description><p><b>poissrnd</b> genere des valeurs aleatoires de loi de Poisson.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[rng(0);
r = poissrnd(4, 2, 3);]]></example_item_data></example_item></examples>
