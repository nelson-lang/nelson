  <language>fr_FR</language>
  <keyword>wblpdf</keyword>
  <short_description>Densite de probabilite Weibull</short_description>
  <syntax>
    <syntax_item>y = wblpdf(x)</syntax_item>
    <syntax_item>y = wblpdf(x, a)</syntax_item>
    <syntax_item>y = wblpdf(x, a, b)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>scalaire reel ou tableau : valeurs.</param_description></param_input_item>
    <param_input_item><param_name>a</param_name><param_description>scalaire positif ou tableau : parametre d'echelle. La valeur par defaut est 1.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>scalaire positif ou tableau : parametre de forme. La valeur par defaut est 1.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>y</param_name><param_description>tableau : valeurs de densite.</param_description></param_output_item></param_output>
  <description><p><b>wblpdf</b> evalue les densites Weibull element par element.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 2 4];
y = wblpdf(x, 2, 3);]]></example_item_data></example_item></examples>
