  <language>fr_FR</language>
  <keyword>poisscdf</keyword>
  <short_description>Fonction de répartition de Poisson</short_description>
  <syntax><syntax_item>p = poisscdf(x, lambda)</syntax_item><syntax_item>p = poisscdf(x, lambda, &apos;upper&apos;)</syntax_item></syntax>
  <param_input><param_input_item><param_name>x</param_name><param_description>tableau numérique réel.</param_description></param_input_item><param_input_item><param_name>lambda</param_name><param_description>paramètre de taux non négatif.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>p</param_name><param_description>probabilités cumulées ou de queue supérieure.</param_description></param_output_item></param_output>
  <description><p><b>poisscdf</b> calculé par défaut les probabilités de queue inférieure de Poisson et les probabilités de queue supérieure avec <b>&apos;upper&apos;</b>.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = 0:10;
p = poisscdf(x, 4);
q = poisscdf(x, 4, 'upper');]]></example_item_data></example_item></examples>
