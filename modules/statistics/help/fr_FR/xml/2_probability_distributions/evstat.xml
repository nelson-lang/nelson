  <language>fr_FR</language>
  <keyword>evstat</keyword>
  <short_description>Moyenne et variance de la loi extreme value</short_description>
  <syntax><syntax_item>[m, v] = evstat(mu, sigma)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>mu</param_name><param_description>scalaire ou tableau reel : parametre de position.</param_description></param_input_item>
    <param_input_item><param_name>sigma</param_name><param_description>scalaire ou tableau positif : parametre d'echelle.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>m</param_name><param_description>tableau : valeurs de moyenne.</param_description></param_output_item>
    <param_output_item><param_name>v</param_name><param_description>tableau : valeurs de variance.</param_description></param_output_item>
  </param_output>
  <description><p><b>evstat</b> retourne la moyenne et la variance de la loi extreme value.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[m, v] = evstat(0, 1);]]></example_item_data></example_item></examples>
