  <language>fr_FR</language>
  <keyword>ClassificationNaiveBayes</keyword>
  <short_description>Modèle de classification naive Bayes.</short_description>
  <syntax>
    <syntax_item>mdl = fitcnb(X, Y)</syntax_item>
    <syntax_item>label = predict(mdl, Xnew)</syntax_item>
    <syntax_item>[label, score, cost] = predict(mdl, Xnew)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>matrice numérique : les lignes sont les observations et les colonnes sont les prédicteurs.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>vecteur : étiquettes de classes, une étiquette pour chaque ligne de X.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Name, Value</param_name>
      <param_description>arguments nom-valeur optionnels acceptés par la fonction d&apos;ajustement correspondante.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>mdl</param_name>
      <param_description>objet modèle de classification renvoyé par la fonction d&apos;ajustement.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>label</param_name>
      <param_description>étiquettes de classes prédites pour de nouvelles observations.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>score</param_name>
      <param_description>scores de classes ou valeurs apparentées aux probabilités a posteriori lorsque le modèle les fournit.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>ClassificationNaiveBayes stocke un classifieur naive Bayes avec les probabilités a priori des classes et les informations de distribution des prédicteurs.</p>
    <p>Créez cet objet avec fitcnb. Utilisez predict pour classer de nouvelles observations.</p>
  </description>
  <used_function>
    <used_function_item>fitcnb</used_function_item>
    <used_function_item>predict</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Entraîner un classifieur naive Bayes et classer deux observations.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[X = [0 0; 0 1; 1 0; 5 5; 5 6; 6 5];
Y = [1; 1; 1; 2; 2; 2];
mdl = fitcnb(X, Y);
label = predict(mdl, [0.2 0.1; 5.2 5.1])]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${statistics}predict">predict</link></see_also_item>
    <see_also_item><link linkend="${statistics}fitcnb">fitcnb</link></see_also_item>
  </see_also>
