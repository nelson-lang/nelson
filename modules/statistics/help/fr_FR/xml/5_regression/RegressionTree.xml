  <language>fr_FR</language>
  <keyword>RegressionTree</keyword>
  <short_description>Modele d&apos;arbre de regression.</short_description>
  <syntax>
    <syntax_item>mdl = fitrtree(X, y)</syntax_item>
    <syntax_item>yfit = predict(mdl, Xnew)</syntax_item>
    <syntax_item>[yfit, node] = predict(mdl, Xnew)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>matrice numerique : les lignes sont les observations et les colonnes sont les predicteurs.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>y</param_name>
      <param_description>vecteur numerique : reponses, une valeur pour chaque ligne de X.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Name, Value</param_name>
      <param_description>arguments nom-valeur optionnels acceptes par la fonction d&apos;ajustement correspondante.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>mdl</param_name>
      <param_description>objet modele de regression renvoye par la fonction d&apos;ajustement.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>yfit</param_name>
      <param_description>reponses predites pour de nouvelles observations.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>RegressionTree stocke un arbre de regression construit a partir de predicteurs et d&apos;une reponse numerique.</p>
    <p>Creez cet objet avec fitrtree. Utilisez predict pour estimer les reponses de nouvelles observations.</p>
  </description>
  <used_function>
    <used_function_item>fitrtree</used_function_item>
    <used_function_item>predict</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Entrainer un arbre de regression et predire deux reponses.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[X = [1 1; 2 1; 3 2; 4 3; 5 3; 6 4];
y = 1 + 2 * X(:,1) - X(:,2);
mdl = fitrtree(X, y);
yfit = predict(mdl, [7 4; 8 5])]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${statistics}predict">predict</link></see_also_item>
    <see_also_item><link linkend="${statistics}fitrtree">fitrtree</link></see_also_item>
  </see_also>
