  <language>fr_FR</language>
  <keyword>ridge</keyword>
  <short_description>Régression ridge.</short_description>
  <syntax>
    <syntax_item>B = ridge(y, X, k)</syntax_item>
    <syntax_item>B = ridge(y, X, k, scaled)</syntax_item>
  </syntax>
  <description>
    <p><b>ridge</b> retourne les coefficients de modèles de régression ridge du vecteur réponse <b>y</b> sur la matrice de prédicteurs <b>X</b>.</p>
    <p>Les prédicteurs sont centrés et réduits avant l'ajustement. Si <b>scaled</b> vaut <b>0</b>, les coefficients sont ramenés à l'échelle d'origine des prédicteurs et une ligne d'interception est incluse.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[y = [1; 2.1; 2.9; 4.2; 5.1; 5.9];
X = [(1:6)' [2; 1; 4; 3; 7; 6]];
B = ridge(y, X, [0 0.5 2])]]></example_item_data>
    </example_item>
  </examples>
