  <language>fr_FR</language>
  <keyword>cluster</keyword>
  <short_description>Construire des classes depuis un arbre hierarchique.</short_description>
  <syntax>
    <syntax_item>T = cluster(Z, &apos;MaxClust&apos;, maxclust)</syntax_item>
    <syntax_item>T = cluster(Z, &apos;Cutoff&apos;, cutoff, &apos;Criterion&apos;, &apos;distance&apos;)</syntax_item>
  </syntax>
  <description>
    <p><b>cluster</b> affecte les observations a des classes en coupant un arbre hierarchique.</p>
    <p>Cette version prend en charge le critere distance avec MaxClust ou Cutoff.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [0 0; 1 0; 0 2; 4 4];
Z = linkage(X);
T = cluster(Z, 'MaxClust', 2)]]></example_item_data>
    </example_item>
  </examples>
