  <language>fr_FR</language>
  <keyword>knnsearch</keyword>
  <short_description>Trouver les k plus proches voisins.</short_description>
  <syntax>
    <syntax_item>idx = knnsearch(X, Y)</syntax_item>
    <syntax_item>idx = knnsearch(X, Y, Name, Value)</syntax_item>
    <syntax_item>[idx, D] = knnsearch(...)</syntax_item>
  </syntax>
  <description>
    <p><b>knnsearch</b> trouve les lignes de <b>X</b> les plus proches de chaque ligne de requete de <b>Y</b> avec une recherche exhaustive native.</p>
    <p>Les options prises en charge incluent K, Distance, IncludeTies, NSMethod, SortIndices, P, Scale, Cov, BucketSize et CacheSize. Quand IncludeTies vaut true, les sorties sont des tableaux de cellules.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [0 0; 1 0; 0 2; 4 4];
Y = [0 1; 3 4];
[idx, D] = knnsearch(X, Y, 'K', 2)]]></example_item_data>
    </example_item>
  </examples>
