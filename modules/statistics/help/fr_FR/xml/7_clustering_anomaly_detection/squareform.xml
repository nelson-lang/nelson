  <language>fr_FR</language>
  <keyword>squareform</keyword>
  <short_description>Convertir entre vecteur de distances condense et matrice carree de distances.</short_description>
  <syntax>
    <syntax_item>Z = squareform(D)</syntax_item>
    <syntax_item>D = squareform(Z)</syntax_item>
    <syntax_item>Y = squareform(X, direction)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>D</param_name>
      <param_description>vecteur de distances avec n*(n-1)/2 elements.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Z</param_name>
      <param_description>matrice de distances carree et symetrique.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>direction</param_name>
      <param_description>'tomatrix' ou 'tovector'.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>squareform</b> convertit un vecteur de distances condense en matrice symetrique carree, ou l'inverse.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[D = [1 2 3];
Z = squareform(D)
D2 = squareform(Z)]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item>
      <link linkend="${statistics}pdist">pdist</link>
    </see_also_item>
  </see_also>
