  <language>fr_FR</language>
  <keyword>ztest</keyword>
  <short_description>Test z pour une moyenne avec ecart type connu</short_description>
  <syntax>
    <syntax_item>h = ztest(x, m, sigma)</syntax_item>
    <syntax_item>h = ztest(x, m, sigma, &apos;Alpha&apos;, alpha)</syntax_item>
    <syntax_item>h = ztest(x, m, sigma, &apos;Tail&apos;, tail)</syntax_item>
    <syntax_item>h = ztest(x, m, sigma, &apos;Dim&apos;, dim)</syntax_item>
    <syntax_item>[h, p, ci, zval] = ztest(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>tableau numerique reel : donnees d'echantillon.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>m</param_name>
      <param_description>scalaire reel : moyenne supposee.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>sigma</param_name>
      <param_description>scalaire reel positif : ecart type connu.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>scalaire dans (0,1), 0.05 par defaut : niveau de signification.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>&apos;both&apos;, &apos;right&apos; ou &apos;left&apos;.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>entier positif : dimension de calcul.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>tableau logique : decision du test.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>tableau : p-values.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ci</param_name>
      <param_description>tableau a 2 lignes : intervalles de confiance de la moyenne.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>zval</param_name>
      <param_description>tableau : statistiques z.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ztest</b> effectue un test z le long de la premiere dimension non singleton sauf si <b>Dim</b> est specifie.</p>
    <p>Les valeurs NaN sont ignorees dans chaque tranche testee.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [72 75 77 70 74 76];
[h, p, ci, zval] = ztest(x, 75, 10);
[h2, p2] = ztest(x, 72, 10, 'Tail', 'right');]]></example_item_data>
    </example_item>
  </examples>
