  <language>fr_FR</language>
  <keyword>ttest2</keyword>
  <short_description>Test t a deux echantillons</short_description>
  <syntax>
    <syntax_item>h = ttest2(x, y)</syntax_item>
    <syntax_item>h = ttest2(x, y, &apos;Alpha&apos;, alpha)</syntax_item>
    <syntax_item>h = ttest2(x, y, &apos;Tail&apos;, tail)</syntax_item>
    <syntax_item>h = ttest2(x, y, &apos;Vartype&apos;, vartype)</syntax_item>
    <syntax_item>h = ttest2(x, y, &apos;Dim&apos;, dim)</syntax_item>
    <syntax_item>[h, p, ci, stats] = ttest2(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>tableau numerique reel : premier echantillon.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>y</param_name>
      <param_description>tableau numerique reel : second echantillon.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>scalaire dans (0,1), 0.05 par defaut : niveau de signification.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>&apos;both&apos;, &apos;right&apos; ou &apos;left&apos;.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>vartype</param_name>
      <param_description>&apos;equal&apos; par defaut ou &apos;unequal&apos; pour le test de Welch.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>entier positif : dimension de calcul.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>tableau logique : decision du test.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>tableau : p-values.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ci</param_name>
      <param_description>tableau a 2 lignes : intervalles de confiance de la difference moyenne.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>stats</param_name>
      <param_description>structure avec les champs tstat, df et sd.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ttest2</b> effectue un test t a deux echantillons le long de la premiere dimension non singleton sauf si <b>Dim</b> est specifie.</p>
    <p>Les valeurs NaN sont ignorees independamment dans chaque echantillon teste.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [10 11 13 15 18];
y = [7 8 8 9];
[h, p, ci, stats] = ttest2(x, y, 'Vartype', 'unequal', 'Tail', 'right');]]></example_item_data>
    </example_item>
  </examples>
