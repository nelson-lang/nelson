  <language>fr_FR</language>
  <keyword>vartest</keyword>
  <short_description>Test du chi-square pour une variance</short_description>
  <syntax>
    <syntax_item>h = vartest(x, v)</syntax_item>
    <syntax_item>h = vartest(x, v, &apos;Alpha&apos;, alpha)</syntax_item>
    <syntax_item>h = vartest(x, v, &apos;Tail&apos;, tail)</syntax_item>
    <syntax_item>h = vartest(x, v, &apos;Dim&apos;, dim)</syntax_item>
    <syntax_item>[h, p, ci, stats] = vartest(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>tableau numerique reel : donnees d'echantillon.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v</param_name>
      <param_description>scalaire reel non negatif : variance supposee.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>scalaire dans (0,1), 0.05 par defaut : niveau de signification.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>&apos;both&apos;, &apos;right&apos; ou &apos;left&apos;.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>entier positif : dimension de calcul.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>tableau logique : decision du test.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>tableau : p-values.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ci</param_name>
      <param_description>tableau a 2 lignes : intervalles de confiance de la variance.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>stats</param_name>
      <param_description>structure avec les champs chisqstat et df.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>vartest</b> effectue un test de variance chi-square le long de la premiere dimension non singleton sauf si <b>Dim</b> est specifie.</p>
    <p>Les valeurs NaN sont ignorees dans chaque tranche testee.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [4.5 4.8 5.1 5.4 5.7 6.0];
[h, p, ci, stats] = vartest(x, 0.4);
[h2, p2] = vartest(x, 0.2, 'Tail', 'right');]]></example_item_data>
    </example_item>
  </examples>
