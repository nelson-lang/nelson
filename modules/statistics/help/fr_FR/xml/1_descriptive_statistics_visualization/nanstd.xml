  <language>fr_FR</language>
  <keyword>nanstd</keyword>
  <short_description>Ecart type en ignorant les valeurs NaN.</short_description>
  <syntax>
    <syntax_item>s = nanstd(X)</syntax_item>
    <syntax_item>s = nanstd(X, flag)</syntax_item>
    <syntax_item>s = nanstd(X, flag, dim)</syntax_item>
    <syntax_item>s = nanstd(X, flag, vecdim)</syntax_item>
    <syntax_item>s = nanstd(X, flag, 'all')</syntax_item>
  </syntax>
  <description>
    <p><b>nanstd</b> calcule l'ecart type apres suppression des valeurs <b>NaN</b> dans chaque tranche traitee.</p>
    <p><b>flag</b> vaut <b>0</b> pour la normalisation echantillon et <b>1</b> pour la normalisation population.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = magic(3);
X([1 6:9]) = NaN;
s = nanstd(X, 0, 2)]]></example_item_data>
    </example_item>
  </examples>
