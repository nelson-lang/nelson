  <language>fr_FR</language>
  <keyword>kurtosis</keyword>
  <short_description>Aplatissement d'un jeu de donnees.</short_description>
  <syntax>
    <syntax_item>k = kurtosis(X)</syntax_item>
    <syntax_item>k = kurtosis(X, flag)</syntax_item>
    <syntax_item>k = kurtosis(X, flag, dim)</syntax_item>
    <syntax_item>k = kurtosis(X, flag, vecdim)</syntax_item>
    <syntax_item>k = kurtosis(X, flag, 'all')</syntax_item>
  </syntax>
  <description>
    <p><b>kurtosis</b> calcule l'aplatissement d'echantillon de donnees numeriques. Les valeurs <b>NaN</b> sont omises.</p>
    <p><b>flag</b> vaut 1 par defaut. Mettre <b>flag</b> a 0 applique la correction de biais.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [1 2 5; 2 4 8; 3 8 13];
k = kurtosis(X)]]></example_item_data>
    </example_item>
  </examples>
