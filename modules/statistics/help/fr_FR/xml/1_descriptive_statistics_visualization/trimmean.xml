  <language>fr_FR</language>
  <keyword>trimmean</keyword>
  <short_description>Moyenne apres suppression des valeurs extremes.</short_description>
  <syntax>
    <syntax_item>m = trimmean(X, percent)</syntax_item>
    <syntax_item>m = trimmean(X, percent, flag)</syntax_item>
    <syntax_item>m = trimmean(..., dim)</syntax_item>
    <syntax_item>m = trimmean(..., vecdim)</syntax_item>
    <syntax_item>m = trimmean(..., 'all')</syntax_item>
  </syntax>
  <description>
    <p><b>trimmean</b> calcule la moyenne apres suppression d'un pourcentage des plus petites et plus grandes valeurs. Les valeurs <b>NaN</b> sont omises.</p>
    <p><b>flag</b> controle les comptes de rognage non entiers et peut valoir <b>round</b>, <b>floor</b> ou <b>weighted</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = reshape(1:40, [5 4 2]);
X([3 37]) = -100;
m = trimmean(X, 10, [1 2])]]></example_item_data>
    </example_item>
  </examples>
