  <language>fr_FR</language>
  <keyword>corr</keyword>
  <short_description>Correlation lineaire ou de rang.</short_description>
  <syntax>
    <syntax_item>rho = corr(X)</syntax_item>
    <syntax_item>rho = corr(X, Y)</syntax_item>
    <syntax_item>[rho, pval] = corr(...)</syntax_item>
    <syntax_item>[rho, pval] = corr(..., Name, Value)</syntax_item>
  </syntax>
  <description>
    <p><b>corr</b> calcule les correlations entre paires de colonnes de <b>X</b>, ou entre les colonnes de <b>X</b> et <b>Y</b>.</p>
    <p>Les options prises en charge sont <b>Type</b> avec <b>pearson</b>, <b>spearman</b> ou <b>kendall</b>; <b>Rows</b> avec <b>all</b>, <b>complete</b> ou <b>pairwise</b>; <b>Tail</b> avec <b>both</b>, <b>right</b> ou <b>left</b>; et <b>Weights</b> pour les poids d'observation.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [1 2 3; 2 4 1; 3 NaN 2; 4 8 4; 5 10 5];
rho = corr(X, 'Rows', 'pairwise')]]></example_item_data>
    </example_item>
  </examples>
