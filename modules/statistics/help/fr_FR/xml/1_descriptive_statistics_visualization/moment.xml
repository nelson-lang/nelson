  <language>fr_FR</language>
  <keyword>moment</keyword>
  <short_description>Moment centre d'un jeu de donnees.</short_description>
  <syntax>
    <syntax_item>m = moment(X, order)</syntax_item>
    <syntax_item>m = moment(X, order, dim)</syntax_item>
    <syntax_item>m = moment(X, order, vecdim)</syntax_item>
    <syntax_item>m = moment(X, order, 'all')</syntax_item>
  </syntax>
  <description>
    <p><b>moment</b> calcule le moment centre d'ordre entier positif demande.</p>
    <p>Le moment centre du premier ordre vaut zero. Le moment centre du second ordre utilise un diviseur <b>n</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [1 2 4; 2 4 8; 3 8 13];
m = moment(X, 3)]]></example_item_data>
    </example_item>
  </examples>
