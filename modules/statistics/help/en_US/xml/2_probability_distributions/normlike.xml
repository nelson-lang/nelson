  <language>en_US</language>
  <keyword>normlike</keyword>
  <short_description>Normal negative log-likelihood</short_description>
  <syntax>
    <syntax_item>nlogL = normlike(params, x)</syntax_item>
    <syntax_item>[nlogL, avar] = normlike(params, x)</syntax_item>
    <syntax_item>[nlogL, avar] = normlike(params, x, censoring, freq)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>params</param_name><param_description>two-element real vector [mu sigma]: normal distribution parameters.</param_description></param_input_item>
    <param_input_item><param_name>x</param_name><param_description>finite real nonempty array: sample data.</param_description></param_input_item>
    <param_input_item><param_name>censoring</param_name><param_description>array containing 0 or 1 values: right-censoring flags.</param_description></param_input_item>
    <param_input_item><param_name>freq</param_name><param_description>array of nonnegative finite values: observation frequencies.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>nlogL</param_name><param_description>scalar: negative log-likelihood.</param_description></param_output_item>
    <param_output_item><param_name>avar</param_name><param_description>2-by-2 array: asymptotic covariance estimate.</param_description></param_output_item>
  </param_output>
  <description><p><b>normlike</b> returns the negative log-likelihood for normal distribution data and the asymptotic covariance estimate.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [-2 -1 0 1 3 5];
[nlogL, avar] = normlike([1 2], x);]]></example_item_data></example_item></examples>
