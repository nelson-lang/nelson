  <short_description>Student t mean and variance</short_description>
  <syntax><syntax_item>[m, v] = tstat(nu)</syntax_item></syntax>
  <param_input><param_input_item><param_name>nu</param_name><param_description>positive scalar or array: degrees of freedom.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>m</param_name><param_description>array: mean values.</param_description></param_output_item><param_output_item><param_name>v</param_name><param_description>array: variance values.</param_description></param_output_item></param_output>
  <description><p><b>tstat</b> returns the mean and variance of the Student t distribution.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[m, v] = tstat([1.5 3 Inf]);]]></example_item_data></example_item></examples>
