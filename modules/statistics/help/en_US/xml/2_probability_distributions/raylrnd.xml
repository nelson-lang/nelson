  <keyword>raylrnd</keyword>
  <short_description>Rayleigh random numbers</short_description>
  <syntax>
    <syntax_item>r = raylrnd(b)</syntax_item>
    <syntax_item>r = raylrnd(b, sz)</syntax_item>
    <syntax_item>r = raylrnd(b, sz1, ..., szN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>b</param_name><param_description>positive scalar or array: scale parameter.</param_description></param_input_item>
    <param_input_item><param_name>sz</param_name><param_description>size vector or size scalars for the output.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>array: random values.</param_description></param_output_item></param_output>
  <description><p><b>raylrnd</b> generates Rayleigh random numbers using Nelson&apos;s global random generator.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[rng(0);
r = raylrnd(2, [2 3]);]]></example_item_data></example_item></examples>
