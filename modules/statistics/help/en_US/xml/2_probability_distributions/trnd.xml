  <keyword>trnd</keyword>
  <short_description>Student t random numbers</short_description>
  <syntax><syntax_item>r = trnd(nu)</syntax_item><syntax_item>r = trnd(nu, sz)</syntax_item><syntax_item>r = trnd(nu, sz1, ..., szN)</syntax_item></syntax>
  <param_input><param_input_item><param_name>nu</param_name><param_description>positive scalar or array: degrees of freedom.</param_description></param_input_item><param_input_item><param_name>sz</param_name><param_description>scalar, vector, or comma-separated dimensions: output size.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>array: random values.</param_description></param_output_item></param_output>
  <description><p><b>trnd</b> generates Student t distributed random values.</p></description>
