  <language>en_US</language>
  <keyword>gamlike</keyword>
  <short_description>Gamma negative log-likelihood</short_description>
  <syntax>
    <syntax_item>nlogL = gamlike(params, x)</syntax_item>
    <syntax_item>[nlogL, avar] = gamlike(params, x, censoring, freq)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>params</param_name><param_description>two-element vector: shape and scale parameters.</param_description></param_input_item>
    <param_input_item><param_name>x</param_name><param_description>positive finite real nonempty array: sample data.</param_description></param_input_item>
    <param_input_item><param_name>censoring</param_name><param_description>array containing 0 or 1 values: right-censoring flags.</param_description></param_input_item>
    <param_input_item><param_name>freq</param_name><param_description>array of nonnegative finite values: observation frequencies.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>nlogL</param_name><param_description>scalar: negative log-likelihood.</param_description></param_output_item>
    <param_output_item><param_name>avar</param_name><param_description>2-by-2 array: approximate covariance matrix.</param_description></param_output_item>
  </param_output>
  <description><p><b>gamlike</b> evaluates the negative log-likelihood of the gamma distribution.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0.5 1 2 3 5 8];
phat = gamfit(x);
nlogL = gamlike(phat, x);]]></example_item_data></example_item></examples>
