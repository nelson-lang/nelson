  <language>en_US</language>
  <keyword>evstat</keyword>
  <short_description>Extreme value mean and variance</short_description>
  <syntax><syntax_item>[m, v] = evstat(mu, sigma)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>mu</param_name><param_description>real scalar or array: location parameter.</param_description></param_input_item>
    <param_input_item><param_name>sigma</param_name><param_description>positive scalar or array: scale parameter.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>m</param_name><param_description>array: mean values.</param_description></param_output_item>
    <param_output_item><param_name>v</param_name><param_description>array: variance values.</param_description></param_output_item>
  </param_output>
  <description><p><b>evstat</b> returns the mean and variance of the extreme value distribution.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[m, v] = evstat(0, 1);]]></example_item_data></example_item></examples>
