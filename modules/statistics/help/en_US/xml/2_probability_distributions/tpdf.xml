  <language>en_US</language>
  <keyword>tpdf</keyword>
  <short_description>Student t probability density function</short_description>
  <syntax>
    <syntax_item>y = tpdf(x, v)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>real numeric array: values where the distribution is evaluated.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v</param_name>
      <param_description>positive real numeric array or scalar: degrees of freedom.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>y</param_name>
      <param_description>probability density values.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tpdf</b> computes Student t probability density values. Scalar inputs are expanded to match array inputs.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [-3 -1 0 1 3];
y = tpdf(x, 5);]]></example_item_data>
    </example_item>
  </examples>
