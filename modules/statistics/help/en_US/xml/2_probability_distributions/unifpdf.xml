  <language>en_US</language>
  <keyword>unifpdf</keyword>
  <short_description>Continuous uniform probability density function</short_description>
  <syntax><syntax_item>y = unifpdf(x)</syntax_item><syntax_item>y = unifpdf(x, a, b)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>real numeric array.</param_description></param_input_item>
    <param_input_item><param_name>a</param_name><param_description>lower endpoint, default 0.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>upper endpoint, default 1.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>y</param_name><param_description>probability density values.</param_description></param_output_item></param_output>
  <description><p><b>unifpdf</b> computes continuous uniform density values. Scalar inputs are expanded to match array inputs.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = 0:0.25:1;
y = unifpdf(x);]]></example_item_data></example_item></examples>
