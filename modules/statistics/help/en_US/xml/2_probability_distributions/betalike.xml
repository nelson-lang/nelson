  <language>en_US</language>
  <keyword>betalike</keyword>
  <short_description>Beta negative log-likelihood</short_description>
  <syntax>
    <syntax_item>nlogL = betalike(params, x)</syntax_item>
    <syntax_item>[nlogL, avar] = betalike(params, x)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>params</param_name><param_description>two-element positive real vector: beta distribution shape parameters.</param_description></param_input_item>
    <param_input_item><param_name>x</param_name><param_description>finite real nonempty array with values in the open interval (0, 1): sample data.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>nlogL</param_name><param_description>scalar: negative log-likelihood.</param_description></param_output_item>
    <param_output_item><param_name>avar</param_name><param_description>2-by-2 array: asymptotic covariance estimate.</param_description></param_output_item>
  </param_output>
  <description><p><b>betalike</b> returns the negative log-likelihood for beta distribution data and the asymptotic covariance estimate.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0.12 0.2 0.35 0.5 0.7 0.85];
[nlogL, avar] = betalike([1.5 1.8], x);]]></example_item_data></example_item></examples>
