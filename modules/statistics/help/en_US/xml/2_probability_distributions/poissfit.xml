  <language>en_US</language>
  <keyword>poissfit</keyword>
  <short_description>Poisson rate estimate</short_description>
  <syntax><syntax_item>lambdaHat = poissfit(x)</syntax_item><syntax_item>[lambdaHat, lambdaCI] = poissfit(x, alpha)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>nonnegative integer finite real nonempty vector or matrix: sample counts.</param_description></param_input_item>
    <param_input_item><param_name>alpha</param_name><param_description>scalar in the range [0, 1]: significance level. Default is 0.05.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>lambdaHat</param_name><param_description>array: Poisson rate estimates.</param_description></param_output_item>
    <param_output_item><param_name>lambdaCI</param_name><param_description>array: confidence intervals for the estimates.</param_description></param_output_item>
  </param_output>
  <description><p><b>poissfit</b> estimates the rate parameter of the Poisson distribution.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 1 2 3 5 8];
[lambdaHat, lambdaCI] = poissfit(x);]]></example_item_data></example_item></examples>
