  <keyword>gevrnd</keyword>
  <short_description>Generalized extreme value random numbers</short_description>
  <syntax><syntax_item>r = gevrnd(k, sigma, mu)</syntax_item><syntax_item>r = gevrnd(k, sigma, mu, sz)</syntax_item><syntax_item>r = gevrnd(k, sigma, mu, sz1, ..., szN)</syntax_item></syntax>
  <param_input><param_input_item><param_name>k</param_name><param_description>real array: shape parameter.</param_description></param_input_item><param_input_item><param_name>sigma</param_name><param_description>positive real array: scale parameter.</param_description></param_input_item><param_input_item><param_name>mu</param_name><param_description>real array: location parameter.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>array: random values.</param_description></param_output_item></param_output>
  <description><p><b>gevrnd</b> generates generalized extreme value random values.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[r = gevrnd(0.2, 1, 0, 2, 3);]]></example_item_data></example_item></examples>
