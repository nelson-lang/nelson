  <keyword>poisspdf</keyword>
  <short_description>Poisson probability density function</short_description>
  <syntax><syntax_item>y = poisspdf(x, lambda)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>real numeric array.</param_description></param_input_item>
    <param_input_item><param_name>lambda</param_name><param_description>nonnegative rate parameter.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>y</param_name><param_description>probability mass values.</param_description></param_output_item></param_output>
  <description><p><b>poisspdf</b> computes Poisson probability mass values. Scalar inputs are expanded to match array inputs.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = 0:10;
y = poisspdf(x, 4);]]></example_item_data></example_item></examples>
