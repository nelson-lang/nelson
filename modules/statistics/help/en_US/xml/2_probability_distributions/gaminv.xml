  <language>en_US</language>
  <keyword>gaminv</keyword>
  <short_description>Gamma inverse cumulative distribution function</short_description>
  <syntax>
    <syntax_item>x = gaminv(p, a)</syntax_item>
    <syntax_item>x = gaminv(p, a, b)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>p</param_name><param_description>real numeric array of probabilities.</param_description></param_input_item>
    <param_input_item><param_name>a</param_name><param_description>positive shape parameter.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>positive scale parameter, default 1.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>x</param_name><param_description>inverse lower-tail gamma values.</param_description></param_output_item>
  </param_output>
  <description><p><b>gaminv</b> computes inverse lower-tail gamma probabilities.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[p = [0.025 0.5 0.975];
x = gaminv(p, 2, 3);]]></example_item_data></example_item></examples>
