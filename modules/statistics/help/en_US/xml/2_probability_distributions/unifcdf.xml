  <language>en_US</language>
  <keyword>unifcdf</keyword>
  <short_description>Continuous uniform cumulative distribution function</short_description>
  <syntax><syntax_item>p = unifcdf(x)</syntax_item><syntax_item>p = unifcdf(x, a, b)</syntax_item><syntax_item>p = unifcdf(..., &apos;upper&apos;)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>real numeric array.</param_description></param_input_item>
    <param_input_item><param_name>a</param_name><param_description>lower endpoint, default 0.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>upper endpoint, default 1.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>p</param_name><param_description>cumulative probabilities or upper-tail probabilities.</param_description></param_output_item></param_output>
  <description><p><b>unifcdf</b> computes lower-tail continuous uniform probabilities by default and upper-tail probabilities with <b>&apos;upper&apos;</b>.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = 0:0.25:1;
p = unifcdf(x);
q = unifcdf(x, 'upper');]]></example_item_data></example_item></examples>
