  <language>en_US</language>
  <keyword>expinv</keyword>
  <short_description>Exponential inverse cumulative distribution function</short_description>
  <syntax>
    <syntax_item>x = expinv(p)</syntax_item>
    <syntax_item>x = expinv(p, mu)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>p</param_name><param_description>real numeric array of probabilities.</param_description></param_input_item>
    <param_input_item><param_name>mu</param_name><param_description>positive mean parameter, default 1.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>inverse lower-tail exponential values.</param_description></param_output_item></param_output>
  <description><p><b>expinv</b> computes inverse lower-tail exponential probabilities.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[p = [0.025 0.5 0.975];
x = expinv(p, 3);]]></example_item_data></example_item></examples>
