  <language>en_US</language>
  <keyword>exprnd</keyword>
  <short_description>Exponential random numbers</short_description>
  <syntax>
    <syntax_item>r = exprnd(mu)</syntax_item>
    <syntax_item>r = exprnd(mu, sz)</syntax_item>
    <syntax_item>r = exprnd(mu, sz1, ..., szN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>mu</param_name><param_description>positive scalar or array: mean parameter.</param_description></param_input_item>
    <param_input_item><param_name>sz</param_name><param_description>scalar, vector, or comma-separated dimensions: output size.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>array: random values.</param_description></param_output_item></param_output>
  <description><p><b>exprnd</b> generates exponential distributed random values.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[rng(0);
r = exprnd(2, 2, 3);]]></example_item_data></example_item></examples>
