  <language>en_US</language>
  <keyword>geornd</keyword>
  <short_description>Geometric random numbers</short_description>
  <syntax>
    <syntax_item>r = geornd(p)</syntax_item>
    <syntax_item>r = geornd(p, sz)</syntax_item>
    <syntax_item>r = geornd(p, sz1, ..., szN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>p</param_name><param_description>scalar or array in the range [0, 1]: probability of success.</param_description></param_input_item>
    <param_input_item><param_name>sz</param_name><param_description>scalar, vector, or comma-separated dimensions: output size.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>array: random values.</param_description></param_output_item></param_output>
  <description><p><b>geornd</b> generates geometric distributed random values.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[rng(0);
r = geornd(0.25, 2, 3);]]></example_item_data></example_item></examples>
