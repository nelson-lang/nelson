  <copyright>SAME AS NELSON SOFTWARE</copyright><language>en_US</language><keyword>normstat</keyword>
  <short_description>Normal mean and variance</short_description>
  <syntax><syntax_item>[m, v] = normstat(mu, sigma)</syntax_item></syntax>
  <param_input><param_input_item><param_name>mu</param_name><param_description>scalar or array: mean parameter.</param_description></param_input_item><param_input_item><param_name>sigma</param_name><param_description>nonnegative scalar or array: standard deviation.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>m</param_name><param_description>array: mean values.</param_description></param_output_item><param_output_item><param_name>v</param_name><param_description>array: variance values.</param_description></param_output_item></param_output>
  <description><p><b>normstat</b> returns the mean and variance of the normal distribution.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[m, v] = normstat([0 1 2], [1 2 3]);]]></example_item_data></example_item></examples>
