  <language>en_US</language>
  <keyword>geocdf</keyword>
  <short_description>Geometric cumulative distribution function</short_description>
  <syntax>
    <syntax_item>y = geocdf(x, p)</syntax_item>
    <syntax_item>y = geocdf(x, p, 'upper')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>real scalar or array: number of failures before the first success.</param_description></param_input_item>
    <param_input_item><param_name>p</param_name><param_description>scalar or array in the range [0, 1]: probability of success.</param_description></param_input_item>
    <param_input_item><param_name>'upper'</param_name><param_description>option to return the upper tail probability.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>y</param_name><param_description>array: probability values.</param_description></param_output_item></param_output>
  <description><p><b>geocdf</b> evaluates geometric cumulative probabilities element by element.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 1 2 5];
y = geocdf(x, 0.25);]]></example_item_data></example_item></examples>
