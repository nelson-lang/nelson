  <language>en_US</language>
  <keyword>unifrnd</keyword>
  <short_description>Continuous uniform random numbers</short_description>
  <syntax>
    <syntax_item>r = unifrnd(a, b)</syntax_item>
    <syntax_item>r = unifrnd(a, b, sz)</syntax_item>
    <syntax_item>r = unifrnd(a, b, sz1, ..., szN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>a</param_name>
      <param_description>real scalar or array: lower endpoint.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>b</param_name>
      <param_description>real scalar or array: upper endpoint.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>sz</param_name>
      <param_description>size vector or size scalars for the output.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>r</param_name>
      <param_description>array: random values.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>unifrnd</b> generates random numbers from continuous uniform distributions using Nelson&apos;s global random generator.</p>
    <p>Scalar endpoints are expanded to the requested output size. Invalid intervals produce NaN values.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[rng(0);
r = unifrnd(0, 1);
r2 = unifrnd(0, 1, [2 3]);
r3 = unifrnd(0:5, 1:6, 1, 6);]]></example_item_data>
    </example_item>
  </examples>
