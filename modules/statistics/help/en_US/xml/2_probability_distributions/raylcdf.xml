  <language>en_US</language>
  <keyword>raylcdf</keyword>
  <short_description>Rayleigh cumulative distribution function</short_description>
  <syntax>
    <syntax_item>p = raylcdf(x, b)</syntax_item>
    <syntax_item>p = raylcdf(x, b, 'upper')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>real scalar or array: values.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>positive scalar or array: scale parameter.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>p</param_name><param_description>array: cumulative probabilities.</param_description></param_output_item></param_output>
  <description><p><b>raylcdf</b> evaluates Rayleigh cumulative probabilities element by element.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[p = raylcdf([0 2 4], 2);
q = raylcdf([0 2 4], 2, 'upper');]]></example_item_data></example_item></examples>
