  <keyword>gevinv</keyword>
  <short_description>Generalized extreme value inverse cumulative distribution function</short_description>
  <syntax><syntax_item>x = gevinv(p, k, sigma, mu)</syntax_item></syntax>
  <param_input><param_input_item><param_name>p</param_name><param_description>real array in the range [0, 1]: probabilities.</param_description></param_input_item><param_input_item><param_name>k</param_name><param_description>real array: shape parameter.</param_description></param_input_item><param_input_item><param_name>sigma</param_name><param_description>positive real array: scale parameter.</param_description></param_input_item><param_input_item><param_name>mu</param_name><param_description>real array: location parameter.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>array: quantiles.</param_description></param_output_item></param_output>
  <description><p><b>gevinv</b> computes generalized extreme value quantiles element by element.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[p = [0.1 0.5 0.9];
x = gevinv(p, 0.2, 1, 0);]]></example_item_data></example_item></examples>
