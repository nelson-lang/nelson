  <language>en_US</language>
  <keyword>unidfit</keyword>
  <short_description>Discrete uniform maximum estimate</short_description>
  <syntax><syntax_item>nHat = unidfit(x)</syntax_item><syntax_item>[nHat, nCI] = unidfit(x, alpha)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>positive integer finite real nonempty vector or matrix: sample data.</param_description></param_input_item>
    <param_input_item><param_name>alpha</param_name><param_description>scalar in the range [0, 1]: significance level. Default is 0.05.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>nHat</param_name><param_description>array: estimates of the maximum integer value.</param_description></param_output_item>
    <param_output_item><param_name>nCI</param_name><param_description>array: confidence intervals for the estimates.</param_description></param_output_item>
  </param_output>
  <description><p><b>unidfit</b> estimates the maximum value of a discrete uniform distribution on integers from 1 to n.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [1 2 4 5 5];
[nHat, nCI] = unidfit(x);]]></example_item_data></example_item></examples>
