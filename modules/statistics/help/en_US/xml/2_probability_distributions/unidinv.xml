  <language>en_US</language>
  <keyword>unidinv</keyword>
  <short_description>Discrete uniform inverse cumulative distribution function</short_description>
  <syntax><syntax_item>x = unidinv(p, n)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>p</param_name><param_description>probabilities in the range [0, 1].</param_description></param_input_item>
    <param_input_item><param_name>n</param_name><param_description>positive integer scalar or array: maximum value.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>inverse values.</param_description></param_output_item></param_output>
  <description><p><b>unidinv</b> computes inverse cumulative probabilities for the discrete uniform distribution on integers from 1 to <b>n</b>.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[p = [0 0.1 0.5 1];
x = unidinv(p, 5);]]></example_item_data></example_item></examples>
