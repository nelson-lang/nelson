  <keyword>frnd</keyword>
  <short_description>F random numbers</short_description>
  <syntax><syntax_item>r = frnd(v1, v2)</syntax_item><syntax_item>r = frnd(v1, v2, sz)</syntax_item><syntax_item>r = frnd(v1, v2, sz1, ..., szN)</syntax_item></syntax>
  <param_input><param_input_item><param_name>v1</param_name><param_description>positive scalar or array: numerator degrees of freedom.</param_description></param_input_item><param_input_item><param_name>v2</param_name><param_description>positive scalar or array: denominator degrees of freedom.</param_description></param_input_item><param_input_item><param_name>sz</param_name><param_description>scalar, vector, or comma-separated dimensions: output size.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>array: random values.</param_description></param_output_item></param_output>
  <description><p><b>frnd</b> generates F distributed random values.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[rng(0);
r = frnd(5, 7, 2, 3);]]></example_item_data></example_item></examples>
