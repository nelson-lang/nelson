  <keyword>exppdf</keyword>
  <short_description>Exponential probability density function</short_description>
  <syntax>
    <syntax_item>y = exppdf(x)</syntax_item>
    <syntax_item>y = exppdf(x, mu)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>real numeric array.</param_description></param_input_item>
    <param_input_item><param_name>mu</param_name><param_description>positive mean parameter, default 1.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>y</param_name><param_description>probability density values.</param_description></param_output_item></param_output>
  <description><p><b>exppdf</b> computes exponential distribution density values.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 0.5 1 2];
y = exppdf(x, 3);]]></example_item_data></example_item></examples>
