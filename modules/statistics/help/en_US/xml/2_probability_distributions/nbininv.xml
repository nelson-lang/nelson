  <language>en_US</language>
  <keyword>nbininv</keyword>
  <short_description>Negative binomial inverse cumulative distribution function</short_description>
  <syntax><syntax_item>x = nbininv(y, r, p)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>y</param_name><param_description>probabilities in the range [0, 1].</param_description></param_input_item>
    <param_input_item><param_name>r</param_name><param_description>positive scalar or array: number of successes.</param_description></param_input_item>
    <param_input_item><param_name>p</param_name><param_description>scalar or array in the range [0, 1]: success probability.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>x</param_name><param_description>inverse values.</param_description></param_output_item></param_output>
  <description><p><b>nbininv</b> computes inverse cumulative probabilities for the negative binomial distribution.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[y = [0.1 0.5 0.9];
x = nbininv(y, 3, 0.4);]]></example_item_data></example_item></examples>
