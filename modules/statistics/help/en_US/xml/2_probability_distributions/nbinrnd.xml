  <language>en_US</language>
  <keyword>nbinrnd</keyword>
  <short_description>Negative binomial random numbers</short_description>
  <syntax>
    <syntax_item>rout = nbinrnd(r, p)</syntax_item>
    <syntax_item>rout = nbinrnd(r, p, sz)</syntax_item>
    <syntax_item>rout = nbinrnd(r, p, sz1, ..., szN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>r</param_name><param_description>positive scalar or array: number of successes.</param_description></param_input_item>
    <param_input_item><param_name>p</param_name><param_description>scalar or array in the range [0, 1]: success probability.</param_description></param_input_item>
    <param_input_item><param_name>sz</param_name><param_description>scalar, vector, or comma-separated dimensions: output size.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>rout</param_name><param_description>array: random values.</param_description></param_output_item></param_output>
  <description><p><b>nbinrnd</b> generates negative binomial distributed random values.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[rng(0);
rout = nbinrnd(3, 0.4, 2, 3);]]></example_item_data></example_item></examples>
