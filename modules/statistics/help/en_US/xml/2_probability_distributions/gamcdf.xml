  <language>en_US</language>
  <keyword>gamcdf</keyword>
  <short_description>Gamma cumulative distribution function</short_description>
  <syntax>
    <syntax_item>p = gamcdf(x, a)</syntax_item>
    <syntax_item>p = gamcdf(x, a, b)</syntax_item>
    <syntax_item>p = gamcdf(x, a, b, &apos;upper&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>real numeric array.</param_description></param_input_item>
    <param_input_item><param_name>a</param_name><param_description>positive shape parameter.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>positive scale parameter, default 1.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>p</param_name><param_description>cumulative probabilities or upper-tail probabilities.</param_description></param_output_item>
  </param_output>
  <description><p><b>gamcdf</b> computes lower-tail gamma probabilities by default and upper-tail probabilities with <b>&apos;upper&apos;</b>.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 0.5 1 2 5];
p = gamcdf(x, 2, 3);
q = gamcdf(x, 2, 3, 'upper');]]></example_item_data></example_item></examples>
  <history><history_item><history_version>2.0.0</history_version><history_description>initial version</history_description></history_item></history>
  <authors><author_item>Allan CORNET</author_item></authors>
</xmldoc>
