  <language>en_US</language>
  <keyword>chi2cdf</keyword>
  <short_description>Chi-square cumulative distribution function</short_description>
  <syntax>
    <syntax_item>p = chi2cdf(x, v)</syntax_item>
    <syntax_item>p = chi2cdf(x, v, &apos;upper&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>real numeric array: values where the distribution is evaluated.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v</param_name>
      <param_description>positive real numeric array or scalar: degrees of freedom.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>cumulative probabilities or upper-tail probabilities.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>chi2cdf</b> computes lower-tail chi-square probabilities by default and upper-tail probabilities when <b>&apos;upper&apos;</b> is specified.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [0.5 1 2 5];
p = chi2cdf(x, 4);
q = chi2cdf(x, 4, 'upper');]]></example_item_data>
    </example_item>
  </examples>
