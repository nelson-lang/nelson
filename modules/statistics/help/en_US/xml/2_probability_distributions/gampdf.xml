  <language>en_US</language>
  <keyword>gampdf</keyword>
  <short_description>Gamma probability density function</short_description>
  <syntax>
    <syntax_item>y = gampdf(x, a)</syntax_item>
    <syntax_item>y = gampdf(x, a, b)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x</param_name><param_description>real numeric array.</param_description></param_input_item>
    <param_input_item><param_name>a</param_name><param_description>positive shape parameter.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>positive scale parameter, default 1.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>y</param_name><param_description>probability density values.</param_description></param_output_item>
  </param_output>
  <description><p><b>gampdf</b> computes gamma distribution density values. Scalar inputs are expanded to match array inputs.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [0 0.5 1 2 5];
y = gampdf(x, 2, 3);]]></example_item_data></example_item></examples>
