  <language>en_US</language>
  <keyword>fpdf</keyword>
  <short_description>F probability density function</short_description>
  <syntax>
    <syntax_item>y = fpdf(x, v1, v2)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>real numeric array: values where the distribution is evaluated.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v1</param_name>
      <param_description>positive real numeric array or scalar: numerator degrees of freedom.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v2</param_name>
      <param_description>positive real numeric array or scalar: denominator degrees of freedom.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>y</param_name>
      <param_description>probability density values.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>fpdf</b> computes F distribution probability density values. Scalar inputs are expanded to match array inputs.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [0.5 1 2 5];
y = fpdf(x, 5, 20);]]></example_item_data>
    </example_item>
  </examples>
