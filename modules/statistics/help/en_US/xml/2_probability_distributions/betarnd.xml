  <language>en_US</language>
  <keyword>betarnd</keyword>
  <short_description>Beta random numbers</short_description>
  <syntax>
    <syntax_item>r = betarnd(a, b)</syntax_item>
    <syntax_item>r = betarnd(a, b, sz)</syntax_item>
    <syntax_item>r = betarnd(a, b, sz1, ..., szN)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>a</param_name><param_description>positive scalar or array: first shape parameter.</param_description></param_input_item>
    <param_input_item><param_name>b</param_name><param_description>positive scalar or array: second shape parameter.</param_description></param_input_item>
    <param_input_item><param_name>sz</param_name><param_description>scalar, vector, or comma-separated dimensions: output size.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>r</param_name><param_description>array: random values.</param_description></param_output_item></param_output>
  <description><p><b>betarnd</b> generates beta distributed random values. Scalar parameters are expanded to match array inputs or the requested output size.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[rng(0);
r = betarnd(2, 5, 2, 3);]]></example_item_data></example_item></examples>
