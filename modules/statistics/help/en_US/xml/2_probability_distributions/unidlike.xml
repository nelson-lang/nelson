  <language>en_US</language>
  <keyword>unidlike</keyword>
  <short_description>Discrete uniform negative log-likelihood</short_description>
  <syntax><syntax_item>nlogL = unidlike(n, x)</syntax_item><syntax_item>[nlogL, avar] = unidlike(n, x)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>n</param_name><param_description>positive integer scalar: maximum value.</param_description></param_input_item>
    <param_input_item><param_name>x</param_name><param_description>positive integer finite real nonempty array: sample data.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>nlogL</param_name><param_description>scalar: negative log-likelihood.</param_description></param_output_item>
    <param_output_item><param_name>avar</param_name><param_description>scalar: asymptotic variance estimate.</param_description></param_output_item>
  </param_output>
  <description><p><b>unidlike</b> returns the negative log-likelihood for discrete uniform distribution data.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[x = [1 2 4 5 5];
[nlogL, avar] = unidlike(5, x);]]></example_item_data></example_item></examples>
