  <language>en_US</language>
  <keyword>ttest2</keyword>
  <short_description>Two-sample t-test</short_description>
  <syntax>
    <syntax_item>h = ttest2(x, y)</syntax_item>
    <syntax_item>h = ttest2(x, y, &apos;Alpha&apos;, alpha)</syntax_item>
    <syntax_item>h = ttest2(x, y, &apos;Tail&apos;, tail)</syntax_item>
    <syntax_item>h = ttest2(x, y, &apos;Vartype&apos;, vartype)</syntax_item>
    <syntax_item>h = ttest2(x, y, &apos;Dim&apos;, dim)</syntax_item>
    <syntax_item>[h, p, ci, stats] = ttest2(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>real numeric array: first sample.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>y</param_name>
      <param_description>real numeric array: second sample.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>scalar in (0,1), 0.05 by default: significance level.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>&apos;both&apos;, &apos;right&apos;, or &apos;left&apos;.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>vartype</param_name>
      <param_description>&apos;equal&apos; by default or &apos;unequal&apos; for Welch&apos;s test.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>positive integer: dimension to operate along.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>logical array: test decision.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>array: p-values.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ci</param_name>
      <param_description>2-row array: confidence intervals for the mean difference.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>stats</param_name>
      <param_description>structure with tstat, df, and sd fields.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ttest2</b> performs a two-sample t-test along the first non-singleton dimension unless <b>Dim</b> is specified.</p>
    <p>NaN values are omitted independently from each tested sample.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [10 11 13 15 18];
y = [7 8 8 9];
[h, p, ci, stats] = ttest2(x, y, 'Vartype', 'unequal', 'Tail', 'right');]]></example_item_data>
    </example_item>
  </examples>
