  <language>en_US</language>
  <keyword>ztest</keyword>
  <short_description>Z-test for a mean with known standard deviation</short_description>
  <syntax>
    <syntax_item>h = ztest(x, m, sigma)</syntax_item>
    <syntax_item>h = ztest(x, m, sigma, &apos;Alpha&apos;, alpha)</syntax_item>
    <syntax_item>h = ztest(x, m, sigma, &apos;Tail&apos;, tail)</syntax_item>
    <syntax_item>h = ztest(x, m, sigma, &apos;Dim&apos;, dim)</syntax_item>
    <syntax_item>[h, p, ci, zval] = ztest(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>real numeric array: sample data.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>m</param_name>
      <param_description>real scalar: hypothesized mean.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>sigma</param_name>
      <param_description>positive real scalar: known standard deviation.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>scalar in (0,1), 0.05 by default: significance level.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>&apos;both&apos;, &apos;right&apos;, or &apos;left&apos;.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>positive integer: dimension to operate along.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>logical array: test decision.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>array: p-values.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ci</param_name>
      <param_description>2-row array: confidence intervals for the mean.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>zval</param_name>
      <param_description>array: z statistics.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ztest</b> performs a z-test along the first non-singleton dimension unless <b>Dim</b> is specified.</p>
    <p>NaN values are omitted from each tested slice.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [72 75 77 70 74 76];
[h, p, ci, zval] = ztest(x, 75, 10);
[h2, p2] = ztest(x, 72, 10, 'Tail', 'right');]]></example_item_data>
    </example_item>
  </examples>
