  <language>en_US</language>
  <keyword>vartest</keyword>
  <short_description>Chi-square test for a variance</short_description>
  <syntax>
    <syntax_item>h = vartest(x, v)</syntax_item>
    <syntax_item>h = vartest(x, v, &apos;Alpha&apos;, alpha)</syntax_item>
    <syntax_item>h = vartest(x, v, &apos;Tail&apos;, tail)</syntax_item>
    <syntax_item>h = vartest(x, v, &apos;Dim&apos;, dim)</syntax_item>
    <syntax_item>[h, p, ci, stats] = vartest(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>real numeric array: sample data.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>v</param_name>
      <param_description>nonnegative real scalar: hypothesized variance.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>scalar in (0,1), 0.05 by default: significance level.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>&apos;both&apos;, &apos;right&apos;, or &apos;left&apos;.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>positive integer: dimension to operate along.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>logical array: test decision.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>array: p-values.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ci</param_name>
      <param_description>2-row array: confidence intervals for the variance.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>stats</param_name>
      <param_description>structure with chisqstat and df fields.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>vartest</b> performs a chi-square variance test along the first non-singleton dimension unless <b>Dim</b> is specified.</p>
    <p>NaN values are omitted from each tested slice.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [4.5 4.8 5.1 5.4 5.7 6.0];
[h, p, ci, stats] = vartest(x, 0.4);
[h2, p2] = vartest(x, 0.2, 'Tail', 'right');]]></example_item_data>
    </example_item>
  </examples>
