  <language>en_US</language>
  <keyword>ttest</keyword>
  <short_description>One-sample and paired t-test</short_description>
  <syntax>
    <syntax_item>h = ttest(x)</syntax_item>
    <syntax_item>h = ttest(x, m)</syntax_item>
    <syntax_item>h = ttest(x, y)</syntax_item>
    <syntax_item>[h, p, ci, stats] = ttest(..., &apos;Alpha&apos;, alpha, &apos;Tail&apos;, tail, &apos;Dim&apos;, dim)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>real array: sample data.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>m</param_name>
      <param_description>real scalar, 0 by default: hypothesized mean.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>y</param_name>
      <param_description>real array with the same size as x: paired sample.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>scalar in (0,1), 0.05 by default: significance level.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>&apos;both&apos;, &apos;right&apos;, or &apos;left&apos;.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>positive integer: dimension to operate along.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>logical array: test decision.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>array: p-values.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ci</param_name>
      <param_description>2-row array: confidence intervals for the mean difference.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>stats</param_name>
      <param_description>structure with tstat, df, and sd fields.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ttest</b> performs a t-test along the first non-singleton dimension unless <b>Dim</b> is specified.</p>
    <p>NaN values are omitted from each tested slice.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [2 4 5 6 9];
[h, p, ci, stats] = ttest(x, 4);
[h2, p2] = ttest([4 6 7], [3 5 7], 'Tail', 'right');]]></example_item_data>
    </example_item>
  </examples>
