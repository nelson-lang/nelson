  <language>en_US</language>
  <keyword>kstest2</keyword>
  <short_description>Two-sample Kolmogorov-Smirnov test</short_description>
  <syntax>
    <syntax_item>h = kstest2(x1, x2)</syntax_item>
    <syntax_item>h = kstest2(x1, x2, &apos;Alpha&apos;, alpha)</syntax_item>
    <syntax_item>h = kstest2(x1, x2, &apos;Tail&apos;, tail)</syntax_item>
    <syntax_item>[h, p, ks2stat] = kstest2(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x1</param_name>
      <param_description>real vector: first sample.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>x2</param_name>
      <param_description>real vector: second sample.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>scalar in (0,1), 0.05 by default: significance level.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>&apos;unequal&apos;, &apos;larger&apos;, or &apos;smaller&apos;.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>logical scalar: test decision.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>asymptotic p-value.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ks2stat</param_name>
      <param_description>two-sample test statistic.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>kstest2</b> compares the empirical distributions of two sample vectors.</p>
    <p>NaN sample values are omitted independently before sorting and computing the empirical distributions.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x1 = [1 2 3 4 5];
x2 = [2 3 4 6 8 10];
[h, p, ks2stat] = kstest2(x1, x2);
[h2, p2] = kstest2(x1, x2, 'Tail', 'larger');]]></example_item_data>
    </example_item>
  </examples>
