  <language>en_US</language>
  <keyword>kstest</keyword>
  <short_description>One-sample Kolmogorov-Smirnov test</short_description>
  <syntax>
    <syntax_item>h = kstest(x)</syntax_item>
    <syntax_item>h = kstest(x, &apos;CDF&apos;, cdf)</syntax_item>
    <syntax_item>h = kstest(x, &apos;CDF&apos;, cdfFunction)</syntax_item>
    <syntax_item>[h, p, ksstat, cv] = kstest(..., &apos;Alpha&apos;, alpha, &apos;Tail&apos;, tail)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>real vector: sample data.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>cdf</param_name>
      <param_description>two-column matrix defining x values and cumulative probabilities, function handle evaluated at the sorted sample values, or object with a cdf method.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>cdfFunction</param_name>
      <param_description>function handle returning cumulative probabilities for each input sample value.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>scalar in (0,1), 0.05 by default: significance level.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>&apos;unequal&apos;, &apos;larger&apos;, or &apos;smaller&apos;.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>logical scalar: test decision.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>p-value.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ksstat</param_name>
      <param_description>test statistic.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>cv</param_name>
      <param_description>critical value.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>kstest</b> compares the empirical distribution of <b>x</b> with the standard normal distribution or a user-supplied cumulative distribution.</p>
    <p>NaN sample values are omitted before sorting and computing the empirical distribution.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[x = [-1.2 -0.4 0.1 0.3 0.8];
[h, p, ksstat, cv] = kstest(x);
cdf = [-2 0; -1 0.2; 0 0.5; 1 0.8; 2 1];
h2 = kstest(x, 'CDF', cdf);
h3 = kstest([0 1 2], 'CDF', @(z) 0.2 + 0.3 .* z);]]></example_item_data>
    </example_item>
  </examples>
