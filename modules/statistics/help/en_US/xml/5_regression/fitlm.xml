  <language>en_US</language>
  <keyword>fitlm</keyword>
  <short_description>Fit a linear regression model.</short_description>
  <syntax>
    <syntax_item>mdl = fitlm(X, y)</syntax_item>
    <syntax_item>mdl = fitlm(X, y, modelspec)</syntax_item>
    <syntax_item>mdl = fitlm(X, y, ..., Name, Value)</syntax_item>
    <syntax_item>yfit = predict(mdl, Xnew)</syntax_item>
  </syntax>
  <description>
    <p><b>fitlm</b> creates a <b>LinearModel</b> object from numeric predictors <b>X</b> and response <b>y</b>.</p>
    <p>Supported model specifications include <b>constant</b>, <b>linear</b>, <b>interactions</b>, <b>quadratic</b>, <b>purequadratic</b>, and numeric term matrices. Name-value arguments include <b>Intercept</b>, <b>PredictorNames</b>, and <b>ResponseName</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [1 2; 2 1; 3 4; 4 3; 5 6; 6 5];
y = 1 + 2 * X(:,1) - 3 * X(:,2);
mdl = fitlm(X, y);
yfit = predict(mdl, [7 8; 8 7])]]></example_item_data>
    </example_item>
  </examples>
