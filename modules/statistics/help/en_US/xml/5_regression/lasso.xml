  <language>en_US</language>
  <keyword>lasso</keyword>
  <short_description>Lasso and elastic net regularization for linear models.</short_description>
  <syntax>
    <syntax_item>B = lasso(X, y)</syntax_item>
    <syntax_item>B = lasso(X, y, Name, Value)</syntax_item>
    <syntax_item>[B, FitInfo] = lasso(...)</syntax_item>
  </syntax>
  <description>
    <p><b>lasso</b> fits L1 and elastic-net regularized linear models using coordinate descent.</p>
    <p>Supported name-value options are <b>Alpha</b>, <b>Lambda</b>, <b>LambdaRatio</b>, <b>NumLambda</b>, <b>Standardize</b>, <b>Intercept</b>, <b>MaxIter</b>, <b>RelTol</b>, and <b>Weights</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = randn(100, 5);
y = X * [0; 2; 0; -3; 0] + 0.1 * randn(100, 1);
[B, FitInfo] = lasso(X, y, 'NumLambda', 10)]]></example_item_data>
    </example_item>
  </examples>
