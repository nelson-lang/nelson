  <language>en_US</language>
  <keyword>partialcorr</keyword>
  <short_description>Linear or rank partial correlation coefficients.</short_description>
  <syntax>
    <syntax_item>rho = partialcorr(X)</syntax_item>
    <syntax_item>rho = partialcorr(X, Z)</syntax_item>
    <syntax_item>rho = partialcorr(X, Y, Z)</syntax_item>
    <syntax_item>[rho, pval] = partialcorr(...)</syntax_item>
    <syntax_item>[rho, pval] = partialcorr(..., Name, Value)</syntax_item>
  </syntax>
  <description>
    <p><b>partialcorr</b> computes partial correlations between columns while controlling for other variables.</p>
    <p>Supported options are <b>Type</b> with <b>pearson</b> or <b>spearman</b>, <b>Rows</b> with <b>all</b>, <b>complete</b>, or <b>pairwise</b>, and <b>Tail</b> with <b>both</b>, <b>right</b>, or <b>left</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [1 2 3; 2 4 1; 3 5 2; 4 8 4; 5 10 5];
Z = [1 0; 1 1; 2 1; 2 0; 3 1];
rho = partialcorr(X, Z)]]></example_item_data>
    </example_item>
  </examples>
