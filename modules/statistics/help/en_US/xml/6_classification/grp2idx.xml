  <language>en_US</language>
  <keyword>grp2idx</keyword>
  <short_description>Create index vector from grouping variable.</short_description>
  <syntax>
    <syntax_item>[g, gN] = grp2idx(s)</syntax_item>
    <syntax_item>[g, gN, gL] = grp2idx(s)</syntax_item>
  </syntax>
  <description>
    <p><b>grp2idx</b> converts a grouping variable to numeric group indices.</p>
    <p><b>gN</b> is a cell array of group names. <b>gL</b> contains the group levels in a type matching the input when possible. Missing group values produce <b>NaN</b> indices.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[s = {'red', 'blue', 'red', ''};
[g, gN, gL] = grp2idx(s)]]></example_item_data>
    </example_item>
  </examples>
