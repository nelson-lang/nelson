  <language>en_US</language>
  <keyword>dummyvar</keyword>
  <short_description>Create dummy variables from grouping variables.</short_description>
  <syntax>
    <syntax_item>D = dummyvar(group)</syntax_item>
  </syntax>
  <description>
    <p><b>dummyvar</b> creates a numeric matrix of indicator columns for the grouping variables in <b>group</b>.</p>
    <p>Each numeric matrix column, categorical vector, text vector, or cell element in <b>group</b> contributes one block of dummy variables. Missing group values produce <b>NaN</b> rows in their block.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[Colors = categorical({'Red'; 'Blue'; 'Green'; 'Red'; 'Green'; 'Blue'});
D = dummyvar(Colors)]]></example_item_data>
    </example_item>
  </examples>
