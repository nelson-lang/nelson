  <language>en_US</language>
  <keyword>ClassificationDiscriminant</keyword>
  <short_description>Discriminant analysis classification model.</short_description>
  <syntax>
    <syntax_item>mdl = fitcdiscr(X, Y)</syntax_item>
    <syntax_item>label = predict(mdl, Xnew)</syntax_item>
    <syntax_item>[label, score, cost] = predict(mdl, Xnew)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>numeric matrix: rows are observations and columns are predictors.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>vector: class labels with one label for each row of X.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Name, Value</param_name>
      <param_description>optional name-value arguments accepted by the corresponding fitting function.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>mdl</param_name>
      <param_description>classification model object returned by the fitting function.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>label</param_name>
      <param_description>predicted class labels for new observations.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>score</param_name>
      <param_description>class scores or posterior-like values when the model provides them.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>ClassificationDiscriminant stores a discriminant analysis classifier trained from predictor data and class labels.</p>
    <p>Create this object with fitcdiscr. Use predict to classify new observations when the model supports prediction.</p>
  </description>
  <used_function>
    <used_function_item>fitcdiscr</used_function_item>
    <used_function_item>predict</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Train a discriminant classifier and classify two observations.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[X = [0 0; 0 1; 1 0; 5 5; 5 6; 6 5];
Y = [1; 1; 1; 2; 2; 2];
mdl = fitcdiscr(X, Y);
label = predict(mdl, [0.2 0.1; 5.2 5.1])]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${statistics}predict">predict</link></see_also_item>
    <see_also_item><link linkend="${statistics}fitcdiscr">fitcdiscr</link></see_also_item>
  </see_also>
