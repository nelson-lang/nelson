  <language>en_US</language>
  <keyword>evalclusters</keyword>
  <short_description>Evaluate clustering solutions.</short_description>
  <syntax>
    <syntax_item>eva = evalclusters(X, clust, criterion)</syntax_item>
    <syntax_item>eva = evalclusters(X, clust, criterion, Name, Value)</syntax_item>
  </syntax>
  <description>
    <p><b>evalclusters</b> evaluates clustering solutions for rows of <b>X</b>.</p>
    <p>Supported criteria are silhouette, CalinskiHarabasz, and DaviesBouldin. The clustering input can be a matrix of labels, kmeans, linkage, or a function handle. The result is a structure with evaluation properties.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [0; 1; 10; 11];
C = [1 1; 1 1; 1 2; 1 2];
eva = evalclusters(X, C, 'CalinskiHarabasz')]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [0; 1; 10; 11];
eva = evalclusters(X, 'kmeans', 'silhouette', 'KList', 1:3)]]></example_item_data>
    </example_item>
  </examples>
