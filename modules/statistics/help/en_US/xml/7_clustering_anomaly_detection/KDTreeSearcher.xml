  <language>en_US</language>
  <keyword>KDTreeSearcher</keyword>
  <short_description>Nearest neighbor searcher object.</short_description>
  <syntax>
    <syntax_item>Mdl = KDTreeSearcher(X)</syntax_item>
    <syntax_item>Mdl = KDTreeSearcher(X, Name, Value)</syntax_item>
    <syntax_item>[idx, D] = knnsearch(Mdl, Y, Name, Value)</syntax_item>
    <syntax_item>[idx, D] = rangesearch(Mdl, Y, radius, Name, Value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>the data to search, as a real numeric matrix with one point per row.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Name, Value</param_name>
      <param_description>options: <b>Distance</b> (default <b>'euclidean'</b>), <b>P</b> (Minkowski exponent) and <b>BucketSize</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Mdl</param_name>
      <param_description>a KDTreeSearcher object holding the data and the search options.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>KDTreeSearcher</b> stores a set of points and the distance metric used
      to query them, so that nearest neighbor searches can be run against the
      same data with <b>knnsearch</b> and <b>rangesearch</b>. The object exposes
      the properties <b>X</b>, <b>Distance</b>, <b>DistParameter</b> and
      <b>BucketSize</b>.</p>
    <p>The searches delegate to the <b>knnsearch</b> and <b>rangesearch</b>
      functions, forwarding the distance metric stored on the object.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [0 0; 1 0; 0 2; 4 4];
Mdl = KDTreeSearcher(X);
[idx, D] = knnsearch(Mdl, [0 1; 3 4], 'K', 2)]]></example_item_data>
    </example_item>
  </examples>
