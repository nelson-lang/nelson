  <language>en_US</language>
  <keyword>trimmean</keyword>
  <short_description>Mean after trimming extreme values.</short_description>
  <syntax>
    <syntax_item>m = trimmean(X, percent)</syntax_item>
    <syntax_item>m = trimmean(X, percent, flag)</syntax_item>
    <syntax_item>m = trimmean(..., dim)</syntax_item>
    <syntax_item>m = trimmean(..., vecdim)</syntax_item>
    <syntax_item>m = trimmean(..., 'all')</syntax_item>
  </syntax>
  <description>
    <p><b>trimmean</b> computes the mean after removing a percentage of the smallest and largest values. <b>NaN</b> values are omitted.</p>
    <p><b>flag</b> controls noninteger trimming counts and can be <b>round</b>, <b>floor</b>, or <b>weighted</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = reshape(1:40, [5 4 2]);
X([3 37]) = -100;
m = trimmean(X, 10, [1 2])]]></example_item_data>
    </example_item>
  </examples>
