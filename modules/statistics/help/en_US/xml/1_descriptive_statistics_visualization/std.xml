  <language>en_US</language>
  <keyword>std</keyword>
  <short_description>Standard deviation</short_description>
  <syntax>
    <syntax_item>S = std(M)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M</param_name>
      <param_description>a vector, matrix or multidimensional array: single, double, int8, int16, int32, int64, uint8, uint16, uint32 or uint64.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>S</param_name>
      <param_description>Standard deviation of M.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>S = std(M)</b> returns the standard deviation of the elements of M along the first array dimension whose size does not equal 1.</p>
    <p>For integer input data (int8, int16, int32, int64, uint8, uint16, uint32, uint64), the standard deviation is computed in double precision and <b>S</b> is double. The mean returned as second output is double too.</p>
  </description>
  <used_function>
    <link linkend="${statistics}var">var</link>
    <link linkend="${statistics}mean">mean</link>
    <link linkend="${statistics}cov">cov</link>
  </used_function>
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[M = [4 -7 3; 1 4 -2; 10 7 9];
S = std(M)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Integer input data</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[[S, M] = std(uint8([10 20 255]))]]></example_item_data>
    </example_item>
  </examples>
