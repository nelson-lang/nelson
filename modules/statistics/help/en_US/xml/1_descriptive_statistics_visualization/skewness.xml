  <language>en_US</language>
  <keyword>skewness</keyword>
  <short_description>Skewness of a data set.</short_description>
  <syntax>
    <syntax_item>y = skewness(X)</syntax_item>
    <syntax_item>y = skewness(X, flag)</syntax_item>
    <syntax_item>y = skewness(X, flag, dim)</syntax_item>
    <syntax_item>y = skewness(X, flag, vecdim)</syntax_item>
    <syntax_item>y = skewness(X, flag, 'all')</syntax_item>
  </syntax>
  <description>
    <p><b>skewness</b> computes the sample skewness of numeric data. Missing numeric values are ignored.</p>
    <p><b>flag</b> is 1 by default. Set <b>flag</b> to 0 to apply the bias correction for sample skewness.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [1 2 5; 2 4 8; 3 8 13];
y = skewness(X)]]></example_item_data>
    </example_item>
  </examples>
