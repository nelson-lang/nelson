  <language>en_US</language>
  <keyword>range</keyword>
  <short_description>Range of values.</short_description>
  <syntax>
    <syntax_item>Y = range(X)</syntax_item>
    <syntax_item>Y = range(X, dim)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>numeric or logical array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>dimension along which to operate.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>difference between the maximum and minimum values.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>range</b> returns the difference between the maximum and minimum values, max(X) - min(X). For a matrix, range operates on each column; range(X, dim) operates along dimension dim. NaN values are ignored.</p>
  </description>
  <used_function />
