  <language>en_US</language>
  <keyword>median</keyword>
  <short_description>Median value of array elements.</short_description>
  <syntax>
    <syntax_item>R = median(M)</syntax_item>
    <syntax_item>R = median(M, d)</syntax_item>
    <syntax_item>R = median(M, 'all')</syntax_item>
    <syntax_item>R = median(..., 'omitnan')</syntax_item>
  </syntax>
  <description>
    <p>
      <b>median</b> returns the middle value of sorted data along the selected dimension.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[R = median([4 1 2 3])]]></example_item_data>
    </example_item>
  </examples>
