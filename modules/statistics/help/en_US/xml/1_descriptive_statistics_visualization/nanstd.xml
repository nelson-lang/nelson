  <language>en_US</language>
  <keyword>nanstd</keyword>
  <short_description>Standard deviation, ignoring NaN values.</short_description>
  <syntax>
    <syntax_item>s = nanstd(X)</syntax_item>
    <syntax_item>s = nanstd(X, flag)</syntax_item>
    <syntax_item>s = nanstd(X, flag, dim)</syntax_item>
    <syntax_item>s = nanstd(X, flag, vecdim)</syntax_item>
    <syntax_item>s = nanstd(X, flag, 'all')</syntax_item>
  </syntax>
  <description>
    <p><b>nanstd</b> computes the standard deviation after removing <b>NaN</b> values from each operated slice.</p>
    <p><b>flag</b> is <b>0</b> for sample normalization and <b>1</b> for population normalization.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = magic(3);
X([1 6:9]) = NaN;
s = nanstd(X, 0, 2)]]></example_item_data>
    </example_item>
  </examples>
