  <language>en_US</language>
  <keyword>corr</keyword>
  <short_description>Linear or rank correlation.</short_description>
  <syntax>
    <syntax_item>rho = corr(X)</syntax_item>
    <syntax_item>rho = corr(X, Y)</syntax_item>
    <syntax_item>[rho, pval] = corr(...)</syntax_item>
    <syntax_item>[rho, pval] = corr(..., Name, Value)</syntax_item>
  </syntax>
  <description>
    <p><b>corr</b> computes pairwise correlations between columns of <b>X</b>, or between columns of <b>X</b> and <b>Y</b>.</p>
    <p>Supported options are <b>Type</b> with <b>pearson</b>, <b>spearman</b>, or <b>kendall</b>; <b>Rows</b> with <b>all</b>, <b>complete</b>, or <b>pairwise</b>; <b>Tail</b> with <b>both</b>, <b>right</b>, or <b>left</b>; and <b>Weights</b> for observation weights.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [1 2 3; 2 4 1; 3 NaN 2; 4 8 4; 5 10 5];
rho = corr(X, 'Rows', 'pairwise')]]></example_item_data>
    </example_item>
  </examples>
