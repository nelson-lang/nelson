  <language>en_US</language>
  <keyword>harmmean</keyword>
  <short_description>Harmonic mean of a data set.</short_description>
  <syntax>
    <syntax_item>m = harmmean(X)</syntax_item>
    <syntax_item>m = harmmean(X, dim)</syntax_item>
    <syntax_item>m = harmmean(X, vecdim)</syntax_item>
    <syntax_item>m = harmmean(X, 'all')</syntax_item>
    <syntax_item>m = harmmean(..., nanflag)</syntax_item>
  </syntax>
  <description>
    <p><b>harmmean</b> computes the harmonic mean of numeric data.</p>
    <p>By default, <b>NaN</b> values are included. Use <b>omitnan</b> to ignore them.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = reshape(1:30, [3 5 2]);
m = harmmean(X, [1 2])]]></example_item_data>
    </example_item>
  </examples>
