  <language>en_US</language>
  <keyword>probplot</keyword>
  <short_description>Probability plot.</short_description>
  <syntax>
    <syntax_item>probplot(y)</syntax_item>
    <syntax_item>probplot(y, cens)</syntax_item>
    <syntax_item>probplot(y, cens, freq)</syntax_item>
    <syntax_item>probplot(dist, ...)</syntax_item>
    <syntax_item>probplot(..., &apos;noref&apos;)</syntax_item>
    <syntax_item>h = probplot(...)</syntax_item>
  </syntax>
  <description>
    <p><b>probplot</b> creates a probability plot for sample data.</p>
    <p>The default distribution is normal. Supported distribution names include normal, exponential, extreme value, half normal, lognormal, logistic, loglogistic, rayleigh, and weibull. The returned value contains line handles for data points and, unless noref is specified, reference lines.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[x = randn(100, 1);
probplot(x)]]></example_item_data>
    </example_item>
  </examples>
