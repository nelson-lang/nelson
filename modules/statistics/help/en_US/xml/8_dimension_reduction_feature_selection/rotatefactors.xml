  <language>en_US</language>
  <keyword>rotatefactors</keyword>
  <short_description>Rotate factor loadings.</short_description>
  <syntax>
    <syntax_item>B = rotatefactors(X)</syntax_item>
    <syntax_item>B = rotatefactors(X, Name, Value)</syntax_item>
    <syntax_item>[B, T] = rotatefactors(...)</syntax_item>
  </syntax>
  <description>
    <p><b>rotatefactors</b> rotates factor loading columns. Supported methods include varimax, quartimax, equamax, parsimax, orthomax, promax, procrustes, and pattern.</p>
    <p>Name-value arguments include Method, Normalize, RelTol, MaxIt, Coeff, Power, Target, and Type.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [0.8 0.2; 0.7 -0.1; 0.1 0.9; 0.2 0.8];
[B, T] = rotatefactors(X)]]></example_item_data>
    </example_item>
  </examples>
