  <language>en_US</language>
  <keyword>pca</keyword>
  <short_description>Principal component analysis of raw data.</short_description>
  <syntax>
    <syntax_item>coeff = pca(X)</syntax_item>
    <syntax_item>coeff = pca(X, Name, Value)</syntax_item>
    <syntax_item>[coeff, score, latent] = pca(...)</syntax_item>
    <syntax_item>[coeff, score, latent, tsquared, explained, mu] = pca(...)</syntax_item>
  </syntax>
  <description>
    <p><b>pca</b> computes principal component coefficients for a numeric data matrix whose rows are observations and columns are variables.</p>
    <p>Name-value arguments include Algorithm, Centered, Economy, NumComponents, Rows, Weights, and VariableWeights. The main computation uses native singular value or eigenvalue decomposition.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [1 2; 3 4; 5 8; 7 11];
[coeff, score, latent] = pca(X)]]></example_item_data>
    </example_item>
  </examples>
