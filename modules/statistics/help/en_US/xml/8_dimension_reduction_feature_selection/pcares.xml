  <language>en_US</language>
  <keyword>pcares</keyword>
  <short_description>Residuals from principal component analysis.</short_description>
  <syntax>
    <syntax_item>residuals = pcares(X, NumComponents)</syntax_item>
    <syntax_item>[residuals, reconstructed] = pcares(X, NumComponents)</syntax_item>
  </syntax>
  <description>
    <p><b>pcares</b> returns residuals obtained by retaining the requested number of principal components of the data matrix X.</p>
    <p>The reconstructed output is the low-dimensional approximation of X, and residuals is equal to X minus reconstructed.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[X = [1 2; 3 4; 5 8; 7 11];
[residuals, reconstructed] = pcares(X, 1)]]></example_item_data>
    </example_item>
  </examples>
