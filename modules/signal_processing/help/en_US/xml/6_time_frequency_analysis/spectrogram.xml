  <keyword>spectrogram</keyword>
  <short_description>Spectrogram using short-time Fourier transforms.</short_description>
  <syntax><syntax_item>[S, F, T] = spectrogram(X)</syntax_item><syntax_item>[S, F, T, P] = spectrogram(X, window, noverlap, NFFT, Fs)</syntax_item></syntax>
  <param_input><param_input_item><param_name>X</param_name><param_description>input signal.</param_description></param_input_item><param_input_item><param_name>window</param_name><param_description>window vector or length.</param_description></param_input_item><param_input_item><param_name>noverlap</param_name><param_description>number of overlapping samples.</param_description></param_input_item><param_input_item><param_name>NFFT</param_name><param_description>FFT length.</param_description></param_input_item><param_input_item><param_name>Fs</param_name><param_description>sample rate.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>S</param_name><param_description>complex short-time spectrum.</param_description></param_output_item><param_output_item><param_name>F</param_name><param_description>frequency vector.</param_description></param_output_item><param_output_item><param_name>T</param_name><param_description>time vector.</param_description></param_output_item><param_output_item><param_name>P</param_name><param_description>power spectral density estimate.</param_description></param_output_item></param_output>
  <description><p><b>spectrogram</b> splits the signal into overlapping windowed segments and computes an FFT for each segment.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
[s, f, t] = spectrogram(sin((0:255)' * 0.1), 64, 32, 128, 10);
]]></example_item_data></example_item></examples>
