<xmldoc><copyright>SAME AS NELSON SOFTWARE</copyright><language>en_US</language><keyword>meanfreq</keyword><short_description>Mean frequency of a signal spectrum.</short_description><syntax><syntax_item>Fmean = meanfreq(X)</syntax_item><syntax_item>Fmean = meanfreq(X, Fs)</syntax_item><syntax_item>Fmean = meanfreq(Pxx, F)</syntax_item><syntax_item>[Fmean, P] = meanfreq(...)</syntax_item></syntax><param_input><param_input_item><param_name>X</param_name><param_description>input time-domain signal.</param_description></param_input_item><param_input_item><param_name>Fs</param_name><param_description>sample rate.</param_description></param_input_item><param_input_item><param_name>Pxx, F</param_name><param_description>power spectral density estimate and matching frequency vector.</param_description></param_input_item></param_input><param_output><param_output_item><param_name>Fmean</param_name><param_description>power-weighted mean frequency.</param_description></param_output_item><param_output_item><param_name>P</param_name><param_description>power used for the measurement.</param_description></param_output_item></param_output><description><p><b>meanfreq</b> computes the power-weighted mean frequency. Time-domain inputs use a rectangular-window periodogram with the input length.</p></description><examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
