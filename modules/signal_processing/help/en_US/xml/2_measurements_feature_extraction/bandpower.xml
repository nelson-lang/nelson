<xmldoc><copyright>SAME AS NELSON SOFTWARE</copyright><language>en_US</language><keyword>bandpower</keyword><short_description>Estimate signal power in a frequency band.</short_description><syntax><syntax_item>P = bandpower(X)</syntax_item><syntax_item>P = bandpower(X, Fs, freqRange)</syntax_item><syntax_item>P = bandpower(Pxx, F, 'psd')</syntax_item><syntax_item>P = bandpower(Pxx, F, freqRange, 'psd')</syntax_item></syntax><param_input><param_input_item><param_name>X</param_name><param_description>input time-domain signal.</param_description></param_input_item><param_input_item><param_name>Fs</param_name><param_description>sample rate.</param_description></param_input_item><param_input_item><param_name>freqRange</param_name><param_description>two-element frequency range.</param_description></param_input_item><param_input_item><param_name>Pxx, F</param_name><param_description>power spectral density estimate and matching frequency vector.</param_description></param_input_item></param_input><param_output><param_output_item><param_name>P</param_name><param_description>estimated average power.</param_description></param_output_item></param_output><description><p><b>bandpower</b> computes average time-domain power, or integrates a PSD estimate with a rectangle approximation. For time-domain band measurements, a Hamming-window periodogram with the input length is used.</p></description><examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
