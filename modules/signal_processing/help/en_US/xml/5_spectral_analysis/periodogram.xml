  <language>en_US</language>
  <keyword>periodogram</keyword>
  <short_description>Power spectral density estimate using a periodogram.</short_description>
  <syntax>
    <syntax_item>[Pxx, F] = periodogram(X)</syntax_item>
    <syntax_item>[Pxx, F] = periodogram(X, WINDOW, NFFT, Fs)</syntax_item>
    <syntax_item>[Pxx, F] = periodogram(..., FREQRANGE)</syntax_item>
    <syntax_item>[Pxx, F] = periodogram(..., SPECTRUMTYPE)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>input signal.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>WINDOW</param_name>
      <param_description>window vector or length.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>NFFT</param_name>
      <param_description>FFT length.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Fs</param_name>
      <param_description>sample rate.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>FREQRANGE</param_name>
      <param_description>"onesided", "twosided", "centered", "half", or "whole". "half" is treated as "onesided" and "whole" as "twosided".</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>SPECTRUMTYPE</param_name>
      <param_description>"psd" or "power".</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Pxx</param_name>
      <param_description>power spectral density or power spectrum estimate.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>F</param_name>
      <param_description>frequency vector.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>periodogram</b> estimates signal power distribution over frequency.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[
[pxx, f] = periodogram(sin((0:127)' * 0.1), [], 128, 10);
]]></example_item_data>
    </example_item>
  </examples>
