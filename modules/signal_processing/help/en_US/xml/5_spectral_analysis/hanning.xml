  <keyword>hanning</keyword>
  <short_description>Hann window compatibility function.</short_description>
  <syntax><syntax_item>w = hanning(n)</syntax_item><syntax_item>w = hanning(n, option)</syntax_item></syntax>
  <param_input><param_input_item><param_name>n</param_name><param_description>Window length.</param_description></param_input_item><param_input_item><param_name>option</param_name><param_description>'symmetric' or 'periodic'.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>w</param_name><param_description>Column vector containing the window.</param_description></param_output_item></param_output>
  <description><p><b>hanning</b> returns the same window as <b>hann</b>.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[w = hanning(6, 'periodic')]]></example_item_data></example_item></examples>
