  <keyword>rectwin</keyword>
  <short_description>Rectangular window.</short_description>
  <syntax><syntax_item>W = rectwin(M)</syntax_item></syntax>
  <param_input><param_input_item><param_name>M</param_name><param_description>window length.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>W</param_name><param_description>column vector containing the window.</param_description></param_output_item></param_output>
  <description><p><b>rectwin</b> returns an M-point rectangular window.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
w = rectwin(4);
]]></example_item_data></example_item></examples>
