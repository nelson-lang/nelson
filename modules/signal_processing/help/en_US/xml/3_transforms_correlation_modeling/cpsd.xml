  <language>en_US</language>
  <keyword>cpsd</keyword>
  <short_description>Cross power spectral density estimate.</short_description>
  <syntax>
    <syntax_item>[Pxy, F] = cpsd(X, Y)</syntax_item>
    <syntax_item>[Pxy, F] = cpsd(X, Y, window, noverlap, nfft, fs)</syntax_item>
    <syntax_item>[Pxy, F] = cpsd(..., FREQRANGE)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>X, Y</param_name><param_description>input signals.</param_description></param_input_item>
    <param_input_item><param_name>window</param_name><param_description>analysis window.</param_description></param_input_item>
    <param_input_item><param_name>noverlap</param_name><param_description>number of overlapped samples.</param_description></param_input_item>
    <param_input_item><param_name>nfft</param_name><param_description>FFT length.</param_description></param_input_item>
    <param_input_item><param_name>fs</param_name><param_description>sample rate.</param_description></param_input_item>
    <param_input_item><param_name>FREQRANGE</param_name><param_description><code>'onesided'</code>, <code>'twosided'</code>, <code>'centered'</code>, <code>'half'</code>, or <code>'whole'</code>.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>Pxy</param_name><param_description>cross spectral density estimate.</param_description></param_output_item>
    <param_output_item><param_name>F</param_name><param_description>frequency vector.</param_description></param_output_item>
  </param_output>
  <description><p><b>cpsd</b> estimates cross spectral density between two signals by averaging overlapped segments.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
[pxy, f] = cpsd(sin((0:63)'), cos((0:63)'), hamming(16), 8, 32, 10, 'twosided');
]]></example_item_data></example_item></examples>
