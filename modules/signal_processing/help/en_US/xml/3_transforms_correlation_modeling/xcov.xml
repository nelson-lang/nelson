  <language>en_US</language>
  <keyword>xcov</keyword>
  <short_description>Cross-covariance of discrete-time signals.</short_description>
  <syntax>
    <syntax_item>C = xcov(X)</syntax_item>
    <syntax_item>C = xcov(X, Y)</syntax_item>
    <syntax_item>[C, Lags] = xcov(..., maxlag)</syntax_item>
    <syntax_item>[C, Lags] = xcov(..., scaleopt)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>X</param_name><param_description>input signal.</param_description></param_input_item>
    <param_input_item><param_name>Y</param_name><param_description>optional second input signal.</param_description></param_input_item>
    <param_input_item><param_name>maxlag</param_name><param_description>maximum lag to return.</param_description></param_input_item>
    <param_input_item><param_name>scaleopt</param_name><param_description>scaling option passed to xcorr after mean removal.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>C</param_name><param_description>covariance sequence.</param_description></param_output_item>
    <param_output_item><param_name>Lags</param_name><param_description>lag vector.</param_description></param_output_item>
  </param_output>
  <description><p><b>xcov</b> subtracts the mean from each signal and computes the corresponding correlation sequence.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
[c, lags] = xcov([1 2 3], 1, 'biased');
]]></example_item_data></example_item></examples>
