  <language>en_US</language>
  <keyword>xcorr</keyword>
  <short_description>Cross-correlation of discrete-time signals.</short_description>
  <syntax>
    <syntax_item>C = xcorr(X)</syntax_item>
    <syntax_item>C = xcorr(X, Y)</syntax_item>
    <syntax_item>[C, Lags] = xcorr(..., maxlag)</syntax_item>
    <syntax_item>[C, Lags] = xcorr(..., scaleopt)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>X</param_name><param_description>input signal.</param_description></param_input_item>
    <param_input_item><param_name>Y</param_name><param_description>optional second input signal.</param_description></param_input_item>
    <param_input_item><param_name>maxlag</param_name><param_description>maximum lag to return.</param_description></param_input_item>
    <param_input_item><param_name>scaleopt</param_name><param_description>scaling option: 'none', 'biased', 'unbiased', 'coeff', or 'normalized'.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>C</param_name><param_description>correlation sequence.</param_description></param_output_item>
    <param_output_item><param_name>Lags</param_name><param_description>lag vector.</param_description></param_output_item>
  </param_output>
  <description><p><b>xcorr</b> computes auto-correlation or cross-correlation for one-dimensional signals.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
[c, lags] = xcorr([1 2 3], 1, 'biased');
]]></example_item_data></example_item></examples>
