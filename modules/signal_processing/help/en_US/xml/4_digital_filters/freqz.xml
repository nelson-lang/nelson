  <language>en_US</language>
  <keyword>freqz</keyword>
  <short_description>Frequency response of a digital filter.</short_description>
  <syntax>
    <syntax_item>[H, W] = freqz(B, A)</syntax_item>
    <syntax_item>[H, W] = freqz(B, A, N)</syntax_item>
    <syntax_item>[H, W] = freqz(B, A, N, 'whole')</syntax_item>
    <syntax_item>[H, F] = freqz(B, A, N, Fs)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>B</param_name><param_description>numerator coefficients.</param_description></param_input_item>
    <param_input_item><param_name>A</param_name><param_description>denominator coefficients.</param_description></param_input_item>
    <param_input_item><param_name>N</param_name><param_description>number of frequency samples or vector of frequencies.</param_description></param_input_item>
    <param_input_item><param_name>Fs</param_name><param_description>sample rate.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>H</param_name><param_description>complex frequency response.</param_description></param_output_item>
    <param_output_item><param_name>W</param_name><param_description>frequencies in radians per sample.</param_description></param_output_item>
    <param_output_item><param_name>F</param_name><param_description>frequencies in cycles per unit time when Fs is supplied.</param_description></param_output_item>
  </param_output>
  <description><p><b>freqz</b> evaluates the transfer function defined by B and A on the unit circle.</p></description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
[h, w] = freqz([1 1], 1, 8);
]]></example_item_data></example_item>
  </examples>
  <see_also><see_also_item><link linkend="${signal_processing}phasez">phasez</link></see_also_item><see_also_item><link linkend="${signal_processing}grpdelay">grpdelay</link></see_also_item></see_also>
