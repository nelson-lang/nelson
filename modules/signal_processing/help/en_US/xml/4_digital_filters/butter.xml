  <language>en_US</language>
  <keyword>butter</keyword>
  <short_description>Butterworth digital filter design.</short_description>
  <syntax>
    <syntax_item>[B, A] = butter(N, Wn)</syntax_item>
    <syntax_item>[B, A] = butter(N, Wn, type)</syntax_item>
    <syntax_item>[Z, P, K] = butter(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>N</param_name><param_description>filter order.</param_description></param_input_item>
    <param_input_item><param_name>Wn</param_name><param_description>normalized cutoff frequency.</param_description></param_input_item>
    <param_input_item><param_name>type</param_name><param_description>optional filter type.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>B</param_name><param_description>numerator coefficients.</param_description></param_output_item>
    <param_output_item><param_name>A</param_name><param_description>denominator coefficients.</param_description></param_output_item>
    <param_output_item><param_name>Z, P, K</param_name><param_description>zero-pole-gain representation.</param_description></param_output_item>
  </param_output>
  <description><p><b>butter</b> designs a Butterworth IIR digital filter.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
[b, a] = butter(2, 0.4);
[h, w] = freqz(b, a, 64);
]]></example_item_data></example_item></examples>
