  <language>en_US</language>
  <keyword>fir1</keyword>
  <short_description>Window-based FIR filter design.</short_description>
  <syntax>
    <syntax_item>B = fir1(N, Wn)</syntax_item>
    <syntax_item>B = fir1(N, Wn, type)</syntax_item>
    <syntax_item>B = fir1(N, Wn, window)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>N</param_name><param_description>filter order.</param_description></param_input_item>
    <param_input_item><param_name>Wn</param_name><param_description>normalized cutoff frequency or frequency pair.</param_description></param_input_item>
    <param_input_item><param_name>type</param_name><param_description>filter type such as 'low', 'high', 'bandpass', or 'stop'.</param_description></param_input_item>
    <param_input_item><param_name>window</param_name><param_description>window vector of length N + 1.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>B</param_name><param_description>FIR numerator coefficients.</param_description></param_output_item></param_output>
  <description><p><b>fir1</b> designs a linear-phase FIR filter by windowing an ideal impulse response.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
b = fir1(16, 0.25);
]]></example_item_data></example_item></examples>
