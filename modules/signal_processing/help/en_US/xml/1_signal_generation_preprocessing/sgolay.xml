  <language>en_US</language>
  <keyword>sgolay</keyword>
  <short_description>Savitzky-Golay filter coefficients.</short_description>
  <syntax>
    <syntax_item>[B, G] = sgolay(K, F)</syntax_item>
    <syntax_item>[B, G] = sgolay(K, F, W)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>K</param_name>
      <param_description>polynomial order.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>F</param_name>
      <param_description>frame length.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>W</param_name>
      <param_description>positive weighting vector.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>smoothing coefficient matrix.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>G</param_name>
      <param_description>least-squares coefficient matrix.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>sgolay</b> computes local polynomial least-squares filter coefficients.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[
[b, g] = sgolay(2, 5);
]]></example_item_data>
    </example_item>
  </examples>
