  <language>en_US</language>
  <keyword>upsample</keyword>
  <short_description>Upsample a sequence by an integer factor.</short_description>
  <syntax>
    <syntax_item>Y = upsample(X, n)</syntax_item>
    <syntax_item>Y = upsample(X, n, phase)</syntax_item>
    <syntax_item>Y = upsample(X, n, phase, dim)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>X</param_name><param_description>input array.</param_description></param_input_item>
    <param_input_item><param_name>n</param_name><param_description>positive integer upsampling factor.</param_description></param_input_item>
    <param_input_item><param_name>phase</param_name><param_description>optional insertion phase from 0 to n - 1.</param_description></param_input_item>
    <param_input_item><param_name>dim</param_name><param_description>optional dimension to process.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>Y</param_name><param_description>upsampled array with inserted zeros.</param_description></param_output_item>
  </param_output>
  <description><p><b>upsample</b> inserts n - 1 zeros between samples along the selected dimension.</p></description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
Y = upsample([1 2 3], 2)
]]></example_item_data></example_item>
  </examples>
