  <language>en_US</language>
  <keyword>sgolayfilt</keyword>
  <short_description>Savitzky-Golay smoothing filter.</short_description>
  <syntax>
    <syntax_item>Y = sgolayfilt(X, K, F)</syntax_item>
    <syntax_item>Y = sgolayfilt(X, K, F, W)</syntax_item>
    <syntax_item>Y = sgolayfilt(X, K, F, W, DIM)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>input signal.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>K</param_name>
      <param_description>polynomial order.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>F</param_name>
      <param_description>frame length.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>W</param_name>
      <param_description>positive weighting vector. Use [] for default weights.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>DIM</param_name>
      <param_description>dimension to filter along.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>smoothed signal.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>sgolayfilt</b> smooths data using Savitzky-Golay FIR coefficients.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[
y = sgolayfilt([1 2 3 2 1], 2, 5);
]]></example_item_data>
    </example_item>
  </examples>
