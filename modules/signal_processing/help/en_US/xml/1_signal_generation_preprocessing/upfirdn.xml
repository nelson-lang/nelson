  <language>en_US</language>
  <keyword>upfirdn</keyword>
  <short_description>Upsample, FIR filter, and downsample.</short_description>
  <syntax><syntax_item>Y = upfirdn(X, H)</syntax_item><syntax_item>Y = upfirdn(X, H, P, Q)</syntax_item><syntax_item>Y = upfirdn(X, H, P, Q, dim)</syntax_item></syntax>
  <param_input><param_input_item><param_name>X</param_name><param_description>nonempty nonsparse input signal.</param_description></param_input_item><param_input_item><param_name>H</param_name><param_description>nonempty nonsparse FIR coefficients. A matrix applies one filter column per signal column.</param_description></param_input_item><param_input_item><param_name>P</param_name><param_description>upsampling factor.</param_description></param_input_item><param_input_item><param_name>Q</param_name><param_description>downsampling factor.</param_description></param_input_item><param_input_item><param_name>dim</param_name><param_description>dimension to process.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>Y</param_name><param_description>multirate filtered output.</param_description></param_output_item></param_output>
  <description><p><b>upfirdn</b> is the basic polyphase-style multirate operation used by resampling functions.</p><p>When <b>H</b> is a matrix, each column of <b>H</b> filters the corresponding signal column.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
Y = upfirdn([1 2 3], [1 1], 2, 2);
]]></example_item_data></example_item><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
Y = upfirdn([1; 2], [1 2; 3 4]);
]]></example_item_data></example_item></examples>
