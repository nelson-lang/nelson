<xmldoc><copyright>SAME AS NELSON SOFTWARE</copyright><language>en_US</language><keyword>resample</keyword><short_description>Change sample rate by a rational factor.</short_description><syntax><syntax_item>Y = resample(X, P, Q)</syntax_item><syntax_item>Y = resample(X, P, Q, N)</syntax_item><syntax_item>Y = resample(X, P, Q, N, Beta)</syntax_item><syntax_item>Y = resample(X, P, Q, B)</syntax_item><syntax_item>Y = resample(..., &apos;Dimension&apos;, Dim)</syntax_item></syntax><param_input><param_input_item><param_name>X</param_name><param_description>input signal or array.</param_description></param_input_item><param_input_item><param_name>P</param_name><param_description>upsampling factor.</param_description></param_input_item><param_input_item><param_name>Q</param_name><param_description>downsampling factor.</param_description></param_input_item><param_input_item><param_name>N</param_name><param_description>filter half-length factor. Default is 10.</param_description></param_input_item><param_input_item><param_name>Beta</param_name><param_description>Kaiser window shape parameter. Default is 5.</param_description></param_input_item><param_input_item><param_name>B</param_name><param_description>FIR antialiasing filter coefficients.</param_description></param_input_item><param_input_item><param_name>Dim</param_name><param_description>dimension to operate along.</param_description></param_input_item></param_input><param_output><param_output_item><param_name>Y</param_name><param_description>resampled signal.</param_description></param_output_item></param_output><description><p><b>resample</b> changes a signal sample rate by filtering between upsampling and downsampling stages.</p></description><examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
y = resample(1:10, 3, 2);
]]></example_item_data></example_item></examples><see_also><see_also_item><link linkend="${signal_processing}upfirdn">upfirdn</link></see_also_item><see_also_item><link linkend="${signal_processing}decimate">decimate</link></see_also_item></see_also><history><history_item><history_version>2.0.0</history_version><history_description>initial version</history_description></history_item></history><authors><author_item>Allan CORNET</author_item></authors></xmldoc>
