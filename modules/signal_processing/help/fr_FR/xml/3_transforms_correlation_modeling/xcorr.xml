  <language>fr_FR</language>
  <keyword>xcorr</keyword>
  <short_description>Corrélation croisée de signaux discrets.</short_description>
  <syntax><syntax_item>C = xcorr(X)</syntax_item><syntax_item>C = xcorr(X, Y)</syntax_item><syntax_item>[C, Lags] = xcorr(..., maxlag)</syntax_item><syntax_item>[C, Lags] = xcorr(..., scaleopt)</syntax_item></syntax>
  <param_input><param_input_item><param_name>X</param_name><param_description>signal d&apos;entrée.</param_description></param_input_item><param_input_item><param_name>Y</param_name><param_description>second signal optionnel.</param_description></param_input_item><param_input_item><param_name>maxlag</param_name><param_description>retard maximal à retourner.</param_description></param_input_item><param_input_item><param_name>scaleopt</param_name><param_description>option de mise à l&apos;échelle : 'none', 'biased', 'unbiased', 'coeff' ou 'normalized'.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>C</param_name><param_description>séquence de corrélation.</param_description></param_output_item><param_output_item><param_name>Lags</param_name><param_description>vecteur de retards.</param_description></param_output_item></param_output>
  <description><p><b>xcorr</b> calcule l&apos;auto-corrélation ou la corrélation croisée de signaux unidimensionnels.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
[c, lags] = xcorr([1 2 3], 1, 'biased');
]]></example_item_data></example_item></examples>
