  <language>fr_FR</language>
  <keyword>xcov</keyword>
  <short_description>Covariance croisée de signaux discrets.</short_description>
  <syntax><syntax_item>C = xcov(X)</syntax_item><syntax_item>C = xcov(X, Y)</syntax_item><syntax_item>[C, Lags] = xcov(..., maxlag)</syntax_item><syntax_item>[C, Lags] = xcov(..., scaleopt)</syntax_item></syntax>
  <param_input><param_input_item><param_name>X</param_name><param_description>signal d&apos;entrée.</param_description></param_input_item><param_input_item><param_name>Y</param_name><param_description>second signal optionnel.</param_description></param_input_item><param_input_item><param_name>maxlag</param_name><param_description>retard maximal à retourner.</param_description></param_input_item><param_input_item><param_name>scaleopt</param_name><param_description>option de mise à l&apos;échelle transmise à xcorr après retrait de la moyenne.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>C</param_name><param_description>séquence de covariance.</param_description></param_output_item><param_output_item><param_name>Lags</param_name><param_description>vecteur de retards.</param_description></param_output_item></param_output>
  <description><p><b>xcov</b> retire la moyenne de chaque signal puis calcule la séquence de corrélation correspondante.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
[c, lags] = xcov([1 2 3], 1, 'biased');
]]></example_item_data></example_item></examples>
