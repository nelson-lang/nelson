  <language>fr_FR</language>
  <keyword>tfe</keyword>
  <short_description>Wrapper de compatibilite pour estimation de fonction de transfert.</short_description>
  <syntax>
    <syntax_item>[Hv, f] = tfe(u, y)</syntax_item>
    <syntax_item>[Hv, f, Puu, Pyy, Puy, coh, Sv] = tfe(u, y, nfft, fs)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>u</param_name><param_description>vecteur du signal d&apos;entree.</param_description></param_input_item>
    <param_input_item><param_name>y</param_name><param_description>vecteur du signal de sortie.</param_description></param_input_item>
    <param_input_item><param_name>nfft</param_name><param_description>longueur de FFT.</param_description></param_input_item>
    <param_input_item><param_name>fs</param_name><param_description>frequence d&apos;echantillonnage.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>Hv</param_name><param_description>estimation de fonction de transfert.</param_description></param_output_item>
    <param_output_item><param_name>f</param_name><param_description>vecteur de frequences.</param_description></param_output_item>
    <param_output_item><param_name>Puu, Pyy, Puy</param_name><param_description>spectres de puissance d&apos;entree, de sortie et croise.</param_description></param_output_item>
    <param_output_item><param_name>coh</param_name><param_description>estimation de coherence quadratique.</param_description></param_output_item>
    <param_output_item><param_name>Sv</param_name><param_description>estimation approximative d&apos;ecart type pour <b>Hv</b>.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>tfe</b> estime une fonction de transfert depuis des donnees d&apos;entree et de sortie. Preferer <b>tfestimate</b> pour le nouveau code.</p>
  </description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
u = (1:16)';
y = filter([1 0.5], 1, u);
[Hv, f] = tfe(u, y, 4, 8)
]]></example_item_data></example_item>
  </examples>
