  <language>fr_FR</language>
  <keyword>peak2peak</keyword>
  <short_description>Ecart entre maximum et minimum.</short_description>
  <syntax>
    <syntax_item>Y = peak2peak(X)</syntax_item>
    <syntax_item>Y = peak2peak(X, "all")</syntax_item>
    <syntax_item>Y = peak2peak(X, DIM)</syntax_item>
    <syntax_item>Y = peak2peak(X, VECDIM)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>donnees d'entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>DIM</param_name>
      <param_description>dimension sur laquelle calculer l'ecart.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>VECDIM</param_name>
      <param_description>vecteur de dimensions sur lesquelles calculer l'ecart.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>valeur crete-a-crete.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>peak2peak</b> calcule max(X) - min(X).</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[
y = peak2peak([1 4 -2]);
]]></example_item_data>
    </example_item>
  </examples>
