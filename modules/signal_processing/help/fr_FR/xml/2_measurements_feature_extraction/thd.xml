  <language>fr_FR</language>
  <keyword>thd</keyword>
  <short_description>Estimation de distorsion harmonique totale.</short_description>
  <syntax>
    <syntax_item>D = thd(X)</syntax_item>
    <syntax_item>D = thd(X, Fs)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>signal d'entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Fs</param_name>
      <param_description>frequence d'echantillonnage.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>D</param_name>
      <param_description>distorsion estimee en decibels.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>thd</b> estime la distorsion harmonique totale a partir des amplitudes de FFT.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[
d = thd(sin((0:255)' * 0.1));
]]></example_item_data>
    </example_item>
  </examples>
