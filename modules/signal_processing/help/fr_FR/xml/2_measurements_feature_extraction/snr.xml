<xmldoc><copyright>SAME AS NELSON SOFTWARE</copyright><language>fr_FR</language><keyword>snr</keyword><short_description>Rapport signal sur bruit.</short_description><syntax><syntax_item>R = snr(X)</syntax_item><syntax_item>R = snr(X, Noise)</syntax_item><syntax_item>R = snr(X, Fs)</syntax_item><syntax_item>[R, NoisePower] = snr(...)</syntax_item></syntax><param_input><param_input_item><param_name>X</param_name><param_description>signal.</param_description></param_input_item><param_input_item><param_name>Noise</param_name><param_description>signal de bruit de memes dimensions que X.</param_description></param_input_item><param_input_item><param_name>Fs</param_name><param_description>frequence d'echantillonnage pour l'estimation spectrale du SNR.</param_description></param_input_item></param_input><param_output><param_output_item><param_name>R</param_name><param_description>rapport en decibels.</param_description></param_output_item><param_output_item><param_name>NoisePower</param_name><param_description>estimation lineaire de la puissance de bruit avec un bruit direct, ou puissance de bruit en decibels avec l'estimation spectrale.</param_description></param_output_item></param_output><description><p><b>snr</b> calcule un rapport signal sur bruit direct lorsqu'un vecteur de bruit est fourni. Avec une frequence d'echantillonnage scalaire, il estime le SNR sinusoidal depuis le spectre.</p></description><examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
[r, n] = snr([1 1 1], [0.1 0.1 0.1]);
]]></example_item_data></example_item></examples><see_also><see_also_item><link linkend="${signal_processing}thd">thd</link></see_also_item></see_also><history><history_item><history_version>2.0.0</history_version><history_description>version initiale</history_description></history_item></history><authors><author_item>Allan CORNET</author_item></authors></xmldoc>
