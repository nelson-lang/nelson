  <keyword>upsample</keyword>
  <short_description>Suréchantillonne une séquence par un facteur entier.</short_description>
  <syntax><syntax_item>Y = upsample(X, n)</syntax_item><syntax_item>Y = upsample(X, n, phase)</syntax_item><syntax_item>Y = upsample(X, n, phase, dim)</syntax_item></syntax>
  <param_input><param_input_item><param_name>X</param_name><param_description>tableau d&apos;entrée.</param_description></param_input_item><param_input_item><param_name>n</param_name><param_description>facteur de suréchantillonnage entier positif.</param_description></param_input_item><param_input_item><param_name>phase</param_name><param_description>phase optionnelle entre 0 et n - 1.</param_description></param_input_item><param_input_item><param_name>dim</param_name><param_description>dimension optionnelle à traiter.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>Y</param_name><param_description>tableau suréchantillonné avec insertion de zéros.</param_description></param_output_item></param_output>
  <description><p><b>upsample</b> insère n - 1 zéros entre les échantillons le long de la dimension choisie.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
Y = upsample([1 2 3], 2)
]]></example_item_data></example_item></examples>
