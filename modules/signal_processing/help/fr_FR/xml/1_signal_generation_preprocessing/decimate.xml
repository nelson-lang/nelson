  <language>fr_FR</language>
  <keyword>decimate</keyword>
  <short_description>Filtre passe-bas puis sous-echantillonne un vecteur.</short_description>
  <syntax>
    <syntax_item>Y = decimate(X, Q)</syntax_item>
    <syntax_item>Y = decimate(X, Q, N)</syntax_item>
    <syntax_item>Y = decimate(X, Q, N, 'iir')</syntax_item>
    <syntax_item>Y = decimate(X, Q, N, 'fir')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>vecteur d'entree non vide.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Q</param_name>
      <param_description>facteur entier de decimation strictement superieur a un.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>N</param_name>
      <param_description>ordre du filtre. L'ordre par defaut vaut 8 en mode IIR et 30 en mode FIR.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>vecteur decime.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>decimate</b> applique un filtre passe-bas anti-repliement puis conserve un echantillon sur Q. Le mode par defaut utilise un filtre IIR de Chebyshev type I avec filtrage aller-retour a phase nulle. Le mode <b>'fir'</b> utilise un filtre passe-bas FIR fenetre et compense son delai avant le sous-echantillonnage.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[
y = decimate(1:20, 2, 4, 'fir');
]]></example_item_data>
    </example_item>
  </examples>
