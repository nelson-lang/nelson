  <language>fr_FR</language>
  <keyword>sgolayfilt</keyword>
  <short_description>Filtre de lissage Savitzky-Golay.</short_description>
  <syntax>
    <syntax_item>Y = sgolayfilt(X, K, F)</syntax_item>
    <syntax_item>Y = sgolayfilt(X, K, F, W)</syntax_item>
    <syntax_item>Y = sgolayfilt(X, K, F, W, DIM)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>signal d'entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>K</param_name>
      <param_description>ordre polynomial.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>F</param_name>
      <param_description>longueur de trame.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>W</param_name>
      <param_description>vecteur de poids positifs. Utiliser [] pour les poids par defaut.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>DIM</param_name>
      <param_description>dimension sur laquelle appliquer le filtre.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>signal lisse.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>sgolayfilt</b> lisse les donnees avec des coefficients FIR Savitzky-Golay.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[
y = sgolayfilt([1 2 3 2 1], 2, 5);
]]></example_item_data>
    </example_item>
  </examples>
