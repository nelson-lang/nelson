  <keyword>upfirdn</keyword>
  <short_description>Surechantillonne, filtre en FIR, puis sous-échantillonne.</short_description>
  <syntax><syntax_item>Y = upfirdn(X, H)</syntax_item><syntax_item>Y = upfirdn(X, H, P, Q)</syntax_item><syntax_item>Y = upfirdn(X, H, P, Q, dim)</syntax_item></syntax>
  <param_input><param_input_item><param_name>X</param_name><param_description>signal d&apos;entrée non vide et non sparse.</param_description></param_input_item><param_input_item><param_name>H</param_name><param_description>coefficients FIR non vides et non sparse. Une matrice applique une colonne de filtre par colonne de signal.</param_description></param_input_item><param_input_item><param_name>P</param_name><param_description>facteur de suréchantillonnage.</param_description></param_input_item><param_input_item><param_name>Q</param_name><param_description>facteur de sous-échantillonnage.</param_description></param_input_item><param_input_item><param_name>dim</param_name><param_description>dimension à traiter.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>Y</param_name><param_description>sortie filtrée multirate.</param_description></param_output_item></param_output>
  <description><p><b>upfirdn</b> fournit l&apos;opération multirate de base utilisée par les fonctions de rééchantillonnage.</p><p>Lorsque <b>H</b> est une matrice, chaque colonne de <b>H</b> filtre la colonne de signal correspondante.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
Y = upfirdn([1 2 3], [1 1], 2, 2);
]]></example_item_data></example_item><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
Y = upfirdn([1; 2], [1 2; 3 4]);
]]></example_item_data></example_item></examples>
