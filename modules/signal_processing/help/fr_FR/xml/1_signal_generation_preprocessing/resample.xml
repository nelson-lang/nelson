]]></example_item_data></example_item></examples><see_also><see_also_item><link linkend="${signal_processing}upfirdn">upfirdn</link></see_also_item><see_also_item><link linkend="${signal_processing}decimate">decimate</link></see_also_item></see_also><history><history_item><history_version>2.0.0</history_version><history_description>version initiale</history_description></history_item></history><authors><author_item>Allan CORNET</author_item></authors></xmldoc>
