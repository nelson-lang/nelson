<xmldoc><copyright>SAME AS NELSON SOFTWARE</copyright><language>fr_FR</language><keyword>resample</keyword><short_description>Change la frequence d&apos;echantillonnage par un facteur rationnel.</short_description><syntax><syntax_item>Y = resample(X, P, Q)</syntax_item><syntax_item>Y = resample(X, P, Q, N)</syntax_item><syntax_item>Y = resample(X, P, Q, N, Beta)</syntax_item><syntax_item>Y = resample(X, P, Q, B)</syntax_item><syntax_item>Y = resample(..., &apos;Dimension&apos;, Dim)</syntax_item></syntax><param_input><param_input_item><param_name>X</param_name><param_description>signal ou tableau d&apos;entree.</param_description></param_input_item><param_input_item><param_name>P</param_name><param_description>facteur de surechantillonnage.</param_description></param_input_item><param_input_item><param_name>Q</param_name><param_description>facteur de sous-echantillonnage.</param_description></param_input_item><param_input_item><param_name>N</param_name><param_description>facteur de demi-longueur du filtre. La valeur par defaut est 10.</param_description></param_input_item><param_input_item><param_name>Beta</param_name><param_description>parametre de forme de la fenetre de Kaiser. La valeur par defaut est 5.</param_description></param_input_item><param_input_item><param_name>B</param_name><param_description>coefficients FIR du filtre anti-repliement.</param_description></param_input_item><param_input_item><param_name>Dim</param_name><param_description>dimension de travail.</param_description></param_input_item></param_input><param_output><param_output_item><param_name>Y</param_name><param_description>signal reechantillonne.</param_description></param_output_item></param_output><description><p><b>resample</b> change la frequence d&apos;un signal en filtrant entre surechantillonnage et sous-echantillonnage.</p></description><examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
