  <language>fr_FR</language>
  <keyword>impzlength</keyword>
  <short_description>Longueur estimee d'une reponse impulsionnelle.</short_description>
  <syntax>
    <syntax_item>N = impzlength(B, A)</syntax_item>
    <syntax_item>N = impzlength(B, A, tolerance)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>B</param_name>
      <param_description>coefficients du numerateur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>coefficients du denominateur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tolerance</param_name>
      <param_description>tolerance de troncature de la reponse.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>N</param_name>
      <param_description>longueur estimee.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>impzlength</b> retourne une longueur pratique pour les calculs de reponse impulsionnelle.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[
n = impzlength([1 1], 1);
]]></example_item_data>
    </example_item>
  </examples>
