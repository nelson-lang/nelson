  <keyword>fir1</keyword>
  <short_description>Conception de filtre FIR par fenêtrage.</short_description>
  <syntax><syntax_item>B = fir1(N, Wn)</syntax_item><syntax_item>B = fir1(N, Wn, type)</syntax_item><syntax_item>B = fir1(N, Wn, window)</syntax_item></syntax>
  <param_input><param_input_item><param_name>N</param_name><param_description>ordre du filtre.</param_description></param_input_item><param_input_item><param_name>Wn</param_name><param_description>fréquence de coupure normalisée ou paire de fréquences.</param_description></param_input_item><param_input_item><param_name>type</param_name><param_description>type de filtre, par exemple 'low', 'high', 'bandpass' ou 'stop'.</param_description></param_input_item><param_input_item><param_name>window</param_name><param_description>fenêtre de longueur N + 1.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>B</param_name><param_description>coefficients FIR du numérateur.</param_description></param_output_item></param_output>
  <description><p><b>fir1</b> conçoit un filtre FIR à phase linéaire par fenêtrage d&apos;une réponse impulsionnelle idéale.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
b = fir1(16, 0.25);
]]></example_item_data></example_item></examples>
