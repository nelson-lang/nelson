  <keyword>sosfilt</keyword>
  <short_description>Filtre des donnees avec des sections du second ordre.</short_description>
  <syntax>
    <syntax_item>Y = sosfilt(SOS, X)</syntax_item>
    <syntax_item>Y = sosfilt(SOS, X, DIM)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>SOS</param_name>
      <param_description>matrice de sections du second ordre.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>donnees d'entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>DIM</param_name>
      <param_description>dimension sur laquelle appliquer le filtre.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>donnees filtrees.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>sosfilt</b> applique chaque ligne de SOS comme une section de filtre.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[
y = sosfilt([1 2 1 1 -0.5 0], [1 0 0 0]);
]]></example_item_data>
    </example_item>
  </examples>
