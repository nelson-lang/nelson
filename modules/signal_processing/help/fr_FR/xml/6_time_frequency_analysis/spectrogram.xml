  <language>fr_FR</language>
  <keyword>spectrogram</keyword>
  <short_description>Spectrogramme par transformées de Fourier locales.</short_description>
  <syntax>
    <syntax_item>[S, F, T] = spectrogram(X)</syntax_item>
    <syntax_item>[S, F, T, P] = spectrogram(X, window, noverlap, NFFT, Fs)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>signal d'entrée.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>window</param_name>
      <param_description>vecteur de fenêtre ou longueur.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>noverlap</param_name>
      <param_description>nombre d'échantillons de recouvrement.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>NFFT</param_name>
      <param_description>longueur de FFT.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Fs</param_name>
      <param_description>fréquence d'échantillonnage.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>S</param_name>
      <param_description>spectre local complexe.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>F</param_name>
      <param_description>vecteur de fréquences.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>T</param_name>
      <param_description>vecteur de temps.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>P</param_name>
      <param_description>estimation de densité spectrale de puissance.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>spectrogram</b> découpe le signal en segments fenêtres recouvrants et calcule une FFT pour chaque segment.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[
[s, f, t] = spectrogram(sin((0:255)' * 0.1), 64, 32, 128, 10);
]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Afficher le spectrogramme (transformée de Fourier a court terme).</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[spectrogram(sin((0:255)' * 0.1), 64, 32, 128, 10);]]></example_item_data>
      <example_item_img
        src="../../images/spectrogram.svg"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
