  <keyword>gausswin</keyword>
  <short_description>Fenêtre gaussienne.</short_description>
  <syntax><syntax_item>W = gausswin(M)</syntax_item><syntax_item>W = gausswin(M, alpha)</syntax_item></syntax>
  <param_input><param_input_item><param_name>M</param_name><param_description>longueur de la fenêtre.</param_description></param_input_item><param_input_item><param_name>alpha</param_name><param_description>paramètre de forme.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>W</param_name><param_description>vecteur colonne contenant la fenêtre.</param_description></param_output_item></param_output>
  <description><p><b>gausswin</b> retourne une fenêtre gaussienne de M points.</p></description>
