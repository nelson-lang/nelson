  <keyword>chebwin</keyword>
  <short_description>Fenêtre de Dolph-Chebyshev.</short_description>
  <syntax><syntax_item>W = chebwin(M)</syntax_item><syntax_item>W = chebwin(M, ripple)</syntax_item></syntax>
  <param_input><param_input_item><param_name>M</param_name><param_description>longueur de la fenêtre.</param_description></param_input_item><param_input_item><param_name>ripple</param_name><param_description>atténuation des lobes secondaires en décibels.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>W</param_name><param_description>vecteur colonne contenant la fenêtre.</param_description></param_output_item></param_output>
  <description><p><b>chebwin</b> retourne une fenêtre de Dolph-Chebyshev normalisée à une amplitude maximale unitaire.</p></description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[
w = chebwin(5, 40);
]]></example_item_data></example_item></examples>
