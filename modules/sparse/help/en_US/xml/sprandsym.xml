  <language>en_US</language>
  <keyword>sprandsym</keyword>
  <short_description>Random sparse symmetric matrix.</short_description>
  <syntax>
    <syntax_item>R = sprandsym(S)</syntax_item>
    <syntax_item>R = sprandsym(n, density)</syntax_item>
    <syntax_item>R = sprandsym(n, density, rc)</syntax_item>
    <syntax_item>R = sprandsym(n, density, rc, kind)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>size of the matrix.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>density</param_name>
      <param_description>approximate fraction of nonzero values, in [0, 1].</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>S</param_name>
      <param_description>a square matrix whose lower triangle gives the sparsity pattern.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>rc</param_name>
      <param_description>reciprocal condition number in (0, 1], or a vector of n positive eigenvalues.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>kind</param_name>
      <param_description><b>1</b> (default) or <b>2</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>a sparse symmetric matrix.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>R = sprandsym(S)</b> returns a symmetric matrix with the pattern of the lower triangle of <b>S</b> (mirrored) and normally distributed values.</p>
    <p><b>R = sprandsym(n, density)</b> returns an n-by-n symmetric matrix with about <b>density * n^2</b> normally distributed nonzero values.</p>
    <p><b>R = sprandsym(n, density, rc)</b> returns a positive definite matrix with reciprocal condition number <b>rc</b>: eigenvalues are spaced geometrically between <b>rc</b> and 1 and mixed with random plane rotations until the density is reached.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[R = sprandsym(6, 0.3);
issymmetric(R)
R = sprandsym(10, 0.2, 1e-2);
cond(full(R))]]></example_item_data>
    </example_item>
  </examples>
