  <language>en_US</language>
  <keyword>nonzeros</keyword>
  <short_description>Nonzero matrix elements.</short_description>
  <syntax>
    <syntax_item>v = nonzeros(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>numeric, logical, or character array, including sparse numeric and sparse logical matrices.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>v</param_name>
      <param_description>dense column vector containing the nonzero values of A.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>nonzeros</b> returns the nonzero values of <b>A</b> in column-major order.</p>
    <p>For sparse input, the output is a dense column vector containing only values that are actually nonzero. Stored zero values in a sparse matrix are skipped.</p>
    <p>The output keeps the value class of <b>A</b>, including single, complex single, logical, and integer inputs.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[A = sparse([1 0 2; 0 3 0]);
v = nonzeros(A)
]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[S = sparse([1 2 1 2], [1 1 2 2], single([0 -0 complex(0, 0) complex(0, 2)]), 2, 2, 4);
v = nonzeros(S)
]]></example_item_data>
    </example_item>
  </examples>
