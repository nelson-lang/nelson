  <language>en_US</language>
  <keyword>colperm</keyword>
  <short_description>Column permutation sorted by nonzero count.</short_description>
  <syntax>
    <syntax_item>p = colperm(S)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>S</param_name>
      <param_description>a sparse or full matrix.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>a row vector permutation.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>p = colperm(S)</b> orders the columns of <b>S</b> by increasing number of nonzero values; columns with the same count keep their order. <b>S(:, p)</b> often has less fill-in in factorizations.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[S = sparse([1 0 1; 1 1 1; 0 0 1; 1 0 0]);
p = colperm(S)]]></example_item_data>
    </example_item>
  </examples>
