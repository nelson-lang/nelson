  <language>en_US</language>
  <keyword>spalloc</keyword>
  <short_description>Create a sparse matrix with allocated storage.</short_description>
  <syntax>
    <syntax_item>S = spalloc(m, n, nz)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>m</param_name>
      <param_description>number of rows.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>number of columns.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>nz</param_name>
      <param_description>requested storage allocation for nonzero elements.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>S</param_name>
      <param_description>a sparse double matrix.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>spalloc</b> creates an m-by-n sparse double matrix and reserves storage for up to <b>nz</b> nonzero elements.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[S = spalloc(3, 4, 5)
nzmax(S)]]></example_item_data>
    </example_item>
  </examples>
