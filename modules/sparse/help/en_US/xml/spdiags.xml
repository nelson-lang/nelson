  <language>en_US</language>
  <keyword>spdiags</keyword>
  <short_description>Extract or create sparse matrix diagonals.</short_description>
  <syntax>
    <syntax_item>B = spdiags(A)</syntax_item>
    <syntax_item>[B, d] = spdiags(A)</syntax_item>
    <syntax_item>S = spdiags(B, d, A)</syntax_item>
    <syntax_item>S = spdiags(B, d, m, n)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>a sparse or full matrix.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>B</param_name>
      <param_description>a full matrix whose columns contain diagonal values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>d</param_name>
      <param_description>diagonal offsets.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>m, n</param_name>
      <param_description>output sparse matrix dimensions.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>dense matrix containing extracted diagonals.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>d</param_name>
      <param_description>diagonal offsets.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>S</param_name>
      <param_description>a sparse matrix.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>spdiags</b> extracts stored diagonals from a matrix, replaces selected diagonals, or builds a sparse matrix from diagonal columns.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[A = sparse([1 0 2; 0 3 0; 4 0 5]);
[B, d] = spdiags(A)
R = spdiags([10; 20; 30], 0, A)
S = spdiags(B, d, 3, 3)]]></example_item_data>
    </example_item>
  </examples>
