  <language>fr_FR</language>
  <keyword>spalloc</keyword>
  <short_description>Cree une matrice sparse avec stockage reserve.</short_description>
  <syntax>
    <syntax_item>S = spalloc(m, n, nz)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>m</param_name>
      <param_description>nombre de lignes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>nombre de colonnes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>nz</param_name>
      <param_description>stockage demande pour les elements non nuls.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>S</param_name>
      <param_description>une matrice sparse double.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>spalloc</b> cree une matrice sparse double m-par-n et reserve du stockage pour au plus <b>nz</b> elements non nuls.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[S = spalloc(3, 4, 5)
nzmax(S)]]></example_item_data>
    </example_item>
  </examples>
