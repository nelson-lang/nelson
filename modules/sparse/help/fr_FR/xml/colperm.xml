  <language>fr_FR</language>
  <keyword>colperm</keyword>
  <short_description>Permutation de colonnes triée par nombre de non-zéros.</short_description>
  <syntax>
    <syntax_item>p = colperm(S)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>S</param_name>
      <param_description>une matrice creuse ou pleine.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>une permutation en vecteur ligne.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>p = colperm(S)</b> ordonne les colonnes de <b>S</b> par nombre croissant de valeurs non nulles ; les colonnes de même nombre gardent leur ordre. <b>S(:, p)</b> crée souvent moins de remplissage dans les factorisations.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[S = sparse([1 0 1; 1 1 1; 0 0 1; 1 0 0]);
p = colperm(S)]]></example_item_data>
    </example_item>
  </examples>
