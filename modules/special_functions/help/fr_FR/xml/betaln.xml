  <language>fr_FR</language>
  <keyword>betaln</keyword>
  <short_description>Logarithme de la fonction bêta</short_description>
  <syntax>
    <syntax_item>L = betaln(Z, W)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>Z</param_name>
      <param_description>scalaire, vecteur, ou matrice réel.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>W</param_name>
      <param_description>scalaire, vecteur, ou matrice réel.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>L</param_name>
      <param_description>logarithme naturel de la fonction bêta.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>betaln</b> calcule le logarithme naturel de la fonction bêta, log(beta(Z,W)), sans les dépassements que peut provoquer un calcul direct pour de grands Z et W.</p>
  </description>
