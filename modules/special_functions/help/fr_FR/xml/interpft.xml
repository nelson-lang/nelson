  <language>fr_FR</language>
  <keyword>interpft</keyword>
  <short_description>Interpolation 1-D par la méthode FFT.</short_description>
  <syntax>
    <syntax_item>y = interpft(x, ny)</syntax_item>
    <syntax_item>y = interpft(x, ny, dim)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>un vecteur ou une matrice d&apos;échantillons d&apos;une fonction périodique.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ny</param_name>
      <param_description>le nombre d&apos;échantillons de sortie (au moins le nombre d&apos;entrée).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>la dimension le long de laquelle interpoler.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>y</param_name>
      <param_description>les données rééchantillonnées.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>y = interpft(x, ny)</b> rééchantillonne <b>x</b> sur <b>ny</b> points équidistants à l&apos;aide de la transformée de Fourier, en supposant <b>x</b> périodique.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[y = interpft([1 2 3 4], 8)]]></example_item_data>
    </example_item>
  </examples>
