  <language>fr_FR</language>
  <keyword>gammainc</keyword>
  <short_description>Fonction gamma incomplète</short_description>
  <syntax>
    <syntax_item>Y = gammainc(X, A)</syntax_item>
    <syntax_item>Y = gammainc(X, A, tail)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>valeurs réelles positives ou nulles.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>valeurs réelles positives ou nulles.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>'lower' (défaut) ou 'upper'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>fonction gamma incomplète régularisée.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>gammainc</b> retourne la fonction gamma incomplète régularisée inférieure évaluée aux éléments de X et A. gammainc(X, A, 'upper') retourne la version supérieure (complémentaire). X et A doivent être de même taille, ou l'un des deux peut être un scalaire.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[Y = gammainc(0.5, 2)]]></example_item_data>
    </example_item>
  </examples>
