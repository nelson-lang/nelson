  <short_description>Interpolation par spline cubique.</short_description>
  <syntax><syntax_item>yq = spline(x, y, xq)</syntax_item><syntax_item>pp = spline(x, y)</syntax_item></syntax>
  <param_input><param_input_item><param_name>x</param_name><param_description>Points d'echantillonnage.</param_description></param_input_item><param_input_item><param_name>y</param_name><param_description>Valeurs echantillonnees.</param_description></param_input_item><param_input_item><param_name>xq</param_name><param_description>Points de requete.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>yq</param_name><param_description>Valeurs interpolees.</param_description></param_output_item><param_output_item><param_name>pp</param_name><param_description>Structure polynomiale par morceaux.</param_description></param_output_item></param_output>
  <description><p><b>spline</b> evalue une spline cubique not-a-knot ou retourne sa forme polynomiale par morceaux.</p></description>
