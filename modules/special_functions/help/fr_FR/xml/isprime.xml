  <keyword>isprime</keyword>
  <short_description>Détermine quels éléments d'un tableau sont premiers</short_description>
  <syntax>
    <syntax_item>TF = isprime(X)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>un scalaire, vecteur, ou matrice d'entiers positifs ou nuls.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>TF</param_name>
      <param_description>tableau logique, vrai là où l'élément correspondant de X est un nombre premier.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>isprime</b> retourne un tableau logique de même taille que X, contenant vrai là où les éléments de X sont des nombres premiers et faux sinon.</p>
  </description>
