  <language>fr_FR</language>
  <keyword>lcm</keyword>
  <short_description>Plus petit commun multiple</short_description>
  <syntax>
    <syntax_item>L = lcm(A, B)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>un scalaire, vecteur, ou matrice de valeurs entières réelles.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>B</param_name>
      <param_description>un scalaire, vecteur, ou matrice de valeurs entières réelles.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>L</param_name>
      <param_description>plus petit commun multiple de A et B.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>lcm</b> retourne le plus petit commun multiple des éléments correspondants de A et B. Les entrées doivent être des entiers réels.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = [4 6 8];
B = [6 9 12];
L = lcm(A, B)]]></example_item_data>
    </example_item>
  </examples>
