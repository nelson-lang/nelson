  <short_description>Cubic spline interpolation.</short_description>
  <syntax><syntax_item>yq = spline(x, y, xq)</syntax_item><syntax_item>pp = spline(x, y)</syntax_item></syntax>
  <param_input><param_input_item><param_name>x</param_name><param_description>Sample points.</param_description></param_input_item><param_input_item><param_name>y</param_name><param_description>Sample values.</param_description></param_input_item><param_input_item><param_name>xq</param_name><param_description>Query points.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>yq</param_name><param_description>Interpolated values.</param_description></param_output_item><param_output_item><param_name>pp</param_name><param_description>Piecewise polynomial structure.</param_description></param_output_item></param_output>
  <description><p><b>spline</b> evaluates a not-a-knot cubic spline or returns its piecewise polynomial form.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[yq = spline(1:4, [0 1 0 1], [1.5 2.5])]]></example_item_data></example_item></examples>
