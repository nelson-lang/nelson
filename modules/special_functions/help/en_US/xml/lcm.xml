  <language>en_US</language>
  <keyword>lcm</keyword>
  <short_description>Least common multiple.</short_description>
  <syntax>
    <syntax_item>L = lcm(A, B)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>a scalar, vector, or matrix of real integer values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>B</param_name>
      <param_description>a scalar, vector, or matrix of real integer values.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>L</param_name>
      <param_description>least common multiple of A and B.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>lcm</b> returns the least common multiple of corresponding elements of A and B. Inputs must be real integers.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = [4 6 8];
B = [6 9 12];
L = lcm(A, B)]]></example_item_data>
    </example_item>
  </examples>
