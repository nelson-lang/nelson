  <language>en_US</language>
  <keyword>gammainc</keyword>
  <short_description>Incomplete gamma function.</short_description>
  <syntax>
    <syntax_item>Y = gammainc(X, A)</syntax_item>
    <syntax_item>Y = gammainc(X, A, tail)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>nonnegative real values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>nonnegative real values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tail</param_name>
      <param_description>'lower' (default) or 'upper'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>regularized incomplete gamma function.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>gammainc</b> returns the lower regularized incomplete gamma function evaluated at the elements of X and A. gammainc(X, A, 'upper') returns the upper (complementary) regularized incomplete gamma function. X and A must be the same size, or either can be a scalar.</p>
  </description>
  <used_function />
