  <language>en_US</language>
  <keyword>beta</keyword>
  <short_description>Beta function.</short_description>
  <syntax>
    <syntax_item>B = beta(Z, W)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>Z</param_name>
      <param_description>real scalar, vector, or matrix.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>W</param_name>
      <param_description>real scalar, vector, or matrix.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>value of the beta function.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>beta</b> computes the beta function B(Z,W) = gamma(Z).*gamma(W)./gamma(Z+W).</p>
  </description>
  <used_function />
