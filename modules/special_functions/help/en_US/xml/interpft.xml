  <language>en_US</language>
  <keyword>interpft</keyword>
  <short_description>1-D interpolation using the FFT method.</short_description>
  <syntax>
    <syntax_item>y = interpft(x, ny)</syntax_item>
    <syntax_item>y = interpft(x, ny, dim)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>a vector or matrix of samples of a periodic function.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ny</param_name>
      <param_description>the number of output samples (at least the number of input samples).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>the dimension along which to interpolate.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>y</param_name>
      <param_description>the resampled data.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>y = interpft(x, ny)</b> resamples <b>x</b> to <b>ny</b> equally spaced points using the Fourier transform, assuming <b>x</b> is periodic.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[y = interpft([1 2 3 4], 8)]]></example_item_data>
    </example_item>
  </examples>
