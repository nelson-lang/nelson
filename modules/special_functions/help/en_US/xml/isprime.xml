  <language>en_US</language>
  <keyword>isprime</keyword>
  <short_description>Determine which array elements are prime.</short_description>
  <syntax>
    <syntax_item>TF = isprime(X)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>a scalar, vector, or matrix of nonnegative integers.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>TF</param_name>
      <param_description>logical array, true where the corresponding element of X is a prime number.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>isprime</b> returns a logical array the same size as X, containing true where the elements of X are prime numbers and false where they are not.</p>
  </description>
  <used_function />
  <bibliography />
