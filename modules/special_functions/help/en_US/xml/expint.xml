  <language>en_US</language>
  <keyword>expint</keyword>
  <short_description>Exponential integral.</short_description>
  <syntax>
    <syntax_item>Y = expint(X)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>a real or complex single or double array.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>an array of the size and class of <b>X</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>Y = expint(X)</b> evaluates the exponential integral <b>E1(x)</b>, the integral of <b>exp(-t) / t</b> from <b>x</b> to infinity, extended to complex values.</p>
    <p>For negative real values the result is complex with an imaginary part of <b>-pi</b>. <b>expint(0)</b> is <b>Inf</b>.</p>
    <p>A power series is used near the origin and on the left half plane, and a continued fraction elsewhere.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[expint([0.5 1 2])
expint(-1)
expint(1 + 2i)]]></example_item_data>
    </example_item>
  </examples>
