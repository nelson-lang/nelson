  <language>en_US</language>
  <keyword>getweburl</keyword>
  <short_description>Returns the current Web GUI URL and port.</short_description>
  <syntax><syntax_item>[url, port] = getweburl()</syntax_item></syntax>
  <param_output>
    <param_output_item><param_name>url</param_name><param_description>Current Web GUI URL, or an empty string outside an active web launch.</param_description></param_output_item>
    <param_output_item><param_name>port</param_name><param_description>Current Web GUI port, or <b>0</b> outside an active web launch.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>getweburl()</b> returns the effective HTTP URL and port used by the current Web GUI session. A private webview launch still has an internal localhost port, but that URL is not printed at startup.</p>
  </description>
  <used_function />
  <bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data><![CDATA[[url, port] = getweburl()]]></example_item_data></example_item></examples>
