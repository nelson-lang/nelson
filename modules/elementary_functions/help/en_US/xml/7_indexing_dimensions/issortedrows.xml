  <language>en_US</language>
  <keyword>issortedrows</keyword>
  <short_description>Determine whether matrix rows are sorted.</short_description>
  <syntax>
    <syntax_item>tf = issortedrows(A)</syntax_item>
    <syntax_item>tf = issortedrows(A, col)</syntax_item>
    <syntax_item>tf = issortedrows(A, ..., direction)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>a matrix.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>col</param_name>
      <param_description>the columns used for the comparison.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>direction</param_name>
      <param_description><b>&apos;ascend&apos;</b> (default) or <b>&apos;descend&apos;</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>a logical: <b>true</b> when the rows of <b>A</b> are sorted.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = issortedrows(A)</b> returns <b>true</b> when the rows of <b>A</b> are sorted in ascending order.</p>
    <p>Pass <b>col</b> and <b>direction</b> to match the sorting used by <b>sortrows</b>.</p>
  </description>
