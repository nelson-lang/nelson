  <language>en_US</language>
  <keyword>topkrows</keyword>
  <short_description>Top k sorted rows of a matrix.</short_description>
  <syntax>
    <syntax_item>B = topkrows(A, k)</syntax_item>
    <syntax_item>B = topkrows(A, k, col)</syntax_item>
    <syntax_item>B = topkrows(A, k, col, direction)</syntax_item>
    <syntax_item>[B, I] = topkrows(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>a matrix.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>k</param_name>
      <param_description>the number of rows to return.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>col</param_name>
      <param_description>the columns used for sorting (default all).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>direction</param_name>
      <param_description><b>&apos;descend&apos;</b> (default) or <b>&apos;ascend&apos;</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>the first <b>k</b> rows of the sorted matrix.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>I</param_name>
      <param_description>the indices such that <b>B = A(I, :)</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>B = topkrows(A, k)</b> returns the first <b>k</b> rows of <b>A</b> sorted in descending order.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[[B, I] = topkrows([3 1; 1 2; 2 9], 2)]]></example_item_data>
    </example_item>
  </examples>
