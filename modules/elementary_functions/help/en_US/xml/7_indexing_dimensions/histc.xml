<xmldoc>
  <copyright>SAME AS NELSON SOFTWARE</copyright><language>en_US</language><keyword>histc</keyword>
  <short_description>Histogram count with explicit edges.</short_description>
  <syntax><syntax_item>N = histc(X, edges)</syntax_item><syntax_item>[N, bin] = histc(X, edges)</syntax_item><syntax_item>N = histc(X, edges, dim)</syntax_item></syntax>
  <param_input><param_input_item><param_name>X</param_name><param_description>Numeric or logical array.</param_description></param_input_item><param_input_item><param_name>edges</param_name><param_description>Numeric vector of bin edges.</param_description></param_input_item><param_input_item><param_name>dim</param_name><param_description>Dimension to operate along.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>N</param_name><param_description>Counts for each edge interval.</param_description></param_output_item><param_output_item><param_name>bin</param_name><param_description>Bin index for each element of X.</param_description></param_output_item></param_output>
  <description><p><b>histc</b> counts values in bins defined by <b>edges</b>. Values equal to the last edge are counted in the last bin.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[N, bin] = histc([0 1 1.5 2], [0 1 2])]]></example_item_data></example_item></examples>
