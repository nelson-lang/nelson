  <language>en_US</language>
  <keyword>find</keyword>
  <short_description>Find Non-zero Elements</short_description>
  <syntax>
    <syntax_item>K = find(M)</syntax_item>
    <syntax_item>[R, C] = find(M)</syntax_item>
    <syntax_item>[R, C, V] = find(M)</syntax_item>
    <syntax_item>K = find(M, N)</syntax_item>
    <syntax_item>[R, C] = find(M, N)</syntax_item>
    <syntax_item>[R, C, V] = find(M, N)</syntax_item>
    <syntax_item>K = find(M, N, D)</syntax_item>
    <syntax_item>[R, C] = find(M, N, D)</syntax_item>
    <syntax_item>[R, C, V] = find(M, N, D)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M</param_name>
      <param_description
      >a scalar, vector, matrix, multidimensional array, or sparse matrix.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>N</param_name>
      <param_description
      >positive integer scalar value, or <b>Inf</b>, indicating the number of nonzeros to find.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>D</param_name>
      <param_description
      >direction: &apos;first&apos; (default) or &apos;last&apos;. The value is case-insensitive.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>K</param_name>
      <param_description
      >indices to nonzero elements (vector).</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>row subscripts (vector).</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>C</param_name>
      <param_description>column subscripts (vector).</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>V</param_name>
      <param_description>nonzero elements of M (vector).</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>K = find(M)</b> returns a vector with the linear indices of each nonzero element of <b>M</b>.</p>
    <p>
      <b>find(M, Inf)</b> returns all nonzero indices and can be combined with the direction argument.</p>
    <p>
      For sparse input, <b>find</b> accepts double, single, logical, complex double, and complex single sparse matrices. Stored zero values are ignored; only entries whose value is actually nonzero are returned.</p>
    <p>
      With three outputs, <b>V</b> keeps the value class of the input sparse matrix, including single and logical values.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[M = rand(4, 3, 5);
[R, C, V] = find(M > 0.9)
M(R(1),C(1),V(1))]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[K = find([0 2 0 3], Inf, 'LAST')]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[S = sparse([1 2 1 2], [1 1 2 2], single([0 -0 complex(0, 0) complex(0, 2)]), 2, 2, 4);
[R, C, V] = find(S)]]></example_item_data>
    </example_item>
  </examples>
