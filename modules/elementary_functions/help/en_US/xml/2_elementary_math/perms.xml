  <language>en_US</language>
  <keyword>perms</keyword>
  <short_description>All possible permutations.</short_description>
  <syntax>
    <syntax_item>P = perms(v)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>v</param_name>
      <param_description>vector.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>P</param_name>
      <param_description>matrix containing all permutations of the elements of v, in reverse lexicographic order.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>perms</b> returns a matrix containing all permutations of the elements of vector v. Each row of P is one permutation; there are factorial(numel(v)) rows, listed in reverse lexicographic order.</p>
  </description>
