  <language>en_US</language>
  <keyword>rat</keyword>
  <short_description>Rational fraction approximation.</short_description>
  <syntax>
    <syntax_item>[N, D] = rat(X)</syntax_item>
    <syntax_item>[N, D] = rat(X, tol)</syntax_item>
    <syntax_item>S = rat(X)</syntax_item>
    <syntax_item>S = rat(X, tol)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description
      >Input array: real or complex, scalar, vector or matrix (single or double).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tol</param_name>
      <param_description
      >Tolerance: scalar. The default is <b>1e-6 * norm(X(:), 1)</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>N</param_name>
      <param_description
      >Numerator: array of the same size as <b>X</b>, or the continued fraction character array when a single output is requested.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>D</param_name>
      <param_description>Denominator: array of the same size as <b>X</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>[N, D] = rat(X)</b> returns two integer arrays so that <b
      >N ./ D</b> is close to <b>X</b> in the sense that <b
      >abs(N ./ D - X) &lt;= tol</b>.</p>
    <p>The rational approximations are generated by truncating continued fraction expansions.</p>
    <p><b>S = rat(X)</b> returns the continued fraction representation as a character array.</p>
  </description>
  <used_function />
