  <keyword>clip</keyword>
  <short_description>Limit values to a range.</short_description>
  <syntax>
    <syntax_item>Y = clip(X, lowerBound, upperBound)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>a numeric or logical array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>lowerBound</param_name>
      <param_description>a numeric scalar: lower limit of the range.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>upperBound</param_name>
      <param_description>a numeric scalar: upper limit of the range.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>the clipped array, same size as X.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>clip</b> limits the values of <b>X</b> to the interval
    <b>[lowerBound, upperBound]</b>.</p>
    <p>Values smaller than <b>lowerBound</b> are set to <b>lowerBound</b> and
    values greater than <b>upperBound</b> are set to <b>upperBound</b>.</p>
    <p><b>NaN</b> values in a floating-point input are preserved.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[Y = clip([-2 0 5 10], 0, 8)]]></example_item_data>
    </example_item>
  </examples>
