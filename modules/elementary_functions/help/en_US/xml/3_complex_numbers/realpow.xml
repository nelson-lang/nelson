  <language>en_US</language>
  <keyword>realpow</keyword>
  <short_description>Element-wise power with real-only result.</short_description>
  <syntax>
    <syntax_item>Z = realpow(X, Y)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>Real base values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Y</param_name>
      <param_description>Real exponent values.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Z</param_name>
      <param_description>result of X .^ Y when all values are real.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>realpow</b> computes element-wise powers and returns an error if an input or the result is complex.</p>
    <p>
      <b>X</b> and <b>Y</b> must have compatible sizes for element-wise power.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[X = -2 * ones(3, 3);
Y = pascal(3);
Z = realpow(X, Y)]]></example_item_data>
    </example_item>
  </examples>
