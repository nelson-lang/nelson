  <keyword>clip</keyword>
  <short_description>Limiter des valeurs a un intervalle.</short_description>
  <syntax>
    <syntax_item>Y = clip(X, lowerBound, upperBound)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>un tableau numerique ou logique.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>lowerBound</param_name>
      <param_description>un scalaire numerique : borne inferieure de l'intervalle.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>upperBound</param_name>
      <param_description>un scalaire numerique : borne superieure de l'intervalle.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>le tableau limite, de meme taille que X.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>clip</b> limite les valeurs de <b>X</b> a l'intervalle
    <b>[lowerBound, upperBound]</b>.</p>
    <p>Les valeurs inferieures a <b>lowerBound</b> sont fixees a
    <b>lowerBound</b> et les valeurs superieures a <b>upperBound</b> sont
    fixees a <b>upperBound</b>.</p>
    <p>Les valeurs <b>NaN</b> d'une entree en virgule flottante sont
    preservees.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[Y = clip([-2 0 5 10], 0, 8)]]></example_item_data>
    </example_item>
  </examples>
