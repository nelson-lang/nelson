  <language>fr_FR</language>
  <keyword>idivide</keyword>
  <short_description>Division entiere avec option d'arrondi.</short_description>
  <syntax>
    <syntax_item>C = idivide(A, B)</syntax_item>
    <syntax_item>C = idivide(A, B, opt)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A, B</param_name>
      <param_description>tableaux entiers (au moins un doit appartenir a une classe entiere).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>opt</param_name>
      <param_description>regle d'arrondi : 'fix' (defaut), 'round', 'floor' ou 'ceil'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>C</param_name>
      <param_description>resultat de la division entiere.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>idivide(A, B)</b> divise <b>A</b> par <b>B</b> et arrondit le resultat vers zero (<b>'fix'</b>), en conservant la classe entiere des entrees.</p>
    <p>Utilisez <b>opt</b> pour choisir une autre regle d'arrondi : <b>'round'</b>, <b>'floor'</b> ou <b>'ceil'</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[idivide(int32(7), int32(2))
idivide(int32(7), int32(2), 'ceil')]]></example_item_data>
    </example_item>
  </examples>
