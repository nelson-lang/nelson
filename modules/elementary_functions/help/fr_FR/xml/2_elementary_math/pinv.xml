  <language>fr_FR</language>
  <keyword>pinv</keyword>
  <short_description>Pseudo-inverse de Moore-Penrose</short_description>
  <syntax>
    <syntax_item>y = pinv(A)</syntax_item>
    <syntax_item>y = pinv(A, tol)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>matrice : matrice d'entrée</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tol</param_name>
      <param_description>scalaire : tolérance sur les valeurs singulières</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>y</param_name>
      <param_description
      >Pseudo-inverse de Moore-Penrose de la matrice A.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>pinv</b> renvoie la pseudo-inverse de Moore-Penrose de la matrice A.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[A = [1, 2, 3; 4, 5, 6];
R = pinv(A)
R = pinv(A, 2)]]></example_item_data>
    </example_item>
  </examples>
