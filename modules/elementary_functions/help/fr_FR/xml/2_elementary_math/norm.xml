  <language>fr_FR</language>
  <keyword>norm</keyword>
  <short_description>Normes de matrices et de vecteurs</short_description>
  <syntax>
    <syntax_item>R = norm(V)</syntax_item>
    <syntax_item>R = norm(V, p)</syntax_item>
    <syntax_item>R = norm(V, &apos;fro&apos;)</syntax_item>
    <syntax_item>R = norm(M)</syntax_item>
    <syntax_item>R = norm(M, 1)</syntax_item>
    <syntax_item>R = norm(M, 2)</syntax_item>
    <syntax_item>R = norm(M, Inf)</syntax_item>
    <syntax_item>R = norm(M, &apos;fro&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M</param_name>
      <param_description>une matrice 2D single ou double</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>V</param_name>
      <param_description>un vecteur single ou double</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>un scalaire (norme p)</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>résultat de norm : scalaire.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>norm</b> calcule la norme d'un vecteur ou d'une matrice.</p>
    <p>La norme de Frobenius de M est égale à <b>sqrt (sum (diag (M&apos; * M)))</b> .</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[M = [1 2; 3 4];
norm(M)
norm(M, 1)
norm(M, 2)
norm(M, Inf)
norm(M, 'fro')
V = [1 2 3 4];
norm(V)
norm(V, 1)
norm(V, 2)
norm(V, Inf)
norm(V, 'fro')]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[x = ones(3000, 3000);
tic();R = norm(x);toc]]></example_item_data>
    </example_item>
  </examples>
