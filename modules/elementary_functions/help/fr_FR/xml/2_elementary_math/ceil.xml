  <language>fr_FR</language>
  <keyword>ceil</keyword>
  <short_description>Arrondir vers le haut</short_description>
  <syntax>
    <syntax_item>C = ceil(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>une variable</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>C</param_name>
      <param_description>résultat de ceil.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>ceil</b> renvoie une matrice d&apos;entiers ou complexes dont les éléments sont arrondis vers le haut.</p>
    <p>
      Les entrees sparse single et sparse single complexes sont prises en charge. Seules les
      entrees non nulles stockees sont arrondies et le resultat conserve le stockage sparse.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[ceil(pi)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Arrondi vers le haut d'une matrice sparse single.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[S = sparse(single([1.2 0; -2.7 3.1]));
C = ceil(S)]]></example_item_data>
    </example_item>
  </examples>
