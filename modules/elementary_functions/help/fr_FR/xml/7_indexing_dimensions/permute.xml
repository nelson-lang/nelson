  <language>fr_FR</language>
  <keyword>permute</keyword>
  <short_description>Permute les dimensions d&apos;un tableau.</short_description>
  <syntax>
    <syntax_item>R = permute(A, order)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>un tableau.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>order</param_name>
      <param_description>ordre des dimensions : vecteur ligne</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description
      >tableau résultat réorganisé selon le nouvel ordre des dimensions.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>permute</b> permute les dimensions d&apos;un tableau.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
      ><![CDATA[x = [1 2 3; 4 5 6]
y = permute(x,[3 1 2])]]></example_item_data>
    </example_item>
  </examples>
