  <keyword>issortedrows</keyword>
  <short_description>Détermine si les lignes d&apos;une matrice sont triées.</short_description>
  <syntax>
    <syntax_item>tf = issortedrows(A)</syntax_item>
    <syntax_item>tf = issortedrows(A, col)</syntax_item>
    <syntax_item>tf = issortedrows(A, ..., direction)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>une matrice.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>col</param_name>
      <param_description>les colonnes utilisées pour la comparaison.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>direction</param_name>
      <param_description><b>&apos;ascend&apos;</b> (par défaut) ou <b>&apos;descend&apos;</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>un logique : <b>true</b> si les lignes de <b>A</b> sont triées.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = issortedrows(A)</b> renvoie <b>true</b> si les lignes de <b>A</b> sont triées par ordre croissant.</p>
    <p>Fournissez <b>col</b> et <b>direction</b> pour correspondre au tri de <b>sortrows</b>.</p>
  </description>
  <used_function />
