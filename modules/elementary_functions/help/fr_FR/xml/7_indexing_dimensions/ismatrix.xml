  <language>fr_FR</language>
  <keyword>ismatrix</keyword>
  <short_description
  >détermine si l&apos;entrée est une matrice ou non</short_description>
  <syntax>
    <syntax_item>TF = ismatrix(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description
      >tableau d&apos;entrée : scalaire, vecteur, matrice ou tableau multidimensionnel.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>TF</param_name>
      <param_description>un logique : true s&apos;il s&apos;agit d&apos;une matrice.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>TF = ismatrix(A)</b> renvoie true si A est une matrice.</p>
    <p
    >Une matrice est un tableau bidimensionnel de taille m par n, où m et n sont des entiers positifs ou nuls.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
      ><![CDATA[x = [1+i,-i;i,2i];
ismatrix(x)
ismatrix(ones(3,1,2))]]></example_item_data>
    </example_item>
  </examples>
