  <language>fr_FR</language>
  <keyword>topkrows</keyword>
  <short_description>Les k premières lignes triées d&apos;une matrice.</short_description>
  <syntax>
    <syntax_item>B = topkrows(A, k)</syntax_item>
    <syntax_item>B = topkrows(A, k, col)</syntax_item>
    <syntax_item>B = topkrows(A, k, col, direction)</syntax_item>
    <syntax_item>[B, I] = topkrows(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>une matrice.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>k</param_name>
      <param_description>le nombre de lignes à renvoyer.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>col</param_name>
      <param_description>les colonnes utilisées pour le tri (toutes par défaut).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>direction</param_name>
      <param_description><b>&apos;descend&apos;</b> (par défaut) ou <b>&apos;ascend&apos;</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>les <b>k</b> premières lignes de la matrice triée.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>I</param_name>
      <param_description>les indices tels que <b>B = A(I, :)</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>B = topkrows(A, k)</b> renvoie les <b>k</b> premières lignes de <b>A</b> triées par ordre décroissant.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[[B, I] = topkrows([3 1; 1 2; 2 9], 2)]]></example_item_data>
    </example_item>
  </examples>
