  <language>fr_FR</language>
  <keyword>isequalto</keyword>
  <short_description
  >Renvoie true si tous les arguments x1, x2, ... , xn sont égaux (même type, mêmes dimensions, mêmes valeurs ou NaN).</short_description>
  <syntax>
    <syntax_item>res = isequalto(x1, x2)</syntax_item>
    <syntax_item>res = isequalto(x1, x2, xn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x1</param_name>
      <param_description>une valeur</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>x2</param_name>
      <param_description>une valeur</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>xn</param_name>
      <param_description>une valeur</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>res</param_name>
      <param_description>une valeur logique</param_description>
    </param_output_item>
  </param_output>
  <description>
    <b>isequalto</b> renvoie true si x1 et x2 ont le même type, la même taille et les mêmes valeurs ; sinon, elle renvoie false.</description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[A = eye(3, 3);
res = isequal(A, single(A))
res = isequalto(A, single(A))
]]></example_item_data>
    </example_item>
  </examples>
