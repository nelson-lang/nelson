  <language>fr_FR</language>
  <keyword>tril</keyword>
  <short_description>Partie triangulaire inférieure d&apos;une matrice</short_description>
  <syntax>
    <syntax_item>T = tril(M)</syntax_item>
    <syntax_item>T = tril(M, k)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M</param_name>
      <param_description>matrice d&apos;entrée 2D</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>k</param_name>
      <param_description
      >diagonales à inclure : valeur entière réelle</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>partie triangulaire inférieure de la matrice</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>tril</b> calcule la partie triangulaire inférieure d&apos;une matrice.</p>
    <p>
      <b>R = tril(M, k)</b> renvoie les éléments situés sur et au-dessous de la k-ième diagonale de M.</p>
    <p>
      Les matrices sparse single et sparse single complexes sont prises en charge. Le resultat
      conserve le stockage sparse et la precision de l'entree.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[x = [1+i,-i;i,2i];
r = tril(x)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Partie triangulaire inferieure sparse single.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[S = sparse(single([1 2; 3 4]));
R = tril(S)]]></example_item_data>
    </example_item>
  </examples>
