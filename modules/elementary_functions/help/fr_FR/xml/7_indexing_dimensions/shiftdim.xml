  <language>fr_FR</language>
  <keyword>shiftdim</keyword>
  <short_description>Décale les dimensions d&apos;un tableau</short_description>
  <syntax>
    <syntax_item>B = shiftdim(A, n)</syntax_item>
    <syntax_item>B = shiftdim(A)</syntax_item>
    <syntax_item>[B, m] = shiftdim(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description
      >tableau d&apos;entrée : vecteur, matrice ou tableau multidimensionnel.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>nombre de positions : valeur entière.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description
      >vecteur, matrice ou tableau multidimensionnel.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>m</param_name>
      <param_description
      >nombre de dimensions supprimées : entier positif ou nul.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>shiftdim(A, n)</b> réorganise les dimensions d&apos;un tableau A de n positions.</p>
    <p
    >Plus précisément, lorsque n est un entier positif, les dimensions sont décalées vers la gauche, et lorsque n est un entier négatif, elles sont décalées vers la droite.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[A = rand(2, 3, 4);
size(A)
% Shift the dimensions of array A by 2 positions to the left
B = shiftdim(A, 2)]]></example_item_data>
    </example_item>
  </examples>
