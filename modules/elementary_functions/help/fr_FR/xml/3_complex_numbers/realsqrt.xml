  <keyword>realsqrt</keyword>
  <short_description>Racine carree avec resultat reel uniquement.</short_description>
  <syntax>
    <syntax_item>R = realsqrt(X)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>input array.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>Square root with real-only result.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>realsqrt</b> calcule sqrt(X) et renvoie une erreur si une entree ou le resultat est complexe.</p>
  </description>
  <used_function />
  <bibliography />
