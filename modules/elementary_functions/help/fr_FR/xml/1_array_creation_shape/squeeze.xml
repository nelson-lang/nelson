  <language>fr_FR</language>
  <keyword>squeeze</keyword>
  <short_description>Supprimer les dimensions de longueur 1.</short_description>
  <syntax>
    <syntax_item>B = squeeze(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>tableau d'entrée : tableau multidimensionnel</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>tableau de sortie.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>B = squeeze(A)</b> renvoie un tableau contenant les mêmes éléments que le tableau d'entrée A, mais dont les dimensions de longueur 1 ont été supprimées.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[ A = zeros(1, 1, 3);
A(:, :, 1:3) = [1 20 3];
R = squeeze(A)]]></example_item_data>
    </example_item>
  </examples>
