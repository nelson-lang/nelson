  <language>fr_FR</language>
  <keyword>reshape</keyword>
  <short_description
  >Redimensionne un vecteur ou une matrice en une matrice de taille différente.</short_description>
  <syntax>
    <syntax_item>M2 = reshape(M1, s1, ... ,sN)</syntax_item>
    <syntax_item>M2 = reshape(M1, ..., [], ...)</syntax_item>
    <syntax_item>M2 = reshape(M1, size)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M1</param_name>
      <param_description>un vecteur ou une matrice</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>size</param_name>
      <param_description>un vecteur de tailles</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>s1, ... ,sN</param_name>
      <param_description
      >un tableau s1 - par - ... - par - sN où s1, ..., sN indiquent la taille de chaque dimension.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>M2</param_name>
      <param_description>Matrice redimensionnée</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>reshape</b> redimensionne en une matrice de taille différente. Si une seule dimension est spécifiée,<b>reshape</b> détermine automatiquement la taille complémentaire. [ ] permet de laisser une dimension non spécifiée.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
      ><![CDATA[M1 = ones(3, 4, 5);
M2 = reshape(M1, [5, 3, 4])
M2 = reshape(M1, 5, [], 4)
]]></example_item_data>
    </example_item>
  </examples>
