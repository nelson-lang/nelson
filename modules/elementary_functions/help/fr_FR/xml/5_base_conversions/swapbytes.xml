  <keyword>swapbytes</keyword>
  <short_description>Inverse l&apos;ordre des octets.</short_description>
  <syntax>
    <syntax_item>R = swapbytes(M)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M</param_name>
      <param_description
      >une variable : matrice pleine réelle entière, single ou double.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description
      >résultat de swapbytes : ordre des octets de M inversé.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>swapbytes</b> inverse l&apos;ordre des octets.</p>
    <p>convertisseur d&apos;endianness (petit-boutiste / gros-boutiste)</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[X = uint16([65535 128; 1 0])
Y = swapbytes(X)]]></example_item_data>
    </example_item>
  </examples>
