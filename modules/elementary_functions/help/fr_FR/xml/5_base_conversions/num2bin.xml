  <keyword>num2bin</keyword>
  <short_description
  >Convertit un nombre en sa représentation binaire.</short_description>
  <syntax>
    <syntax_item>R = num2bin(M)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M</param_name>
      <param_description
      >une variable : matrice pleine réelle logique, entière, single ou double.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>résultat de num2bin : tableau de caractères.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>num2bin</b> renvoie un tableau de caractères donnant la représentation binaire littérale d&apos;un nombre.</p>
  </description>
  <used_function>C++ std::bitset</used_function>
  <bibliography>http://www.oxfordmathcenter.com/drupal7/node/43</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[X = [65535 128; 1 0]
Y = num2bin(X)]]></example_item_data>
    </example_item>
  </examples>
