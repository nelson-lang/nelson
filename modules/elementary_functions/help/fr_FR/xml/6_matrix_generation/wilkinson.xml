  <keyword>wilkinson</keyword>
  <short_description>Matrice de test de valeurs propres de Wilkinson</short_description>
  <syntax>
    <syntax_item>W = wilkinson(n)</syntax_item>
    <syntax_item>W = wilkinson(n, classname)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>valeur entière scalaire : ordre.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>classname</param_name>
      <param_description
      >vecteur de caractères ligne ou chaîne scalaire : nom de classe souhaité (&apos;double&apos; par défaut).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>W</param_name>
      <param_description>matrice de test de valeurs propres de Wilkinson.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>W = wilkinson(n)</b> renvoie la matrice de Wilkinson d&apos;ordre<b>n</b>.</p>
  </description>
  <used_function />
  <bibliography>https://en.wikipedia.org/wiki/Wilkinson_matrix</bibliography>
