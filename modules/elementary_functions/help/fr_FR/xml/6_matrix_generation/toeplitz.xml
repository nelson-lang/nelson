  <language>fr_FR</language>
  <keyword>toeplitz</keyword>
  <short_description>Matrice de Toeplitz</short_description>
  <syntax>
    <syntax_item>T = toeplitz(c, r)</syntax_item>
    <syntax_item>T = toeplitz(r)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>c</param_name>
      <param_description
      >un scalaire ou un vecteur : colonne de la matrice de Toeplitz.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>r</param_name>
      <param_description
      >un scalaire ou un vecteur : ligne de la matrice de Toeplitz.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>T</param_name>
      <param_description>matrice de Toeplitz.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>T = toeplitz(c, r)</b> renvoie la matrice de Toeplitz dont la première ligne est<b>r</b> et la première colonne est <b>c</b>.</p>
    <p>
      <b>T = toeplitz(c)</b> renvoie la matrice de Toeplitz symétrique.</p>
  </description>
  <used_function />
  <bibliography>https://en.wikipedia.org/wiki/Toeplitz_matrix</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[T = toeplitz(1:5, 1:2:7)]]></example_item_data>
    </example_item>
  </examples>
