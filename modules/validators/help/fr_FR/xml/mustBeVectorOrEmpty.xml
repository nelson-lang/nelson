  <keyword>mustBeVectorOrEmpty</keyword>
  <short_description
  >Verifie que la valeur est un vecteur ou vide, sinon renvoie une erreur.</short_description>
  <syntax>
    <syntax_item>mustBeVectorOrEmpty(var)</syntax_item>
    <syntax_item>mustBeVectorOrEmpty(var, argPosition)</syntax_item>
    <syntax_item
    >C++: void mustBeVectorOrEmpty(const ArrayOfVector&amp; args, int argPosition)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>var</param_name>
      <param_description
      >une variable : tous les types et classes pris en charge qui implementent isvector et isempty.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>argPosition</param_name>
      <param_description
      >un entier positif : position de l'argument d'entree.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p>
      <b>mustBeVectorOrEmpty</b> verifie que la valeur est un vecteur ou vide, sinon renvoie une erreur.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[mustBeVectorOrEmpty([1 2])
mustBeVectorOrEmpty(zeros(0, 3))
mustBeVectorOrEmpty(ones(2))]]></example_item_data>
    </example_item>
  </examples>
