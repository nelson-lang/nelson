  <language>en_US</language>
  <keyword>mustBeUnderlyingType</keyword>
  <short_description>Validate that value has a specified underlying type.</short_description>
  <syntax>
    <syntax_item>mustBeUnderlyingType(A, typename)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>value to validate.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>typename</param_name>
      <param_description>text scalar naming the required underlying type.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>none</param_name><param_description>this validation function returns no value.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>mustBeUnderlyingType</b> throws an error if the underlying type of A (as returned by underlyingType) is not equal to typename. This function does not return a value.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[mustBeUnderlyingType(int32(5), 'int32')]]></example_item_data>
    </example_item>
  </examples>
