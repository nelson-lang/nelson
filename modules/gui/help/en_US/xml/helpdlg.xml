  <language>en_US</language>
  <keyword>helpdlg</keyword>
  <short_description>Creates a help dialog box.</short_description>
  <syntax>
    <syntax_item>h = helpdlg</syntax_item>
    <syntax_item>h = helpdlg(message)</syntax_item>
    <syntax_item>h = helpdlg(message, title)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>message</param_name>
      <param_description>Help text. Use a character vector, string, or cell array of character vectors.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>Graphics figure handle.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>helpdlg creates a help message dialog and returns a graphics figure handle.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Create a help dialog.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[h = helpdlg('Use the OK button to close this dialog.', 'Help');]]></example_item_data>
      <example_item_img
        src="../images/helpdlg_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Display several help lines.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[h = helpdlg({'Select a file.', 'Then press Open.'}, 'Help');
close(h)]]></example_item_data>
    </example_item>
  </examples>
