  <language>en_US</language>
  <keyword>errordlg</keyword>
  <short_description>Creates an error dialog box.</short_description>
  <syntax>
    <syntax_item>h = errordlg</syntax_item>
    <syntax_item>h = errordlg(message)</syntax_item>
    <syntax_item>h = errordlg(message, title)</syntax_item>
    <syntax_item>h = errordlg(message, title, mode)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>message</param_name>
      <param_description>Error text. Use a character vector, string, or cell array of character vectors.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>Graphics figure handle.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>errordlg creates an error message dialog and returns a graphics figure handle.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Create an error dialog.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[h = errordlg('Invalid value.', 'Error', 'non-modal');]]></example_item_data>
      <example_item_img
        src="../images/errordlg_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Create the default error dialog.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[h = errordlg();
close(h)]]></example_item_data>
    </example_item>
  </examples>
