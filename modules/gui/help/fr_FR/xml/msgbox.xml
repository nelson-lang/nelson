  <language>fr_FR</language>
  <keyword>msgbox</keyword>
  <short_description>Cree une boite de dialogue de message.</short_description>
  <syntax>
    <syntax_item>h = msgbox(message)</syntax_item>
    <syntax_item>h = msgbox(message, title)</syntax_item>
    <syntax_item>h = msgbox(message, title, icon)</syntax_item>
    <syntax_item>h = msgbox(message, title, icon, mode)</syntax_item>
    <syntax_item>h = msgbox(message, mode)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>message</param_name>
      <param_description>Message text. Use a character vector, string array, or cell array of character vectors for multiple lines.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>Graphics figure handle.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>msgbox creates a message dialog and returns a graphics figure handle. The handle can be used with get, set, close, delete, and waitfor.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Creer une boite de message.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[h = msgbox({'Operation', 'completed'}, 'Status', 'help', 'non-modal');]]></example_item_data>
      <example_item_img
        src="../images/msgbox_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Create a plain message box.</example_item_description>
      <example_item_data runnable="adv-cli"><![CDATA[h = msgbox('Ready.', 'Status', 'none', 'non-modal');
close(h)]]></example_item_data>
    </example_item>
  </examples>
