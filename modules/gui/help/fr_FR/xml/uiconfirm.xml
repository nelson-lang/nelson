  <language>fr_FR</language>
  <keyword>uiconfirm</keyword>
  <short_description>Affiche une boite de confirmation pour une figure UI.</short_description>
  <syntax>
    <syntax_item>selection = uiconfirm(parent, message, title)</syntax_item>
    <syntax_item>selection = uiconfirm(parent, message, title, Name, Value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>parent</param_name>
      <param_description>Handle de figure UI parent, generalement cree avec uifigure.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>message</param_name>
      <param_description>Texte de la question affichee dans la boite de confirmation.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>title</param_name>
      <param_description>Titre de la boite de dialogue.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Name, Value</param_name>
      <param_description>Paires optionnelles. 'Options' definit les libelles des boutons. 'DefaultOption' definit l'option selectionnee initialement.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>selection</param_name>
      <param_description>Texte de l'option selectionnee, ou vecteur de caracteres vide si la boite est fermee.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>uiconfirm affiche une boite de confirmation et retourne le texte du bouton selectionne.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Apercu rendu pour l'image d'aide.</example_item_description>
      <example_item_data><![CDATA[f = figure('Name', 'Confirm preview', 'Position', [100 100 420 260], 'Color', [1 1 1]);
axis([0 1 0 1]); axis off; hold on;
patch([0.06 0.94 0.94 0.06], [0.12 0.12 0.88 0.88], [0.97 0.98 0.99], 'EdgeColor', [0.62 0.65 0.68]);

text(0.16, 0.78, 'Confirm', 'FontSize', 12, 'FontWeight', 'bold');
text(0.24, 0.56, 'Save changes before closing?', 'FontSize', 11);
patch([0.28 0.44 0.44 0.28], [0.25 0.25 0.36 0.36], [0.90 0.94 1.00], 'EdgeColor', [0.25 0.45 0.75]);
patch([0.54 0.70 0.70 0.54], [0.25 0.25 0.36 0.36], [0.95 0.95 0.95], 'EdgeColor', [0.55 0.55 0.55]);
text(0.36, 0.30, 'Yes', 'HorizontalAlignment', 'center', 'FontSize', 10);
text(0.62, 0.30, 'No', 'HorizontalAlignment', 'center', 'FontSize', 10);]]></example_item_data>
      <example_item_img
        src="../images/uiconfirm_example.svg"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Poser une question de confirmation simple.</example_item_description>
      <example_item_data><![CDATA[f = uifigure('Visible', 'off', 'Name', 'Close');
answer = uiconfirm(f, 'Close the window?', 'Confirm');
close(f);
disp(answer)]]></example_item_data>
    </example_item>
  </examples>
