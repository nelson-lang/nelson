  <!-- Build the gui frontend as part of the solution. `npm run build` bundles
       the frontend into the module-root dist (modules/gui/dist), the folder the
       desktop resolves from the module tree at runtime; its postbuild also
       mirrors it into the bin runtime trees. Without this, the exe links but the
       server has no index.html to serve. -->
  <ItemGroup>
    <GuiFrontendSources Include="$(MSBuildThisFileDirectory)..\ts\frontend\src\**\*" />
    <GuiFrontendSources Include="$(MSBuildThisFileDirectory)..\ts\frontend\scripts\**\*" />
    <GuiFrontendSources Include="$(MSBuildThisFileDirectory)..\ts\frontend\index.html" />
    <GuiFrontendSources Include="$(MSBuildThisFileDirectory)..\ts\frontend\package.json" />
    <GuiFrontendSources Include="$(MSBuildThisFileDirectory)..\ts\frontend\vite.config.ts" />
    <GuiFrontendSources Include="$(MSBuildThisFileDirectory)..\ts\frontend\vite.replayer.config.ts" />
    <GuiFrontendSources Include="$(MSBuildThisFileDirectory)..\ts\frontend\tsconfig.json" />
    <GuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\..\web_engine\frontend\examples\*" />
  </ItemGroup>
  <Target Name="GuiNpmInstall" Condition="Exists('$(MSBuildThisFileDirectory)..\ts\frontend\package.json') And !Exists('$(MSBuildThisFileDirectory)..\ts\frontend\node_modules')">
    <Message Importance="high" Text="Installing npm deps for gui frontend..." />
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildThisFileDirectory)..\ts\frontend" />
  </Target>
  <Target Name="GuiDistBuild" AfterTargets="Build" DependsOnTargets="GuiNpmInstall" Condition="Exists('$(MSBuildThisFileDirectory)..\ts\frontend\package.json')" Inputs="@(GuiFrontendSources)" Outputs="$(MSBuildThisFileDirectory)..\..\dist\index.html;$(MSBuildThisFileDirectory)..\..\dist-replayer\nelson-figure-replayer.js">
    <Message Importance="high" Text="Building gui frontend (npm run build)..." />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)..\ts\frontend" />
    <Exec Command="npm run build:replayer" WorkingDirectory="$(MSBuildThisFileDirectory)..\ts\frontend" />
  </Target>
</Project>
