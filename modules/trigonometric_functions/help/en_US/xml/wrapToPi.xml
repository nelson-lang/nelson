  <language>en_US</language>
  <keyword>wrapToPi</keyword>
  <short_description>Wrap angle in radians to [-pi, pi].</short_description>
  <syntax>
    <syntax_item>beta = wrapToPi(alpha)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>angle in radians: scalar, vector or matrix.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>beta</param_name>
      <param_description>wrapped angle in radians, in [-pi, pi].</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>wrapToPi(alpha)</b> wraps angles in radians to the interval <b>[-pi, pi]</b>. Positive multiples of pi map to pi, negative multiples map to -pi.</p>
  </description>
