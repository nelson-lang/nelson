  <language>en_US</language>
  <keyword>wrapTo360</keyword>
  <short_description>Wrap angle in degrees to [0, 360].</short_description>
  <syntax>
    <syntax_item>beta = wrapTo360(alpha)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>angle in degrees: scalar, vector or matrix.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>beta</param_name>
      <param_description>wrapped angle in degrees, in [0, 360].</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>wrapTo360(alpha)</b> wraps angles in degrees to the interval <b>[0, 360]</b>. Positive multiples of 360 map to 360, and zero maps to 0.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[wrapTo360([-10 370 720])]]></example_item_data>
    </example_item>
  </examples>
