  <language>en_US</language>
  <keyword>wrapTo180</keyword>
  <short_description>Wrap angle in degrees to [-180, 180].</short_description>
  <syntax>
    <syntax_item>beta = wrapTo180(alpha)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>angle in degrees: scalar, vector or matrix.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>beta</param_name>
      <param_description>wrapped angle in degrees, in [-180, 180].</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>wrapTo180(alpha)</b> wraps angles in degrees to the interval <b>[-180, 180]</b>. Positive multiples of 180 map to 180, negative multiples map to -180.</p>
  </description>
  <used_function />
