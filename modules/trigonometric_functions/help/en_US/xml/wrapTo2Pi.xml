  <language>en_US</language>
  <keyword>wrapTo2Pi</keyword>
  <short_description>Wrap angle in radians to [0, 2*pi].</short_description>
  <syntax>
    <syntax_item>beta = wrapTo2Pi(alpha)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>alpha</param_name>
      <param_description>angle in radians: scalar, vector or matrix.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>beta</param_name>
      <param_description>wrapped angle in radians, in [0, 2*pi].</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>wrapTo2Pi(alpha)</b> wraps angles in radians to the interval <b>[0, 2*pi]</b>. Positive multiples of 2*pi map to 2*pi, and zero maps to 0.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
