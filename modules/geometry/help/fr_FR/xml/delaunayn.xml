  <language>fr_FR</language>
  <keyword>delaunayn</keyword>
  <short_description>Triangulation de Delaunay en N dimensions</short_description>
  <syntax>
    <syntax_item>T = delaunayn(P)</syntax_item>
    <syntax_item>T = delaunayn(P, options)</syntax_item>
  </syntax>
  <description>
    <p><b>delaunayn</b> calcule une triangulation de Delaunay pour les points de <b>P</b>.</p>
    <p>Les lignes de <b>T</b> contiennent des indices a partir de un dans <b>P</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Triangulation de Delaunay de points plans.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[P = [0 0; 1 0; 1 1; 0 1; 0.4 0.6];
T = delaunayn(P)]]></example_item_data>
    </example_item>
  </examples>
