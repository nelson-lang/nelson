  <language>fr_FR</language>
  <keyword>alphaShape</keyword>
  <short_description>Objet alpha shape</short_description>
  <syntax>
    <syntax_item>SHP = alphaShape(P)</syntax_item>
    <syntax_item>SHP = alphaShape(x, y)</syntax_item>
    <syntax_item>SHP = alphaShape(x, y, z)</syntax_item>
    <syntax_item>SHP = alphaShape(..., alpha)</syntax_item>
    <syntax_item>SHP = alphaShape(..., 'HoleThreshold', value, 'RegionThreshold', value)</syntax_item>
    <syntax_item>K = boundaryFacets(SHP)</syntax_item>
    <syntax_item>A = area(SHP)</syntax_item>
    <syntax_item>plot(SHP)</syntax_item>
  </syntax>
  <description>
    <p><b>alphaShape</b> stocke des points et parametres alpha pour les requetes de frontiere et de forme.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Creer et tracer un alpha shape.</example_item_description>
      <example_item_data runnable="gui"><![CDATA[P = [0 0; 1 0; 1 1; 0 1; 0.4 0.6];
SHP = alphaShape(P);
A = area(SHP);
plot(SHP)]]></example_item_data>
    </example_item>
  </examples>
