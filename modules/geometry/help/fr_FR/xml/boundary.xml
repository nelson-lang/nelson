  <language>fr_FR</language>
  <keyword>boundary</keyword>
  <short_description>Facettes frontiere d'un ensemble de points</short_description>
  <syntax>
    <syntax_item>K = boundary(P)</syntax_item>
    <syntax_item>K = boundary(x, y)</syntax_item>
    <syntax_item>K = boundary(x, y, z)</syntax_item>
    <syntax_item>K = boundary(..., s)</syntax_item>
    <syntax_item>[K, A] = boundary(x, y)</syntax_item>
    <syntax_item>boundary(P)</syntax_item>
  </syntax>
  <description>
    <p><b>boundary</b> retourne les facettes frontiere de points plans ou spatiaux.</p>
    <p>Sans sortie, la fonction trace la frontiere.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Calculer et tracer la frontiere de points plans.</example_item_description>
      <example_item_data runnable="gui"><![CDATA[P = [0 0; 1 0; 1 1; 0 1; 0.4 0.6];
K = boundary(P);
boundary(P)]]></example_item_data>
    </example_item>
  </examples>
