  <language>fr_FR</language>
  <keyword>triangulation</keyword>
  <short_description>Objet de triangulation</short_description>
  <syntax>
    <syntax_item>TR = triangulation(T, P)</syntax_item>
    <syntax_item>TR = triangulation(T, x, y)</syntax_item>
    <syntax_item>TR = triangulation(T, x, y, z)</syntax_item>
    <syntax_item>E = edges(TR)</syntax_item>
    <syntax_item>[idx, bary] = pointLocation(TR, Q)</syntax_item>
  </syntax>
  <description>
    <p><b>triangulation</b> stocke des points et une liste de connectivite et fournit des requetes topologiques.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Creer une triangulation et localiser un point.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[P = [0 0; 1 0; 1 1; 0 1];
T = delaunayn(P);
TR = triangulation(T, P);
[idx, bary] = pointLocation(TR, [0.25 0.25])]]></example_item_data>
    </example_item>
  </examples>
