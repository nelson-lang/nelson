  <language>fr_FR</language>
  <keyword>delaunay</keyword>
  <short_description>Triangulation de Delaunay de points 2-D ou 3-D</short_description>
  <syntax>
    <syntax_item>T = delaunay(P)</syntax_item>
    <syntax_item>T = delaunay(x, y)</syntax_item>
    <syntax_item>T = delaunay(x, y, z)</syntax_item>
  </syntax>
  <description>
    <p><b>delaunay</b> calcule une triangulation de Delaunay à partir de vecteurs de coordonnées ou d'une matrice de points.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Tracer les triangles de Delaunay de points plans aléatoires.</example_item_description>
      <example_item_data runnable="gui"><![CDATA[rng default;
x = rand([20, 1]);
y = rand([20, 1]);
DT = delaunay(x, y);
triplot(DT, x, y)]]></example_item_data>
      <example_item_img
        src="../images/delaunay.svg"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
