  <language>en_US</language>
  <keyword>convhulln</keyword>
  <short_description>Convex hull in N dimensions</short_description>
  <syntax>
    <syntax_item>K = convhulln(P)</syntax_item>
    <syntax_item>[K, V] = convhulln(P)</syntax_item>
    <syntax_item>K = convhulln(P, options)</syntax_item>
  </syntax>
  <description>
    <p><b>convhulln</b> computes the convex hull facets of the point matrix <b>P</b>.</p>
    <p>Rows of <b>K</b> contain one-based point indices. The second output is the enclosed measure reported for the hull.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Convex hull of a square.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[P = [0 0; 1 0; 1 1; 0 1];
[K, A] = convhulln(P)]]></example_item_data>
    </example_item>
  </examples>
