  <keyword>nsidedpoly</keyword>
  <short_description>Create a regular polygon.</short_description>
  <syntax>
    <syntax_item>pg = nsidedpoly(n)</syntax_item>
    <syntax_item>pg = nsidedpoly(n, 'Center', c)</syntax_item>
    <syntax_item>pg = nsidedpoly(n, 'Radius', r)</syntax_item>
    <syntax_item>pg = nsidedpoly(n, 'SideLength', s)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>n</param_name><param_description>the number of sides (an integer &gt;= 3).</param_description></param_input_item>
    <param_input_item><param_name>'Center'</param_name><param_description>a two-element center [x y] (default [0 0]).</param_description></param_input_item>
    <param_input_item><param_name>'Radius'</param_name><param_description>the circumscribed-circle radius.</param_description></param_input_item>
    <param_input_item><param_name>'SideLength'</param_name><param_description>the length of each side.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>pg</param_name><param_description>a polyshape of the regular polygon.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>nsidedpoly</b> returns a regular <b>n</b>-sided polygon as a
      <b>polyshape</b>. Without a radius or side length, the polygon has unit
      area.</p>
  </description>
  <used_function />
