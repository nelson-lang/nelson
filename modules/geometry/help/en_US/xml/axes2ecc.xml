  <keyword>axes2ecc</keyword>
  <short_description>Eccentricity of an ellipse from its semi-axes.</short_description>
  <syntax>
    <syntax_item>eccentricity = axes2ecc(semimajor, semiminor)</syntax_item>
    <syntax_item>eccentricity = axes2ecc(axesVector)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>semimajor</param_name>
      <param_description>the semimajor axis length.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>semiminor</param_name>
      <param_description>the semiminor axis length.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>axesVector</param_name>
      <param_description
      >a single input: a two-element vector [semimajor, semiminor] or a two-column matrix (one ellipse per row).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>eccentricity</param_name>
      <param_description>the eccentricity of the ellipse.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>axes2ecc</b> returns the eccentricity of an ellipse from its semimajor
      and semiminor axes, as
      <b>sqrt(1 - (semiminor / semimajor)^2)</b>. A circle (equal axes) has a
      zero eccentricity. The computation is vectorised over the inputs.</p>
  </description>
  <used_function />
