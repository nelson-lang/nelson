  <language>en_US</language>
  <keyword>delaunay</keyword>
  <short_description>Delaunay triangulation of 2-D or 3-D points</short_description>
  <syntax>
    <syntax_item>T = delaunay(P)</syntax_item>
    <syntax_item>T = delaunay(x, y)</syntax_item>
    <syntax_item>T = delaunay(x, y, z)</syntax_item>
  </syntax>
  <description>
    <p><b>delaunay</b> computes a Delaunay triangulation from coordinate vectors or a point matrix.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Plot Delaunay triangles of random planar points.</example_item_description>
      <example_item_data runnable="gui"><![CDATA[rng default;
x = rand([20, 1]);
y = rand([20, 1]);
DT = delaunay(x, y);
triplot(DT, x, y)]]></example_item_data>
    </example_item>
  </examples>
