  <language>en_US</language>
  <keyword>tsearchn</keyword>
  <short_description>Point location in a triangulation</short_description>
  <syntax>
    <syntax_item>idx = tsearchn(P, T, Q)</syntax_item>
    <syntax_item>[idx, bary] = tsearchn(P, T, Q)</syntax_item>
  </syntax>
  <description>
    <p><b>tsearchn</b> finds the simplex containing each query point.</p>
    <p>Points outside the triangulation return <b>NaN</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Find the containing triangle and barycentric coordinates.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[P = [0 0; 1 0; 1 1; 0 1];
T = delaunayn(P);
[idx, bary] = tsearchn(P, T, [0.25 0.25])]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${geometry}dsearchn">dsearchn</link></see_also_item>
    <see_also_item><link linkend="${geometry}delaunayn">delaunayn</link></see_also_item>
  </see_also>
