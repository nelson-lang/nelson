  <language>en_US</language>
  <keyword>inpolygon</keyword>
  <short_description>Points inside or on the edge of a polygon.</short_description>
  <syntax>
    <syntax_item>in = inpolygon(xq, yq, xv, yv)</syntax_item>
    <syntax_item>[in, on] = inpolygon(xq, yq, xv, yv)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>xq, yq</param_name>
      <param_description>coordinates of the query points: arrays of the same size.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>xv, yv</param_name>
      <param_description>polygon vertices. <b>NaN</b> separates several loops.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>in</param_name>
      <param_description>logical array: <b>true</b> for points inside or on the edge.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>on</param_name>
      <param_description>logical array: <b>true</b> for points on the edge.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>[in, on] = inpolygon(xq, yq, xv, yv)</b> tests each query point against the polygon. The polygon is closed automatically.</p>
    <p>Loops separated by <b>NaN</b> are combined with the even-odd rule, so a loop inside another one makes a hole.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[xv = [0 1 1 0];
yv = [0 0 1 1];
[in, on] = inpolygon([0.5 2 1], [0.5 2 0.5], xv, yv)]]></example_item_data>
    </example_item>
  </examples>
