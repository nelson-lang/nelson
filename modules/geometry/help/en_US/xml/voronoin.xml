  <language>en_US</language>
  <keyword>voronoin</keyword>
  <short_description>Voronoi diagram in N dimensions</short_description>
  <syntax>
    <syntax_item>[V, C] = voronoin(P)</syntax_item>
    <syntax_item>[V, C] = voronoin(P, options)</syntax_item>
  </syntax>
  <description>
    <p><b>voronoin</b> computes Voronoi vertices and cells for the input points.</p>
    <p><b>V</b> contains vertices and <b>C</b> is a cell array of one-based vertex indices.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Voronoi vertices and cells of planar points.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[P = [0 0; 1 0; 1 1; 0 1];
[V, C] = voronoin(P)]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${geometry}voronoi">voronoi</link></see_also_item>
    <see_also_item><link linkend="${geometry}delaunayn">delaunayn</link></see_also_item>
  </see_also>
