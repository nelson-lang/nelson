  <language>en_US</language>
  <keyword>dsearchn</keyword>
  <short_description>Nearest point search</short_description>
  <syntax>
    <syntax_item>idx = dsearchn(P, Q)</syntax_item>
    <syntax_item>[idx, dist] = dsearchn(P, Q)</syntax_item>
    <syntax_item>idx = dsearchn(P, T, Q)</syntax_item>
    <syntax_item>idx = dsearchn(P, T, Q, outind)</syntax_item>
  </syntax>
  <description>
    <p><b>dsearchn</b> returns the nearest point in <b>P</b> for each query point.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Nearest point and distance.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[P = [0 0; 1 0; 1 1; 0 1];
[idx, dist] = dsearchn(P, [0.2 0.1])]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${geometry}tsearchn">tsearchn</link></see_also_item>
    <see_also_item><link linkend="${geometry}triangulation">triangulation</link></see_also_item>
  </see_also>
