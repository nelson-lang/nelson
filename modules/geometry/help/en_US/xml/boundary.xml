  <language>en_US</language>
  <keyword>boundary</keyword>
  <short_description>Boundary facets of a set of points</short_description>
  <syntax>
    <syntax_item>K = boundary(P)</syntax_item>
    <syntax_item>K = boundary(x, y)</syntax_item>
    <syntax_item>K = boundary(x, y, z)</syntax_item>
    <syntax_item>K = boundary(..., s)</syntax_item>
    <syntax_item>[K, A] = boundary(x, y)</syntax_item>
    <syntax_item>boundary(P)</syntax_item>
  </syntax>
  <description>
    <p><b>boundary</b> returns boundary facets for planar or spatial points.</p>
    <p>When called without output, it plots the boundary.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Compute and plot the boundary of planar points.</example_item_description>
      <example_item_data runnable="gui"><![CDATA[P = [0 0; 1 0; 1 1; 0 1; 0.4 0.6];
K = boundary(P);
boundary(P)]]></example_item_data>
    </example_item>
  </examples>
