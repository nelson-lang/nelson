  <language>en_US</language>
  <keyword>polyshape</keyword>
  <short_description>Create a polygon.</short_description>
  <syntax>
    <syntax_item>pg = polyshape(x, y)</syntax_item>
    <syntax_item>pg = polyshape(P)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>x, y</param_name><param_description>vectors of the polygon vertex coordinates.</param_description></param_input_item>
    <param_input_item><param_name>P</param_name><param_description>an N-by-2 matrix of vertices [x y].</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>pg</param_name><param_description>a polyshape object.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>polyshape</b> creates a polygon from its vertices. The methods
      <b>area</b>, <b>perimeter</b> and <b>numsides</b> query it, <b>rotate</b>
      and <b>translate</b> transform it, and <b>plot</b> draws it as a filled
      patch (accepting patch name-value properties). <b>rotate(pg, theta)</b>
      turns the polygon counterclockwise by <b>theta</b> degrees about the
      origin, or about a reference point given as a third argument;
      <b>translate(pg, [dx dy])</b> shifts it.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
pg = polyshape([0 1 1 0], [0 0 1 1]);
plot(pg, 'FaceColor', 'r');
area(pg)]]></example_item_data>
    </example_item>
  </examples>
