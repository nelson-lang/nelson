  <language>en_US</language>
  <keyword>structfun</keyword>
  <short_description>Apply a function to each field of a scalar structure.</short_description>
  <syntax>
    <syntax_item>B = structfun(fun, S)</syntax_item>
    <syntax_item>B = structfun(fun, S, 'UniformOutput', tf)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>fun</param_name>
      <param_description>function handle applied to each field value.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>S</param_name>
      <param_description>scalar structure.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>tf</param_name>
      <param_description>'UniformOutput' flag: true (default) or false.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>column vector (uniform output) or structure (non-uniform output).</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>structfun(fun, S)</b> applies <b>fun</b> to each field of the scalar structure <b>S</b> and returns the results as a column vector.</p>
    <p>With <b>'UniformOutput'</b> set to <b>false</b>, the results are returned in a structure with the same fields as <b>S</b>.</p>
  </description>
  <used_function />
