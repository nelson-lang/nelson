<xmldoc>
  <copyright>SAME AS NELSON SOFTWARE</copyright><language>en_US</language><keyword>mat2cell</keyword>
  <short_description>Split an array into a cell array.</short_description>
  <syntax><syntax_item>C = mat2cell(A, rowSizes)</syntax_item><syntax_item>C = mat2cell(A, rowSizes, colSizes, ...)</syntax_item></syntax>
  <param_input><param_input_item><param_name>A</param_name><param_description>Input array.</param_description></param_input_item><param_input_item><param_name>rowSizes</param_name><param_description>Block sizes for the first dimension.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>C</param_name><param_description>Cell array containing blocks of A.</param_description></param_output_item></param_output>
  <description><p><b>mat2cell</b> splits <b>A</b> into cells whose sizes are given for each dimension.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[C = mat2cell(reshape(1:12, [3 4]), [1 2], [3 1])]]></example_item_data></example_item></examples>
