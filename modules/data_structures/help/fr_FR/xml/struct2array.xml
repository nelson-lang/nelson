  <keyword>struct2array</keyword>
  <short_description>Concatène les valeurs des champs d&apos;une structure en un tableau.</short_description>
  <syntax>
    <syntax_item>a = struct2array(s)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>s</param_name>
      <param_description>une structure dont les valeurs de champs peuvent être concaténées.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>a</param_name>
      <param_description>la concaténation horizontale des valeurs des champs.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>a = struct2array(s)</b> renvoie la concaténation horizontale des valeurs des champs de <b>s</b>. Les valeurs doivent avoir des tailles et types compatibles.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[s.a = 1;
s.b = [2 3];
struct2array(s)]]></example_item_data>
    </example_item>
  </examples>
