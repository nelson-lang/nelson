  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
  <!-- Build the web_gui frontend (frontend/dist) as part of the solution.
       `npm run build` bundles the frontend into modules/web_gui/frontend/dist,
       the folder nelson-webview.exe resolves from the module tree at runtime.
       Without this, the exe links but the server has no index.html to serve. -->
  <ItemGroup>
    <WebGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\src\**\*" />
    <WebGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\scripts\**\*" />
    <WebGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\index.html" />
    <WebGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\package.json" />
    <WebGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\vite.config.ts" />
    <WebGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\tsconfig.json" />
    <WebGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\..\webview\frontend\examples\*" />
  </ItemGroup>
  <Target Name="WebGuiNpmInstall" Condition="Exists('$(MSBuildThisFileDirectory)..\..\frontend\package.json') And !Exists('$(MSBuildThisFileDirectory)..\..\frontend\node_modules')">
    <Message Importance="high" Text="Installing npm deps for web_gui frontend..." />
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\frontend" />
  </Target>
  <Target Name="WebGuiDistBuild" AfterTargets="Build" DependsOnTargets="WebGuiNpmInstall" Condition="Exists('$(MSBuildThisFileDirectory)..\..\frontend\package.json')" Inputs="@(WebGuiFrontendSources)" Outputs="$(MSBuildThisFileDirectory)..\..\frontend\dist\index.html">
    <Message Importance="high" Text="Building web_gui frontend (npm run build)..." />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\frontend" />
  </Target>
</Project>
