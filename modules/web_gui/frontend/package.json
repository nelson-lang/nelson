{
  "name": "nelson-webview-frontend",
  "version": "0.0.1",
  "private": true,
  "description": "Web-based desktop frontend for Nelson (React + xterm.js + Dockview).",
  "type": "module",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "watch": "tsc --noEmit --watch",
    "build": "npm run typecheck && vite build",
    "build:wasm": "npm run typecheck && vite build --config vite.wasm.config.ts",
    "postbuild": "node scripts/postbuild.mjs",
    "bundle": "npm run build",
    "build:release": "npm run build",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "coverage": "vitest run --config vitest.config.ts --coverage",
    "lint": "eslint src tests scripts",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\" \"tests/**/*.{ts,tsx,js,json,md}\" \"scripts/**/*.{js,mjs,cjs,ts,json,md}\" \"*.{ts,json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,md}\" \"tests/**/*.{ts,tsx,js,json,md}\" \"scripts/**/*.{js,mjs,cjs,ts,json,md}\" \"*.{ts,json,md}\"",
    "test:e2e": "playwright test",
    "test:e2e:wasm": "playwright test --config playwright.wasm.config.ts",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:b2b": "playwright test --config playwright.b2b.config.ts"
  },
  "dependencies": {
    "@blocknote/core": "0.55.0",
    "@blocknote/mantine": "0.55.0",
    "@blocknote/react": "0.55.0",
    "@mantine/core": "^8.3.11",
    "@mantine/hooks": "^8.3.11",
    "@monaco-editor/react": "^4.7.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dockview": "^4.9.0",
    "dompurify": "^3.4.12",
    "fflate": "^0.8.2",
    "katex": "^0.18.1",
    "monaco-editor": "^0.52.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/katex": "0.16.8",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "jsdom": "29.1.1",
    "prettier": "2.8.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
