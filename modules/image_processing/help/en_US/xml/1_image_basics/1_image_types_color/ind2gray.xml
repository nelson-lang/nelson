  <language>en_US</language>
  <keyword>ind2gray</keyword>
  <short_description>Convert indexed image to grayscale using a colormap.</short_description>
  <syntax>
    <syntax_item>I = ind2gray(X, map)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>Indexed image.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>map</param_name>
      <param_description>Colormap with at least three columns.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>I</param_name>
      <param_description>Double grayscale image obtained from the indexed RGB image.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Convert indexed image to grayscale using a colormap.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Convert indexed image to grayscale</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[X=repmat(uint8(0:63),64,1);
v=linspace(0,1,64)'; map=[v 1-v 0.5*ones(64,1)];
G=ind2gray(X,map);
figure; imagesc(G); g=linspace(0,1,64)'; colormap([g g g]); title('Indexed to gray');]]></example_item_data>
      <example_item_img
        src="../../../images/ind2gray_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
