  <language>en_US</language>
  <keyword>im2single</keyword>
  <short_description>Convert image to single precision.</short_description>
  <syntax>
    <syntax_item>J = im2single(I)</syntax_item>
    <syntax_item>J = im2single(I, 'indexed')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Input image.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'indexed'</param_name>
      <param_description>Optional mode for indexed images. uint8 and uint16 values are converted to one-based single indices.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>J</param_name>
      <param_description>Image converted to single precision.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Convert image to single precision.</p>
    <p>For indexed images, uint8 and uint16 inputs are offset by one in the single output.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Convert uint8 array to single precision</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=reshape(uint8(linspace(1,255,25)),[5 5]);
J=im2single(I);
figure; imagesc(J); g=linspace(0,1,64)'; colormap([g g g]); title('single image');]]></example_item_data>
      <example_item_img
        src="../../../images/im2single_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
