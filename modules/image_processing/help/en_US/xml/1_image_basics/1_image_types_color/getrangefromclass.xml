  <language>en_US</language>
  <keyword>getrangefromclass</keyword>
  <short_description>Default display range of an image class.</short_description>
  <syntax>
    <syntax_item>range = getrangefromclass(I)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>a numeric or logical image.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>range</param_name>
      <param_description>a 1-by-2 double vector.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>range = getrangefromclass(I)</b> returns <b>[0 1]</b> for double, single and logical images, and <b>[intmin intmax]</b> of the class for integer images.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[getrangefromclass(uint8(1))
getrangefromclass(int16(1))]]></example_item_data>
    </example_item>
  </examples>
