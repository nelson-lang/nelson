  <language>en_US</language>
  <keyword>im2uint16</keyword>
  <short_description>Convert image to 16-bit unsigned integer.</short_description>
  <syntax>
    <syntax_item>J = im2uint16(I)</syntax_item>
    <syntax_item>J = im2uint16(I, 'indexed')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Input image. Supported intensity classes are double, single, logical, uint8, uint16, and int16.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'indexed'</param_name>
      <param_description>Optional mode for indexed images. Floating-point inputs use one-based indices and integer inputs use zero-based indices.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>J</param_name>
      <param_description>Image converted to uint16.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Convert image to 16-bit unsigned integer.</p>
    <p>For indexed images, integer inputs are treated as zero-based indices and double inputs are treated as one-based indices.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Convert double array to uint16</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=reshape(linspace(0,1,20),[5 4]);
J=im2uint16(I);
figure; imagesc(J); g=linspace(0,1,64)'; colormap([g g g]); title('uint16 image');]]></example_item_data>
      <example_item_img
        src="../../../images/im2uint16_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
