  <language>en_US</language>
  <keyword>imbinarize</keyword>
  <short_description>Binarize image using a threshold.</short_description>
  <syntax>
    <syntax_item>BW = imbinarize(I)</syntax_item>
    <syntax_item>BW = imbinarize(I, T)</syntax_item>
    <syntax_item>BW = imbinarize(I, 'global')</syntax_item>
    <syntax_item>BW = imbinarize(I, 'adaptive')</syntax_item>
    <syntax_item>BW = imbinarize(__, 'Sensitivity', value)</syntax_item>
    <syntax_item>BW = imbinarize(__, 'ForegroundPolarity', polarity)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Input image.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>T</param_name>
      <param_description>Numeric threshold. It can be scalar or the same size as I.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>method</param_name>
      <param_description>Binarization method: 'global' or 'adaptive'.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'Sensitivity'</param_name>
      <param_description>Sensitivity passed to adaptive thresholding.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'ForegroundPolarity'</param_name>
      <param_description>Foreground polarity for adaptive thresholding: 'bright' or 'dark'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW</param_name>
      <param_description>Logical binary image.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Binarize image using a threshold. The global method uses graythresh when no threshold is supplied. A numeric threshold can be scalar or the same size as the input. The adaptive method uses adaptthresh and supports bright or dark foreground polarity.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Binarize a grayscale image using a global threshold</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=[0 0.25 0.75 1; 0.1 0.4 0.6 0.9];
BW=imbinarize(I,0.5);
figure; subplot(1,2,1); imagesc(I); g=linspace(0,1,64)'; colormap([g g g]); title('Input');
subplot(1,2,2); imagesc(BW); g=linspace(0,1,64)'; colormap([g g g]); title('Binary');]]></example_item_data>
      <example_item_img
        src="../../../images/imbinarize_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Binarize using an adaptive threshold</example_item_description>
      <example_item_data><![CDATA[I=[0.1 0.1 0.1; 0.1 0.9 0.1; 0.1 0.1 0.1];
BW=imbinarize(I,'adaptive','Sensitivity',0.4)]]></example_item_data>
    </example_item>
  </examples>
