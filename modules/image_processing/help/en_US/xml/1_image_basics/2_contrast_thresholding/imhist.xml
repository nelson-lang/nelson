  <language>en_US</language>
  <keyword>imhist</keyword>
  <short_description>Compute image histogram counts.</short_description>
  <syntax>
    <syntax_item>counts = imhist(I)</syntax_item>
    <syntax_item>[counts, binLocations] = imhist(I)</syntax_item>
    <syntax_item>[counts, binLocations] = imhist(I, n)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Input intensity or logical image.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>Positive integer number of histogram bins.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>counts</param_name>
      <param_description>Histogram counts as a column vector.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>binLocations</param_name>
      <param_description>Bin locations on the native image scale.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Compute image histogram counts. Bin locations use the native scale for integer images and the range [0, 1] for floating-point and logical images.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Display an image histogram</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=repmat(linspace(0,1,96),64,1);
[counts,bins]=imhist(I,32);
figure; bar(bins,counts); title('Histogram');]]></example_item_data>
      <example_item_img
        src="../../../images/imhist_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
