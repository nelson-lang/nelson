  <language>en_US</language>
  <keyword>sizesMatch</keyword>
  <short_description>Determine whether a spatial reference matches an image size.</short_description>
  <syntax>
    <syntax_item>tf = sizesMatch(R, image)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>R</param_name>
      <param_description>2-D or 3-D spatial reference structure created by imref2d or imref3d.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>image</param_name>
      <param_description>Image or volume array to compare with the spatial reference image size.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>Logical scalar true when the array size matches the spatial reference dimensions.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Compares the leading image dimensions with the ImageSize field of a 2-D or 3-D spatial reference.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Check whether an RGB image matches a 2-D reference</example_item_description>
      <example_item_data><![CDATA[R = imref2d([2 3], 2, 3);
tf = sizesMatch(R, zeros(2, 3, 3))]]></example_item_data>
    </example_item>
  </examples>
