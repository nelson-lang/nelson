  <keyword>worldToSubscript</keyword>
  <short_description>Convert world coordinates to image subscripts.</short_description>
  <syntax>
    <syntax_item>[row, column] = worldToSubscript(R, xWorld, yWorld)</syntax_item>
    <syntax_item>[row, column, plane] = worldToSubscript(R, xWorld, yWorld, zWorld)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>R</param_name>
      <param_description>2-D or 3-D spatial reference structure created by imref2d or imref3d.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>xWorld, yWorld, zWorld</param_name>
      <param_description>World coordinates. The Z coordinate is used only with 3-D references.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>row, column, plane</param_name>
      <param_description>Nearest image subscripts. Points outside the referenced image return NaN subscripts.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Converts world coordinates to nearest row, column, and optional plane subscripts.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Convert world coordinates to row and column subscripts</example_item_description>
      <example_item_data><![CDATA[R = imref2d([2 3], 2, 3);
[row, column] = worldToSubscript(R, [2 8], [3 6])]]></example_item_data>
    </example_item>
  </examples>
