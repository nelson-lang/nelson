  <keyword>worldToIntrinsic</keyword>
  <short_description>Convert world coordinates to intrinsic image coordinates.</short_description>
  <syntax>
    <syntax_item>[xIntrinsic, yIntrinsic] = worldToIntrinsic(R, xWorld, yWorld)</syntax_item>
    <syntax_item>[xIntrinsic, yIntrinsic, zIntrinsic] = worldToIntrinsic(R, xWorld, yWorld, zWorld)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>R</param_name>
      <param_description>2-D or 3-D spatial reference structure created by imref2d or imref3d.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>xWorld, yWorld, zWorld</param_name>
      <param_description>World coordinates. The Z coordinate is used only with 3-D references.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>xIntrinsic, yIntrinsic, zIntrinsic</param_name>
      <param_description>Intrinsic coordinates corresponding to the world coordinates.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Maps world coordinates to intrinsic coordinates. Coordinates outside the world limits are extrapolated.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Convert 2-D world coordinates</example_item_description>
      <example_item_data><![CDATA[R = imref2d([2 3], 2, 3);
[xIntrinsic, yIntrinsic] = worldToIntrinsic(R, [2 6], [3 6])]]></example_item_data>
    </example_item>
  </examples>
