  <language>en_US</language>
  <keyword>image_registration</keyword>
  <short_description>Image registration task overview.</short_description>
  <description>
    <p>Image registration aligns a moving image with a fixed image by estimating a geometric transform and resampling the moving image on the target grid.</p>
    <p>Use <b>imregconfig</b> to create registration settings, <b>imregcorr</b> for phase-correlation based estimates, <b>imregtform</b> to estimate a transform, <b>imregister</b> for direct registration, and <b>imwarp</b> to apply transforms explicitly.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Register a translated image.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[I = zeros(32, 32);
I(10:18, 12:20) = 1;
J = imtranslate(I, [3 -2]);
[optimizer, metric] = imregconfig('monomodal');
K = imregister(I, J, 'translation', optimizer, metric, 'Interpolation', 'nearest');]]></example_item_data>
    </example_item>
  </examples>
