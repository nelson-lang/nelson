  <language>en_US</language>
  <keyword>labelmatrix</keyword>
  <short_description>Create label matrix from connected components.</short_description>
  <syntax>
    <syntax_item>L = labelmatrix(CC)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>CC</param_name>
      <param_description>Connected-component structure returned by bwconncomp.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>L</param_name>
      <param_description>Label matrix with one positive label per component.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create label matrix from connected components.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Display connected component labels</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[BW=false(64,64); BW(8:20,8:20)=true; BW(36:52,32:48)=true;
CC=bwconncomp(BW);
L=labelmatrix(CC);
figure; imagesc(L); title('Label matrix');]]></example_item_data>
      <example_item_img
        src="../../../images/labelmatrix_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
