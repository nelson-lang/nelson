  <language>en_US</language>
  <keyword>bwselect</keyword>
  <short_description>Select connected binary objects.</short_description>
  <syntax>
    <syntax_item>BW2 = bwselect(BW, c, r)</syntax_item>
    <syntax_item>BW2 = bwselect(BW, c, r, conn)</syntax_item>
    <syntax_item>[BW2, idx] = bwselect(BW, c, r, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>BW</param_name>
      <param_description>Input binary image. Nonzero values are treated as true.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>c</param_name>
      <param_description>Column coordinates of query points.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>r</param_name>
      <param_description>Row coordinates of query points.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivity, either 4 or 8.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW2</param_name>
      <param_description>Logical image containing selected connected components.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>idx</param_name>
      <param_description>Linear indices of true pixels in BW2.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Select connected components in a 2-D binary image that contain at least one query point. Coordinates are passed as columns c and rows r. Supported connectivities are 4 and 8.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Select one object from a binary image</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[BW=false(64,64); BW(10:26,8:24)=true; BW(36:56,38:58)=true;
BW2=bwselect(BW, 16, 18, 8);
figure; subplot(1,2,1); imagesc(BW); title('Input');
subplot(1,2,2); imagesc(BW2); title('Selected');]]></example_item_data>
      <example_item_img
        src="../../../images/bwselect_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
