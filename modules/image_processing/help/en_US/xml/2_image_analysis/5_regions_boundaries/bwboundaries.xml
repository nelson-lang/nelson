  <language>en_US</language>
  <keyword>bwboundaries</keyword>
  <short_description>Find boundary pixels of binary regions.</short_description>
  <syntax>
    <syntax_item>B = bwboundaries(BW)</syntax_item>
    <syntax_item>B = bwboundaries(BW, conn)</syntax_item>
    <syntax_item>[B, L, n] = bwboundaries(BW, conn, option)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>BW</param_name>
      <param_description>Input binary image. Nonzero values are treated as true.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivity, either 4 or 8.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>option</param_name>
      <param_description>Boundary option: 'holes' or 'noholes'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>Cell array of boundary coordinate matrices.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>L</param_name>
      <param_description>Label matrix for foreground components.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>n</param_name>
      <param_description>Number of foreground components.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Find perimeter coordinates of connected binary regions. Supported connectivities are 4 and 8. The option 'holes' appends boundaries of filled holes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Display boundaries of binary regions</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[BW=false(64,64); BW(10:28,10:30)=true; BW(36:54,38:56)=true;
B=bwboundaries(BW);
figure; imagesc(BW); hold on;
for k=1:length(B), plot(B{k}(:,2), B{k}(:,1), 'r.'); end
title('Boundaries');]]></example_item_data>
      <example_item_img
        src="../../../images/bwboundaries_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
