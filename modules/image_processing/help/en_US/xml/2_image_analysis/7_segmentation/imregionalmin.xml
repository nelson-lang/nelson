  <language>en_US</language>
  <keyword>imregionalmin</keyword>
  <short_description>Find regional minima in a 2-D image.</short_description>
  <syntax>
    <syntax_item>BW = imregionalmin(I)</syntax_item>
    <syntax_item>BW = imregionalmin(I, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Input finite real 2-D image.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivity, either 4, 8, or an equivalent 3-by-3 matrix.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW</param_name>
      <param_description>Logical mask whose true pixels belong to regional minima.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>imregionalmin marks connected flat zones that have no lower-valued neighbor under the selected connectivity. It is useful for inspecting natural markers before watershed segmentation.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Find regional minima</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=[2 2 2;2 1 1;2 1 1];
BW=imregionalmin(I);
figure; subplot(1,2,1); imagesc(I); title('Image');
subplot(1,2,2); imagesc(BW); title('Regional minima');]]></example_item_data>
      <example_item_img
        src="../../../images/imregionalmin_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
