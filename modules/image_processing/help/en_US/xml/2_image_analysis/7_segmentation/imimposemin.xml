  <language>en_US</language>
  <keyword>imimposemin</keyword>
  <short_description>Impose regional minima at marker pixels.</short_description>
  <syntax>
    <syntax_item>J = imimposemin(I, BW)</syntax_item>
    <syntax_item>J = imimposemin(I, BW, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Input finite real 2-D image.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>BW</param_name>
      <param_description>Binary marker mask with the same size as I.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivity, either 4, 8, or an equivalent 3-by-3 matrix.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>J</param_name>
      <param_description>Image whose marker pixels are forced to be minima.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>imimposemin modifies an image so that marker pixels become the lowest minima. This is useful before watershed segmentation when known markers should seed catchment basins.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Use markers before watershed</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=[5 4 5;4 3 4;5 4 5];
markers=false(3,3); markers(1,1)=true;
J=imimposemin(I,markers);
L=watershed(J,4);
figure; subplot(1,3,1); imagesc(I); title('Input');
subplot(1,3,2); imagesc(J); title('Imposed');
subplot(1,3,3); imagesc(L); title('Watershed');]]></example_item_data>
      <example_item_img
        src="../../../images/imimposemin_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
