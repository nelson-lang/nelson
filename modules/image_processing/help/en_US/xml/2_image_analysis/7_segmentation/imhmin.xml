  <language>en_US</language>
  <keyword>imhmin</keyword>
  <short_description>Suppress shallow minima using the h-minima transform.</short_description>
  <syntax>
    <syntax_item>J = imhmin(I, h)</syntax_item>
    <syntax_item>J = imhmin(I, h, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Input finite real 2-D image.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>h</param_name>
      <param_description>Nonnegative finite height used to suppress shallow minima.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivity, either 4, 8, or an equivalent 3-by-3 matrix.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>J</param_name>
      <param_description>Image after h-minima suppression.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>imhmin computes the h-minima transform by grayscale reconstruction by erosion of I+h under I. It is useful for suppressing shallow minima before marker extraction or watershed segmentation.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Suppress a shallow minimum</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=[5 5 5;5 2 5;5 5 5];
J=imhmin(I,2);
figure; subplot(1,2,1); imagesc(I); title('Input');
subplot(1,2,2); imagesc(J); title('h-minima');]]></example_item_data>
      <example_item_img
        src="../../../images/imhmin_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
