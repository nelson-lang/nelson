  <language>en_US</language>
  <keyword>imextendedmax</keyword>
  <short_description>Find extended maxima in a 2-D image.</short_description>
  <syntax>
    <syntax_item>BW = imextendedmax(I, h)</syntax_item>
    <syntax_item>BW = imextendedmax(I, h, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Input finite real 2-D image.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>h</param_name>
      <param_description>Nonnegative finite height for the h-maxima transform.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivity, either 4, 8, or an equivalent 3-by-3 matrix.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW</param_name>
      <param_description>Logical mask of regional maxima after h-maxima suppression.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>imextendedmax applies imhmax and then finds regional maxima. It helps build marker masks that ignore maxima shallower than h.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Find extended maxima</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=[1 1 1 1 1;1 5 1 4 1;1 1 1 1 1];
BW=imextendedmax(I,2);
figure; subplot(1,2,1); imagesc(I); title('Image');
subplot(1,2,2); imagesc(BW); title('Extended maxima');]]></example_item_data>
      <example_item_img
        src="../../../images/imextendedmax_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
