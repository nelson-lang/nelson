  <language>en_US</language>
  <keyword>imtophat</keyword>
  <short_description>Top-hat filtering of an image.</short_description>
  <syntax>
    <syntax_item>J = imtophat(I, SE)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Input grayscale image.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>SE</param_name>
      <param_description>Structuring element structure or logical neighborhood.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>J</param_name>
      <param_description>Top-hat filtered image.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Top-hat filtering of an image.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Apply top-hat filtering</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=zeros(64,64); I(20:44,20:44)=0.4; I(30:34,30:34)=1;
J=imtophat(I,strel('disk',5));
figure; subplot(1,2,1); imagesc(I); g=linspace(0,1,64)'; colormap([g g g]); title('Input');
subplot(1,2,2); imagesc(J); g=linspace(0,1,64)'; colormap([g g g]); title('Top-hat');]]></example_item_data>
      <example_item_img
        src="../../../images/imtophat_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
