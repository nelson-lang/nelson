  <language>en_US</language>
  <keyword>imfill</keyword>
  <short_description>Fill holes in binary images.</short_description>
  <syntax>
    <syntax_item>BW2 = imfill(BW)</syntax_item>
    <syntax_item>BW2 = imfill(BW, 'holes')</syntax_item>
    <syntax_item>BW2 = imfill(BW, conn, 'holes')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>BW</param_name>
      <param_description>Input binary image. Nonzero values are treated as true.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivity, either 4 or 8.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'holes'</param_name>
      <param_description>Fill holes in foreground objects.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW2</param_name>
      <param_description>Logical image with holes filled.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Fill holes in a 2-D binary image. Supported connectivities are 4 and 8.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Fill a hole in a binary object</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[BW=false(64,64); BW(12:52,12:52)=true; BW(24:40,24:40)=false;
BW2=imfill(BW,'holes');
figure; subplot(1,2,1); imagesc(BW); title('Input');
subplot(1,2,2); imagesc(BW2); title('Filled');]]></example_item_data>
      <example_item_img
        src="../../../images/imfill_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
