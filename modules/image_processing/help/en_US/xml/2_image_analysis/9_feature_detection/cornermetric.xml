  <language>en_US</language>
  <keyword>cornermetric</keyword>
  <short_description>Compute a corner strength metric.</short_description>
  <syntax>
    <syntax_item>C = cornermetric(I)</syntax_item>
    <syntax_item>C = cornermetric(I, method)</syntax_item>
    <syntax_item>C = cornermetric(..., Name, Value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Input grayscale or RGB image.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>method</param_name>
      <param_description>Corner metric method: Harris or Minimum Eigenvalue.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>C</param_name>
      <param_description>Corner metric image.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>cornermetric computes a 2-D corner response from image gradients smoothed by a Gaussian window. Supported name-value options are FilterSize and SensitivityFactor.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Display a Harris corner metric</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=zeros(64,64); I(18:46,18:46)=1;
C=cornermetric(I);
figure; subplot(1,2,1); imagesc(I); axis image; title('Image');
subplot(1,2,2); imagesc(C); axis image; title('Corner metric');]]></example_item_data>
      <example_item_img
        src="../../../images/cornermetric_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
