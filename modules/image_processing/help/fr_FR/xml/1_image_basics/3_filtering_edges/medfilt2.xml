  <language>fr_FR</language>
  <keyword>medfilt2</keyword>
  <short_description>Applique un filtrage median 2D.</short_description>
  <syntax>
    <syntax_item>B = medfilt2(A)</syntax_item>
    <syntax_item>B = medfilt2(A, [m n])</syntax_item>
    <syntax_item>B = medfilt2(A, [m n], padopt)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Image 2-D numerique ou logique.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>[m n]</param_name>
      <param_description>Scalaire entier positif ou taille de voisinage a deux elements. La valeur par defaut est [3 3].</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>padopt</param_name>
      <param_description>Option de padding : zeros, indexed, symmetric ou replicate.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>Image filtree par mediane, avec preservation de la classe d'entree.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Applique un filtrage median 2D. Le padding par defaut utilise des zeros. Les options de padding incluent zeros, indexed, symmetric et replicate. Les options textuelles sont insensibles a la casse.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Appliquer un filtrage median</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=peaks(64);
I(16:4:48,16:4:48)=8;
J=medfilt2(I,[3 3]);
figure; subplot(1,2,1); imagesc(I); title('Input');
subplot(1,2,2); imagesc(J); title('Median filtered');]]></example_item_data>
      <example_item_img
        src="../../../images/medfilt2_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
