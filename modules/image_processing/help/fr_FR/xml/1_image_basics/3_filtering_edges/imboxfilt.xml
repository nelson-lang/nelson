  <language>fr_FR</language>
  <keyword>imboxfilt</keyword>
  <short_description>Applique un filtrage par moyenne locale.</short_description>
  <syntax>
    <syntax_item>B = imboxfilt(A)</syntax_item>
    <syntax_item>B = imboxfilt(A, filterSize)</syntax_item>
    <syntax_item>B = imboxfilt(__, 'Padding', pad)</syntax_item>
    <syntax_item>B = imboxfilt(__, 'NormalizationFactor', factor)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Image 2-D numérique/logique ou image RGB.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>filterSize</param_name>
      <param_description>Scalaire entier positif ou vecteur à deux éléments. La valeur par défaut est [3 3].</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'Padding'</param_name>
      <param_description>Méthode de padding ou valeur scalaire finie de remplissage transmise à imfilter. La valeur par défaut est replicate.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'NormalizationFactor'</param_name>
      <param_description>Scalaire numérique fini multiplié par le noyau de moyenne locale. La valeur par défaut calcule une moyenne locale.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>Image filtrée par moyenne locale.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Applique un filtrage par moyenne locale. FilterSize doit contenir des entiers positifs. Par défaut, le filtre calcule une moyenne locale avec un padding par réplication. Utiliser NormalizationFactor égal à 1 pour calculer des sommes locales.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Appliquer un filtrage par moyenne locale</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=peaks(64);
J=imboxfilt(I,[5 5]);
figure; subplot(1,2,1); imagesc(I); title('Input');
subplot(1,2,2); imagesc(J); title('Box filtered');]]></example_item_data>
      <example_item_img
        src="../../../images/imboxfilt_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Calculer des sommes locales avec padding nul</example_item_description>
      <example_item_data><![CDATA[A = [1 2; 3 4];
S = imboxfilt(A, [2 2], 'Padding', 0, 'NormalizationFactor', 1)]]></example_item_data>
    </example_item>
  </examples>
