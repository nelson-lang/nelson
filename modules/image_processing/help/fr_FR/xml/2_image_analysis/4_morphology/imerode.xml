  <language>fr_FR</language>
  <keyword>imerode</keyword>
  <short_description>Erode une image ou un volume binaire ou en niveaux de gris.</short_description>
  <syntax>
    <syntax_item>J = imerode(I, SE)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Image binaire ou en niveaux de gris d'entree, ou volume 3-D.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>SE</param_name>
      <param_description>Structure d'element structurant ou voisinage logique.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>J</param_name>
      <param_description>Image ou volume erode.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Erode une image binaire ou en niveaux de gris. Avec un element structurant 3-D, imerode erode un volume 3-D.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Eroder une image binaire</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[BW=false(64,64); BW(20:44,20:44)=true;
J=imerode(BW,strel('disk',5));
figure; subplot(1,2,1); imagesc(BW); g=linspace(0,1,64)'; colormap([g g g]); title('Input');
subplot(1,2,2); imagesc(J); g=linspace(0,1,64)'; colormap([g g g]); title('Eroded');]]></example_item_data>
      <example_item_img
        src="../../../images/imerode_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
