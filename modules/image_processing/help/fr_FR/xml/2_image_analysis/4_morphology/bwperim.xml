  <language>fr_FR</language>
  <keyword>bwperim</keyword>
  <short_description>Trouve les pixels de perimetre des objets binaires.</short_description>
  <syntax>
    <syntax_item>BW2 = bwperim(BW)</syntax_item>
    <syntax_item>BW2 = bwperim(BW, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>BW</param_name>
      <param_description>Image binaire d'entree. Les valeurs non nulles sont traitees comme true.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivite, 4 ou 8.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW2</param_name>
      <param_description>Image logique contenant les pixels de perimetre.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Trouve les pixels de perimetre des objets binaires. Les connectivites prises en charge sont 4 et 8.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Trouver le perimetre d un objet</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[BW=false(64,64); BW(20:44,20:44)=true;
P=bwperim(BW);
figure; imagesc(P); g=linspace(0,1,64)'; colormap([g g g]); title('Perimeter');]]></example_item_data>
      <example_item_img
        src="../../../images/bwperim_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
