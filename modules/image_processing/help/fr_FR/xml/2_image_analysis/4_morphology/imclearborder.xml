  <keyword>imclearborder</keyword>
  <short_description>Supprime les composants binaires connectes au bord de l'image.</short_description>
  <syntax>
    <syntax_item>BW2 = imclearborder(BW)</syntax_item>
    <syntax_item>BW2 = imclearborder(BW, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>BW</param_name>
      <param_description>Image binaire 2-D d'entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivite, soit 4, 8, ou une matrice 3-by-3 equivalente.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW2</param_name>
      <param_description>Image logique apres suppression des composants connectes au bord.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>imclearborder supprime les composants de premier plan qui touchent la premiere ou la derniere ligne ou colonne. Cette fonction est utile apres seuillage ou segmentation lorsque les objets partiels au bord doivent etre retires.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Supprimer les composants au bord</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[BW=false(64,64);
BW(1:18,8:28)=true; BW(28:48,34:54)=true;
BW2=imclearborder(BW);
figure; subplot(1,2,1); imagesc(BW); title('Entree');
subplot(1,2,2); imagesc(BW2); title('Nettoyee');]]></example_item_data>
      <example_item_img
        src="../../../images/imclearborder_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
