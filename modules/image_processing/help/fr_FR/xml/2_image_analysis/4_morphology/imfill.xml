  <language>fr_FR</language>
  <keyword>imfill</keyword>
  <short_description>Remplit les trous dans les images binaires.</short_description>
  <syntax>
    <syntax_item>BW2 = imfill(BW)</syntax_item>
    <syntax_item>BW2 = imfill(BW, 'holes')</syntax_item>
    <syntax_item>BW2 = imfill(BW, conn, 'holes')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>BW</param_name>
      <param_description>Image binaire d'entree. Les valeurs non nulles sont traitees comme true.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivite, 4 ou 8.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'holes'</param_name>
      <param_description>Remplit les trous dans les objets de premier plan.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW2</param_name>
      <param_description>Image logique avec trous remplis.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Remplit les trous dans une image binaire 2-D. Les connectivites prises en charge sont 4 et 8.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Remplir un trou dans un objet binaire</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[BW=false(64,64); BW(12:52,12:52)=true; BW(24:40,24:40)=false;
BW2=imfill(BW,'holes');
figure; subplot(1,2,1); imagesc(BW); title('Input');
subplot(1,2,2); imagesc(BW2); title('Filled');]]></example_item_data>
      <example_item_img
        src="../../../images/imfill_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
