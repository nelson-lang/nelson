  <language>fr_FR</language>
  <keyword>imextendedmax</keyword>
  <short_description>Trouve les maxima etendus dans une image 2-D.</short_description>
  <syntax>
    <syntax_item>BW = imextendedmax(I, h)</syntax_item>
    <syntax_item>BW = imextendedmax(I, h, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Image 2-D reelle finie.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>h</param_name>
      <param_description>Hauteur finie non negative pour la transformation h-maxima.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivite, soit 4, 8, ou une matrice 3-by-3 equivalente.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW</param_name>
      <param_description>Masque logique des maxima regionaux apres suppression h-maxima.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>imextendedmax applique imhmax puis trouve les maxima regionaux. Cette fonction aide a construire des masques de marqueurs qui ignorent les maxima moins profonds que h.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Trouver les maxima etendus</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=[1 1 1 1 1;1 5 1 4 1;1 1 1 1 1];
BW=imextendedmax(I,2);
figure; subplot(1,2,1); imagesc(I); title('Image');
subplot(1,2,2); imagesc(BW); title('Maxima etendus');]]></example_item_data>
      <example_item_img
        src="../../../images/imextendedmax_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
