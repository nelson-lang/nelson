  <keyword>imregionalmin</keyword>
  <short_description>Trouve les minima regionaux dans une image 2-D.</short_description>
  <syntax>
    <syntax_item>BW = imregionalmin(I)</syntax_item>
    <syntax_item>BW = imregionalmin(I, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Image 2-D reelle finie.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivite, soit 4, 8, ou une matrice 3-by-3 equivalente.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW</param_name>
      <param_description>Masque logique dont les pixels vrais appartiennent aux minima regionaux.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>imregionalmin marque les zones plates connectees qui n'ont aucun voisin de valeur plus basse selon la connectivite choisie. Cette fonction aide a inspecter les marqueurs naturels avant une segmentation watershed.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Trouver les minima regionaux</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=[2 2 2;2 1 1;2 1 1];
BW=imregionalmin(I);
figure; subplot(1,2,1); imagesc(I); title('Image');
subplot(1,2,2); imagesc(BW); title('Minima regionaux');]]></example_item_data>
      <example_item_img
        src="../../../images/imregionalmin_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
