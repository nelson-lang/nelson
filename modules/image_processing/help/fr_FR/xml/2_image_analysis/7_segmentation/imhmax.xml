  <language>fr_FR</language>
  <keyword>imhmax</keyword>
  <short_description>Supprime les maxima peu profonds avec la transformation h-maxima.</short_description>
  <syntax>
    <syntax_item>J = imhmax(I, h)</syntax_item>
    <syntax_item>J = imhmax(I, h, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Image 2-D reelle finie.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>h</param_name>
      <param_description>Hauteur finie non negative utilisee pour supprimer les maxima peu profonds.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivite, soit 4, 8, ou une matrice 3-by-3 equivalente.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>J</param_name>
      <param_description>Image apres suppression h-maxima.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>imhmax supprime les maxima moins profonds que h. Cette fonction aide a extraire des marqueurs de premier plan avant segmentation.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Supprimer un maximum peu profond</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=[1 1 1;1 5 1;1 1 1];
J=imhmax(I,2);
figure; subplot(1,2,1); imagesc(I); title('Entree');
subplot(1,2,2); imagesc(J); title('h-maxima');]]></example_item_data>
      <example_item_img
        src="../../../images/imhmax_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
