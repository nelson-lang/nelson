  <language>fr_FR</language>
  <keyword>bwlabel</keyword>
  <short_description>Etiquette les composants connexes d une image binaire.</short_description>
  <syntax>
    <syntax_item>L = bwlabel(BW)</syntax_item>
    <syntax_item>L = bwlabel(BW, conn)</syntax_item>
    <syntax_item>[L, num] = bwlabel(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>BW</param_name>
      <param_description>Image binaire d'entree. Les valeurs non nulles sont traitees comme true.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivite transmise a bwconncomp.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>L</param_name>
      <param_description>Matrice d'etiquettes avec une etiquette positive par composante connexe.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>num</param_name>
      <param_description>Nombre de composantes connexes.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Etiquette les composants connexes d une image binaire.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Etiqueter les composants connexes</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[BW=false(64,64); BW(8:20,8:20)=true; BW(36:52,32:48)=true;
L=bwlabel(BW);
figure; imagesc(L); title('Labels');]]></example_item_data>
      <example_item_img
        src="../../../images/bwlabel_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
