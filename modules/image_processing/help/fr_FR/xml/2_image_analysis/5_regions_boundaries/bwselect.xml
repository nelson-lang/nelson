  <language>fr_FR</language>
  <keyword>bwselect</keyword>
  <short_description>Sélectionne des objets binaires connexes.</short_description>
  <syntax>
    <syntax_item>BW2 = bwselect(BW, c, r)</syntax_item>
    <syntax_item>BW2 = bwselect(BW, c, r, conn)</syntax_item>
    <syntax_item>[BW2, idx] = bwselect(BW, c, r, conn)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>BW</param_name>
      <param_description>Image binaire d'entrée. Les valeurs non nulles sont traitées comme true.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>c</param_name>
      <param_description>Coordonnées de colonnes des points de requête.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>r</param_name>
      <param_description>Coordonnées de lignes des points de requête.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>conn</param_name>
      <param_description>Connectivité, 4 ou 8.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>BW2</param_name>
      <param_description>Image logique contenant les composantes connexes sélectionnées.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>idx</param_name>
      <param_description>Indices linéaires des pixels true dans BW2.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Sélectionne les composantes connexes d une image binaire 2-D qui contiennent au moins un point de requête. Les coordonnées sont passées sous forme de colonnes c et lignes r. Les connectivités prises en charge sont 4 et 8.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Sélectionner un objet dans une image binaire</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[BW=false(64,64); BW(10:26,8:24)=true; BW(36:56,38:58)=true;
BW2=bwselect(BW, 16, 18, 8);
figure; subplot(1,2,1); imagesc(BW); title('Input');
subplot(1,2,2); imagesc(BW2); title('Selected');]]></example_item_data>
      <example_item_img
        src="../../../images/bwselect_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
