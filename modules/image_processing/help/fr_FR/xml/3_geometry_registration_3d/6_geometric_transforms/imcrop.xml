  <language>fr_FR</language>
  <keyword>imcrop</keyword>
  <short_description>Rogne une image avec un rectangle.</short_description>
  <syntax>
    <syntax_item>J = imcrop(I)</syntax_item>
    <syntax_item>J = imcrop(I, rect)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>I</param_name>
      <param_description>Image d'entree en niveaux de gris ou RGB.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>rect</param_name>
      <param_description>Rectangle de rognage [x y width height] avec largeur et hauteur non negatives.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>J</param_name>
      <param_description>Image rognee. Sans rect, l'image d'entree est renvoyee inchangee.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Rogne une image avec un rectangle [x y width height]. Le rectangle doit etre un vecteur numerique a 4 elements avec une largeur et une hauteur non negatives.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Rogner une image</example_item_description>
      <example_item_data
        runnable="adv-cli"
      ><![CDATA[I=peaks(64);
J=imcrop(I,[16 16 31 31]);
figure; subplot(1,2,1); imagesc(I); title('Input');
subplot(1,2,2); imagesc(J); title('Crop');]]></example_item_data>
      <example_item_img
        src="../../../images/imcrop_1.png"
        align="middle"
        generate="true"
      />
    </example_item>
  </examples>
