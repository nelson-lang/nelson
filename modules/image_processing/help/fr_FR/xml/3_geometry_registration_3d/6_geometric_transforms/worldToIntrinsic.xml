  <language>fr_FR</language>
  <keyword>worldToIntrinsic</keyword>
  <short_description>Convertit des coordonnées monde en coordonnées intrinseques.</short_description>
  <syntax>
    <syntax_item>[xIntrinsic, yIntrinsic] = worldToIntrinsic(R, xWorld, yWorld)</syntax_item>
    <syntax_item>[xIntrinsic, yIntrinsic, zIntrinsic] = worldToIntrinsic(R, xWorld, yWorld, zWorld)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>R</param_name>
      <param_description>Structure de référence spatiale 2-D ou 3-D créée par imref2d ou imref3d.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>xWorld, yWorld, zWorld</param_name>
      <param_description>Coordonnées monde. La coordonnée Z est utilisée uniquement avec les références 3-D.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>xIntrinsic, yIntrinsic, zIntrinsic</param_name>
      <param_description>Coordonnées intrinseques correspondant aux coordonnées monde.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Convertit les coordonnées monde en coordonnées intrinseques. Les coordonnées hors limites sont extrapolées.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Convertir des coordonnées monde 2-D</example_item_description>
      <example_item_data><![CDATA[R = imref2d([2 3], 2, 3);
[xIntrinsic, yIntrinsic] = worldToIntrinsic(R, [2 6], [3 6])]]></example_item_data>
    </example_item>
  </examples>
