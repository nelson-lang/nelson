  <language>fr_FR</language>
  <keyword>web</keyword>
  <short_description>Ouvre une page web, un fichier local ou du texte HTML.</short_description>
  <syntax>
    <syntax_item>web()</syntax_item>
    <syntax_item>web(url)</syntax_item>
    <syntax_item>web(url, option1, ..., optionN)</syntax_item>
    <syntax_item>stat = web(...)</syntax_item>
    <syntax_item>[stat, h, url] = web(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>url</param_name>
      <param_description>chaine : adresse web, chemin local, URL file ou URL text.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>option</param_name>
      <param_description>une valeur parmi '-browser', '-new', '-noaddressbox' ou '-notoolbar'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>stat</param_name>
      <param_description>0 en cas de succes, valeur non nulle sinon.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>handle du visualiseur HTML, ou vide lorsque le navigateur systeme est utilise.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>url</param_name>
      <param_description>entree courante du visualiseur HTML, ou chaine vide lorsque le navigateur systeme est utilise.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>web</b> ouvre les adresses externes dans le navigateur systeme et ouvre le contenu HTML local ou inline dans le visualiseur HTML Nelson.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Afficher du texte HTML inline.</example_item_description>
      <example_item_data runnable="gui"><![CDATA[[stat, h] = web('text://<html><body><h1>Hello</h1></body></html>');]]></example_item_data>
    </example_item>
  </examples>
