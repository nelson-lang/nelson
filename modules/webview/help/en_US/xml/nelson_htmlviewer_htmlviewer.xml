  <language>en_US</language>
  <keyword>nelson.htmlviewer.htmlviewer</keyword>
  <short_description>Handle to a Nelson HTML viewer window.</short_description>
  <syntax>
    <syntax_item>h = nelson.htmlviewer.htmlviewer()</syntax_item>
    <syntax_item>h = nelson.htmlviewer.htmlviewer(input)</syntax_item>
    <syntax_item>htmlText = getHTMLText(h)</syntax_item>
    <syntax_item>close(h)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>input</param_name>
      <param_description>a string: local file path, file URL, or text URL.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>HTML viewer handle.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>htmlText</param_name>
      <param_description>current HTML document text.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>The <b>nelson.htmlviewer.htmlviewer</b> class represents an HTML viewer window. Its public properties are <b>Input</b> and <b>Visible</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Display HTML and read the document text.</example_item_description>
      <example_item_data runnable="gui"><![CDATA[h = nelson.htmlviewer.htmlviewer('text://<html><body>Hello</body></html>');
txt = getHTMLText(h);
close(h);
]]></example_item_data>
    </example_item>
  </examples>
