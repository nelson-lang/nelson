  <language>en_US</language>
  <keyword>web</keyword>
  <short_description>Open a web page, local file, or HTML text.</short_description>
  <syntax>
    <syntax_item>web()</syntax_item>
    <syntax_item>web(url)</syntax_item>
    <syntax_item>web(url, option1, ..., optionN)</syntax_item>
    <syntax_item>stat = web(...)</syntax_item>
    <syntax_item>[stat, h, url] = web(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>url</param_name>
      <param_description>a string: web address, local file path, file URL, or text URL.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>option</param_name>
      <param_description>one of '-browser', '-new', '-noaddressbox', or '-notoolbar'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>stat</param_name>
      <param_description>0 on success, nonzero otherwise.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>HTML viewer handle, or empty when the system browser is used.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>url</param_name>
      <param_description>current HTML viewer input, or an empty string when the system browser is used.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>web</b> opens external addresses in the system browser and opens local or inline HTML content in the Nelson HTML viewer.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Display inline HTML text.</example_item_description>
      <example_item_data runnable="gui"><![CDATA[[stat, h] = web('text://<html><body><h1>Hello</h1></body></html>');]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item>
      <link linkend="${webview}nelson.htmlviewer.htmlviewer">nelson.htmlviewer.htmlviewer</link>
    </see_also_item>
  </see_also>
