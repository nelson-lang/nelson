  <language>en_US</language>
  <keyword>realmin</keyword>
  <short_description
  >Smallest positive floating-point number.</short_description>
  <syntax>
    <syntax_item>R = realmin()</syntax_item>
    <syntax_item>R = realmin(&apos;double&apos;)</syntax_item>
    <syntax_item>R = realmin(&apos;single&apos;)</syntax_item>
    <syntax_item>R = realmin(&apos;like&apos;, p)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>an array whose class, complexity and sparsity are given to the result.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>a double or single.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>realmin</b> returns smallest positive floating-point number.</p>
    <p><b>realmin('like', p)</b> returns the value for the class of <b>p</b>; a complex or sparse <b>p</b> gives a complex or sparse result.</p>
  </description>
