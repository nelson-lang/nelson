  <language>fr_FR</language>
  <keyword>realmax</keyword>
  <short_description>Plus grand nombre flottant positif.</short_description>
  <syntax>
    <syntax_item>R = realmax()</syntax_item>
    <syntax_item>R = realmax(&apos;double&apos;)</syntax_item>
    <syntax_item>R = realmax(&apos;single&apos;)</syntax_item>
    <syntax_item>R = realmax(&apos;like&apos;, p)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>p</param_name>
      <param_description>un tableau dont la classe, la complexité et le caractère creux sont repris par le résultat.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>un double ou single.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>realmax</b> renvoie le plus grand nombre flottant positif.</p>
    <p><b>realmax('like', p)</b> renvoie la valeur pour la classe de <b>p</b> ; un <b>p</b> complexe ou creux donne un résultat complexe ou creux.</p>
  </description>
