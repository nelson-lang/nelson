  <language>en_US</language>
  <keyword>timezones</keyword>
  <short_description>List timezone names available in the embedded timezone data.</short_description>
  <syntax>
    <syntax_item>zones = timezones()</syntax_item>
    <syntax_item>[zones, version] = timezones()</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>inputs</param_name>
      <param_description>No input arguments.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>output</param_name>
      <param_description>A string array of zone names and, optionally, a data version string.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>List timezone names available in the embedded timezone data.</p>
    <p>The list includes zones supplied by the small embedded timezone database and the local pseudo-zone.</p>
    <p>Array-valued inputs keep their data shape when the operation supports arrays. Scalar operands are expanded where the implementation defines scalar expansion.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Basic usage.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[zones, version] = timezones()
any(strcmp(cellstr(zones), 'Europe/Paris'))
]]></example_item_data>
    </example_item>
  </examples>
