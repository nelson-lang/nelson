  <language>en_US</language>
  <keyword>today</keyword>
  <short_description>Return the serial date number for the current day.</short_description>
  <syntax>
    <syntax_item>t = today()</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>inputs</param_name>
      <param_description>No input arguments.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>output</param_name>
      <param_description>A scalar serial date number with no time-of-day fraction.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Return the serial date number for the current day.</p>
    <p>today is equivalent to floor(now()) at the time of the call.</p>
    <p>Array-valued inputs keep their data shape when the operation supports arrays. Scalar operands are expanded where the implementation defines scalar expansion.</p>
  </description>
