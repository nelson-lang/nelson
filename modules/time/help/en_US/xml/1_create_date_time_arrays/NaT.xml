  <language>en_US</language>
  <keyword>NaT</keyword>
  <short_description>Create not-a-time datetime values.</short_description>
  <syntax>
    <syntax_item>t = NaT()</syntax_item>
    <syntax_item>t = NaT(n)</syntax_item>
    <syntax_item>t = NaT(m, n)</syntax_item>
    <syntax_item>t = NaT(..., &apos;Format&apos;, fmt)</syntax_item>
    <syntax_item>t = NaT(..., &apos;TimeZone&apos;, tz)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>inputs</param_name>
      <param_description>Optional size arguments and optional Format and TimeZone name-value pairs.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>output</param_name>
      <param_description>A datetime array whose serial values are NaN.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Create not-a-time datetime values.</p>
    <p>NaT is the missing value marker for datetime arrays. isnat returns true for these elements, and display functions show them as NaT.</p>
    <p>Array-valued inputs keep their data shape when the operation supports arrays. Scalar operands are expanded where the implementation defines scalar expansion.</p>
  </description>
  <used_function />
