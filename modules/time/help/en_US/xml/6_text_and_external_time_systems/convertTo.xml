  <language>en_US</language>
  <keyword>convertTo</keyword>
  <short_description>Convert datetime values to selected numeric representations.</short_description>
  <syntax>
    <syntax_item>x = convertTo(t, &apos;datenum&apos;)</syntax_item>
    <syntax_item>x = convertTo(t, &apos;posixtime&apos;)</syntax_item>
    <syntax_item>x = convertTo(t, &apos;juliandate&apos;)</syntax_item>
    <syntax_item>x = convertTo(t, &apos;exceltime&apos;)</syntax_item>
    <syntax_item>x = convertTo(t, &apos;yyyymmdd&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>inputs</param_name>
      <param_description>A datetime array and a conversion kind.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>output</param_name>
      <param_description>A numeric array matching the requested representation.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Convert datetime values to selected numeric representations.</p>
    <p>convertTo centralizes the datetime conversions also available through datenum, posixtime, juliandate, exceltime, and yyyymmdd.</p>
    <p>Array-valued inputs keep their data shape when the operation supports arrays. Scalar operands are expanded where the implementation defines scalar expansion.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Basic usage.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[t = datetime(2024, 5, 17)
convertTo(t, 'yyyymmdd')
]]></example_item_data>
    </example_item>
  </examples>
