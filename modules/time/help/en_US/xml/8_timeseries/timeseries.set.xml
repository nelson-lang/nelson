  <language>en_US</language>
  <keyword>timeseries.set</keyword>
  <short_description>Set timeseries property values.</short_description>
  <syntax>
    <syntax_item>tsOut = set(ts, &apos;PropertyName&apos;, value)</syntax_item>
    <syntax_item>tsOut = set(ts, &apos;Name1&apos;, value1, &apos;Name2&apos;, value2)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Timeseries object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>PropertyName</param_name>
      <param_description>Property to set, such as Name, Data, Time, DataInfo, TimeInfo, or UserData.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>value</param_name>
      <param_description>New property value.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Output timeseries object with the updated properties.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>set</b> Returns a copy of the timeseries object with one or more properties changed.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [10; 11; 12], 'Name', 'speed');
ts = set(ts, 'Name', 'velocity');
ts.Name
]]></example_item_data>
    </example_item>
  </examples>
