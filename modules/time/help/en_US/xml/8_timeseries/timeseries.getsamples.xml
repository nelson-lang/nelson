  <language>en_US</language>
  <keyword>timeseries.getsamples</keyword>
  <short_description>Return a timeseries subset by index.</short_description>
  <syntax>
    <syntax_item>tsOut = getsamples(ts, indices)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Input timeseries object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>indices</param_name>
      <param_description>Sample indices to keep.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Timeseries subset with the selected samples.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>getsamples</b> Selects samples and preserves events and metadata.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([10; 20; 30], [1; 2; 3]);
ts2 = getsamples(ts, 2:3);
ts2.Time
]]></example_item_data>
    </example_item>
  </examples>
