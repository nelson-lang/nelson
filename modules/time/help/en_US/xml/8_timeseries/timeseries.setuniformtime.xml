  <keyword>timeseries.setuniformtime</keyword>
  <short_description>Set a uniformly spaced time vector.</short_description>
  <syntax>
    <syntax_item>tsOut = setuniformtime(ts, &apos;StartTime&apos;, startTime, &apos;Interval&apos;, step, &apos;Length&apos;, n)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Input timeseries object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>startTime</param_name>
      <param_description>First sample time.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>step</param_name>
      <param_description>Uniform spacing between samples.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>Number of samples.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Output timeseries object with a uniformly spaced time vector.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>setuniformtime</b> Generates a uniform time vector from name-value settings and assigns it to the object.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3; 4]);
ts = setuniformtime(ts, 'StartTime', 0, 'Interval', 2, 'Length', 4);
ts.Time
]]></example_item_data>
    </example_item>
  </examples>
