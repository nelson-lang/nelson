  <language>en_US</language>
  <keyword>timeseries.delsample</keyword>
  <short_description>Delete samples from a timeseries object.</short_description>
  <syntax>
    <syntax_item>tsOut = delsample(ts, &apos;Index&apos;, indices)</syntax_item>
    <syntax_item>tsOut = delsample(ts, &apos;Time&apos;, times)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Input timeseries object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>indices</param_name>
      <param_description>Sample indices to delete.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>times</param_name>
      <param_description>Sample times to delete.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Output timeseries object with the samples removed.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>delsample</b> Removes samples selected by index or by exact time values.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [10; 11; 12]);
ts = delsample(ts, 'Index', 2);
ts.Data
]]></example_item_data>
    </example_item>
  </examples>
