  <language>en_US</language>
  <keyword>timeseries.resample</keyword>
  <short_description>Resample a timeseries object at new times.</short_description>
  <syntax>
    <syntax_item>tsOut = resample(ts, newTime)</syntax_item>
    <syntax_item>tsOut = resample(ts, newTime, method)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Input timeseries object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>newTime</param_name>
      <param_description>New sample times.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>method</param_name>
      <param_description>Optional interpolation method: linear, zoh, or nearest.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Resampled output timeseries object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>resample</b> Interpolates data onto a new time vector and updates Time while preserving metadata.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [10; 11; 12], 'Name', 'speed');
ts2 = resample(ts, [10; 10.5; 11]);
ts2.Data
]]></example_item_data>
    </example_item>
  </examples>
