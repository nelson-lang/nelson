  <language>en_US</language>
  <keyword>timeseries.append</keyword>
  <short_description>Append timeseries samples.</short_description>
  <syntax>
    <syntax_item>tsOut = append(ts1, ts2)</syntax_item>
    <syntax_item>tsOut = append(ts1, ts2, ts3)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts1</param_name>
      <param_description>First timeseries object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ts2</param_name>
      <param_description>Timeseries object to append.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Output timeseries object with the appended samples.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>append</b> Concatenates samples from two or more timeseries objects along the sample dimension.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts1 = timeseries([1; 2], [10; 11], 'Name', 'speed');
ts2 = timeseries(3, 12, 'Name', 'speed');
ts = append(ts1, ts2);
ts.Data
]]></example_item_data>
    </example_item>
  </examples>
