  <language>en_US</language>
  <keyword>timeseries.loadobj</keyword>
  <short_description>Restore a timeseries object from saved data.</short_description>
  <syntax>
    <syntax_item>ts = timeseries.loadobj(value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>value</param_name>
      <param_description>A timeseries object or a structure containing timeseries storage fields.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ts</param_name>
      <param_description>A timeseries object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>timeseries.loadobj</b> rebuilds a timeseries object from an object or saved structure.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [10; 11; 12], 'Name', 'speed');
state = struct(ts);
copy = timeseries.loadobj(state);
copy.Name
]]></example_item_data>
    </example_item>
  </examples>
