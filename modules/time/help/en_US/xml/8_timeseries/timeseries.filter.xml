  <language>en_US</language>
  <keyword>timeseries.filter</keyword>
  <short_description>Filter timeseries data.</short_description>
  <syntax>
    <syntax_item>tsOut = filter(ts, b, a)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Input timeseries object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>b</param_name>
      <param_description>Numerator filter coefficients.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>a</param_name>
      <param_description>Denominator filter coefficients.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Filtered output timeseries object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>filter</b> Runs filter on the data values and preserves time, name, events, and metadata.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [1; 2; 3]);
ts = filter(ts, [1 1] / 2, 1);
ts.Data
]]></example_item_data>
    </example_item>
  </examples>
