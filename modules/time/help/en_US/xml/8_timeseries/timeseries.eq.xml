  <language>en_US</language>
  <keyword>timeseries.eq</keyword>
  <short_description>Compare two timeseries objects for equality sample by sample.</short_description>
  <syntax>
    <syntax_item>tfTs = eq(a, b)</syntax_item>
    <syntax_item>tfTs = a == b</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>a</param_name>
      <param_description>Left timeseries object or scalar.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>b</param_name>
      <param_description>Right timeseries object or scalar.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tfTs</param_name>
      <param_description>Resulting timeseries object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>eq</b> Compares data values while preserving the time axis when a timeseries input is used.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[left = timeseries([1; 2], [1; 2]);
right = timeseries([1; 3], [1; 2]);
out = left == right;
out.Data
]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item>
      <link linkend="${time}timeseries">timeseries</link>
    </see_also_item>
  </see_also>
