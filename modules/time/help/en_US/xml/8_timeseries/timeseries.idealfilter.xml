  <language>en_US</language>
  <keyword>timeseries.idealfilter</keyword>
  <short_description>Apply an ideal frequency-domain filter to timeseries data.</short_description>
  <syntax>
    <syntax_item>tsOut = idealfilter(ts, band)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Input timeseries object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>band</param_name>
      <param_description>Two-element frequency band.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Filtered output timeseries object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>idealfilter</b> Filters numeric data using the requested ideal frequency band and preserves the time axis.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [1; 2; 3]);
ts2 = idealfilter(ts, [0 1]);
size(ts2.Data)
]]></example_item_data>
    </example_item>
  </examples>
