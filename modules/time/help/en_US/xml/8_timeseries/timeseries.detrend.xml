  <language>en_US</language>
  <keyword>timeseries.detrend</keyword>
  <short_description>Remove a trend from timeseries data.</short_description>
  <syntax>
    <syntax_item>tsOut = detrend(ts)</syntax_item>
    <syntax_item>tsOut = detrend(ts, &apos;constant&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Input timeseries object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>option</param_name>
      <param_description>Optional detrend mode.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Detrended timeseries object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>detrend</b> Applies detrend to the numeric data and preserves the time axis and metadata.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [1; 2; 3]);
ts = detrend(ts, 'constant');
ts.Data
]]></example_item_data>
    </example_item>
  </examples>
