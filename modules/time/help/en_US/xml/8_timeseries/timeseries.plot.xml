  <language>en_US</language>
  <keyword>timeseries.plot</keyword>
  <short_description>Plot timeseries data against time.</short_description>
  <syntax>
    <syntax_item>h = plot(ts)</syntax_item>
    <syntax_item>h = plot(ax, ts)</syntax_item>
    <syntax_item>h = plot(ts, lineSpec)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Input timeseries object.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Optional target axes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>lineSpec</param_name>
      <param_description>Optional line style or graphics arguments.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>Graphics handle to the plotted line or stairs object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>plot</b> Plots sample time on the x-axis and timeseries data on the y-axis. Zero-order hold interpolation uses stair-step drawing.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
ts = timeseries([1; 2; 3], [10; 11; 12], 'Name', 'speed');
h = plot(ts);
]]></example_item_data>
    </example_item>
  </examples>
