  <language>en_US</language>
  <keyword>month</keyword>
  <short_description>Extract month numbers or names from date and time values.</short_description>
  <syntax>
    <syntax_item>m = month(t)</syntax_item>
    <syntax_item>name = month(t, &apos;name&apos;)</syntax_item>
    <syntax_item>abbr = month(t, &apos;shortname&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>inputs</param_name>
      <param_description>datetime values, serial date numbers, or date-compatible input, plus optional name output selector.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>output</param_name>
      <param_description>A double array of month numbers, or a string array of month names.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Extract month numbers or names from date and time values.</p>
    <p>Use name for full English month names and shortname for abbreviated names.</p>
    <p>Array-valued inputs keep their data shape when the operation supports arrays. Scalar operands are expanded where the implementation defines scalar expansion.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Basic usage.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[month(datetime(2024, 5, 17))
month(datetime(2024, 5, 17), 'name')
]]></example_item_data>
    </example_item>
  </examples>
