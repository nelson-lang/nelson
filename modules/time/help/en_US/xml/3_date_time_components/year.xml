  <language>en_US</language>
  <keyword>year</keyword>
  <short_description>Extract year numbers from date and time values.</short_description>
  <syntax>
    <syntax_item>y = year(t)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>inputs</param_name>
      <param_description>datetime values, serial date numbers, or date-compatible input.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>output</param_name>
      <param_description>A double array of calendar years.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Extract year numbers from date and time values.</p>
    <p>year uses datevec for numeric date inputs and the Year dependent property for datetime inputs.</p>
    <p>Array-valued inputs keep their data shape when the operation supports arrays. Scalar operands are expanded where the implementation defines scalar expansion.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Basic usage.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[t = datetime(2024, [1 12], [1 31])
year(t)
]]></example_item_data>
    </example_item>
  </examples>
