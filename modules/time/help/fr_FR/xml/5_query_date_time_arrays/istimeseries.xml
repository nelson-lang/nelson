  <keyword>istimeseries</keyword>
  <short_description>Determine si l entree est un objet timeseries.</short_description>
  <syntax>
    <syntax_item>tf = istimeseries(value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>value</param_name>
      <param_description>Valeur d entree.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>Resultat logique.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>istimeseries</b> retourne true lorsque l entree est un objet timeseries.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2], [10; 11]);
istimeseries(ts)
]]></example_item_data>
    </example_item>
  </examples>
