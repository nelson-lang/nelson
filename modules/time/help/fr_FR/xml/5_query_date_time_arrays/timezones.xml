  <keyword>timezones</keyword>
  <short_description>Liste les noms de fuseaux horaires disponibles dans la base embarquee.</short_description>
  <syntax>
    <syntax_item>zones = timezones()</syntax_item>
    <syntax_item>[zones, version] = timezones()</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>inputs</param_name>
      <param_description>Aucun argument d entree.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>output</param_name>
      <param_description>Un tableau string de noms de zones et, optionnellement, une chaine de version des donnees.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Liste les noms de fuseaux horaires disponibles dans la base embarquee.</p>
    <p>La liste inclut les zones fournies par la petite base timezone embarquee et la pseudo-zone local.</p>
    <p>Array-valued inputs keep their data shape when the operation supports arrays. Scalar operands are expanded where the implementation defines scalar expansion.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Utilisation de base.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[zones, version] = timezones()
any(strcmp(cellstr(zones), 'Europe/Paris'))
]]></example_item_data>
    </example_item>
  </examples>
