  <keyword>posixtime</keyword>
  <short_description>Convertit des valeurs datetime en secondes ecoulees depuis l epoque POSIX.</short_description>
  <syntax>
    <syntax_item>p = posixtime(t)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>inputs</param_name>
      <param_description>Un tableau datetime.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>output</param_name>
      <param_description>Un tableau double de secondes ecoulees depuis 1970-01-01 00:00:00.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Convertit des valeurs datetime en secondes ecoulees depuis l epoque POSIX.</p>
    <p>posixtime est utile pour echanger avec des systemes qui representent les temps comme secondes depuis l epoque Unix.</p>
    <p>Array-valued inputs keep their data shape when the operation supports arrays. Scalar operands are expanded where the implementation defines scalar expansion.</p>
  </description>
  <used_function />
