  <keyword>timeseries.idealfilter</keyword>
  <short_description>Applique un filtre ideal dans le domaine frequentiel aux donnees timeseries.</short_description>
  <syntax>
    <syntax_item>tsOut = idealfilter(ts, band)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Objet timeseries en entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>band</param_name>
      <param_description>Bande de frequences a deux elements.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Objet timeseries filtre en sortie.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>idealfilter</b> Filtre les donnees numeriques avec la bande de frequences ideale demandee et preserve l'axe temporel.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [1; 2; 3]);
ts2 = idealfilter(ts, [0 1]);
size(ts2.Data)
]]></example_item_data>
    </example_item>
  </examples>
