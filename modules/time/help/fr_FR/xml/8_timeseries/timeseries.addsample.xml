  <language>fr_FR</language>
  <keyword>timeseries.addsample</keyword>
  <short_description>Ajoute un echantillon a un objet timeseries.</short_description>
  <syntax>
    <syntax_item>tsOut = addsample(ts, &apos;Time&apos;, t, &apos;Data&apos;, x)</syntax_item>
    <syntax_item>tsOut = addsample(ts, &apos;Time&apos;, t, &apos;Data&apos;, x, &apos;Quality&apos;, q)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Objet timeseries en entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>t</param_name>
      <param_description>Temps d'echantillon a ajouter.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>Donnees d'echantillon a ajouter.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>q</param_name>
      <param_description>Valeur de qualite optionnelle.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Objet timeseries en sortie avec l'echantillon ajoute.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>addsample</b> Ajoute un echantillon avec des paires nom-valeur. L'ordre des echantillons existants est preserve par l'operation d'ajout.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2], [10; 11], 'Name', 'speed');
ts = addsample(ts, 'Time', 12, 'Data', 3);
ts.Time
]]></example_item_data>
    </example_item>
  </examples>
