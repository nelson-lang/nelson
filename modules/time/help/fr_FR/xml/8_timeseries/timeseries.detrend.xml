  <language>fr_FR</language>
  <keyword>timeseries.detrend</keyword>
  <short_description>Supprime une tendance des donnees timeseries.</short_description>
  <syntax>
    <syntax_item>tsOut = detrend(ts)</syntax_item>
    <syntax_item>tsOut = detrend(ts, &apos;constant&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Objet timeseries en entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>option</param_name>
      <param_description>Mode detrend optionnel.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Objet timeseries en sortie sans tendance.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>detrend</b> Applique detrend aux donnees numeriques et preserve l'axe temporel et les metadonnees.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [1; 2; 3]);
ts = detrend(ts, 'constant');
ts.Data
]]></example_item_data>
    </example_item>
  </examples>
