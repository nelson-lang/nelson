  <keyword>tscollection.horzcat</keyword>
  <short_description>Fonction pour objets de serie temporelle.</short_description>
  <syntax>
    <syntax_item>horzcat(...)</syntax_item>
  </syntax>
  <description>
    <p>
      <b>horzcat</b> opere sur les objets timeseries, tscollection ou les metadonnees tsdata.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts1 = timeseries([1; 2], [10; 11], 'Name', 'a');
ts2 = timeseries([3; 4], [10; 11], 'Name', 'b');
tsc = [tscollection(ts1), tscollection(ts2)];
gettimeseriesnames(tsc)
]]></example_item_data>
    </example_item>
  </examples>
