  <language>fr_FR</language>
  <keyword>timeseries.mtimes</keyword>
  <short_description>Multiplication matricielle pour les donnees timeseries.</short_description>
  <syntax>
    <syntax_item>tsOut = mtimes(a, b)</syntax_item>
    <syntax_item>tsOut = a * b</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>a</param_name>
      <param_description>Objet timeseries gauche ou scalaire.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>b</param_name>
      <param_description>Objet timeseries droit ou scalaire.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Objet timeseries resultant.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>mtimes</b> Applique la multiplication matricielle aux valeurs de donnees et preserve l'axe temporel d'une entree timeseries.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2], [1; 2]);
out = ts * 2;
out.Data
]]></example_item_data>
    </example_item>
  </examples>
