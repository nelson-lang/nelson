  <language>fr_FR</language>
  <keyword>timeseries.eq</keyword>
  <short_description>Compare deux objets timeseries echantillon par echantillon.</short_description>
  <syntax>
    <syntax_item>tfTs = eq(a, b)</syntax_item>
    <syntax_item>tfTs = a == b</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>a</param_name>
      <param_description>Objet timeseries gauche ou scalaire.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>b</param_name>
      <param_description>Objet timeseries droit ou scalaire.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tfTs</param_name>
      <param_description>Objet timeseries resultant.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>eq</b> Compare les valeurs de donnees en preservant l'axe temporel lorsqu'une entree timeseries est utilisee.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[left = timeseries([1; 2], [1; 2]);
right = timeseries([1; 3], [1; 2]);
out = left == right;
out.Data
]]></example_item_data>
    </example_item>
  </examples>
