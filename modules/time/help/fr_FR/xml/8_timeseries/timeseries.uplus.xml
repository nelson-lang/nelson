  <keyword>timeseries.uplus</keyword>
  <short_description>Plus unaire pour les données d&apos;un timeseries.</short_description>
  <syntax>
    <syntax_item>tsOut = uplus(ts)</syntax_item>
    <syntax_item>tsOut = +ts</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Objet timeseries en entree.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Objet timeseries de sortie avec des donnees inchangees.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>uplus</b> retourne un timeseries avec des données inchangées.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2], [1; 2]);
out = +ts;
out.Data
]]></example_item_data>
    </example_item>
  </examples>
