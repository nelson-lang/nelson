  <language>fr_FR</language>
  <keyword>timeseries.synchronize</keyword>
  <short_description>Synchronise deux objets timeseries ou plus.</short_description>
  <syntax>
    <syntax_item>[ts1Out, ts2Out] = synchronize(ts1, ts2)</syntax_item>
    <syntax_item>[out1, out2, out3] = synchronize(ts1, ts2, ts3)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts1</param_name>
      <param_description>Premier objet timeseries.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ts2</param_name>
      <param_description>Second objet timeseries.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ts1Out</param_name>
      <param_description>Premier objet timeseries reechantillonne sur le vecteur de temps commun.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ts2Out</param_name>
      <param_description>Second objet timeseries reechantillonne sur le vecteur de temps commun.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>synchronize</b> Construit un vecteur de temps commun a partir de tous les objets d'entree et reechantillonne chaque serie sur ce vecteur.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[a = timeseries([1; 2], [1; 2]);
b = timeseries([10; 30], [1; 3]);
[a2, b2] = synchronize(a, b);
b2.Time
]]></example_item_data>
    </example_item>
  </examples>
