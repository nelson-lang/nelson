  <keyword>timeseries.gettsbetweenevents</keyword>
  <short_description>Renvoie les echantillons entre deux evenements.</short_description>
  <syntax>
    <syntax_item>tsOut = gettsbetweenevents(ts, firstEvent, secondEvent)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Objet timeseries en entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>firstEvent</param_name>
      <param_description>Nom du premier evenement.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>secondEvent</param_name>
      <param_description>Nom du second evenement.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Objet timeseries en sortie contenant les echantillons selectionnes.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>gettsbetweenevents</b> Conserve les echantillons dont le temps est compris entre les temps des evenements nommes, bornes incluses.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [10; 11; 12]);
ts = addevent(ts, tsdata.event('start', 10));
ts = addevent(ts, tsdata.event('stop', 11));
gettsbetweenevents(ts, 'start', 'stop').Data
]]></example_item_data>
    </example_item>
  </examples>
