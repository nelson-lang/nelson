  <language>fr_FR</language>
  <keyword>timeseries.addevent</keyword>
  <short_description>Ajoute un événement a un objet timeseries.</short_description>
  <syntax>
    <syntax_item>tsOut = addevent(ts, eventObj)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Objet timeseries en entrée.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>eventObj</param_name>
      <param_description>Événement crée avec tsdata.event.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Objet timeseries en sortie avec l'événement ajouté.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>addevent</b> Ajoute un événement nomme a la liste Events d'un objet timeseries. Les temps des événements utilisent le même axe temporel que la série.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [10; 11; 12], 'Name', 'speed');
ev = tsdata.event('middle', 11);
ts = addevent(ts, ev);
ts.Events(1).Name
]]></example_item_data>
    </example_item>
  </examples>
