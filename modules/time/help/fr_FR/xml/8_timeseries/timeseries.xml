  <language>fr_FR</language>
  <keyword>timeseries</keyword>
  <short_description>Cree des donnees de serie temporelle.</short_description>
  <syntax>
    <syntax_item>ts = timeseries(data)</syntax_item>
    <syntax_item>ts = timeseries(data, time)</syntax_item>
    <syntax_item>ts = timeseries(data, time, quality)</syntax_item>
    <syntax_item>ts = timeseries(data, time, 'Name', name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>data</param_name>
      <param_description>Donnees echantillonnees.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>time</param_name>
      <param_description>Temps numeriques, duration, datetime ou textes de date.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>quality</param_name>
      <param_description>Valeurs de qualite optionnelles.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>ts</param_name>
      <param_description>Un objet timeseries.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>timeseries</b> stocke des donnees echantillonnees, des temps, des valeurs de qualite optionnelles, des metadonnees et des evenements.</p>
    <p>Les methodes couvrent selection, evenements, interpolation, synchronisation, statistiques, arithmetique, trace graphique et conversion vers timetable.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[x = [-0.2 -0.3 13; -0.1 -0.4 15; NaN 2.8 17; 0.5 0.3 NaN; -0.3 -0.1 15];
tsPosition = timeseries(x(:, 1:2), (1:5)', 'Name', 'Position');
getdatasamplesize(tsPosition)
]]></example_item_data>
    </example_item>
  </examples>
