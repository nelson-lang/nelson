  <language>fr_FR</language>
  <keyword>timeseries.plot</keyword>
  <short_description>Trace les donnees timeseries en fonction du temps.</short_description>
  <syntax>
    <syntax_item>h = plot(ts)</syntax_item>
    <syntax_item>h = plot(ax, ts)</syntax_item>
    <syntax_item>h = plot(ts, lineSpec)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Objet timeseries en entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>ax</param_name>
      <param_description>Axes cibles optionnels.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>lineSpec</param_name>
      <param_description>Style de ligne ou arguments graphiques optionnels.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>h</param_name>
      <param_description>Handle graphique vers la ligne ou l'objet stairs trace.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>plot</b> Trace le temps des echantillons sur l'axe x et les donnees timeseries sur l'axe y. L'interpolation par maintien d'ordre zero utilise un trace en escalier.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="adv-cli"><![CDATA[f = figure();
ts = timeseries([1; 2; 3], [10; 11; 12], 'Name', 'speed');
h = plot(ts);
]]></example_item_data>
    </example_item>
  </examples>
