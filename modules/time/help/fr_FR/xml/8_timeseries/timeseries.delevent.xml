  <language>fr_FR</language>
  <keyword>timeseries.delevent</keyword>
  <short_description>Supprime un evenement d'un objet timeseries.</short_description>
  <syntax>
    <syntax_item>tsOut = delevent(ts, eventName)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ts</param_name>
      <param_description>Objet timeseries en entree.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>eventName</param_name>
      <param_description>Nom de l'evenement a supprimer.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tsOut</param_name>
      <param_description>Objet timeseries en sortie avec l'evenement supprime.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>delevent</b> Supprime de la liste Events les evenements nommes correspondants.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_data runnable="cli"><![CDATA[ts = timeseries([1; 2; 3], [10; 11; 12]);
ts = addevent(ts, tsdata.event('middle', 11));
ts = delevent(ts, 'middle');
numel(ts.Events)
]]></example_item_data>
    </example_item>
  </examples>
