      <example_item_description>Utilisation de base.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[d = timeofday(datetime(2024, 1, 1, 12, 30, 0))
seconds(d)
]]></example_item_data>
    </example_item>
  </examples>
