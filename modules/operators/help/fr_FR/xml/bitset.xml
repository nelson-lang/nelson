  <language>fr_FR</language>
  <keyword>bitset</keyword>
  <short_description>Positionne un bit à une position donnée.</short_description>
  <syntax>
    <syntax_item>r = bitset(A, pos)</syntax_item>
    <syntax_item>r = bitset(A, pos, val)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>un tableau d&apos;entiers.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>pos</param_name>
      <param_description>la position du bit (1 est le bit de poids faible).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>val</param_name>
      <param_description>la valeur du bit, <b>0</b> ou <b>1</b> (par défaut <b>1</b>).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>r</param_name>
      <param_description><b>A</b> avec le bit en position <b>pos</b> fixé à <b>val</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>r = bitset(A, pos)</b> met à <b>1</b> le bit en position <b>pos</b> de <b>A</b>.</p>
    <p><b>r = bitset(A, pos, val)</b> met ce bit à <b>val</b>.</p>
  </description>
  <used_function />
