  <language>fr_FR</language>
  <keyword>bitget</keyword>
  <short_description>Retourne des bits selectionnes.</short_description>
  <syntax><syntax_item>C = bitget(A, bit)</syntax_item><syntax_item>C = bitget(A, bit, assumedtype)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>Tableau entier, ou tableau double avec valeurs entieres positives.</param_description></param_input_item>
    <param_input_item><param_name>bit</param_name><param_description>Position de bit entiere positive.</param_description></param_input_item>
    <param_input_item><param_name>assumedtype</param_name><param_description>Nom de type entier utilise pour une entree double.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>C</param_name><param_description>Tableau contenant des valeurs zero ou un.</param_description></param_output_item></param_output>
  <description><p><b>C = bitget(A, bit)</b> retourne la valeur du bit selectionne pour chaque element de <b>A</b>.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[R = bitget(uint8([1 2 3]), 1)]]></example_item_data></example_item></examples>
