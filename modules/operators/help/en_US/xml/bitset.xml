  <language>en_US</language>
  <keyword>bitset</keyword>
  <short_description>Set bit at a specified position.</short_description>
  <syntax>
    <syntax_item>r = bitset(A, pos)</syntax_item>
    <syntax_item>r = bitset(A, pos, val)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>an integer array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>pos</param_name>
      <param_description>the bit position (1 is the least significant bit).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>val</param_name>
      <param_description>the bit value, <b>0</b> or <b>1</b> (default <b>1</b>).</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>r</param_name>
      <param_description><b>A</b> with the bit at <b>pos</b> set to <b>val</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>r = bitset(A, pos)</b> sets the bit at position <b>pos</b> of <b>A</b> to <b>1</b>.</p>
    <p><b>r = bitset(A, pos, val)</b> sets that bit to <b>val</b>.</p>
  </description>
