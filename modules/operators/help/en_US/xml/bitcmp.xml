  <language>en_US</language>
  <keyword>bitcmp</keyword>
  <short_description>Bitwise complement.</short_description>
  <syntax>
    <syntax_item>r = bitcmp(A)</syntax_item>
    <syntax_item>r = bitcmp(A, assumedtype)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>an integer array, or a double with nonnegative integer values.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>assumedtype</param_name>
      <param_description>an integer class name used to interpret a double <b>A</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>r</param_name>
      <param_description>the bitwise complement of <b>A</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>r = bitcmp(A)</b> returns the bitwise complement of <b>A</b>, where the width is given by the integer class of <b>A</b>.</p>
    <p>When <b>A</b> is a double, pass <b>assumedtype</b> (for example <b>&apos;uint8&apos;</b>) to set the bit width; the result stays double.</p>
  </description>
  <used_function />
