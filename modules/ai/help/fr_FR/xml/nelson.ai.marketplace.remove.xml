  <keyword>nelson.ai.marketplace.remove</keyword>
  <short_description>Supprime un paquet de compétence installé de l'assistant.</short_description>
  <syntax>
    <syntax_item>nelson.ai.marketplace.remove(name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>une chaîne de caractères : le nom d'un paquet installé, tel que listé par <b>nelson.ai.marketplace.installed</b>.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>nelson.ai.marketplace.remove</b> supprime un paquet de compétence installé de l'assistant du répertoire des compétences utilisateur.</p>
    <p>Lorsqu'aucun paquet de ce nom n'est installé, une erreur est levée.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Supprimer un paquet installé.</example_item_description>
      <example_item_data runnable="false"><![CDATA[
nelson.ai.marketplace.remove('nelson-plotting')
]]></example_item_data>
    </example_item>
  </examples>
