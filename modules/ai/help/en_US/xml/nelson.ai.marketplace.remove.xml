  <keyword>nelson.ai.marketplace.remove</keyword>
  <short_description>Remove an installed assistant skill package.</short_description>
  <syntax>
    <syntax_item>nelson.ai.marketplace.remove(name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>a string: the name of an installed package, as listed by <b>nelson.ai.marketplace.installed</b>.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>nelson.ai.marketplace.remove</b> deletes an installed assistant skill package from the user skills directory.</p>
    <p>When no package of that name is installed, an error is raised.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Remove an installed package.</example_item_description>
      <example_item_data runnable="false"><![CDATA[
nelson.ai.marketplace.remove('nelson-plotting')
]]></example_item_data>
    </example_item>
  </examples>
