  <language>en_US</language>
  <keyword>nelson.ai.marketplace.install</keyword>
  <short_description>Install an assistant skill package.</short_description>
  <syntax>
    <syntax_item>nelson.ai.marketplace.install(source)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>source</param_name>
      <param_description>a string: a local <b>.nmz</b> or <b>.zip</b> file, or the name of a package in the catalog, which is then downloaded first.</param_description>
    </param_input_item>
  </param_input>
  <description>
    <p><b>nelson.ai.marketplace.install</b> installs an assistant skill package into the user skills directory, under the preferences directory.</p>
    <p>A <b>.nmz</b> package is a zip archive that contains a <b>SKILL.md</b> file. When <b>source</b> is a catalog name, the package is downloaded with <b>nelson.ai.marketplace.search</b> before being installed; an unknown name raises an error.</p>
    <p>An already installed package with the same base name is replaced. After installation, the skill appears in <b>nelson.ai.skills</b> with the source <b>user</b>.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Install a package by catalog name.</example_item_description>
      <example_item_data runnable="false"><![CDATA[
nelson.ai.marketplace.install('nelson-plotting')
]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Install a local package file.</example_item_description>
      <example_item_data runnable="false"><![CDATA[
nelson.ai.marketplace.install([tempdir(), '/my-skill.nmz'])
]]></example_item_data>
    </example_item>
  </examples>
