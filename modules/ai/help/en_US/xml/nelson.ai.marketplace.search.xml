  <keyword>nelson.ai.marketplace.search</keyword>
  <short_description>Search the assistant skill marketplace catalog.</short_description>
  <syntax>
    <syntax_item>result = nelson.ai.marketplace.search()</syntax_item>
    <syntax_item>result = nelson.ai.marketplace.search(query)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>query</param_name>
      <param_description>a string: filter text matched against each entry name and description. When omitted or empty, the whole catalog is returned.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>result</param_name>
      <param_description>a struct array, one entry per package, with the fields <b>name</b>, <b>description</b> and <b>url</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>nelson.ai.marketplace.search</b> queries the online skill catalog and returns the matching packages.</p>
    <p>When the catalog cannot be reached, an empty result is returned rather than raising an error.</p>
    <p>Pass a returned package <b>name</b> to <b>nelson.ai.marketplace.install</b> to install it.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>List the whole catalog.</example_item_description>
      <example_item_data runnable="false"><![CDATA[
result = nelson.ai.marketplace.search()
]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Search for a topic.</example_item_description>
      <example_item_data runnable="false"><![CDATA[
result = nelson.ai.marketplace.search('plot')
]]></example_item_data>
    </example_item>
  </examples>
