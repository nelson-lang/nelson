  <language>en_US</language>
  <keyword>setvartype</keyword>
  <short_description>Set variable data types for selected variables.</short_description>
  <syntax>
    <syntax_item>opts = setvartype(opts, selection, types)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>opts</param_name>
      <param_description>an import options object (delimited text or spreadsheet).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>selection</param_name>
      <param_description>variable names (character vector, string array or cell of character vectors) or numeric indices.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>types</param_name>
      <param_description>a single type applied to all selected variables, or one type per selected variable.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>opts</param_name>
      <param_description>the updated import options object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>setvartype</b> sets the data types of the selected variables of an import options object, updating both <b>VariableTypes</b> and the per-variable options.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      >opts = delimitedTextImportOptions('NumVariables', 2);
opts.VariableNames = ["id", "value"];
opts = setvartype(opts, ["id", "value"], 'double')</example_item_data>
    </example_item>
  </examples>
