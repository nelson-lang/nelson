  <language>en_US</language>
  <keyword>spreadsheetImportOptions</keyword>
  <short_description>Create options for importing spreadsheet data.</short_description>
  <syntax>
    <syntax_item>opts = spreadsheetImportOptions()</syntax_item>
    <syntax_item>opts = spreadsheetImportOptions(Name, Value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>Name, Value</param_name>
      <param_description>name-value arguments such as 'NumVariables', 'VariableNames', 'VariableTypes', 'Sheet' or 'DataRange'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>opts</param_name>
      <param_description>nelson.io.spreadsheet.SpreadsheetImportOptions object.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>spreadsheetImportOptions</b> creates an import options object for spreadsheet (xlsx) files.</p>
    <p>The object uses the Nelson class <b>nelson.io.spreadsheet.SpreadsheetImportOptions</b> and is consumed by <b>readtable</b> with the 'UseExcel' option set to false.</p>
    <p>Use <b>setvaropts</b> to configure per-variable options such as the datetime 'InputFormat'.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      >opts = spreadsheetImportOptions('NumVariables', 3);
opts.VariableNames = ["name", "value", "date"];
opts.VariableTypes = ["string", "double", "datetime"]</example_item_data>
    </example_item>
  </examples>
