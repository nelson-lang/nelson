  <language>en_US</language>
  <keyword>xlsfinfo</keyword>
  <short_description>Return information about an Open XML spreadsheet file.</short_description>
  <syntax>
    <syntax_item>status = xlsfinfo(filename)</syntax_item>
    <syntax_item>[status, sheets, format] = xlsfinfo(filename)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>filename</param_name>
      <param_description>a string: .xlsx file name.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>status</param_name>
      <param_description>format status string, or an empty string if the file cannot be read.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>sheets</param_name>
      <param_description>cell array of sheet names.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>format</param_name>
      <param_description>format string.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>xlsfinfo</b> returns workbook metadata for .xlsx files supported by the Open XML backend.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>List workbook sheets.</example_item_description>
      <example_item_data runnable="cli">filename = [tempdir(), &apos;xlsfinfo_example.xlsx&apos;]; xlswrite(filename, [1 2], &apos;Run1&apos;, &apos;A1&apos;); [status, sheets, format] = xlsfinfo(filename)</example_item_data>
    </example_item>
  </examples>
