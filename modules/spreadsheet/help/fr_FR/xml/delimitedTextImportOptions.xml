  <keyword>delimitedTextImportOptions</keyword>
  <short_description>Creer des options pour importer des donnees texte delimitees.</short_description>
  <syntax>
    <syntax_item>opts = delimitedTextImportOptions()</syntax_item>
    <syntax_item>opts = delimitedTextImportOptions(Name, Value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>Name, Value</param_name>
      <param_description>arguments nom-valeur comme 'NumVariables', 'VariableNames', 'VariableTypes', 'Delimiter' ou 'DataLines'.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>opts</param_name>
      <param_description>Objet nelson.io.text.DelimitedTextImportOptions.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>delimitedTextImportOptions</b> cree un objet d&apos;options d&apos;importation pour les fichiers texte delimites.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      >opts = delimitedTextImportOptions('NumVariables', 3) opts.Delimiter = {';'} opts.DataLines = [2 Inf]</example_item_data>
    </example_item>
  </examples>
