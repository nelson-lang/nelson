  <language>fr_FR</language>
  <keyword>xlsread</keyword>
  <short_description>Lire les donnees d&apos;un fichier tableur Open XML.</short_description>
  <syntax>
    <syntax_item>num = xlsread(filename)</syntax_item>
    <syntax_item>num = xlsread(filename, sheet)</syntax_item>
    <syntax_item>num = xlsread(filename, sheet, range)</syntax_item>
    <syntax_item>[num, txt, raw] = xlsread(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>filename</param_name>
      <param_description>une chaine : nom de fichier .xlsx.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>sheet</param_name>
      <param_description>nom de feuille ou indice de feuille positif.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>range</param_name>
      <param_description>plage en notation A1, par exemple &apos;A1&apos; ou &apos;A1:C4&apos;.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>num</param_name>
      <param_description>matrice numerique. Les cellules texte donnent NaN.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>txt</param_name>
      <param_description>cellule contenant les valeurs texte.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>raw</param_name>
      <param_description>cellule contenant les valeurs importees.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>xlsread</b> importe les donnees de fichiers .xlsx avec le backend Open XML.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Lire une plage numerique.</example_item_description>
      <example_item_data runnable="cli">filename = [tempdir(), &apos;xlsread_example.xlsx&apos;]; xlswrite(filename, [1 2; 3 4], &apos;Data&apos;, &apos;B2&apos;); [num, txt, raw] = xlsread(filename, &apos;Data&apos;, &apos;B2:C3&apos;)</example_item_data>
    </example_item>
  </examples>
