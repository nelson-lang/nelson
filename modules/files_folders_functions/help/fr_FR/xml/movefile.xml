  <copyright>SAME AS NELSON SOFTWARE</copyright><language>fr_FR</language><keyword>movefile</keyword>
  <short_description>Deplace un fichier ou un dossier.</short_description>
  <syntax><syntax_item>movefile(source, destination)</syntax_item><syntax_item>[status, msg] = movefile(source, destination)</syntax_item><syntax_item>movefile(source, destination, 'f')</syntax_item></syntax>
  <param_input><param_input_item><param_name>source</param_name><param_description>Fichier, dossier ou liste source.</param_description></param_input_item><param_input_item><param_name>destination</param_name><param_description>Chemin de destination.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>status</param_name><param_description>Indicateur logique de succes.</param_description></param_output_item><param_output_item><param_name>msg</param_name><param_description>Message d'erreur lorsque l'operation echoue.</param_description></param_output_item></param_output>
  <description><p><b>movefile</b> copie la source vers la destination puis supprime la source lorsque la copie reussit.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[status, msg] = movefile('source.txt', 'destination.txt')]]></example_item_data></example_item></examples>
