  <copyright>SAME AS NELSON SOFTWARE</copyright><language>en_US</language><keyword>movefile</keyword>
  <short_description>Move a file or folder.</short_description>
  <syntax><syntax_item>movefile(source, destination)</syntax_item><syntax_item>[status, msg] = movefile(source, destination)</syntax_item><syntax_item>movefile(source, destination, 'f')</syntax_item></syntax>
  <param_input><param_input_item><param_name>source</param_name><param_description>Source file, folder, or list.</param_description></param_input_item><param_input_item><param_name>destination</param_name><param_description>Destination path.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>status</param_name><param_description>Logical success flag.</param_description></param_output_item><param_output_item><param_name>msg</param_name><param_description>Error message when the operation fails.</param_description></param_output_item></param_output>
  <description><p><b>movefile</b> copies the source to the destination and removes the source when the copy succeeds.</p></description>
  <used_function /><bibliography />
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description /><example_item_data runnable="cli"><![CDATA[[status, msg] = movefile('source.txt', 'destination.txt')]]></example_item_data></example_item></examples>
