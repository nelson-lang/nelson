  <language>en_US</language>
  <keyword>py</keyword>
  <short_description>Python namespace proxy.</short_description>
  <syntax>
    <syntax_item>p = py()</syntax_item>
    <syntax_item>p.module.function(...)</syntax_item>
  </syntax>
  <param_output>
    <param_output_item>
      <param_name>p</param_name>
      <param_description>Python namespace proxy object.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>pyValue</param_name>
      <param_description>Python object returned by the called function.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>py returns a proxy object used to access Python builtins and modules from Nelson.</p>
    <p>Use attribute access on the returned object to import modules or call Python functions.</p>
  </description>
  <used_function>
    <used_function_item>pyenv</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Call a Python built-in through the namespace proxy.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[p = py();
pyValue = p.int(42)]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${python_engine}pyenv">pyenv</link></see_also_item>
    <see_also_item><link linkend="${python_engine}pyrun">pyrun</link></see_also_item>
    <see_also_item><link linkend="${python_engine}pyrunfile">pyrunfile</link></see_also_item>
  </see_also>
