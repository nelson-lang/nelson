  <language>en_US</language>
  <keyword>numunique</keyword>
  <short_description>Number of distinct values.</short_description>
  <syntax>
    <syntax_item>n = numunique(A)</syntax_item>
    <syntax_item>n = numunique(A, 'rows')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>an array, a cell array of character vectors or a string array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'rows'</param_name>
      <param_description>counts distinct rows instead of distinct elements.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>n</param_name>
      <param_description>a double scalar: the number of distinct values (or rows).</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>n = numunique(A)</b> returns the number of distinct elements of <b>A</b>. Every <b>NaN</b> value counts as distinct.</p>
    <p><b>n = numunique(A, 'rows')</b> returns the number of distinct rows of <b>A</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[numunique([1 2 2 NaN NaN])
numunique([1 2; 1 2], 'rows')]]></example_item_data>
    </example_item>
  </examples>
