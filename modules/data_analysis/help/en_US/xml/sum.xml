  <language>en_US</language>
  <keyword>sum</keyword>
  <short_description>Sum of array elements.</short_description>
  <syntax>
    <syntax_item>R = sum(M)</syntax_item>
    <syntax_item>R = sum(M, d)</syntax_item>
    <syntax_item>R = sum(M, 'all')</syntax_item>
    <syntax_item>R = sum(M, ___, f)</syntax_item>
    <syntax_item>R = sum(M, d, t)</syntax_item>
    <syntax_item>R = sum(M, 'all', t, f)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>M</param_name>
      <param_description
      >an array of double, single, integers, ...</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>d</param_name>
      <param_description
      >dimension to operate along: positive integer scalar.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'all'</param_name>
      <param_description>sum all elements of M and return a scalar.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>t</param_name>
      <param_description
      >a string: &apos;default&apos;, &apos;double&apos; or &apos;native&apos;.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>f</param_name>
      <param_description
      >a string: &apos;includenan&apos; or &apos;omitnan&apos;.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>Sum of array elements.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>R = sum(M)</b> returns the sum along the first non-singleton dimension of M.</p>
    <p>
      <b>R = sum(M, d)</b> sums along dimension d. <b>R = sum(M, 'all')</b> sums all elements of M and returns a scalar.</p>
    <p>
      Optional text arguments control the output type (<b>'default'</b>, <b>'double'</b> or <b>'native'</b>) and NaN handling (<b>'includenan'</b> or <b>'omitnan'</b>).</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Sum along a dimension.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[M = [1 2; 3 4];
R = sum(M, 2)
]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Sum all elements.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[M = [1 2; 3 4];
R = sum(M, 'all')
]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Keep the native integer output type.</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[M = uint8([10:30:70;20:30:80;30:30:90]);
R = sum(M, 'native')]]></example_item_data>
    </example_item>
  </examples>
