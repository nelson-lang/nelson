  <language>en_US</language>
  <keyword>trimdata</keyword>
  <short_description>Trim data to a given length.</short_description>
  <syntax>
    <syntax_item>B = trimdata(A, m)</syntax_item>
    <syntax_item>B = trimdata(A, m, Name, Value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>an array: numeric, logical, char, string or cell.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>m</param_name>
      <param_description>target length: a scalar, or a vector with one length per dimension.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Side</param_name>
      <param_description><b>'trailing'</b> (default), <b>'leading'</b> or <b>'both'</b>.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Dimension</param_name>
      <param_description><b>'auto'</b> (default) or the dimensions to operate along.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>the trimmed array.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>B = trimdata(A, m)</b> removes trailing elements so that <b>A</b> has length <b>m</b> along its first non-singleton dimension. Data already shorter than <b>m</b> is unchanged.</p>
    <p>When <b>m</b> is a vector, <b>m(k)</b> is the length along dimension <b>k</b>.</p>
    <p>With <b>'Side', 'leading'</b> the first elements are removed. With <b>'both'</b>, <b>floor(r/2)</b> elements are removed at the start and the rest at the end, <b>r</b> being the number to remove.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[trimdata(1:6, 4)
trimdata(1:6, 3, 'Side', 'both')
trimdata(magic(4), [2 3])]]></example_item_data>
    </example_item>
  </examples>
