  <language>en_US</language>
  <keyword>movmin</keyword>
  <short_description>Moving minimum.</short_description>
  <syntax>
    <syntax_item>R = movmin(A, window)</syntax_item>
    <syntax_item>R = movmin(A, window, d)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>input array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>window</param_name>
      <param_description>positive scalar window length.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>d</param_name>
      <param_description>dimension to operate along: positive integer scalar.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>Moving minimum.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>movmin</b> computes minimum values over a centered moving window.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = [1 2 8 4 5];
R = movmin(A, 3)]]></example_item_data>
    </example_item>
  </examples>
