  <language>en_US</language>
  <keyword>paddata</keyword>
  <short_description>Pad data to a given length.</short_description>
  <syntax>
    <syntax_item>B = paddata(A, m)</syntax_item>
    <syntax_item>B = paddata(A, m, Name, Value)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>an array: numeric, logical, char, string or cell.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>m</param_name>
      <param_description>target length: a scalar, or a vector with one length per dimension.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Pattern</param_name>
      <param_description><b>'constant'</b> (default), <b>'edge'</b>, <b>'circular'</b>, <b>'flip'</b> or <b>'reflect'</b>.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>FillValue</param_name>
      <param_description>value used by the <b>'constant'</b> pattern. Default: 0, <b>false</b>, <b>char(0)</b>, a missing string or an empty cell.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Side</param_name>
      <param_description><b>'trailing'</b> (default), <b>'leading'</b> or <b>'both'</b>.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>Dimension</param_name>
      <param_description><b>'auto'</b> (default) or the dimensions to operate along.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>the padded array.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>B = paddata(A, m)</b> appends values so that <b>A</b> has length <b>m</b> along its first non-singleton dimension. Data already longer than <b>m</b> is unchanged.</p>
    <p><b>'edge'</b> repeats the end values, <b>'circular'</b> repeats the data periodically, <b>'flip'</b> mirrors it including the end values and <b>'reflect'</b> mirrors it without repeating them.</p>
    <p>With <b>'Side', 'both'</b>, <b>floor(r/2)</b> values are added at the start and the rest at the end, <b>r</b> being the number to add.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[paddata(1:3, 5)
paddata(1:3, 8, 'Pattern', 'reflect')
paddata([1 2; 3 4], [3 4], 'FillValue', NaN)]]></example_item_data>
    </example_item>
  </examples>
