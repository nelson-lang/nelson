  <language>en_US</language>
  <keyword>anymissing</keyword>
  <short_description>Check whether an array contains missing values.</short_description>
  <syntax>
    <syntax_item>tf = anymissing(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>an array, table or categorical.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>a logical scalar: <b>true</b> when <b>A</b> has any missing value.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = anymissing(A)</b> returns <b>true</b> when <b>A</b> contains at least one missing value (for example <b>NaN</b> or <b>missing</b>).</p>
  </description>
  <used_function />
