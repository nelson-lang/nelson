  <language>en_US</language>
  <keyword>anynan</keyword>
  <short_description>Check whether an array contains NaN values.</short_description>
  <syntax>
    <syntax_item>tf = anynan(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>a numeric, char or logical array.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>a logical scalar: <b>true</b> when <b>A</b> has at least one <b>NaN</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = anynan(A)</b> returns <b>true</b> when at least one element of <b>A</b> is <b>NaN</b>, including complex values with a <b>NaN</b> part. Integer, char and logical arrays never hold <b>NaN</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[anynan([1 NaN 3])
anynan(int8([1 2]))]]></example_item_data>
    </example_item>
  </examples>
