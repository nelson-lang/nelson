  <language>en_US</language>
  <keyword>allunique</keyword>
  <short_description>Check whether all values are distinct.</short_description>
  <syntax>
    <syntax_item>tf = allunique(A)</syntax_item>
    <syntax_item>tf = allunique(A, 'rows')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>an array, a cell array of character vectors or a string array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'rows'</param_name>
      <param_description>compares rows instead of elements.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>a logical scalar: <b>true</b> when no value (or row) appears twice.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = allunique(A)</b> returns <b>true</b> when every element of <b>A</b> is distinct. <b>NaN</b> values are all distinct, and an empty array gives <b>true</b>.</p>
    <p><b>tf = allunique(A, 'rows')</b> compares the rows of <b>A</b>.</p>
  </description>
