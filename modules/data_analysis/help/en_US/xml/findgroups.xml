  <language>en_US</language>
  <keyword>findgroups</keyword>
  <short_description>Find groups and return group numbers.</short_description>
  <syntax>
    <syntax_item>G = findgroups(A)</syntax_item>
    <syntax_item>[G, ID] = findgroups(A)</syntax_item>
    <syntax_item>[G, ID1, ..., IDn] = findgroups(A1, ..., An)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A, A1, ..., An</param_name>
      <param_description>grouping variables with the same number of elements.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>G</param_name>
      <param_description>group numbers; missing values map to <b>NaN</b>.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ID</param_name>
      <param_description>the group identifiers, one output per grouping variable.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>G = findgroups(A)</b> returns a vector of group numbers created from the grouping variable <b>A</b>.</p>
    <p>Use <b>G</b> with <b>splitapply</b> to apply a function to each group.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[[G, id] = findgroups([10; 20; 10; 30; 20])]]></example_item_data>
    </example_item>
  </examples>
