  <language>en_US</language>
  <keyword>rescale</keyword>
  <short_description>Scale array elements to a fixed interval.</short_description>
  <syntax>
    <syntax_item>Y = rescale(X)</syntax_item>
    <syntax_item>Y = rescale(X, a, b)</syntax_item>
    <syntax_item>Y = rescale(..., &apos;InputMin&apos;, lo, &apos;InputMax&apos;, hi)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>a numeric array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>a, b</param_name>
      <param_description>the bounds of the output interval (default <b>0</b> and <b>1</b>).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>lo, hi</param_name>
      <param_description>optional input limits mapped to <b>a</b> and <b>b</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>the rescaled array, same size as <b>X</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>Y = rescale(X)</b> scales the entries of <b>X</b> to the interval <b>[0, 1]</b>.</p>
    <p><b>Y = rescale(X, a, b)</b> scales the entries to the interval <b>[a, b]</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[Y = rescale([1 2 3 4 5])
Z = rescale([1 2 3 4 5], 0, 10)]]></example_item_data>
    </example_item>
  </examples>
