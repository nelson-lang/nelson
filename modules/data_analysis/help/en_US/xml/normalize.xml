  <language>en_US</language>
  <keyword>normalize</keyword>
  <short_description>Normalize data.</short_description>
  <syntax>
    <syntax_item>N = normalize(A)</syntax_item>
    <syntax_item>N = normalize(A, method)</syntax_item>
    <syntax_item>N = normalize(A, method, methodtype)</syntax_item>
    <syntax_item>N = normalize(A, dim, ___)</syntax_item>
    <syntax_item>[N, C, S] = normalize(___)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>numeric or logical array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>method</param_name>
      <param_description>'zscore', 'norm', 'range', 'center', 'scale', or 'medianiqr'.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>methodtype</param_name>
      <param_description>option for the chosen method (e.g. 'std' or 'robust' for 'zscore', a norm order for 'norm', a two-element interval for 'range').</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>dimension along which to operate.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>N</param_name>
      <param_description>normalized data.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>C</param_name>
      <param_description>centering value used.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>S</param_name>
      <param_description>scaling value used.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>normalize</b> returns the vectorwise z-score of the data in A (centering by the mean and scaling by the standard deviation). A method and method type can select other normalizations. By default normalize operates along the first array dimension whose size does not equal 1.</p>
  </description>
