  <language>en_US</language>
  <keyword>summary</keyword>
  <short_description>Summarize table variables or categorical values.</short_description>
  <syntax>
    <syntax_item>S = summary(T)</syntax_item>
    <syntax_item>summary(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>T</param_name>
      <param_description>Input table.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Input categorical array.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>S</param_name>
      <param_description>Structure with table variable summary information.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>summary</b> returns size and type information for each table variable.</p>
    <p>Numeric table variables also include minimum, maximum, mean, median, standard deviation, and missing value counts.</p>
    <p>For categorical arrays, <b>summary</b> displays the count for each category and for undefined values.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Summarize a table.</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[T = table([1; 2; 3], ["a"; "b"; "c"], 'VariableNames', {'A', 'Label'});
S = summary(T)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Display categorical counts.</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[A = categorical({'red','blue','red',''});
summary(A)]]></example_item_data>
    </example_item>
  </examples>
