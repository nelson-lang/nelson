  <language>fr_FR</language>
  <keyword>anymissing</keyword>
  <short_description>Teste la présence de valeurs manquantes.</short_description>
  <syntax>
    <syntax_item>tf = anymissing(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>un tableau, une table ou un categorical.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>un scalaire logique : <b>true</b> si <b>A</b> contient au moins une valeur manquante.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = anymissing(A)</b> renvoie <b>true</b> si <b>A</b> contient au moins une valeur manquante (par exemple <b>NaN</b> ou <b>missing</b>).</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[anymissing([1 NaN 3])]]></example_item_data>
    </example_item>
  </examples>
