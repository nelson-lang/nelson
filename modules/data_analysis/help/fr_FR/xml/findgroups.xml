  <keyword>findgroups</keyword>
  <short_description>Trouve les groupes et renvoie les numéros de groupe.</short_description>
  <syntax>
    <syntax_item>G = findgroups(A)</syntax_item>
    <syntax_item>[G, ID] = findgroups(A)</syntax_item>
    <syntax_item>[G, ID1, ..., IDn] = findgroups(A1, ..., An)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A, A1, ..., An</param_name>
      <param_description>variables de regroupement ayant le même nombre d&apos;éléments.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>G</param_name>
      <param_description>numéros de groupe ; les valeurs manquantes valent <b>NaN</b>.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>ID</param_name>
      <param_description>les identifiants de groupe, une sortie par variable de regroupement.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>G = findgroups(A)</b> renvoie un vecteur de numéros de groupe construit à partir de la variable de regroupement <b>A</b>.</p>
    <p>Utilisez <b>G</b> avec <b>splitapply</b> pour appliquer une fonction à chaque groupe.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[[G, id] = findgroups([10; 20; 10; 30; 20])]]></example_item_data>
    </example_item>
  </examples>
