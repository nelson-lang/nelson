  <language>fr_FR</language>
  <keyword>numunique</keyword>
  <short_description>Nombre de valeurs distinctes.</short_description>
  <syntax>
    <syntax_item>n = numunique(A)</syntax_item>
    <syntax_item>n = numunique(A, 'rows')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>un tableau, un tableau de cellules de vecteurs de caractères ou un tableau de chaînes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'rows'</param_name>
      <param_description>compte les lignes distinctes au lieu des éléments distincts.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>n</param_name>
      <param_description>un scalaire double : le nombre de valeurs (ou de lignes) distinctes.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>n = numunique(A)</b> renvoie le nombre d'éléments distincts de <b>A</b>. Chaque valeur <b>NaN</b> compte comme distincte.</p>
    <p><b>n = numunique(A, 'rows')</b> renvoie le nombre de lignes distinctes de <b>A</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[numunique([1 2 2 NaN NaN])
numunique([1 2; 1 2], 'rows')]]></example_item_data>
    </example_item>
  </examples>
