  <language>fr_FR</language>
  <keyword>rescale</keyword>
  <short_description>Met à l&apos;échelle les éléments dans un intervalle fixé.</short_description>
  <syntax>
    <syntax_item>Y = rescale(X)</syntax_item>
    <syntax_item>Y = rescale(X, a, b)</syntax_item>
    <syntax_item>Y = rescale(..., &apos;InputMin&apos;, lo, &apos;InputMax&apos;, hi)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>X</param_name>
      <param_description>un tableau numérique.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>a, b</param_name>
      <param_description>les bornes de l&apos;intervalle de sortie (par défaut <b>0</b> et <b>1</b>).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>lo, hi</param_name>
      <param_description>limites d&apos;entrée optionnelles associées à <b>a</b> et <b>b</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>Y</param_name>
      <param_description>le tableau mis à l&apos;échelle, de même taille que <b>X</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>Y = rescale(X)</b> met les éléments de <b>X</b> à l&apos;échelle sur l&apos;intervalle <b>[0, 1]</b>.</p>
    <p><b>Y = rescale(X, a, b)</b> met les éléments à l&apos;échelle sur l&apos;intervalle <b>[a, b]</b>.</p>
  </description>
  <used_function />
