  <language>fr_FR</language>
  <keyword>movstd</keyword>
  <short_description>Ecart type mobile.</short_description>
  <syntax>
    <syntax_item>R = movstd(A, window)</syntax_item>
    <syntax_item>R = movstd(A, window, d)</syntax_item>
    <syntax_item>R = movstd(..., nanflag)</syntax_item>
    <syntax_item>R = movstd(..., 'Endpoints', endpoints)</syntax_item>
    <syntax_item>[R, M] = movstd(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>tableau d'entrée.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>window</param_name>
      <param_description>longueur de la fenêtre : scalaire positif.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>d</param_name>
      <param_description>dimension de travail : entier positif scalaire.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>Écart type mobile.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>M</param_name>
      <param_description>Moyenne mobile calculée sur les mêmes fenêtres que R (même taille que R ; une timetable pour une entrée timetable).</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>movstd</b> calcule les ecarts types sur une fenetre mobile centree.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = [1 2 8 4 5];
R = movstd(A, 3)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Écart type mobile et moyenne mobile</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = [4 8 6 -1 -2 -3 -1 3 4 5];
[R, M] = movstd(A, 3)]]></example_item_data>
    </example_item>
  </examples>
