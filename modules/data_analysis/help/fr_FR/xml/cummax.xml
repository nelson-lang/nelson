  <language>fr_FR</language>
  <keyword>cummax</keyword>
  <short_description>Maximum cumulatif des elements d'un tableau.</short_description>
  <syntax>
    <syntax_item>R = cummax(A)</syntax_item>
    <syntax_item>R = cummax(A, d)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>input array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>d</param_name>
      <param_description>dimension to operate along: positive integer scalar.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description>Cumulative maximum of array elements.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>cummax</b> renvoie les maximums cumulatifs selon la dimension choisie.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description></example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = [3 1 4 2];
R = cummax(A)]]></example_item_data>
    </example_item>
  </examples>
