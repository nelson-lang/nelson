  <language>fr_FR</language>
  <keyword>anynan</keyword>
  <short_description>Teste si un tableau contient des valeurs NaN.</short_description>
  <syntax>
    <syntax_item>tf = anynan(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>un tableau numérique, char ou logique.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>un scalaire logique : <b>true</b> si <b>A</b> contient au moins un <b>NaN</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = anynan(A)</b> renvoie <b>true</b> si au moins un élément de <b>A</b> vaut <b>NaN</b>, y compris les valeurs complexes avec une partie <b>NaN</b>. Les tableaux entiers, char et logiques ne contiennent jamais de <b>NaN</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[anynan([1 NaN 3])
anynan(int8([1 2]))]]></example_item_data>
    </example_item>
  </examples>
