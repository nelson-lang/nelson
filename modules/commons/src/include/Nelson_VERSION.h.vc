#pragma once

#define NELSON_PRODUCT_NAME "Nelson"
#define NELSON_RELEASE_NAME "Forge"
#define NELSON_VERSION_MAJOR 2
#define NELSON_VERSION_MINOR 0
#define NELSON_VERSION_MAINTENANCE 0
#define NELSON_VERSION_BUILD 0
#define NELSON_VERSION_COMMIT_HASH "5ea26fee9712f324f91f7480549db3e8607bda3c"

/*VERSION string */
#define __quote(x) #x
#define __stringify(x) __quote(x)

#define NELSON_SEMANTIC_VERSION_STRING __stringify(NELSON_VERSION_MAJOR) "." __stringify(NELSON_VERSION_MINOR) "." __stringify(NELSON_VERSION_MAINTENANCE)
#define NELSON_VERSION_STRING __stringify(NELSON_VERSION_MAJOR) "." __stringify(NELSON_VERSION_MINOR) "." __stringify(NELSON_VERSION_MAINTENANCE) "." __stringify(NELSON_VERSION_BUILD)
#define NELSON_VERSION_NMMM_STRING  NELSON_PRODUCT_NAME "-" __stringify(NELSON_VERSION_MAJOR) "." __stringify(NELSON_VERSION_MINOR) "." __stringify(NELSON_VERSION_MAINTENANCE)
