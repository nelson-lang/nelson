  <language>fr_FR</language>
  <keyword>setcats</keyword>
  <short_description>Définir la liste des catégories d'un tableau catégoriel.</short_description>
  <syntax><syntax_item>B = setcats(A, newCategories)</syntax_item></syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>Tableau catégoriel d'entrée.</param_description></param_input_item>
    <param_input_item><param_name>newCategories</param_name><param_description>Liste complète de remplacement des catégories.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>B</param_name><param_description>Tableau catégoriel utilisant exactement les catégories listées dans <b>newCategories</b>.</param_description></param_output_item></param_output>
  <description>
    <p><b>setcats</b> remplace la liste des catégories d'un tableau catégoriel.</p>
    <p>Les éléments dont l'ancienne catégorie n'est pas présenté dans <b>newCategories</b> deviennent non définis. Les nouvelles catégories absentes auparavant sont ajoutées comme catégories inutilisées.</p>
  </description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Conserver seulement certaines catégories.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue','green'}); B = setcats(A, {'red','blue'}); isundefined(B)]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Ajouter une catégorie inutilisée avec une liste complète.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'}); B = setcats(A, {'red','blue','green'}); categories(B)]]></example_item_data></example_item>
  </examples>
