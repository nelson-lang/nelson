  <language>fr_FR</language>
  <keyword>categories</keyword>
  <short_description>Lister les categories d'un tableau categoriel.</short_description>
  <syntax>
    <syntax_item>names = categories(A)</syntax_item>
    <syntax_item>names = categories(A, 'OutputType', type)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>Tableau categoriel d'entree.</param_description></param_input_item>
    <param_input_item><param_name>type</param_name><param_description>Representation de sortie: <b>'char'</b>, <b>'string'</b> ou <b>'categorical'</b>.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>names</param_name><param_description>Noms de categories dans l'ordre des categories.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>categories</b> retourne la liste des categories associee a un tableau categoriel.</p>
    <p>Les elements non definis ne sont pas des categories. La sortie par defaut est un tableau de cellules de chaines de caracteres.</p>
  </description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Retourner les noms de categories.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue','red'}); names = categories(A)]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Retourner les noms sous forme de strings.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'small','large'}); names = categories(A, 'OutputType', 'string')]]></example_item_data></example_item>
  </examples>
