  <language>fr_FR</language>
  <keyword>mergecats</keyword>
  <short_description>Fusionner des catégories dans un tableau catégoriel.</short_description>
  <syntax>
    <syntax_item>B = mergecats(A, oldCategories)</syntax_item>
    <syntax_item>B = mergecats(A, oldCategories, newCategory)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>Tableau catégoriel d'entrée.</param_description></param_input_item>
    <param_input_item><param_name>oldCategories</param_name><param_description>Catégories dont les éléments sont fusionnes.</param_description></param_input_item>
    <param_input_item><param_name>newCategory</param_name><param_description>Nom de la catégorie fusionnée. Si omis, la première catégorie de <b>oldCategories</b> est conservée.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>B</param_name><param_description>Tableau catégoriel avec les codes de catégories fusionnes.</param_description></param_output_item></param_output>
  <description>
    <p><b>mergecats</b> remplace plusieurs catégories par une seule catégorie et réaffecte tous les éléments correspondants.</p>
    <p>Les catégories non listées dans <b>oldCategories</b> conservent leurs valeurs et leur ordre relatif.</p>
  </description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>Fusionner plusieurs catégories en une catégorie.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue','green'}); B = mergecats(A, {'blue','green'}, 'other'); categories(B)]]></example_item_data></example_item></examples>
