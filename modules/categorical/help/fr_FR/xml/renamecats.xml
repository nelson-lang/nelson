  <language>fr_FR</language>
  <keyword>renamecats</keyword>
  <short_description>Renommer les catégories d'un tableau catégoriel.</short_description>
  <syntax>
    <syntax_item>B = renamecats(A, newNames)</syntax_item>
    <syntax_item>B = renamecats(A, oldNames, newNames)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>Tableau catégoriel d'entrée.</param_description></param_input_item>
    <param_input_item><param_name>oldNames</param_name><param_description>Noms de catégories existantes a renommer.</param_description></param_input_item>
    <param_input_item><param_name>newNames</param_name><param_description>Nouveaux noms. Avec deux entrées, il faut fournir un nom pour chaque catégorie.</param_description></param_input_item>
  </param_input>
  <param_output><param_output_item><param_name>B</param_name><param_description>Tableau catégoriel dont les noms de catégories ont été modifiés sans changer les codes.</param_description></param_output_item></param_output>
  <description>
    <p><b>renamecats</b> modifie les libellés de catégories tout en conservant les éléments dans leurs catégories.</p>
    <p>Les nouveaux noms doivent être validés et uniques après l'opération.</p>
  </description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Renommer une catégorie.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'}); B = renamecats(A, 'red', 'rouge'); categories(B)]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Renommer toutes les catégories.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'}); B = renamecats(A, {'bleu','rouge'}); categories(B)]]></example_item_data></example_item>
  </examples>
