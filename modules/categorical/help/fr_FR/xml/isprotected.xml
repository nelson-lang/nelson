  <language>fr_FR</language>
  <keyword>isprotected</keyword>
  <short_description>Determiner si un tableau categoriel est protege.</short_description>
  <syntax><syntax_item>tf = isprotected(A)</syntax_item></syntax>
  <param_input><param_input_item><param_name>A</param_name><param_description>Valeur d'entree.</param_description></param_input_item></param_input>
  <param_output><param_output_item><param_name>tf</param_name><param_description>Scalaire logique qui vaut <b>true</b> pour les tableaux categoriels proteges.</param_description></param_output_item></param_output>
  <description>
    <p><b>isprotected</b> indique si un tableau categoriel empeche l'ajout implicite de categories pendant une affectation.</p>
    <p>Les tableaux categoriels ordinaux sont automatiquement proteges.</p>
  </description>
  <examples><example_item><example_item_type>nelson</example_item_type><example_item_description>Creer puis tester un tableau protege.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'low','high'}, {'low','high'}, 'Protected', true); tf = isprotected(A)]]></example_item_data></example_item></examples>
