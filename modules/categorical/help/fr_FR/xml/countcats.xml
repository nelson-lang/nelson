  <language>fr_FR</language>
  <keyword>countcats</keyword>
  <short_description>Compter les elements categoriels par categorie.</short_description>
  <syntax>
    <syntax_item>counts = countcats(A)</syntax_item>
    <syntax_item>counts = countcats(A, dim)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>Tableau categoriel d'entree.</param_description></param_input_item>
    <param_input_item><param_name>dim</param_name><param_description>Dimension de comptage. Les valeurs prises en charge sont <b>1</b> et <b>2</b>.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>counts</param_name><param_description>Comptes dans l'ordre des categories. Les elements non definis ne sont pas comptes.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>countcats</b> compte le nombre d'elements appartenant a chaque categorie de <b>A</b>.</p>
    <p>Pour les matrices, <b>dim</b> indique si le comptage se fait par colonne ou par ligne.</p>
  </description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Compter les elements dans chaque categorie.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue','red',''}); counts = countcats(A)]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Compter par ligne.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'; 'red','red'}); counts = countcats(A, 2)]]></example_item_data></example_item>
  </examples>
