  <language>fr_FR</language>
  <keyword>addcats</keyword>
  <short_description>Ajouter des catégories a un tableau catégoriel.</short_description>
  <syntax>
    <syntax_item>B = addcats(A, names)</syntax_item>
    <syntax_item>B = addcats(A, names, 'Before', anchor)</syntax_item>
    <syntax_item>B = addcats(A, names, 'After', anchor)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item><param_name>A</param_name><param_description>Tableau catégoriel d'entrée.</param_description></param_input_item>
    <param_input_item><param_name>names</param_name><param_description>Nom ou liste de noms de catégories à ajouter. Les noms déjà présents sont ignorés.</param_description></param_input_item>
    <param_input_item><param_name>anchor</param_name><param_description>Catégorie existante utilisée comme point d'insertion avec <b>Before</b> ou <b>After</b>.</param_description></param_input_item>
  </param_input>
  <param_output>
    <param_output_item><param_name>B</param_name><param_description>Tableau catégoriel avec les mêmes valeurs que <b>A</b> et une liste de catégories mise à jour.</param_description></param_output_item>
  </param_output>
  <description>
    <p><b>addcats</b> ajoute des catégories sans modifier les éléments stockés.</p>
    <p>Pour un tableau catégoriel ordinal, la position doit être précisée car l'ordre des catégories définit les comparaisons.</p>
  </description>
  <examples>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Ajouter une catégorie à la fin.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'}); B = addcats(A, 'green'); categories(B)]]></example_item_data></example_item>
    <example_item><example_item_type>nelson</example_item_type><example_item_description>Insérer une catégorie avant une catégorie existante.</example_item_description><example_item_data runnable="cli"><![CDATA[A = categorical({'low','high'}, {'low','high'}, 'Ordinal', true); B = addcats(A, 'mid', 'Before', 'high'); categories(B)]]></example_item_data></example_item>
  </examples>
