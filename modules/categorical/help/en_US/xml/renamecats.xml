  <language>en_US</language>
  <keyword>renamecats</keyword>
  <short_description>Rename categories in a categorical array.</short_description>
  <syntax>
    <syntax_item>B = renamecats(A, newNames)</syntax_item>
    <syntax_item>B = renamecats(A, oldNames, newNames)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Input categorical array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>oldNames</param_name>
      <param_description>Existing category names to rename.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>newNames</param_name>
      <param_description>Replacement names. With two inputs, this must provide one name for every category.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>Categorical array whose category names have been changed without changing category codes.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>renamecats</b> changes category labels while preserving which elements belong to each category.</p>
    <p>New names must be valid and unique after the rename operation.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Rename one category.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'}); B = renamecats(A, 'red', 'rouge'); categories(B)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Rename all categories.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'}); B = renamecats(A, {'bleu','rouge'}); categories(B)]]></example_item_data>
    </example_item>
  </examples>
