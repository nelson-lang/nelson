  <language>en_US</language>
  <keyword>countcats</keyword>
  <short_description>Count categorical elements by category.</short_description>
  <syntax>
    <syntax_item>counts = countcats(A)</syntax_item>
    <syntax_item>counts = countcats(A, dim)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Input categorical array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dim</param_name>
      <param_description>Dimension along which counts are computed. Supported values are <b>1</b> and <b>2</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>counts</param_name>
      <param_description>Counts in category order. Undefined elements are not counted.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>countcats</b> counts how many elements belong to each category of <b>A</b>.</p>
    <p>For matrices, <b>dim</b> controls whether categories are counted down columns or across rows.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Count elements in each category.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue','red',''}); counts = countcats(A)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Count by row.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'; 'red','red'}); counts = countcats(A, 2)]]></example_item_data>
    </example_item>
  </examples>
