  <language>en_US</language>
  <keyword>iscategorical</keyword>
  <short_description>Determine whether an array is categorical.</short_description>
  <syntax>
    <syntax_item>tf = iscategorical(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Input value.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>Logical scalar that is <b>true</b> when <b>A</b> is a categorical array.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>iscategorical</b> checks the storage type of its input without modifying the input.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Test a categorical array.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'}); tf = iscategorical(A)]]></example_item_data>
    </example_item>
  </examples>
