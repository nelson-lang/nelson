  <language>en_US</language>
  <keyword>isundefined</keyword>
  <short_description>Find undefined categorical elements.</short_description>
  <syntax>
    <syntax_item>tf = isundefined(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Input array.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>Logical array with the same size as <b>A</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>isundefined</b> returns <b>true</b> for categorical elements that do not belong to any category.</p>
    <p>For noncategorical input, the result is a logical array of <b>false</b> values with the same size as the input.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Locate undefined categorical values.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'red','','blue'}); tf = isundefined(A)]]></example_item_data>
    </example_item>
  </examples>
