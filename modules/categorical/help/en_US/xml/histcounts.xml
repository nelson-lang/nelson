  <language>en_US</language>
  <keyword>histcounts</keyword>
  <short_description>Count categorical values for histogram-style summaries.</short_description>
  <syntax>
    <syntax_item>counts = histcounts(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Input categorical array.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>counts</param_name>
      <param_description>Counts for each category in category order.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>histcounts</b> returns category counts for a categorical array.</p>
    <p>The result is equivalent to <b>countcats(A)</b>; undefined elements are ignored.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Count values for each category.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue','red'}); counts = histcounts(A)]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${categorical}countcats">countcats</link></see_also_item>
    <see_also_item><link linkend="${categorical}categories">categories</link></see_also_item>
