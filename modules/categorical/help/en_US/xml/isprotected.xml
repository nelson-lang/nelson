  <language>en_US</language>
  <keyword>isprotected</keyword>
  <short_description>Determine whether a categorical array is protected.</short_description>
  <syntax>
    <syntax_item>tf = isprotected(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Input value.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>Logical scalar that is <b>true</b> for protected categorical arrays.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>isprotected</b> reports whether a categorical array prevents implicit category expansion during assignment.</p>
    <p>Ordinal categorical arrays are protected automatically.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Create a protected categorical array and test it.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'low','high'}, {'low','high'}, 'Protected', true); tf = isprotected(A)]]></example_item_data>
    </example_item>
  </examples>
