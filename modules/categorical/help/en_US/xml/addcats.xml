  <language>en_US</language>
  <keyword>addcats</keyword>
  <short_description>Add categories to a categorical array.</short_description>
  <syntax>
    <syntax_item>B = addcats(A, names)</syntax_item>
    <syntax_item>B = addcats(A, names, 'Before', anchor)</syntax_item>
    <syntax_item>B = addcats(A, names, 'After', anchor)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Input categorical array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>names</param_name>
      <param_description>Category name or names to add. Names already present in <b>A</b> are ignored.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>anchor</param_name>
      <param_description>Existing category used as insertion point when <b>Before</b> or <b>After</b> is specified.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>B</param_name>
      <param_description>Categorical array with the same values as <b>A</b> and an updated category list.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>addcats</b> appends categories to a categorical array without changing the stored elements.</p>
    <p>For ordinal categorical arrays, the insertion position must be explicit because category order defines comparisons.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Add a category at the end of the list.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'}); B = addcats(A, 'green'); categories(B)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Insert a category before an existing category.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'low','high'}, {'low','high'}, 'Ordinal', true); B = addcats(A, 'mid', 'Before', 'high'); categories(B)]]></example_item_data>
    </example_item>
  </examples>
