  <language>en_US</language>
  <keyword>isordinal</keyword>
  <short_description>Determine whether a categorical array is ordinal.</short_description>
  <syntax>
    <syntax_item>tf = isordinal(A)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Input value.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>Logical scalar that is <b>true</b> for ordinal categorical arrays.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>isordinal</b> returns <b>true</b> when <b>A</b> is categorical and category order is meaningful.</p>
    <p>Ordinal arrays support relational comparisons based on category order.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Create an ordinal array and test it.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'low','high'}, {'low','high'}, 'Ordinal', true); tf = isordinal(A)]]></example_item_data>
    </example_item>
  </examples>
