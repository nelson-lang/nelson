  <language>en_US</language>
  <keyword>iscategory</keyword>
  <short_description>Determine whether names are categories.</short_description>
  <syntax>
    <syntax_item>tf = iscategory(A, names)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>A</param_name>
      <param_description>Input categorical array.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>names</param_name>
      <param_description>Category name, string array, cell array of character vectors, or pattern to test.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>Logical result with the same size as <b>names</b>, except for pattern input where a scalar result is returned.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>iscategory</b> tests whether requested names are present in the category list of <b>A</b>.</p>
    <p>Undefined elements do not create a category and are not matched by this function.</p>
  </description>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Check several category names.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[A = categorical({'red','blue'}); tf = iscategory(A, {'red','green'})]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
