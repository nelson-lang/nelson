  <language>fr_FR</language>
  <keyword>ncinfo</keyword>
  <short_description>Retourne les informations d'une source de donnees netCDF.</short_description>
  <syntax>
    <syntax_item>info = ncinfo(filename)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>arguments</param_name>
      <param_description>Input arguments follow the syntax shown above. File and group identifiers are numeric values returned by netCDF open, create, group, dimension, and variable definition calls. Named netCDF constants can be obtained with netcdf.getConstant.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>info</param_name>
      <param_description>Structure Nelson contenant les informations de la source netCDF.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>ncinfo retourne une structure Nelson decrivant une source netCDF.</p>
    <p>La structure contient les groupes, dimensions, variables, attributs et options de stockage disponibles.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Exemple copiable pour ncinfo.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[filename = [tempdir(), 'help_ncinfo.nc'];
nccreate(filename, 'temperature', 'Dimensions', {'x', 3});
info = ncinfo(filename);
info.Variables(1).Name]]></example_item_data>
    </example_item>
  </examples>
