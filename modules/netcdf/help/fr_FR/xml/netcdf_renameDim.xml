  <language>fr_FR</language>
  <keyword>netcdf.renameDim</keyword>
  <short_description>Renomme une dimension netCDF.</short_description>
  <syntax>
    <syntax_item>netcdf.renameDim(ncid, dimid, newname)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ncid</param_name>
      <param_description>Identifiant numerique d'un fichier ou groupe netCDF ouvert.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dimid</param_name>
      <param_description>Identifiant numerique d'une dimension netCDF.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dimname</param_name>
      <param_description>Dimension name.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dimlen</param_name>
      <param_description>Dimension length or NC_UNLIMITED.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>none</param_name>
      <param_description>Cette fonction ne retourne pas de valeur.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf.renameDim expose une operation bas niveau de la bibliotheque netCDF.</p>
    <p>Ces fonctions utilisent des identifiants numeriques et suivent les conventions netCDF, notamment pour les indices, les modes et les constantes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Exemple copiable pour netcdf.renameDim.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[filename = [tempdir(), 'help_netcdf_renameDim.nc'];
ncid = netcdf.create(filename, netcdf.getConstant('NC_CLOBBER'));
dimid = netcdf.defDim(ncid, 'x', 3);
netcdf.renameDim(ncid, dimid, 'samples');
netcdf.close(ncid);]]></example_item_data>
    </example_item>
  </examples>
