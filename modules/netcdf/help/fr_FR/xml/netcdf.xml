  <language>fr_FR</language>
  <keyword>netcdf</keyword>
  <short_description>Interface bas niveau du paquet NetCDF.</short_description>
  <syntax>
    <syntax_item>netcdf.method(...)</syntax_item>
    <syntax_item>netcdf.getConstant(name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>method</param_name>
      <param_description>nom d&apos;une opération NetCDF bas niveau statique.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>nom de constante accepté par getConstant.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>varargout</param_name>
      <param_description>sorties renvoyées par l&apos;opération bas niveau sélectionnée.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf est une classe qui regroupe les opérations NetCDF bas niveau sous forme de méthodes statiques.</p>
    <p>Utilisez les fonctions haut niveau ncinfo, ncread, ncwrite et fonctions associées lorsque cela convient a la tâche.</p>
  </description>
  <used_function>
    <used_function_item>NetCDF C library</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Interroger la version de la bibliothèque NetCDF liée.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[versionText = netcdf.inqLibVers()]]></example_item_data>
    </example_item>
  </examples>
