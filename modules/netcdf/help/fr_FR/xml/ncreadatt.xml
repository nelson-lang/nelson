  <language>fr_FR</language>
  <keyword>ncreadatt</keyword>
  <short_description>Lit un attribut depuis une source netCDF.</short_description>
  <syntax>
    <syntax_item>attvalue = ncreadatt(filename, location, attname)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>filename</param_name>
      <param_description>Chemin du fichier netCDF a creer, ouvrir ou modifier.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>location</param_name>
      <param_description>Chemin de groupe, de variable ou d'attribut dans la source netCDF.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>attname</param_name>
      <param_description>Nom de l'attribut netCDF.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>attvalue</param_name>
      <param_description>Valeur retournee par la syntaxe indiquee ci-dessus.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>ncreadatt lit un attribut global ou associe a une variable netCDF.</p>
    <p>Indiquez la source, l'emplacement et le nom de l'attribut a lire.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Exemple copiable pour ncreadatt.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[filename = [tempdir(), 'help_ncreadatt.nc'];
nccreate(filename, 'temperature', 'Dimensions', {'x', 2});
ncwriteatt(filename, 'temperature', 'units', 'degree');
units = ncreadatt(filename, 'temperature', 'units')]]></example_item_data>
    </example_item>
  </examples>
