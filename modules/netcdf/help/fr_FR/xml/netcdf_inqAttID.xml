  <language>fr_FR</language>
  <keyword>netcdf.inqAttID</keyword>
  <short_description>Retourne l'identifiant d'un attribut netCDF.</short_description>
  <syntax>
    <syntax_item>attid = netcdf.inqAttID(ncid, varid, attname)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ncid</param_name>
      <param_description>Identifiant numerique d'un fichier ou groupe netCDF ouvert.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>varid</param_name>
      <param_description>Identifiant numerique d'une variable netCDF.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>attname</param_name>
      <param_description>Nom de l'attribut netCDF.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>attvalue</param_name>
      <param_description>Attribute value.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>attid</param_name>
      <param_description>Valeur retournee par la syntaxe indiquee ci-dessus.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf.inqAttID expose une operation bas niveau de la bibliotheque netCDF.</p>
    <p>Ces fonctions utilisent des identifiants numeriques et suivent les conventions netCDF, notamment pour les indices, les modes et les constantes.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Exemple copiable pour netcdf.inqAttID.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[filename = [tempdir(), 'help_netcdf_inqAttID.nc'];
ncid = netcdf.create(filename, netcdf.getConstant('NC_CLOBBER'));
netcdf.putAtt(ncid, netcdf.getConstant('NC_GLOBAL'), 'title', 'sample file');
attid = netcdf.inqAttID(ncid, netcdf.getConstant('NC_GLOBAL'), 'title');
netcdf.close(ncid);]]></example_item_data>
    </example_item>
  </examples>
