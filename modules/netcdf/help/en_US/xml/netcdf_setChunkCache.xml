  <keyword>netcdf.setChunkCache</keyword>
  <short_description>Set default chunk cache settings for the netCDF library.</short_description>
  <syntax>
    <syntax_item>netcdf.setChunkCache(size, nelems, preemption)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>size</param_name>
      <param_description>Cache size in bytes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>nelems</param_name>
      <param_description>Number of cache elements.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>preemption</param_name>
      <param_description>Preemption policy value between 0 and 1.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>none</param_name>
      <param_description>This function does not return a value.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf.setChunkCache changes the default chunk cache settings for later operations.</p>
    <p>Existing open variables may keep their current cache settings.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Copy-paste example for netcdf.setChunkCache.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[cacheSize, nelems, preemption] = netcdf.getChunkCache();
netcdf.setChunkCache(cacheSize, nelems, preemption);
[cacheSize2, nelems2, preemption2] = netcdf.getChunkCache()]]></example_item_data>
    </example_item>
  </examples>
