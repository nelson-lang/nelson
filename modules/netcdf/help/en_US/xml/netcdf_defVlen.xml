  <language>en_US</language>
  <keyword>netcdf.defVlen</keyword>
  <short_description>Work with netCDF user-defined variable length types.</short_description>
  <syntax>
    <syntax_item>xtype = netcdf.defVlen(ncid, typeName, baseType)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ncid</param_name>
      <param_description>Open netCDF file or group identifier.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>xtype</param_name>
      <param_description>User-defined type identifier.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>typeName</param_name>
      <param_description>Name of the user-defined type.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>baseType</param_name>
      <param_description>Base netCDF datatype constant.</param_description>
    </param_input_item>
  </param_input>
    <param_output>
    <param_output_item>
      <param_name>xtype</param_name>
      <param_description>Return value described by the syntax shown above.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf.defVlen exposes user-defined type metadata from netCDF-4 files.</p>
    <p>Variable length types require netCDF-4 support in the linked library.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Copy-paste example for netcdf.defVlen.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[filename = [tempdir(), 'help_netcdf_defVlen.nc'];
mode = bitor(netcdf.getConstant('NC_CLOBBER'), netcdf.getConstant('NC_NETCDF4'));
ncid = netcdf.create(filename, mode);
typeid = netcdf.defVlen(ncid, 'sample_vlen', netcdf.getConstant('NC_DOUBLE'));
netcdf.close(ncid);]]></example_item_data>
    </example_item>
  </examples>
