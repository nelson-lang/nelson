  <language>en_US</language>
  <keyword>ncdisp</keyword>
  <short_description>Display a readable summary of a netCDF data source.</short_description>
  <syntax>
    <syntax_item>ncdisp(filename)</syntax_item>
    <syntax_item>ncdisp(filename, location)</syntax_item>
    <syntax_item>ncdisp(filename, location, mode)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>filename</param_name>
      <param_description>Path of the netCDF data source.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>location</param_name>
      <param_description>Optional group or variable location to display.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>mode</param_name>
      <param_description>Optional display mode.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>none</param_name>
      <param_description>This function does not return a value.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>ncdisp prints a human-readable summary of the netCDF source in the command window.</p>
    <p>Use ncinfo when the metadata must be consumed by code.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Copy-paste example for ncdisp.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[filename = [tempdir(), 'help_ncdisp.nc'];
nccreate(filename, 'temperature', 'Dimensions', {'x', 3});
ncwrite(filename, 'temperature', [1 2 3]);
ncdisp(filename)]]></example_item_data>
    </example_item>
  </examples>
