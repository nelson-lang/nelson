  <language>en_US</language>
  <keyword>netcdf.getAtt</keyword>
  <short_description>Work with netCDF attributes.</short_description>
  <syntax>
    <syntax_item>attvalue = netcdf.getAtt(ncid, varid, attname)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ncid</param_name>
      <param_description>Open netCDF file or group identifier.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>varid</param_name>
      <param_description>Variable identifier, or NC_GLOBAL for a global attribute.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>attname</param_name>
      <param_description>Attribute name.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>attvalue</param_name>
      <param_description>Attribute value.</param_description>
    </param_input_item>
  </param_input>
    <param_output>
    <param_output_item>
      <param_name>attvalue</param_name>
      <param_description>Return value described by the syntax shown above.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf.getAtt exposes low-level attribute operations.</p>
    <p>Attributes store metadata such as units, titles, comments, scale factors, and valid ranges.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Copy-paste example for netcdf.getAtt.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[filename = [tempdir(), 'help_netcdf_getAtt.nc'];
ncid = netcdf.create(filename, netcdf.getConstant('NC_CLOBBER'));
netcdf.putAtt(ncid, netcdf.getConstant('NC_GLOBAL'), 'title', 'sample file');
title = netcdf.getAtt(ncid, netcdf.getConstant('NC_GLOBAL'), 'title');
netcdf.close(ncid);]]></example_item_data>
    </example_item>
  </examples>
