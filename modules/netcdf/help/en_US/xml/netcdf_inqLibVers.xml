  <keyword>netcdf.inqLibVers</keyword>
  <short_description>Return netCDF C library version information.</short_description>
  <syntax>
    <syntax_item>version = netcdf.inqLibVers()</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>none</param_name>
      <param_description>This function does not require input arguments.</param_description>
    </param_input_item>
  </param_input>
    <param_output>
    <param_output_item>
      <param_name>version</param_name>
      <param_description>Return value described by the syntax shown above.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf.inqLibVers reports the runtime netCDF C library version.</p>
    <p>This is useful when diagnosing format support and optional library features.</p>
  </description>
  <used_function />
  <bibliography />
