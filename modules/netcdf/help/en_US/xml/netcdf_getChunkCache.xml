  <keyword>netcdf.getChunkCache</keyword>
  <short_description>Return default chunk cache settings for the netCDF library.</short_description>
  <syntax>
    <syntax_item>[size, nelems, preemption] = netcdf.getChunkCache()</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>none</param_name>
      <param_description>This function does not require input arguments.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>size</param_name>
      <param_description>Cache size in bytes.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>nelems</param_name>
      <param_description>Number of cache elements.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>preemption</param_name>
      <param_description>Preemption policy value.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf.getChunkCache reads the process default chunk cache settings used by the netCDF C library.</p>
    <p>These settings affect chunked netCDF-4 variable access.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Copy-paste example for netcdf.getChunkCache.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[cacheSize, nelems, preemption] = netcdf.getChunkCache()]]></example_item_data>
    </example_item>
  </examples>
