  <language>en_US</language>
  <keyword>netcdf</keyword>
  <short_description>Low-level NetCDF package interface.</short_description>
  <syntax>
    <syntax_item>netcdf.method(...)</syntax_item>
    <syntax_item>netcdf.getConstant(name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>method</param_name>
      <param_description>name of a static low-level NetCDF operation.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>constant name accepted by getConstant.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>varargout</param_name>
      <param_description>outputs returned by the selected low-level operation.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf is a class that groups low-level NetCDF operations as static methods.</p>
    <p>Use the high-level ncinfo, ncread, ncwrite, and related functions when they fit the task.</p>
  </description>
  <used_function>
    <used_function_item>NetCDF C library</used_function_item>
  </used_function>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Query the linked NetCDF library version.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[versionText = netcdf.inqLibVers()]]></example_item_data>
    </example_item>
  </examples>
  <see_also>
    <see_also_item><link linkend="${netcdf}ncinfo">ncinfo</link></see_also_item>
    <see_also_item><link linkend="${netcdf}ncread">ncread</link></see_also_item>
    <see_also_item><link linkend="${netcdf}ncwrite">ncwrite</link></see_also_item>
  </see_also>
