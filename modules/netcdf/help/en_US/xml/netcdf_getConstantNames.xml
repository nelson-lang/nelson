    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Copy-paste example for netcdf.getConstantNames.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[names = netcdf.getConstantNames();
names(1)]]></example_item_data>
    </example_item>
  </examples>
