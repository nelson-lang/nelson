  <language>en_US</language>
  <keyword>netcdf.create</keyword>
  <short_description>Create a new netCDF dataset.</short_description>
  <syntax>
    <syntax_item>ncid = netcdf.create(filename, mode)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ncid</param_name>
      <param_description>Open netCDF file or group identifier.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>filename</param_name>
      <param_description>Path of the file when used by create or open.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>mode</param_name>
      <param_description>Numeric mode built from netCDF constants when required.</param_description>
    </param_input_item>
  </param_input>
    <param_output>
    <param_output_item>
      <param_name>ncid</param_name>
      <param_description>Return value described by the syntax shown above.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf.create is a low-level wrapper around the corresponding netCDF C library operation.</p>
    <p>Low-level functions use numeric identifiers returned by netcdf.create, netcdf.open, and related calls.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Copy-paste example for netcdf.create.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[filename = [tempdir(), 'help_netcdf_create.nc'];
ncid = netcdf.create(filename, netcdf.getConstant('NC_CLOBBER'));
netcdf.close(ncid);]]></example_item_data>
    </example_item>
  </examples>
