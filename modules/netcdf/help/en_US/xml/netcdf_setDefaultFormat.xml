  <language>en_US</language>
  <keyword>netcdf.setDefaultFormat</keyword>
  <short_description>Change the default file format used by netCDF create calls.</short_description>
  <syntax>
    <syntax_item>oldFormat = netcdf.setDefaultFormat(format)</syntax_item>
  </syntax>
    <param_input>
    <param_input_item>
      <param_name>arguments</param_name>
      <param_description>Input arguments follow the syntax shown above. File and group identifiers are numeric values returned by netCDF open, create, group, dimension, and variable definition calls. Named netCDF constants can be obtained with netcdf.getConstant.</param_description>
    </param_input_item>
  </param_input>
    <param_output>
    <param_output_item>
      <param_name>oldFormat</param_name>
      <param_description>Return value described by the syntax shown above.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf.setDefaultFormat sets the process default netCDF format.</p>
    <p>Prefer explicit creation modes when a file format matters for reproducibility.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Copy-paste example for netcdf.setDefaultFormat.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[oldFormat = netcdf.setDefaultFormat(netcdf.getConstant('NC_FORMAT_NETCDF4'));
netcdf.setDefaultFormat(oldFormat);]]></example_item_data>
    </example_item>
  </examples>
