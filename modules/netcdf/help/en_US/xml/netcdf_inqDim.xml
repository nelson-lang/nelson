  <language>en_US</language>
  <keyword>netcdf.inqDim</keyword>
  <short_description>Work with netCDF dimensions.</short_description>
  <syntax>
    <syntax_item>[dimname, dimlen] = netcdf.inqDim(ncid, dimid)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ncid</param_name>
      <param_description>Open netCDF file or group identifier.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dimid</param_name>
      <param_description>Dimension identifier.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dimname</param_name>
      <param_description>Dimension name.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>dimlen</param_name>
      <param_description>Dimension length or NC_UNLIMITED.</param_description>
    </param_input_item>
  </param_input>
    <param_output>
    <param_output_item>
      <param_name>[dimname, dimlen]</param_name>
      <param_description>Return value described by the syntax shown above.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>netcdf.inqDim exposes low-level dimension metadata.</p>
    <p>Dimensions define the shape of variables and can be shared by several variables in the same group.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Copy-paste example for netcdf.inqDim.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[filename = [tempdir(), 'help_netcdf_inqDim.nc'];
ncid = netcdf.create(filename, netcdf.getConstant('NC_CLOBBER'));
dimid = netcdf.defDim(ncid, 'x', 3);
[name, len] = netcdf.inqDim(ncid, dimid);
netcdf.close(ncid);]]></example_item_data>
    </example_item>
  </examples>
