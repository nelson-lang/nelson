  <language>en_US</language>
  <keyword>ncreadatt</keyword>
  <short_description>Read an attribute from a netCDF file or variable.</short_description>
  <syntax>
    <syntax_item>attvalue = ncreadatt(filename, location, attname)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>filename</param_name>
      <param_description>Path of the netCDF data source.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>location</param_name>
      <param_description>Variable name, or &apos;/&apos; for a global attribute.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>attname</param_name>
      <param_description>Attribute name.</param_description>
    </param_input_item>
  </param_input>
    <param_output>
    <param_output_item>
      <param_name>attvalue</param_name>
      <param_description>Return value described by the syntax shown above.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>ncreadatt reads metadata stored as netCDF attributes.</p>
    <p>Use this function for high-level attribute access when variable names are known.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Copy-paste example for ncreadatt.</example_item_description>
      <example_item_data runnable="cli"><![CDATA[filename = [tempdir(), 'help_ncreadatt.nc'];
nccreate(filename, 'temperature', 'Dimensions', {'x', 2});
ncwriteatt(filename, 'temperature', 'units', 'degree');
units = ncreadatt(filename, 'temperature', 'units')]]></example_item_data>
    </example_item>
  </examples>
