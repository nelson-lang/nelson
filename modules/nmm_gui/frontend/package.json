{
  "name": "nelson-nmm-gui-frontend",
  "private": true,
  "version": "0.0.1",
  "description": "Nelson package manager window (nmm_gui): React + TypeScript frontend served by WebUI.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "build:wasm": "npm run typecheck && vite build --config vite.wasm.config.ts",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run typecheck && npm run test && npm run test:e2e"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.0",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
