#pragma once
//=============================================================================
// Generated at build time from locale/nmm-ui-<locale>.json (Crowdin catalogs):
// the package manager window strings are embedded in the binary. Each catalog
// line is its own raw literal so no literal reaches the compiler size limit.
//=============================================================================
namespace Nelson::NmmGuiGateway {
//=============================================================================
struct UiCatalog
{
    const char* locale;
    const char* json;
};
//=============================================================================
constexpr UiCatalog UI_CATALOGS[] = {
@NMM_GUI_UI_CATALOGS@
};
//=============================================================================
} // namespace Nelson::NmmGuiGateway
//=============================================================================
