  <Target Name="GenerateNmmGuiLocaleJson" BeforeTargets="ClCompile">
    <MakeDir Directories="$(IntDir)generated" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;$q=[char]34; $n=[char]10; $e=''; foreach ($f in Get-ChildItem '$(SolutionDir)modules\nmm_gui\locale' -Filter 'nmm-ui-*.json' | Sort-Object Name) { $j=[IO.File]::ReadAllText($f.FullName).Replace([string][char]13,'').TrimEnd($n).Replace([string]$n, ')nmmui'+$q+$n+'      R'+$q+'nmmui('); $e+='    { '+$q+$f.BaseName.Substring(7)+$q+','+$n+'      R'+$q+'nmmui('+$j+')nmmui'+$q+' },'+$n }; $t=[IO.File]::ReadAllText('$(SolutionDir)modules\nmm_gui\builtin\cpp\NmmGuiLocaleJson.hpp.in').Replace('@NMM_GUI_UI_CATALOGS@', $e.TrimEnd($n)); $o='$(ProjectDir)$(IntDir)generated\NmmGuiLocaleJson.hpp'; if (-not (Test-Path $o) -or [IO.File]::ReadAllText($o) -ne $t) { [IO.File]::WriteAllText($o, $t, [Text.UTF8Encoding]::new($false)) }&quot;" />
  </Target>
