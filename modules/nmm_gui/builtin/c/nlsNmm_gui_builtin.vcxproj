  <!-- Build the nmm_gui frontend (React + TypeScript, Vite) into frontend/dist,
       the folder the package manager window serves (same as web_gui). -->
  <ItemGroup>
    <NmmGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\src\**\*" />
    <NmmGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\index.html" />
    <NmmGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\package.json" />
    <NmmGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\vite.config.ts" />
    <NmmGuiFrontendSources Include="$(MSBuildThisFileDirectory)..\..\frontend\tsconfig.json" />
  </ItemGroup>
  <Target Name="NmmGuiNpmInstall" Condition="Exists('$(MSBuildThisFileDirectory)..\..\frontend\package.json') And !Exists('$(MSBuildThisFileDirectory)..\..\frontend\node_modules')">
    <Message Importance="high" Text="Installing npm deps for nmm_gui frontend..." />
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\frontend" />
  </Target>
  <Target Name="NmmGuiDistBuild" AfterTargets="Build" DependsOnTargets="NmmGuiNpmInstall" Condition="Exists('$(MSBuildThisFileDirectory)..\..\frontend\package.json')" Inputs="@(NmmGuiFrontendSources)" Outputs="$(MSBuildThisFileDirectory)..\..\frontend\dist\index.html">
    <Message Importance="high" Text="Building nmm_gui frontend (npm run build)..." />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildThisFileDirectory)..\..\frontend" />
  </Target>
