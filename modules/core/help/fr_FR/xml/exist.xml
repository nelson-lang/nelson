  <language>fr_FR</language>
  <keyword>exist</keyword>
  <short_description>Verifie l&apos;existence d&apos;une variable, fonction ou fichier.</short_description>
  <syntax>
    <syntax_item>res = exist(name)</syntax_item>
    <syntax_item>res = exist(name, category)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>chaine : nom de l&apos;entite a tester</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>type</param_name>
      <param_description>chaine : type recherche (optionnel) : &apos;var&apos;, &apos;builtin&apos;, &apos;file&apos;, &apos;dir&apos; ou &apos;class&apos;</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>code</param_name>
      <param_description>un entier : code indiquant le type d&apos;existence</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>Verifie si une entite (variable, fonction, fichier, dossier, classe, etc.) existe et retourne un code indiquant son type.</p>
    <p><b>8</b> indique une classe.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[exist('fileread')
fileread = 3;
exist('fileread')
clear fileread
exist('fileread')
]]></example_item_data>
    </example_item>
  </examples>
