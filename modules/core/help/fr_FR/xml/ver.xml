  <language>fr_FR</language>
  <keyword>ver</keyword>
  <short_description>Informations de version.</short_description>
  <syntax>
    <syntax_item>ver</syntax_item>
    <syntax_item>ver(name)</syntax_item>
    <syntax_item>v = ver()</syntax_item>
    <syntax_item>v = ver(name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>une chaîne ou un tableau de caractères : nom du produit.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>v</param_name>
      <param_description>un tableau de structures avec les champs <b>Name</b>, <b>Version</b>, <b>Release</b> et <b>Date</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ver</b> affiche les informations de version.</p>
    <p><b>v = ver()</b> renvoie les informations de version dans un tableau de structures avec les champs <b>Name</b>, <b>Version</b>, <b>Release</b> et <b>Date</b>.</p>
    <p><b>ver(name)</b> limite les informations au produit <b>name</b> (un résultat vide est renvoyé s&apos;il n&apos;est pas installé).</p>
  </description>
