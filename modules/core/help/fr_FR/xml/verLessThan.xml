  <keyword>verLessThan</keyword>
  <short_description>Compare la version d&apos;un produit à une chaîne de version.</short_description>
  <syntax>
    <syntax_item>tf = verLessThan(toolboxName, versionString)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>toolboxName</param_name>
      <param_description>une chaîne ou un tableau de caractères : nom du produit.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>versionString</param_name>
      <param_description>une chaîne de la forme <b>&apos;major[.minor[.revision]]&apos;</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>un logique : <b>true</b> si la version installée est inférieure à <b>versionString</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = verLessThan(toolboxName, versionString)</b> renvoie <b>true</b> si la version installée du produit nommé est inférieure à <b>versionString</b>.</p>
    <p>Pour la compatibilité, interroger <b>&apos;matlab&apos;</b> renvoie une version récente afin que les tests de version hérités valent <b>false</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[tf = verLessThan('nelson', '0.1')]]></example_item_data>
    </example_item>
  </examples>
