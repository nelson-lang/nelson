  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Pas assez d&apos;arguments d&apos;entrée :</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[msg = nargchk(2, 3, 1)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Trop d&apos;arguments d&apos;entrée :</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[msg = nargchk(1, 2, 3)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description
      >Dans l&apos;intervalle, renvoie un message vide :</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[msg = nargchk(1, 3, 2)]]></example_item_data>
    </example_item>
  </examples>
