  <language>fr_FR</language>
  <keyword>crypto.x25519.keypair</keyword>
  <short_description>Génère une paire de clés X25519.</short_description>
  <syntax>
    <syntax_item>[publicKey, secretKey] = crypto.x25519.keypair()</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>(aucun)</param_name>
      <param_description>cette fonction ne prend aucun argument d'entrée.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>publicKey</param_name>
      <param_description>vecteur de caractères : 64 caractères hexadécimaux minuscules (32 octets).</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>secretKey</param_name>
      <param_description>vecteur de caractères : 64 caractères hexadécimaux minuscules (32 octets aléatoires sûrs) ; à garder secret.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>crypto.x25519.keypair</b> génère une paire de clés Curve25519 aléatoire (RFC 7748) via <b>crypto.random</b>. Partagez la clé publique et gardez la clé secrète privée.</p>
  </description>
  <used_function>Monocypher</used_function>
  <bibliography>https://www.rfc-editor.org/rfc/rfc7748, https://monocypher.org/</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>générer une paire de clés</example_item_description>
      <example_item_data runnable="cli"><![CDATA[[pub, sec] = crypto.x25519.keypair()]]></example_item_data>
    </example_item>
  </examples>
