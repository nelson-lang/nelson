  <language>en_US</language>
  <keyword>isstr</keyword>
  <short_description>Determine whether input is a character array (deprecated).</short_description>
  <syntax>
    <syntax_item>tf = isstr(x)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>x</param_name>
      <param_description>a value, any type.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description
      >a logical: <b>true</b> if <b>x</b> is a character array, <b>false</b> otherwise.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>isstr</b> is a deprecated alias for <b
      >ischar</b>. It returns <b>true</b> when <b
      >x</b> is a character array and <b>false</b> otherwise.</p>
    <p>A string array (created with double quotes) is not a character array, so <b
      >isstr</b> returns <b>false</b> for it.</p>
    <p><b>isstr</b> is kept for compatibility with legacy code. Use <b
      >ischar</b> instead in new code.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>A character array:</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[tf = isstr('hello')]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>A numeric value is not a character array:</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[tf = isstr(42)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>A string is not a character array:</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[tf = isstr("hello")]]></example_item_data>
    </example_item>
  </examples>
