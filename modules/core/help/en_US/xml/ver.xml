  <language>en_US</language>
  <keyword>ver</keyword>
  <short_description>Version information.</short_description>
  <syntax>
    <syntax_item>ver</syntax_item>
    <syntax_item>ver(name)</syntax_item>
    <syntax_item>v = ver()</syntax_item>
    <syntax_item>v = ver(name)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>name</param_name>
      <param_description>a string scalar or character array: product name.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>v</param_name>
      <param_description>a struct array with fields <b>Name</b>, <b>Version</b>, <b>Release</b> and <b>Date</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>ver</b> displays version information.</p>
    <p><b>v = ver()</b> returns the version information in a structure array with the fields <b>Name</b>, <b>Version</b>, <b>Release</b> and <b>Date</b>.</p>
    <p><b>ver(name)</b> restricts the information to the product <b>name</b> (an empty result is returned when it is not installed).</p>
  </description>
  <used_function />
