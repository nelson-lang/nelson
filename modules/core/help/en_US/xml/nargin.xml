  <language>en_US</language>
  <keyword>nargin</keyword>
  <short_description>Returns the number of input arguments.</short_description>
  <syntax>
    <syntax_item>R = nargin()</syntax_item>
    <syntax_item>R = nargin(function_name)</syntax_item>
    <syntax_item>R = nargin(function_handle)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>function_name</param_name>
      <param_description>a string: function name</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>function_handle</param_name>
      <param_description>a function handle</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>R</param_name>
      <param_description
      >an integer value: number of input arguments</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>nargin</b> returns the number of input arguments of a function.</p>
    <p>
      When called without an input argument, <b>nargin</b> returns the number
      of input arguments used to call the currently executing function.</p>
    <p>
      When called with a function name or function handle, <b>nargin</b>
      returns the number of input arguments declared by that function.</p>
    <p>
      If the last declared input argument is <b>varargin</b>, the returned
      value is negative. Its absolute value is the total number of declared
      input arguments, including <b>varargin</b>. For example, for a function
      declared as <b>f(a, b, varargin)</b>, <b>nargin('f')</b> returns
      <b>-3</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>With an macro function:</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[nargin('getfield')]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>With an builtin function:</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[nargin('cos')]]></example_item_data>
    </example_item>
  </examples>
