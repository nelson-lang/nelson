  <language>en_US</language>
  <keyword>nargchk</keyword>
  <short_description>Validate number of input arguments.</short_description>
  <syntax>
    <syntax_item>msg = nargchk(minArgs, maxArgs, n)</syntax_item>
    <syntax_item>msg = nargchk(minArgs, maxArgs, n, 'string')</syntax_item>
    <syntax_item>msgstruct = nargchk(minArgs, maxArgs, n, 'struct')</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>minArgs</param_name>
      <param_description
      >minimum number of accepted inputs (scalar integer value).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>maxArgs</param_name>
      <param_description
      >maximum number of accepted inputs (scalar integer value).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>n</param_name>
      <param_description
      >number of supplied inputs to check, usually <b>nargin</b> (scalar integer value).</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>'string' or 'struct'</param_name>
      <param_description
      >output type: <b>'string'</b> (default) returns a character message, <b>'struct'</b> returns an error structure.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>msg</param_name>
      <param_description
      >a character row vector error message, or <b>''</b> (empty) if <b>n</b> is in the range <b>[minArgs, maxArgs]</b>.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>msgstruct</param_name>
      <param_description
      >a structure with fields <b>message</b> and <b>identifier</b> (a <b>1x0</b> empty structure if <b>n</b> is in range).</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>nargchk</b> checks whether the number of input arguments <b
      >n</b> falls within the range <b>[minArgs, maxArgs]</b>.</p>
    <p>It returns the message <b>'Not enough input arguments.'</b> when <b
      >n</b> is less than <b>minArgs</b>, <b>'Too many input arguments.'</b> when <b
      >n</b> is greater than <b>maxArgs</b>, and an empty result otherwise.</p>
    <p>It is typically used as <b
      >error(nargchk(minArgs, maxArgs, nargin))</b> at the start of a function.</p>
    <p><b>nargchk</b> is deprecated and kept for compatibility with legacy code. Use <b
      >narginchk</b> instead in new code.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Not enough input arguments:</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[msg = nargchk(2, 3, 1)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Too many input arguments:</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[msg = nargchk(1, 2, 3)]]></example_item_data>
    </example_item>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>In range returns an empty message:</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[msg = nargchk(1, 3, 2)]]></example_item_data>
    </example_item>
  </examples>
