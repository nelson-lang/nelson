  <language>en_US</language>
  <keyword>crypto.sha256</keyword>
  <short_description>SHA-256 checksum (crypto namespace alias).</short_description>
  <syntax>
    <syntax_item>hexa_hash = crypto.sha256(...)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>...</param_name>
      <param_description>see <b>sha256</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>hexa_hash</param_name>
      <param_description>hexadecimal string, same as <b>sha256</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>crypto.sha256</b> is an alias of <b>sha256</b> in the <b>crypto</b> namespace (same arguments and same result).</p>
  </description>
