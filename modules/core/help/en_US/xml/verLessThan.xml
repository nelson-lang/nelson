  <language>en_US</language>
  <keyword>verLessThan</keyword>
  <short_description>Compare toolbox version to a version string.</short_description>
  <syntax>
    <syntax_item>tf = verLessThan(toolboxName, versionString)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>toolboxName</param_name>
      <param_description>a string scalar or character array: product name.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>versionString</param_name>
      <param_description>a string of the form <b>&apos;major[.minor[.revision]]&apos;</b>.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>tf</param_name>
      <param_description>a logical: <b>true</b> when the installed version is lower than <b>versionString</b>.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>tf = verLessThan(toolboxName, versionString)</b> returns <b>true</b> when the installed version of the named product is lower than <b>versionString</b>.</p>
    <p>For compatibility, querying <b>&apos;matlab&apos;</b> reports a recent version so that legacy version gates resolve to <b>false</b>.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
        runnable="cli"
      ><![CDATA[tf = verLessThan('nelson', '0.1')]]></example_item_data>
    </example_item>
  </examples>
