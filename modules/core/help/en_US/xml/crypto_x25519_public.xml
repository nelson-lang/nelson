  <keyword>crypto.x25519.public</keyword>
  <short_description>Derive an X25519 public key.</short_description>
  <syntax>
    <syntax_item>publicKey = crypto.x25519.public(secretKey)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>secretKey</param_name>
      <param_description>a uint8 vector of 32 bytes or 64 hexadecimal characters: private key.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>publicKey</param_name>
      <param_description>a character vector: 64 lowercase hexadecimal characters (32 bytes).</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>crypto.x25519.public</b> derives the Curve25519 public key (RFC 7748) matching a 32-byte secret key.</p>
    <p>Generate the secret key with <b>crypto.random(32)</b> or use <b>crypto.x25519.keypair</b> to get both at once.</p>
  </description>
  <used_function>Monocypher</used_function>
  <bibliography>https://www.rfc-editor.org/rfc/rfc7748, https://monocypher.org/</bibliography>
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>derive the public key from a secret</example_item_description>
      <example_item_data runnable="cli"><![CDATA[sec = crypto.random(32, '-hex');
pub = crypto.x25519.public(sec)]]></example_item_data>
    </example_item>
  </examples>
