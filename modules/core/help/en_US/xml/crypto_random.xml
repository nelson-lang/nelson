  <language>en_US</language>
  <keyword>crypto.random</keyword>
  <short_description>Get cryptographically secure random bytes.</short_description>
  <syntax>
    <syntax_item>bytes = crypto.random(n)</syntax_item>
    <syntax_item>hexa = crypto.random(n, &apos;-hex&apos;)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>n</param_name>
      <param_description>an integer between 1 and 1048576: number of random bytes.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>&apos;-hex&apos;</param_name>
      <param_description>return the bytes as a hexadecimal character vector instead of uint8.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>bytes</param_name>
      <param_description>a uint8 row vector of n secure random bytes.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>hexa</param_name>
      <param_description>a character vector: 2 * n lowercase hexadecimal characters.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>crypto.random</b> returns random bytes from the operating system secure random source (<b>BCryptGenRandom</b> on Windows, <b>/dev/urandom</b> on other systems). Use it for keys, nonces and salts. Unlike <b>rand</b>, its output is unpredictable and must not be seeded.</p>
  </description>
  <used_function />
