    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[key = crypto.random(32)
nonce = crypto.random(24, '-hex')]]></example_item_data>
    </example_item>
