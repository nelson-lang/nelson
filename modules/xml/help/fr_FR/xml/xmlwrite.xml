  <language>fr_FR</language>
  <keyword>xmlwrite</keyword>
  <short_description>Sérialiser un objet document XML</short_description>
  <syntax>
    <syntax_item>txt = xmlwrite(doc)</syntax_item>
    <syntax_item>xmlwrite(filename, doc)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>doc</param_name>
      <param_description>un objet document XML retourné par xmlread, ou du texte XML.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>filename</param_name>
      <param_description>une chaîne : chemin vers le fichier XML de sortie.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>txt</param_name>
      <param_description>une chaîne contenant le XML sérialisé.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>xmlwrite convertit un objet document XML en texte ou l&apos;écrit dans un fichier.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data runnable="cli"><![CDATA[xml_filename = [modulepath('xml'), '/tests/test_xml.xml'];
doc = xmlread(xml_filename);
out_filename = [tempdir(), 'xmlwrite_example.xml'];
xmlwrite(out_filename, doc);
isfile(out_filename)]]></example_item_data>
    </example_item>
  </examples>
