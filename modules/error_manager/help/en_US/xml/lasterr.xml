  <language>en_US</language>
  <keyword>lasterr</keyword>
  <short_description>Returns or sets last recorded error message.</short_description>
  <syntax>
    <syntax_item>msg = lasterr()</syntax_item>
    <syntax_item>[msg, id] = lasterr()</syntax_item>
    <syntax_item>previous = lasterr(msg)</syntax_item>
    <syntax_item>previous = lasterr(msg, id)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>msg</param_name>
      <param_description>error message: character vector or string scalar.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>id</param_name>
      <param_description>error identifier: character vector or string scalar.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>msg</param_name>
      <param_description>last error message: character vector.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>id</param_name>
      <param_description>last error identifier: character vector.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>msg = lasterr()</b> returns the message of the last recorded error.</p>
    <p><b>[msg, id] = lasterr()</b> also returns the error identifier.</p>
    <p><b>lasterr(msg)</b> and <b>lasterr(msg, id)</b> set the last error message (and identifier), returning the previous message.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
      ><![CDATA[try
  error('MyPkg:boom', 'exploded');
catch
end
[msg, id] = lasterr()]]></example_item_data>
    </example_item>
  </examples>
