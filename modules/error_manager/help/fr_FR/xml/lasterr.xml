  <language>fr_FR</language>
  <keyword>lasterr</keyword>
  <short_description>Retourne ou definit le dernier message d'erreur.</short_description>
  <syntax>
    <syntax_item>msg = lasterr()</syntax_item>
    <syntax_item>[msg, id] = lasterr()</syntax_item>
    <syntax_item>previous = lasterr(msg)</syntax_item>
    <syntax_item>previous = lasterr(msg, id)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>msg</param_name>
      <param_description>message d'erreur : chaine de caracteres.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>id</param_name>
      <param_description>identifiant d'erreur : chaine de caracteres.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>msg</param_name>
      <param_description>dernier message d'erreur : chaine de caracteres.</param_description>
    </param_output_item>
    <param_output_item>
      <param_name>id</param_name>
      <param_description>dernier identifiant d'erreur : chaine de caracteres.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>msg = lasterr()</b> retourne le message de la derniere erreur enregistree.</p>
    <p><b>[msg, id] = lasterr()</b> retourne aussi l'identifiant de l'erreur.</p>
    <p><b>lasterr(msg)</b> et <b>lasterr(msg, id)</b> definissent le dernier message d'erreur (et l'identifiant), et retournent le message precedent.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data
      ><![CDATA[try
  error('MyPkg:boom', 'exploded');
catch
end
[msg, id] = lasterr()]]></example_item_data>
    </example_item>
  </examples>
