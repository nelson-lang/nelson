  <language>fr_FR</language>
  <keyword>getReport</keyword>
  <short_description>Obtient le rapport MException.</short_description>
  <syntax>
    <syntax_item>report = getReport(ME)</syntax_item>
    <syntax_item>report = getReport(ME, type)</syntax_item>
    <syntax_item>report = ME.getReport(type)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>ME</param_name>
      <param_description>un objet MException scalaire.</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>type</param_name>
      <param_description>&apos;basic&apos; ou &apos;extended&apos;.</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>report</param_name>
      <param_description>une chaine : rapport formate de l&apos;exception.</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p><b>getReport</b> renvoie un rapport formate pour un objet MException.</p>
    <p>Le rapport <b>basic</b> contient le message de l&apos;exception. Le rapport <b>extended</b> inclut des informations de diagnostic supplementaires lorsqu&apos;elles sont disponibles.</p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description />
      <example_item_data><![CDATA[ME = MException('nelson:badIndex', 'Unable to index into array.');
getReport(ME, 'basic')]]></example_item_data>
    </example_item>
  </examples>
