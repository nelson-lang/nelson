  <language>en_US</language>
  <keyword>format</keyword>
  <short_description>Display format and number printing.</short_description>
  <syntax>
    <syntax_item>fmt = format()</syntax_item>
    <syntax_item>format()</syntax_item>
    <syntax_item>format(&apos;default&apos;)</syntax_item>
    <syntax_item>format(new_style)</syntax_item>
    <syntax_item>format(&apos;truncateMatrices&apos;, &apos;on&apos;)</syntax_item>
    <syntax_item>format(&apos;truncateMatrices&apos;, &apos;off&apos;)</syntax_item>
    <syntax_item>format(fmt)</syntax_item>
  </syntax>
  <param_input>
    <param_input_item>
      <param_name>new_style</param_name>
      <param_description>a string or character vector</param_description>
    </param_input_item>
    <param_input_item>
      <param_name>fmt</param_name>
      <param_description>a nelson.display.DisplayFormatOptions object</param_description>
    </param_input_item>
  </param_input>
  <param_output>
    <param_output_item>
      <param_name>fmt</param_name>
      <param_description>nelson.display.DisplayFormatOptions object: current display format</param_description>
    </param_output_item>
  </param_output>
  <description>
    <p>
      <b>format(new_style)</b> changes the display format and number printing of the current session.</p>
    <p>
      <b>format(&apos;default&apos;)</b> resets to the default format (short, loose, truncateMatrices on).</p>
    <p>
      <b>fmt = format()</b> returns a <b>nelson.display.DisplayFormatOptions</b> object with the current <b>NumericFormat</b>, <b>LineSpacing</b>, and <b>TruncateMatrices</b> values.</p>
    <p>
      <b>format(fmt)</b> restores the display format stored in a <b>nelson.display.DisplayFormatOptions</b> object.</p>
    <p />
    <p>Numeric formats supported:</p>
    <p><b>short</b></p>
    <p><b>long</b></p>
    <p><b>shortE</b></p>
    <p><b>longE</b></p>
    <p><b>shortG</b></p>
    <p><b>longG</b></p>
    <p><b>shortEng</b></p>
    <p><b>longEng</b></p>
    <p><b>+</b></p>
    <p><b>bank</b></p>
    <p><b>rational</b></p>
    <p><b>hex</b></p>
    <p />
    <p>Line spacing formats supported:</p>
    <p><b>loose</b></p>
    <p><b>compact</b></p>
    <p />
    <p>Matrix truncation formats supported:</p>
    <p><b>format(&apos;truncateMatrices&apos;, &apos;on&apos;)</b></p>
    <p><b>format(&apos;truncateMatrices&apos;, &apos;off&apos;)</b></p>
  </description>
  <used_function />
  <bibliography />
  <examples>
    <example_item>
      <example_item_type>nelson</example_item_type>
      <example_item_description>Save and restore display format.</example_item_description>
      <example_item_data
        runnable="cli"
      ><![CDATA[current_style = format()
pi
format('longE')
pi
format('compact')
pi
format(current_style)
pi]]></example_item_data>
    </example_item>
  </examples>
