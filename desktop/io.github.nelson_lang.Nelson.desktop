[Desktop Entry]
Name=Nelson
X-Nelson-Version=2.0.0
Version=1.0
Comment=Nelson is a matrix and array programming language for engineering and scientific computing. It uses C/C++ numerical libraries such as Eigen.
Comment[fr]=Nelson est un langage de programmation matricielle et tableau pour le calcul scientifique et l'ingenierie. Il utilise des bibliotheques numeriques C/C++ comme Eigen.
Exec=nelson-gui --associated-files %F
Icon=nelson
GenericName=Scientific Computing Environment
Terminal=false
Type=Application
Categories=Science;Education;Math;Development;
StartupNotify=true
StartupWMClass=Nelson
MimeType=application/x-nelson-script;application/x-nelson-workspace;application/x-nelson-data;application/x-nflow-model;application/x-nelson-notebook;
Keywords=numerical computation;science;plotting;math;matrix;scientific computing;engineering;data analysis;programming;statistics;visualization;simulation;
